<!doctype html>
{%- liquid
    assign is_rtl = false
    assign list_rtl = 'ar,dv,ha,he,ku,fa,ur,ug' | split: ','
    if list_rtl contains request.locale.iso_code or settings.rtl
        assign is_rtl = true
    endif
-%}
<html class="no-js" lang="{{ shop.locale }}" {% if is_rtl %}dir="rtl"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_button }}">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ shop.name }} &ndash; {{ 'general.password_page.opening_soon' | t }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {%- if settings.favicon != blank -%}
        <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: '32' }}" type="image/png">
    {%- endif -%}
    {%- if settings.favicon_retina != blank -%}
        <link rel="apple-touch-icon-precomposed" type="image/png" sizes="152x152" href="{{ settings.favicon_retina | image_url: width: '152' }}">
    {%- endif -%}

    {% render 'social-meta-tags' %}
    {% render 'head-css' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'default.css' | asset_url | stylesheet_tag }}

    <style>
        .template-password { height:100vh; position:relative; }
        .template-password.modal--is-active { height:100vh; }
        .password-main #contact_form .btn { white-space: nowrap; padding-inline:25px;}
        .password_input { max-width: 450px; margin-left:auto; margin-right:auto; }
        @media only screen and (max-width: 766px) {
            .password-content { margin-bottom: 20px; }
            #shopify-section-password-content { width:100%; }
        }

        .modal { padding:20px; display:none; overflow:hidden; z-index:667; width:80%; max-width:440px; text-align:center; background-color:#fff; box-shadow:0 0 10px 0 rgba(0, 0, 0, 0.5); bottom:inherit; }
        #LoginModal .at-icon { height: 20px; width:20px; }
        #LoginModal.modal { width:100%; max-width:100%; height:100%; top:0; left:0; transform:translate(0, 0); }
        .modal--is-active { transform: translateY(0); display: block; opacity: 1; overflow: hidden; }
        .modal__inner { transform-style: preserve-3d; height:100%; }
        .modal__centered { transform:translateY(-50%); position:relative; top:50%; }
        .no-csstransforms .modal__centered { top:20%; }
        .modal__close { border:0 !important; padding:10px 15px; position:fixed; top:0; right:0; background:none; }
    </style>

    <script src="{{ 'jquery.min.js' | asset_url }}" defer="defer"></script>
    <script>
		var theme = {
            shopCurrency:{{ shop.currency | json }},moneyFormat:{% if settings.curCode %}{{ shop.money_with_currency_format | json }}{% else %}{{ shop.money_format | json }}{% endif %},
            {%- if settings.mlcurrency and settings.curOpt == 'script' -%}
              mlcurrency:true,autocurrency:{{ settings.auto_currencies }},currencyFormat:"{% if settings.curCode %}money_with_currency_format{% else %}money_format{% endif %}",money_currency_format:{{ shop.money_with_currency_format | strip_html | json }},
            {%- endif -%}
            animation:{{settings.animef }},animationMobile:{{settings.animefm }},wladd:{{ 'products.wishlist.add_to_wishlist' | t | json }},wlremove:{{ 'products.wishlist.remove' | t | json }},isrtl:{{is_rtl}},
        };
		document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
        var alpha="Abcdefghijklmnopqrstuvwxyz".split(""),thm=alpha[0]+alpha[21]+alpha[14]+alpha[13]+alpha[4],shpeml='{{shop.email}}',dmn=window.location.hostname;
        window.shopUrl = '{{ request.origin }}'; window.routes = { cart_add_url:'{{ routes.cart_add_url }}', cart_change_url:'{{ routes.cart_change_url }}', cart_update_url:'{{ routes.cart_update_url }}', cart_url:'{{ routes.cart_url }}', predictive_search_url:'{{ routes.predictive_search_url }}' };
        window.cartStrings = { error: `{{ 'cart.general.error' | t }}`, quantityError: `{{ 'cart.general.quantity_error_html' | t: quantity: '[quantity]' }}` };
        window.variantStrings = {addToCart: `{{ 'products.product.add_to_cart' | t }}`,preOrder: `{{ 'products.product.pre_order' | t }}`,soldOut: `{{ 'products.product.sold_out' | t }}`,unavailable: `{{ 'products.product.unavailable' | t }}`,unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,};
    </script>
    <script src="{{ 'vendor.js' | asset_url }}" defer></script>
    <script src="{{ 'password.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
</head>
<body class="template-password">
    {{ content_for_layout }}
    <div id="LoginModal" class="modal pa">
      <div class="modal__inner">
        <button type="button" class="modal__close js-modal-close">
            <svg class="at-icon"><use xlink:href="#icon-close"></use></svg>
            <span class="fallback_txt">{{ 'accessibility.close' | t | json }}</span>
        </button>
        <div class="modal__centered page-width tc">
          <div class="shopify-section">
            <div class="passCnt">
                <p class="password_heading mb30 h4">{{ 'general.password_page.login_form_heading' | t }}</p>
                {% form 'storefront_password' %}
                    {{ form.errors | default_errors }}
                    <label for="password" class="hidden_txt">{{- 'general.password_page.login_form_password_label' | t -}}</label>
                    <div class="nw fl password_input mb20 gap" style="--gap:10px;">
                        <input class="fl1 newsletter-txt mb0" type="password" name="password" id="Password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
                        <button type="submit" name="commit" class="btn">{{ 'general.password_page.login_form_submit' | t }}</button>
                    </div>
                {% endform %}
                <p class="fl f-jcc gap" style="--gap:20px;"><a href="/admin" class="js-modal-open-login-modal btn-link">{{ 'general.password_page.admin_link' | t }}</a> | <a href="#" class="js-modal-close btn-link">{{ 'accessibility.close' | t }}</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
    {%- render 'site-bottom', content_for_layout:content_for_layout, is_rtl:is_rtl -%}
</body>
</html>
