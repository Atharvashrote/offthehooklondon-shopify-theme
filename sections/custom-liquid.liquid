{% assign section_st = section.settings %}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st: section_st, bgimage: true %}>
  <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}" id="{{ section.id }}">
    {% render 'sec-title' %}
    {% if section_st.custom_liquid != blank %}{{ section_st.custom_liquid }}{% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Custom liquid",
  "class": "custom-liquid",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading"
     
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",      
    }, 
     {
      "type": "richtext",
      "id": "text",
      "label": "Description"    
    },  
    {
      "id": "custom_liquid",
      "type": "liquid",
      "label": "Liquid code"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },    
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 20
    }    
  ],
  "presets": [
    {
      "name": "Custom liquid",
      "category": "Layout"
    }
  ]
}
{% endschema %}