{%- capture products_row -%}
{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
-%}
{%- capture sizes -%}
  (min-width:1024px) calc({{ page_width }} / {{ section_st.grid }}),(min-width:768px) calc(100vw / {{ section_st.gridtb }}), calc(100vw / {{ section_st.gridmb }})
{%- endcapture -%}
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}" id="{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="collection-template"> 
        {%- render 'sec-title' -%}

        {%- assign collection = collections[section_st.collection] -%}
        {%- assign product_limit = section_st.rows -%}
        <div class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products">         
            {%- if section_st.products != blank or section_st.collection != blank -%}                     
                {% if section_st.products != blank  %}                                        
                        {% for product in section_st.products limit: section_st.rows %}                      
                            <div class="gitem">{% render 'product-card-grid', product: product, section_st:section_st, sizes: sizes %}</div>
                        {% endfor %}                   
                    {% else %}
                        {%- for product in section_st.collection.products limit: section_st.rows -%}
                           <div class="gitem {% render 'animate-data', css:true %}" {% render 'animate-data', i:forloop.index %}>{% render 'product-card-grid', product: product, section_st:section_st, sizes:sizes %}</div>
                        {%- endfor -%}
                {% endif %}                    
            {%- else -%}
                {%- for i in (1..product_limit) -%}
                    <div class="gitem {% render 'animate-data', css:true %}" {% render 'animate-data', i:forloop.index %}>
                        <div class="grid-content">
                            <a href="#" class="grid_lnk">
                                <div class="grid-image__wrapper">{% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}{{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}</div>
                                <br/>
                                <div class="h5 fw-500 grid-title">{{ 'homepage.onboarding.product_title' | t }}</div>
                                <div class="grid-price"> {% render 'product-price' %} </div>
                            </a>
                        </div>
                    </div>
                  {%- endfor -%}
            {%- endif -%} 
        </div>
        {%- if section_st.show_view_all != blank -%}
            <div class="tc mt20 {% render 'animate-data', css:true %}"><a href="{{ collection.url }}" class="btn {{ section_st.btn-size }} {{ section_st.btn-style }}">{{ section_st.show_view_all }}</a></div>
        {%- endif -%}
    </div>
</div>
{%- endcapture -%}
{{- products_row | strip_newlines | remove: '  ' | remove: '	' -}}
{% schema %}
{
  "name": "Products: Rows",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "id": "collection",
      "type": "collection",
      "label": "Collection"
    },
    {
      "id": "products",
      "type": "product_list",
      "label": "Products",
      "info": "replace collection"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "TOP RATED"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Most-Loved Products"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Showcase the finest selections from your store</p> "
    },
    {
      "type": "header",
      "content": "Grid appearance"
    },
    {
      "type": "select",
      "id": "prbox_style",
      "label": "Style",
      "default": "grid-1",
      "options": [
        {
          "value": "grid-1",
          "label": "Icons - bottom center"
        },
        {
          "value": "grid-2",
          "label": "Content on image hover"
        },
        {
          "value": "grid-3",
          "label": "Icons - bottom Left"
        },
        {
          "value": "grid-4",
          "label": "Icons - top right"
        },
         {
          "value": "grid-5",
          "label": "Icons - below image"
        },
         {
          "value": "grid-6",
          "label": "Text button "
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_color_swatch",
      "label": "Show color swatch",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Columns (desktop)",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridtb",
      "label": "Columns (tablet)",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridmb",
      "label": "Columns (mobile)",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Products to show",
      "default": 8,
      "min": 2,
      "max": 50,
      "step": 1
    },
    {
      "type": "paragraph",
      "content": "Find additional grid options under [theme settings](/editor?context=theme&category=Products grid)"
    },
    {
      "type": "header",
      "content": "Button",
      "visible_if": "{{ section.settings.collection != blank }}"
    },
    {
      "type": "text",
      "id": "show_view_all",
      "label": "Button label",
      "visible_if": "{{ section.settings.collection != blank }}"
    },
    {
      "type": "select",
      "id": "btn-style",
      "label": "Button design",
      "default": "btn1",
      "options": [
        {
          "label": "Button 1",
          "value": "btn1"
        },
        {
          "label": "Button 2",
          "value": "btn2"
        },
        {
          "label": "Button 3",
          "value": "btn3"
        },
        {
          "label": "Outline Button 1",
          "value": "btn4"
        },
        {
          "label": "Outline Button 2",
          "value": "btn5"
        },
        {
          "label": "Link",
          "value": "btn-link"
        }
      ],
      "visible_if": "{{ section.settings.collection != blank and section.settings.show_view_all != blank}}"
    },
    {
      "type": "select",
      "id": "btn-size",
      "label": "Button size",
      "default": "btn-md",
      "options": [
        {
          "label": "Small",
          "value": "btn-sm"
        },
        {
          "label": "Medium",
          "value": "btn-md"
        },
        {
          "label": "Large",
          "value": "btn-lg"
        }
      ],
      "visible_if": "{{ section.settings.collection != blank and section.settings.show_view_all != blank}}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    }, 
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Products: Rows",
      "category": "Products"
    }
  ]
}
{% endschema %}
