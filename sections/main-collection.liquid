{%- capture collection_page -%}
{%- liquid
    assign is_rtl = false
    assign list_rtl = 'ar,dv,ha,he,ku,fa,ur,ug' | split: ','
    if list_rtl contains request.locale.iso_code or settings.rtl
        assign is_rtl = true
    endif
    if is_rtl
        assign left_right = 'right'
    else
        assign left_right = 'left'
    endif

    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
    assign pageurl = canonical_url | split:'type=' | last
-%}

{%- style -%}
    :root { 
        --tfilter_bdr:{{ section_st.flbdr }};--filterby:{{ section_st.ttl_fs | minus:1 }}px;
        --opt_fs:{{ section_st.opt_fs }}px; --optp:{{ section_st.opt_fs | plus : 1 }}px;--hdcl:{{ section_st.ttl_cl }};--bubblebg:{{ section_st.ttl_cl | color_modify: 'alpha', 0.15 }};--opt_cl:{{ section_st.opt_cl }};--opt_clh:{{ section_st.opt_cl_hov }};
        --filter_bdr:{{ section_st.sw_bdr }}; --act_filter_bdr:{{ section_st.sw_bdra }};
        --swatch_size :{{section_st.swatch_size}}px; --swatch_rounded:{{section_st.swatch_rounded}}px;
        --active_filter_lbl:{{ section_st.active_filter_lbl }}; --active_filter_border:{{ section_st.active_filter_border }}; --clear_btn:{{ section_st.clear_btn }};--clear_btn_bg:{{ section_st.clear_btn_bg }};
  
    }
    {%- if section_st.bottom_border -%}.widget-title { --border:{{ section_st.flbtmbdr }} }{%- endif -%}
    {%- if section_st.ttlpreset == 'custom-hd' -%}
        .widget-title { --fs:{{ section_st.wdTtl }}px;--fsm:{{ section_st.wdTtlm }}px;--ff:var(--{{ section_st.wdTtlft }});--fw:{{ section_st.wdTtlwt }};--lh:1.2; }
    {%- endif -%}
    {%- if section_st.tbdr -%}
        .filter-horizontal { border-top:1px solid var(--tfilter_bdr); border-bottom:1px solid var(--tfilter_bdr) }
        .filter-horizontal .sidebar-widget { padding:15px 0 }
    {%- endif -%}
     price-range.filters-select__list .field:before { content:'{{ cart.currency.symbol }}'; position:absolute; top:7px; {{ left_right }}:15px; }
{%- endstyle -%}

{%- paginate collection.products by section_st.prpp -%}

{%- capture pr_view -%}
    {%- if section_st.gridicn -%}
        <div class="toolbar-item hide-sm hide-md{% if section_st.sbpos == 'top' %} mr0{% endif %}" style="--icns:14px;">
            <button type="button" title="Grid View" class="change-view{% unless pageurl == 'list' %} active-view{% endunless %}" data-view="grid" style="color:var(--all_text);"><svg focusable="false" class="icon at-icon" viewBox="0 0 18 18" role="presentation"><path d="M1 .030067h2c.55228475 0 1 .44771525 1 1v2c0 .55228475-.44771525 1-1 1H1c-.55228475 0-1-.44771525-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.55228475 0 1 .44771525 1 1v2c0 .5522847-.44771525 1-1 1H1c-.55228475 0-1-.4477153-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.55228475 0 1 .4477153 1 1v2c0 .5522847-.44771525 1-1 1H1c-.55228475 0-1-.4477153-1-1v-2c0-.5522847.44771525-1 1-1zm7-14h2c.5522847 0 1 .44771525 1 1v2c0 .55228475-.4477153 1-1 1H8c-.55228475 0-1-.44771525-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.5522847 0 1 .44771525 1 1v2c0 .5522847-.4477153 1-1 1H8c-.55228475 0-1-.4477153-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.5522847 0 1 .4477153 1 1v2c0 .5522847-.4477153 1-1 1H8c-.55228475 0-1-.4477153-1-1v-2c0-.5522847.44771525-1 1-1zm7-14h2c.5522847 0 1 .44771525 1 1v2c0 .55228475-.4477153 1-1 1h-2c-.5522847 0-1-.44771525-1-1v-2c0-.55228475.4477153-1 1-1zm0 7h2c.5522847 0 1 .44771525 1 1v2c0 .5522847-.4477153 1-1 1h-2c-.5522847 0-1-.4477153-1-1v-2c0-.55228475.4477153-1 1-1zm0 7h2c.5522847 0 1 .4477153 1 1v2c0 .5522847-.4477153 1-1 1h-2c-.5522847 0-1-.4477153-1-1v-2c0-.5522847.4477153-1 1-1z" fill="currentColor" fill-rule="evenodd"></path></svg></button>
            <button type="button" title="List View" class="change-view{% if pageurl == 'list' %} active-view{% endif %}" data-view="list" style="color:var(--all_text);"><svg focusable="false" class="icon at-icon" viewBox="0 0 18 18" role="presentation"> <path d="M8 1.030067h9c.5522847 0 1 .44771525 1 1s-.4477153 1-1 1H8c-.55228475 0-1-.44771525-1-1s.44771525-1 1-1zm0 7h9c.5522847 0 1 .44771525 1 1s-.4477153 1-1 1H8c-.55228475 0-1-.44771525-1-1s.44771525-1 1-1zm0 7h9c.5522847 0 1 .4477153 1 1s-.4477153 1-1 1H8c-.55228475 0-1-.4477153-1-1s.44771525-1 1-1zm-7-15h2c.55228475 0 1 .44771525 1 1v2c0 .55228475-.44771525 1-1 1H1c-.55228475 0-1-.44771525-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.55228475 0 1 .44771525 1 1v2c0 .5522847-.44771525 1-1 1H1c-.55228475 0-1-.4477153-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.55228475 0 1 .4477153 1 1v2c0 .5522847-.44771525 1-1 1H1c-.55228475 0-1-.4477153-1-1v-2c0-.5522847.44771525-1 1-1z" fill="currentColor" fill-rule="evenodd"></path></svg></button>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture shorting -%}
    {%- if section_st.sortby -%}
        <div class="toolbar-item sorting{% if section_st.sbpos == 'top' %} fl f-aic tpShort{% endif %}">
            <label class="hidden_txt" for="sort-by">{{ 'collections.general.sort_by_label' | t }}</label>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select name="sort_by" class="select__select sort-by mb0 fs13" id="sort-by" form="CollectionFiltersForm">
                {%- for option in collection.sort_options -%}
                    <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected="selected"{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
            </select>
        </div>
    {%- endif -%}
{%- endcapture -%}
{%- capture productcount -%}
    {%- if section_st.pcount -%}
        <div id="itemsCount" class="toolbar-item hide-sm hide-md">
            <span class="toolbar__products-count collection-product-count light" role="status">
                {%- if collection.results_count -%}
                    {{ 'collections.general.product_count' | t: product_count: collection.terms, count: collection.results_count }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
                {%- else -%}
                    {{ 'collections.general.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
                {%- endif -%}
            </span>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture filter_button -%}
    {%- if section_st.filters -%}
        <button type="button" class="btn-filter fl f-aic text-upper fw-500 pd0 mr15 border-0{% if section_st.sbpos != 'popup' %} hide-lg{% endif %}" area-label="{{ 'collections.general.filter_button' | t }}">
            <svg class="at-icon mr5" fill="none" height="512" viewBox="0 0 24 24" width="512" xmlns="http://www.w3.org/2000/svg"><path d="m3 6.25c-.41421 0-.75.33579-.75.75s.33579.75.75.75zm0 10c-.41421 0-.75.3358-.75.75s.33579.75.75.75zm6 1.5c.41421 0 .75-.3358.75-.75s-.33579-.75-.75-.75zm12 0c.4142 0 .75-.3358.75-.75s-.3358-.75-.75-.75zm-6-11.5c-.4142 0-.75.33579-.75.75s.3358.75.75.75zm6 1.5c.4142 0 .75-.33579.75-.75s-.3358-.75-.75-.75zm-18 0h3v-1.5h-3zm0 10h6v-1.5h-6zm15 0h3v-1.5h-3zm-3-10h6v-1.5h-6zm2.25 9.25c0 1.2426-1.0074 2.25-2.25 2.25v1.5c2.0711 0 3.75-1.6789 3.75-3.75zm-2.25 2.25c-1.2426 0-2.25-1.0074-2.25-2.25h-1.5c0 2.0711 1.6789 3.75 3.75 3.75zm-2.25-2.25c0-1.2426 1.0074-2.25 2.25-2.25v-1.5c-2.0711 0-3.75 1.6789-3.75 3.75zm2.25-2.25c1.2426 0 2.25 1.0074 2.25 2.25h1.5c0-2.0711-1.6789-3.75-3.75-3.75zm-3.75-7.75c0 1.24264-1.0074 2.25-2.25 2.25v1.5c2.0711 0 3.75-1.67893 3.75-3.75zm-2.25 2.25c-1.24264 0-2.25-1.00736-2.25-2.25h-1.5c0 2.07107 1.67893 3.75 3.75 3.75zm-2.25-2.25c0-1.24264 1.00736-2.25 2.25-2.25v-1.5c-2.07107 0-3.75 1.67893-3.75 3.75zm2.25-2.25c1.2426 0 2.25 1.00736 2.25 2.25h1.5c0-2.07107-1.6789-3.75-3.75-3.75z" fill="#28303f"/></svg>
            {{ 'collections.general.filter_button' | t }}
        </button>
    {%- endif -%}
{%- endcapture -%}

{%- capture products_list -%}
    {%- if collection.products.size == 0 -%}
        <div id="collection-products" class="collection" data-id="{{ section.id }}">
            <div class="collection--empty">
                <p class="collection-product-count light hide" role="status">{{ 'collections.general.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}</p>
                <div class="title-wrapper w-100 fl f-jcc">
                    <div class="title title--primary">
                        <h3 class="mb5">{{ 'collections.general.empty' | t }}</h3>
                        <p>{{ 'collections.general.use_fewer_filters_html' | t: link: collection.url, class: "underlined-link link" }}</p>
                    </div>
                </div>
            </div>
        </div>
    {%- else -%}
        <div class="collection">
            {%- if pageurl == 'list' -%}
                <div id="collection-products" class="listview-items" data-availability-pages="{{ paginate.pages }}" data-availability-per-page="{{ section_st.prpp }}" data-availability-current-page="{{ paginate.current_page }}" data-availability-view="list">
                    {%- for product in collection.products -%}
                    {%- assign all_variants_sold_out = true -%}
                    {%- for variant in product.variants -%}
                        {%- if variant.available -%}
                            {%- assign all_variants_sold_out = false -%}
                            {%- break -%}
                        {%- endif -%}
                    {%- endfor -%}
                    {%- assign availability_position = paginate.current_page | minus: 1 | times: section_st.prpp | plus: forloop.index -%}
                    <product-card class="listview-item fl f-row-md f-col mb20 {% render 'animate-data', css:true %}" data-availability="{{ product.available }}" data-all-variants-sold-out="{{ all_variants_sold_out }}" data-fully-out-of-stock="{{ all_variants_sold_out }}" data-original-position="{{ availability_position }}" {% render 'animate-data' %}>{% render 'product-card-list', product: product, section_st: section_st, sizes:'(min-width:768px) 250px, 100vw'  %}</product-card>
                    {%- endfor -%}
                </div>
            {%- else -%}
                <div id="collection-products" class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products" data-availability-pages="{{ paginate.pages }}" data-availability-per-page="{{ section_st.prpp }}" data-availability-current-page="{{ paginate.current_page }}" data-availability-view="grid">
                    {%- for product in collection.products -%}
                        {%- capture sizes -%}
                            {%- if section_st.filters and section_st.sbpos != 'top' and section_st.sbpos != 'popup' -%}
                                (min-width:1024px) calc(({{ page_width }} - {{ settings.grid_space | times: section_st.grid | minus:settings.grid_space | plus:340 }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ settings.grid_space | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ settings.grid_spacem | times: section_st.gridmb | minus:settings.grid_spacem }}px) / {{ section_st.gridmb }})
                            {%- else -%}
                                (min-width:1024px) calc(({{ page_width }} - {{ settings.grid_space | times: section_st.grid | minus:settings.grid_space }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ settings.grid_space | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ settings.grid_spacem | times: section_st.gridmb | minus:settings.grid_spacem }}px) / {{ section_st.gridmb }})
                            {%- endif -%}
                        {%- endcapture -%}
                        {%- assign all_variants_sold_out = true -%}
                        {%- for variant in product.variants -%}
                            {%- if variant.available -%}
                                {%- assign all_variants_sold_out = false -%}
                                {%- break -%}
                            {%- endif -%}
                        {%- endfor -%}
                        {%- assign availability_position = paginate.current_page | minus: 1 | times: section_st.prpp | plus: forloop.index -%}
                        <div class="gitem fl {% render 'animate-data', css:true %}" data-availability="{{ product.available }}" data-all-variants-sold-out="{{ all_variants_sold_out }}" data-fully-out-of-stock="{{ all_variants_sold_out }}" data-original-position="{{ availability_position }}" {% render 'animate-data' %}>{% render 'product-card-grid', product:product, section_st:section_st, sizes:sizes %}</div>
                    {%- endfor -%}
                </div>
            {%- endif -%}
        </div>
    {%- endif -%}

    <div id="pagination" class="pagination-wrapper mt30">
        {%- if section_st.pagination == "infinite" or section_st.pagination == "button" -%}
            {%- if paginate.next -%}
                <div class="infinitpagin tc">
                    {%-liquid
                        assign view_type = '&type=grid'
                        if pageurl == 'list'
                            assign view_type = '&type=list'
                        endif
                        assign pgurl = paginate.next.url
                        unless paginate.next.url contains "&type="
                            assign pgurl = paginate.next.url | append: view_type
                        endunless
                    -%}
                    {%- if section_st.pagination == "infinite" -%}
                        <a href="{{ pgurl }}" class="load-more infinite"><svg class="at-icon at-spin mb10" style="--icns:25px"><use xlink:href="#icon-loading"></use></svg><p>{{ 'general.pagination.loading' | t }}</p></a>
                    {%- else -%}
                        <a href="{{ pgurl }}" class="btn load-more"><span class="txt">{{ 'general.pagination.loadmore' | t }}</span><div class="loading__spinner"><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg></div></a>
                    {%- endif -%}
                </div>
            {%- endif -%}
        {%- else -%}
            {%- render 'pagination', paginate: paginate -%}
        {%- endif -%}
    </div>
{%- endcapture -%}

{%- capture block_data -%}
    {%- content_for 'blocks' -%}
{%- endcapture -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="facets{% if section_st.fullwidth %} fw-section{% if section_st.npd %} npd{% endif %}{% else %} page-width{% endif %}" id="Collection">
        <div class="{% unless section_st.sbpos == 'top' %}fl f-col f-ais f-row-md{% endunless %}">
            {%- if section_st.filters and section_st.sbpos != 'top' -%}
                <filters-form class="sidebar sidebar-filter fl f-col gap anim{% if section_st.sbpos == 'popup' %} sidebar-popup custom-scroll{% endif %}{% if section_st.sbpos == 'right' %} order2 sb_right{% endif %}" id="collection-filters" data-id="{{ section.id }}" data-url="{{ shop.url }}{{ collection.url | split: "?" | first }}" style="--gap:{{ section_st.sdgap }}px;--gapm:{{ section_st.sdgapm }}px;">
                    {{ block_data }}
                </filters-form>
            {%- endif -%}

            <div class="main-col fl1 w-100">
                <div class="fl f-col row-gap{% if section_st.talign %} tc{% endif %} mb10" style="--gap:15px;--gapm:10px">                  
                    {%- if section_st.climg and collection.image != blank -%}
                        {%- capture image_sizes -%}
                            {%- if section_st.filters and section_st.sbpos != 'top' and section_st.sbpos != 'popup' -%}
                                (min-width:1024px) calc({{ page_width }} - 340px), 100vw
                            {%- else -%}
                                (min-width:1024px) {{ page_width }}, 100vw
                            {%- endif -%}
                        {%- endcapture -%}
                        {{ collection.image | image_url: width: collection.image.width | image_tag: loading:'lazy', width:collection.image.width, height:collection.image.height, class:'img-auto cl_img mb10', sizes:image_sizes, widths:"400,550,700,900,1200,1500" }}
                    {%- endif -%}
                    {% comment %} {%- if section_st.clttl != blank -%}<h1 class="page-title m0{% if section_st.talign %} tc{% endif %}{% if settings.ttl_c %} text-upper{% endif %}">{{ collection.title }}</h1>{%- endif -%}
                    {%- if collection.description != blank and section_st.des_pos == "1" -%}<div class="rte mb5"> {{ collection.description }} </div>{%- endif -%} {% endcomment %}
                {%- if section_st.clttl != blank -%}<h1 class="page-title m0{% if section_st.talign %} tc{% endif %}{% if settings.ttl_c %} text-upper{% endif %}">{{ collection.title }}</h1>{%- endif -%}
                
                  </div>
                {%- if section_st.filters and section_st.sbpos == 'top' -%}
                    <filters-form class="anim fl f-aic f-jcs f-col f-row-md filter-horizontal mt25 mb20 sidebar-filter{% if section_st.flshadow %} items-shadow{% endif %}" id="collection-filters" data-id="{{ section.id }}" style="--gap:{{ section_st.sdgap }}px;--gapm:{{ section_st.sdgapm }}px;">
                        {{ block_data }}
                    </filters-form>
                {%- endif -%}

                <div class="toolbar fl f-jcsb f-aic mb15 fs13">
                    {%- if section_st.sbpos == 'popup' and section_st.filters -%}
                        <div class="fl f-aic gap" style="--gap:15px;">{{ filter_button }}{{ pr_view }}</div>
                    {%- else -%}
                        {{ filter_button }}{{ pr_view }}
                    {%- endif -%}
                    {{- productcount -}}
                    {{ shorting }}
                </div>
                <div id="active-filters" class="active-facets fl f-wrap gap mb25" style="--gap:10px;">
                    <a href="{{ collection.url }}?sort_by={{ sort_by }}&pgview={% if pageurl == 'list' %}list{% else %}grid{% endif %}" class="active-fl clear-all border-0">{{ 'collections.general.clear_all' | t }}</a>
                    {%- for filter in collection.filters -%}
                        {%- for value in filter.active_values -%}
                            <a class="active-fl" href="{{ value.url_to_remove }}">{{ value.label | escape }} <svg class="at-icon"><use xlink:href="#icon-close"></use></svg></a>
                        {%- endfor -%}
                        {%- if filter.type == "price_range" and filter.min_value.value != nil or filter.max_value.value != nil -%}
                            <a class="active-fl" href="{{ filter.url_to_remove }}">
                                {% if filter.min_value.value %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %} - {% if filter.max_value.value %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %}
                                <svg class="at-icon"><use xlink:href="#icon-close"></use></svg>
                            </a>
                        {%- endif -%}
                    {%- endfor -%}
                </div>
                {{ products_list | strip_newlines }}
                <br/>
                {% comment %} {%- if collection.description != blank and section_st.des_pos == "2" -%}<div class="rte mt30">{{ collection.description }}</div>{%- endif -%}	 {% endcomment %}
            </div>          
        </div>
    </div>
</div>
{%- endpaginate -%}
{%- endcapture -%}
{{- collection_page | strip_newlines | remove: '  ' -}}

{%- for filter in collection.filters -%}
  {%- if filter.type == 'price_range' -%}
    <script src="{{ 'toolcool-range-slider.min.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
{%- endfor -%}
<script src="{{ 'collections.js' | asset_url }}" defer></script>

<style>
  /* ==========================================================
     Availability-first collection ordering
     - Keeps Avone's product cards/animations intact
     - Prevents the white/fade flash while DOM is reordered
     - Keeps sold-out products visible
     ========================================================== */
  #collection-products.availability-ordering-active,
  #collection-products.availability-ordering-active > *,
  #collection-products.availability-ordering-active .gitem,
  #collection-products.availability-ordering-active product-card {
    animation: none !important;
    transition: none !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
  }

  #collection-products.availability-ordering-loading {
    opacity: 1 !important;
  }

  #collection-products [data-availability="false"] {
    display: block !important;
  }

  /* When the native Out of stock filter is selected, mixed-stock products
     are hidden by the product-level availability check below. */
  #collection-products.strict-out-of-stock-filter [data-fully-out-of-stock="false"],
  #collection-products.strict-out-of-stock-filter [data-all-variants-sold-out="false"] {
    display: none !important;
  }

  /* Keep the native Avone pagination area clean while our global ordering is active. */
  #availability-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  #availability-pagination button,
  #availability-pagination a {
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ddd;
    background: #fff;
    color: #111;
    text-decoration: none;
    cursor: pointer;
    font-size: 13px;
    line-height: 1;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }

  #availability-pagination button:hover,
  #availability-pagination a:hover,
  #availability-pagination .is-current {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  #availability-pagination .availability-page-label {
    border: 0;
    cursor: default;
    background: transparent;
    min-width: auto;
  }

  #availability-pagination .availability-load-more {
    min-width: 180px;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 600;
  }

  #availability-pagination .availability-loading {
    pointer-events: none;
    opacity: .55;
  }
</style>

<script>
(function () {
  'use strict';

  var SCRIPT_KEY = 'availabilityFirstCollectionSorterV4';

  /* Prevent Avone from registering the same sorter more than once. */
  if (window[SCRIPT_KEY]) {
    if (typeof window[SCRIPT_KEY].refresh === 'function') {
      window[SCRIPT_KEY].refresh();
    }
    return;
  }

  var state = {
    observer: null,
    refreshTimer: null,
    sorting: false,
    requestId: 0,
    lastGrid: null,
    lastUrl: window.location.href
  };

  function getProductGrid() {
    return document.getElementById('collection-products');
  }

  function getCollectionRoot() {
    return document.getElementById('Collection');
  }

  function getCurrentPage(grid) {
    return grid ? parseInt(grid.dataset.availabilityCurrentPage || '1', 10) || 1 : 1;
  }

  function getPerPage(grid) {
    return grid ? parseInt(grid.dataset.availabilityPerPage || '12', 10) || 12 : 12;
  }

  function getTotalPages(grid) {
    return grid ? parseInt(grid.dataset.availabilityPages || '1', 10) || 1 : 1;
  }

  function isListView(grid) {
    return !!(grid && grid.dataset.availabilityView === 'list');
  }

  function getProductNodes(container) {
    if (!container) return [];

    return Array.prototype.slice.call(container.children).filter(function (node) {
      return node.hasAttribute('data-original-position');
    });
  }

  function availabilityValue(node) {
    return node.getAttribute('data-availability') === 'true' ? 0 : 1;
  }

  /* Product-level availability:
     true only when EVERY variant is unavailable.
     This prevents a product with one sold-out size from appearing
     in the Out of stock filter. */
  function isFullySoldOut(node) {
    /*
     * Out of stock means EVERY variant is unavailable.
     * A product with even ONE available variant is NOT out of stock.
     */
    return node.getAttribute('data-fully-out-of-stock') === 'true' ||
           node.getAttribute('data-all-variants-sold-out') === 'true';
  }

  function strictOutOfStockFilterActive() {
    /*
     * Use the URL as the source of truth.
     * After Avone clears filters through AJAX, the old checkbox can remain
     * in the DOM for a short time. Looking only at :checked therefore makes
     * the strict Out of stock mode incorrectly survive "Clear All".
     */
    var url = new URL(window.location.href);
    var availabilityValues = url.searchParams.getAll('filter.v.availability');

    if (availabilityValues.indexOf('0') === -1) return false;
    if (availabilityValues.indexOf('1') !== -1) return false;

    return true;
  }

  function filterForStrictOutOfStock(products) {
    if (!strictOutOfStockFilterActive()) return products;
    return products.filter(function (node) {
      return isFullySoldOut(node);
    });
  }

  function updateStrictOutOfStockClass(grid) {
    if (!grid) return;
    grid.classList.toggle('strict-out-of-stock-filter', strictOutOfStockFilterActive());
  }

  function originalPosition(node) {
    var value = parseInt(node.getAttribute('data-original-position') || '999999999', 10);
    return isNaN(value) ? 999999999 : value;
  }

  /* Stable sort: availability first, original collection position second. */
  function sortProducts(products) {
    return products.slice().sort(function (a, b) {
      var availabilityDifference = availabilityValue(a) - availabilityValue(b);
      if (availabilityDifference !== 0) return availabilityDifference;
      return originalPosition(a) - originalPosition(b);
    });
  }

  function uniqueProducts(products) {
    var seen = Object.create(null);

    return products.filter(function (node) {
      var position = node.getAttribute('data-original-position');

      if (!position || seen[position]) return false;
      seen[position] = true;
      return true;
    });
  }

  /*
   * When only "Out of stock" is selected, Shopify's native availability
   * parameter (filter.v.availability=0) must NOT be used for our source data.
   * Shopify's native filter is variant-based, so it can return products such
   * as a product with UK 7 sold out but UK 8 available.
   *
   * We therefore fetch the same collection/filter URL WITHOUT the native
   * availability parameter, then apply our own product-level rule:
   * only products where ALL variants are unavailable are kept.
   */
  function isStrictOutOfStockMode() {
    return strictOutOfStockFilterActive();
  }

  /*
   * Performance optimization:
   * Use Shopify's Section Rendering API instead of downloading the entire
   * collection page (header, footer, etc.) for every background request.
   * Only this collection section is rendered on the server.
   */
  var SECTION_ID = '{{ section.id }}';
  var requestCache = Object.create(null);

  function buildSectionUrl(pageNumber, grid, removeNativeAvailability) {
    var params = new URLSearchParams(window.location.search);

    if (removeNativeAvailability) {
      params.delete('filter.v.availability');
    }

    params.set('page', String(pageNumber));
    params.set('type', isListView(grid) ? 'list' : 'grid');
    params.set('section_id', SECTION_ID);

    return window.location.pathname + '?' + params.toString();
  }

  function parseCollectionResponse(html) {
    var parser = new DOMParser();
    var remoteDocument = parser.parseFromString(html, 'text/html');
    var remoteGrid = remoteDocument.querySelector('#collection-products');

    if (!remoteGrid) {
      return { nodes: [], totalPages: 1 };
    }

    return {
      nodes: getProductNodes(remoteGrid),
      totalPages: parseInt(remoteGrid.dataset.availabilityPages || '1', 10) || 1
    };
  }

  function fetchPage(pageNumber, grid, removeNativeAvailability) {
    var url = buildSectionUrl(pageNumber, grid, removeNativeAvailability);

    /* Reuse an identical background request during the same page state. */
    if (requestCache[url]) {
      return requestCache[url];
    }

    requestCache[url] = fetch(url, {
      method: 'GET',
      credentials: 'same-origin',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'text/html'
      }
    })
      .then(function (response) {
        if (!response.ok) {
          throw new Error('Unable to load collection page ' + pageNumber);
        }
        return response.text();
      })
      .then(parseCollectionResponse)
      .catch(function (error) {
        delete requestCache[url];
        throw error;
      });

    return requestCache[url];
  }

  function fetchAllProducts(totalPages, currentPage, grid, removeNativeAvailability) {
    var requests = [];

    for (var page = 1; page <= totalPages; page++) {
      if (page === currentPage && !removeNativeAvailability) continue;
      requests.push(fetchPage(page, grid, removeNativeAvailability));
    }

    if (!requests.length) {
      return Promise.resolve({ products: [], totalPages: totalPages });
    }

    return Promise.all(requests).then(function (pageResults) {
      var products = [];
      var discoveredTotalPages = totalPages;

      pageResults.forEach(function (pageResult) {
        products = products.concat(pageResult.nodes);
        discoveredTotalPages = Math.max(discoveredTotalPages, pageResult.totalPages);
      });

      return {
        products: products,
        totalPages: discoveredTotalPages
      };
    });
  }

  function fetchStrictOutOfStockProducts(grid) {
    /*
     * Shopify's native availability filter is removed from these requests.
     * All other active filters (category, price, color, size, etc.) remain.
     * The complete filtered collection is then checked client-side using
     * data-all-variants-sold-out.
     */
    return fetchPage(1, grid, true).then(function (firstPage) {
      var totalPages = firstPage.totalPages;
      var requests = [];

      for (var page = 2; page <= totalPages; page++) {
        requests.push(fetchPage(page, grid, true));
      }

      if (!requests.length) {
        return firstPage.nodes;
      }

      return Promise.all(requests).then(function (pageResults) {
        var products = firstPage.nodes.slice();

        pageResults.forEach(function (pageResult) {
          products = products.concat(pageResult.nodes);
        });

        return products;
      });
    });
  }

  function setOrderingMode(grid, active) {
    if (!grid) return;

    if (active) {
      grid.classList.add('availability-ordering-active');
      grid.classList.add('availability-ordering-loading');
    } else {
      grid.classList.remove('availability-ordering-active');
      grid.classList.remove('availability-ordering-loading');
    }
  }

  function moveNodesWithoutAnimation(grid, nodes) {
    if (!grid || !nodes.length) return;

    /* CSS above disables Avone's entrance animation before nodes are moved. */
    var fragment = document.createDocumentFragment();

    nodes.forEach(function (node) {
      fragment.appendChild(node);
    });

    grid.appendChild(fragment);
  }

  function showSlice(products, pageNumber, append, grid) {
    if (!grid) return;

    updateStrictOutOfStockClass(grid);

    var perPage = getPerPage(grid);
    var start = Math.max(0, (pageNumber - 1) * perPage);
    var end = Math.min(start + perPage, products.length);
    var slice = products.slice(start, end);

    if (!append) {
      /* Remove only the currently rendered product cards. The grid itself and
         Avone's surrounding DOM stay untouched. */
      getProductNodes(grid).forEach(function (node) {
        node.remove();
      });
    }

    moveNodesWithoutAnimation(grid, slice);
  }

  function clearPagination() {
    var pagination = document.getElementById('pagination');
    if (!pagination) return null;

    pagination.innerHTML = '';
    return pagination;
  }

  function updateUrlPage(pageNumber, replace) {
    var url = new URL(window.location.href);

    if (pageNumber <= 1) {
      url.searchParams.delete('page');
    } else {
      url.searchParams.set('page', pageNumber);
    }

    var method = replace ? 'replaceState' : 'pushState';
    history[method]({ availabilityCollectionPage: pageNumber }, '', url.toString());
  }

  function scrollToCollection() {
    var root = getCollectionRoot();
    if (!root) return;

    window.scrollTo({
      top: Math.max(0, root.getBoundingClientRect().top + window.pageYOffset - 30),
      behavior: 'smooth'
    });
  }

  function renderClassicPagination(products, grid) {
    var pagination = clearPagination();
    if (!pagination) return;

    var perPage = getPerPage(grid);
    var totalPages = Math.max(1, Math.ceil(products.length / perPage));
    var currentPage = Math.min(getCurrentPage(grid), totalPages);

    if (totalPages <= 1) return;

    var wrapper = document.createElement('div');
    wrapper.id = 'availability-pagination';

    if (currentPage > 1) {
      var previous = document.createElement('button');
      previous.type = 'button';
      previous.textContent = '‹';
      previous.setAttribute('aria-label', 'Previous page');

      previous.addEventListener('click', function () {
        var targetPage = currentPage - 1;
        grid.dataset.availabilityCurrentPage = String(targetPage);
        showSlice(products, targetPage, false, grid);
        updateUrlPage(targetPage, false);
        renderClassicPagination(products, grid);
        scrollToCollection();
      });

      wrapper.appendChild(previous);
    }

    for (var page = 1; page <= totalPages; page++) {
      var pageButton = document.createElement('button');
      pageButton.type = 'button';
      pageButton.textContent = page;
      pageButton.className = page === currentPage ? 'is-current' : '';
      pageButton.setAttribute('aria-label', 'Page ' + page);

      (function (targetPage) {
        pageButton.addEventListener('click', function () {
          grid.dataset.availabilityCurrentPage = String(targetPage);
          showSlice(products, targetPage, false, grid);
          updateUrlPage(targetPage, false);
          renderClassicPagination(products, grid);
          scrollToCollection();
        });
      })(page);

      wrapper.appendChild(pageButton);
    }

    if (currentPage < totalPages) {
      var next = document.createElement('button');
      next.type = 'button';
      next.textContent = '›';
      next.setAttribute('aria-label', 'Next page');

      next.addEventListener('click', function () {
        var targetPage = currentPage + 1;
        grid.dataset.availabilityCurrentPage = String(targetPage);
        showSlice(products, targetPage, false, grid);
        updateUrlPage(targetPage, false);
        renderClassicPagination(products, grid);
        scrollToCollection();
      });

      wrapper.appendChild(next);
    }

    pagination.appendChild(wrapper);
  }

  function renderLoadMorePagination(products, grid) {
    var pagination = clearPagination();
    if (!pagination) return;

    var perPage = getPerPage(grid);
    var totalPages = Math.max(1, Math.ceil(products.length / perPage));
    var currentPage = getCurrentPage(grid);

    if (currentPage >= totalPages) return;

    var wrapper = document.createElement('div');
    wrapper.id = 'availability-pagination';

    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'availability-load-more';
    button.textContent = 'Load more';

    button.addEventListener('click', function () {
      if (button.classList.contains('availability-loading')) return;

      button.classList.add('availability-loading');
      button.textContent = 'Loading...';

      var nextPage = (parseInt(grid.dataset.availabilityCurrentPage || currentPage, 10) || 1) + 1;

      if (nextPage <= totalPages) {
        showSlice(products, nextPage, true, grid);
        grid.dataset.availabilityCurrentPage = String(nextPage);
      }

      button.classList.remove('availability-loading');
      button.textContent = 'Load more';

      if (nextPage >= totalPages) {
        pagination.innerHTML = '';
      }
    });

    wrapper.appendChild(button);
    pagination.appendChild(wrapper);
  }

  function renderInfinitePagination(products, grid) {
    var pagination = clearPagination();
    if (!pagination) return;

    var perPage = getPerPage(grid);
    var totalPages = Math.max(1, Math.ceil(products.length / perPage));
    var currentPage = getCurrentPage(grid);

    if (currentPage >= totalPages) return;

    var wrapper = document.createElement('div');
    wrapper.id = 'availability-pagination';

    var sentinel = document.createElement('div');
    sentinel.className = 'availability-page-label';
    sentinel.textContent = 'Loading more…';
    wrapper.appendChild(sentinel);
    pagination.appendChild(wrapper);

    var loading = false;
    var observer = new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting || loading) return;

      var current = parseInt(grid.dataset.availabilityCurrentPage || currentPage, 10) || 1;
      var nextPage = current + 1;

      if (nextPage > totalPages) {
        observer.disconnect();
        pagination.innerHTML = '';
        return;
      }

      loading = true;
      showSlice(products, nextPage, true, grid);
      grid.dataset.availabilityCurrentPage = String(nextPage);
      loading = false;

      if (nextPage >= totalPages) {
        observer.disconnect();
        pagination.innerHTML = '';
      }
    }, { rootMargin: '500px 0px' });

    observer.observe(sentinel);
  }

  function renderPagination(products, grid) {
    var paginationMode = '{{ section_st.pagination }}';

    if (paginationMode === 'default') {
      renderClassicPagination(products, grid);
    } else if (paginationMode === 'infinite') {
      renderInfinitePagination(products, grid);
    } else {
      renderLoadMorePagination(products, grid);
    }
  }

  function restoreNativeState(grid) {
    if (!grid) return;

    grid.dataset.availabilitySorted = 'error';
    setOrderingMode(grid, false);
  }

  function sortCurrentCollection() {
    var grid = getProductGrid();
    if (!grid) return Promise.resolve();

    /* If this exact grid has already been processed, do nothing. */
    if (grid.dataset.availabilitySorted === 'true') return Promise.resolve();
    if (state.sorting) return Promise.resolve();

    var currentProducts = getProductNodes(grid);
    if (!currentProducts.length) return Promise.resolve();

    state.sorting = true;
    state.lastGrid = grid;

    var requestId = ++state.requestId;
    var currentPage = getCurrentPage(grid);
    var totalPages = getTotalPages(grid);

    /* Stop Avone's animation from fading cards while we rearrange them. */
    grid.dataset.availabilitySorted = 'loading';
    setOrderingMode(grid, true);

    if (isStrictOutOfStockMode()) {
      var loadingCount = document.querySelector('#itemsCount .collection-product-count');
      if (loadingCount) loadingCount.textContent = 'Loading out of stock products…';
    }

    /*
     * IMPORTANT:
     * In strict Out of stock mode we must fetch the UNFILTERED collection,
     * because the current Shopify URL contains filter.v.availability=0.
     * Fetching that URL would otherwise give us the same incorrect
     * variant-based result set we are trying to fix.
     */
    var sourcePromise = isStrictOutOfStockMode()
      ? fetchStrictOutOfStockProducts(grid)
      : fetchAllProducts(totalPages, currentPage, grid, false).then(function (result) {
          return uniqueProducts(currentProducts.concat(result.products));
        });

    return sourcePromise
      .then(function (sourceProducts) {
        if (requestId !== state.requestId) return;

        /*
         * In strict mode, sourceProducts contains the complete collection
         * without Shopify's native availability filter. In normal mode it
         * contains the existing collection source.
         */
        var allProducts = uniqueProducts(sourceProducts);

        /* Only fully sold-out products belong in Out of stock. */
        var filteredProducts = filterForStrictOutOfStock(allProducts);
        var sortedProducts = sortProducts(filteredProducts);

        /*
         * Only move the existing DOM nodes. We never rebuild product HTML,
         * so product images, wishlist state and Avone card markup are retained.
         */
        showSlice(sortedProducts, 1, false, grid);

        grid.dataset.availabilitySorted = 'true';
        grid.dataset.availabilityCurrentPage = '1';

        renderPagination(sortedProducts, grid);

        /*
         * Shopify's toolbar count is based on the native variant filter.
         * Replace it with the actual number of fully sold-out products while
         * strict Out of stock mode is active.
         */
        if (isStrictOutOfStockMode()) {
          var countNode = document.querySelector('#itemsCount .collection-product-count');
          if (countNode) {
            var visibleCount = Math.min(getPerPage(grid), sortedProducts.length);
            countNode.textContent = 'Showing ' + visibleCount + ' of ' + sortedProducts.length + ' products';
          }
        }
      })
      .catch(function (error) {
        console.error('[Availability ordering]', error);
        restoreNativeState(grid);
      })
      .finally(function () {
        if (requestId === state.requestId) {
          setOrderingMode(grid, false);
        }
        state.sorting = false;
      });
  }

  function scheduleRefresh() {
    window.clearTimeout(state.refreshTimer);

    state.refreshTimer = window.setTimeout(function () {
      var grid = getProductGrid();
      if (!grid) return;

      var currentUrl = window.location.href;
      var urlChanged = currentUrl !== state.lastUrl;

      /*
       * A URL change means a filter was added/removed, including Clear All.
       * Always allow a fresh pass in that case.
       */
      if (urlChanged) {
        state.lastUrl = currentUrl;
        state.lastGrid = null;
        state.requestId++;
        state.sorting = false;

        /*
         * When Clear All removes filter.v.availability=0, the native Shopify
         * collection should be shown normally again. We deliberately do not
         * apply the strict Out of stock filter in this state.
         */
        grid.dataset.availabilitySorted = '';
      }

      /* A new grid means Avone/filter AJAX has replaced the collection. */
      if (urlChanged || grid !== state.lastGrid || grid.dataset.availabilitySorted !== 'true') {
        sortCurrentCollection();
      }
    }, 150);
  }

  function startObserver() {
    if (state.observer) return;

    var collectionRoot = getCollectionRoot();
    if (!collectionRoot || typeof MutationObserver === 'undefined') return;

    state.observer = new MutationObserver(function () {
      if (state.sorting) return;
      scheduleRefresh();
    });

    /*
     * Watch only the collection area. The sorter disconnects logically via
     * state.sorting, so its own DOM moves don't cause another full fetch.
     */
    state.observer.observe(collectionRoot, {
      childList: true,
      subtree: true
    });
  }

  function refresh() {
    startObserver();
    scheduleRefresh();
  }

  window[SCRIPT_KEY] = {
    refresh: refresh
  };

  /*
   * Avone may handle Clear All with AJAX instead of a full page navigation.
   * Give the theme time to update the URL and collection markup, then force
   * one clean refresh. This prevents the previous strict Out of stock result
   * set from being reused after all filters are cleared.
   */
  document.addEventListener('click', function (event) {
    var clearAll = event.target.closest && event.target.closest('#active-filters .clear-all');

    if (!clearAll) return;

    state.lastGrid = null;
    state.requestId++;
    state.sorting = false;

    window.setTimeout(refresh, 100);
    window.setTimeout(refresh, 350);
    window.setTimeout(refresh, 700);
  });

  refresh();

  document.addEventListener('shopify:section:load', function () {
    state.lastGrid = null;
    state.requestId++;
    state.sorting = false;
    refresh();
  });

  window.addEventListener('popstate', function () {
    state.lastGrid = null;
    state.lastUrl = window.location.href;
    state.requestId++;
    state.sorting = false;
    refresh();
  });
})();
</script>

