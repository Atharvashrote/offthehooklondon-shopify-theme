{%- capture collection_page -%}
{%- liquid
    assign is_rtl = false
    assign list_rtl = 'ar,dv,ha,he,ku,fa,ur,ug' | split: ','
    if list_rtl contains request.locale.iso_code or settings.rtl
        assign is_rtl = true
    endif
    if is_rtl
        assign left_right = 'right'
    else
        assign left_right = 'left'
    endif

    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
    assign pageurl = canonical_url | split:'type=' | last
-%}

{%- style -%}
    :root { 
        --tfilter_bdr:{{ section_st.flbdr }};--filterby:{{ section_st.ttl_fs | minus:1 }}px;
        --opt_fs:{{ section_st.opt_fs }}px; --optp:{{ section_st.opt_fs | plus : 1 }}px;--hdcl:{{ section_st.ttl_cl }};--bubblebg:{{ section_st.ttl_cl | color_modify: 'alpha', 0.15 }};--opt_cl:{{ section_st.opt_cl }};--opt_clh:{{ section_st.opt_cl_hov }};
        --filter_bdr:{{ section_st.sw_bdr }}; --act_filter_bdr:{{ section_st.sw_bdra }};
        --swatch_size :{{section_st.swatch_size}}px; --swatch_rounded:{{section_st.swatch_rounded}}px;
        --active_filter_lbl:{{ section_st.active_filter_lbl }}; --active_filter_border:{{ section_st.active_filter_border }}; --clear_btn:{{ section_st.clear_btn }};--clear_btn_bg:{{ section_st.clear_btn_bg }};
  
    }
    {%- if section_st.bottom_border -%}.widget-title { --border:{{ section_st.flbtmbdr }} }{%- endif -%}
    {%- if section_st.ttlpreset == 'custom-hd' -%}
        .widget-title { --fs:{{ section_st.wdTtl }}px;--fsm:{{ section_st.wdTtlm }}px;--ff:var(--{{ section_st.wdTtlft }});--fw:{{ section_st.wdTtlwt }};--lh:1.2; }
    {%- endif -%}
    {%- if section_st.tbdr -%}
        .filter-horizontal { border-top:1px solid var(--tfilter_bdr); border-bottom:1px solid var(--tfilter_bdr) }
        .filter-horizontal .sidebar-widget { padding:15px 0 }
    {%- endif -%}
     price-range.filters-select__list .field:before { content:'{{ cart.currency.symbol }}'; position:absolute; top:7px; {{ left_right }}:15px; }
{%- endstyle -%}

{%- paginate collection.products by section_st.prpp -%}

{%- comment -%}
    Availability ordering is done per page on the server so Shopify's native
    pagination stays authoritative: in-stock products render first, sold-out
    ones after. When "Out of stock" is the only availability filter, products
    that still have an available variant are skipped (Shopify's filter is
    variant-based and would otherwise include them).
{%- endcomment -%}
{%- liquid
    assign strict_oos = false
    for filter in collection.filters
        if filter.param_name == 'filter.v.availability'
            for value in filter.active_values
                if value.value == '0'
                    assign strict_oos = true
                endif
            endfor
            for value in filter.active_values
                if value.value == '1'
                    assign strict_oos = false
                endif
            endfor
        endif
    endfor
-%}

{%- capture pr_view -%}
    {%- if section_st.gridicn -%}
        <div class="toolbar-item hide-sm hide-md{% if section_st.sbpos == 'top' %} mr0{% endif %}" style="--icns:14px;">
            <button type="button" title="Grid View" class="change-view{% unless pageurl == 'list' %} active-view{% endunless %}" data-view="grid" style="color:var(--all_text);"><svg focusable="false" class="icon at-icon" viewBox="0 0 18 18" role="presentation"><path d="M1 .030067h2c.55228475 0 1 .44771525 1 1v2c0 .55228475-.44771525 1-1 1H1c-.55228475 0-1-.44771525-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.55228475 0 1 .44771525 1 1v2c0 .5522847-.44771525 1-1 1H1c-.55228475 0-1-.4477153-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.55228475 0 1 .4477153 1 1v2c0 .5522847-.44771525 1-1 1H1c-.55228475 0-1-.4477153-1-1v-2c0-.5522847.44771525-1 1-1zm7-14h2c.5522847 0 1 .44771525 1 1v2c0 .55228475-.4477153 1-1 1H8c-.55228475 0-1-.44771525-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.5522847 0 1 .44771525 1 1v2c0 .5522847-.4477153 1-1 1H8c-.55228475 0-1-.4477153-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.5522847 0 1 .4477153 1 1v2c0 .5522847-.4477153 1-1 1H8c-.55228475 0-1-.4477153-1-1v-2c0-.5522847.44771525-1 1-1zm7-14h2c.5522847 0 1 .44771525 1 1v2c0 .55228475-.4477153 1-1 1h-2c-.5522847 0-1-.44771525-1-1v-2c0-.55228475.4477153-1 1-1zm0 7h2c.5522847 0 1 .44771525 1 1v2c0 .5522847-.4477153 1-1 1h-2c-.5522847 0-1-.4477153-1-1v-2c0-.55228475.4477153-1 1-1zm0 7h2c.5522847 0 1 .4477153 1 1v2c0 .5522847-.4477153 1-1 1h-2c-.5522847 0-1-.4477153-1-1v-2c0-.5522847.4477153-1 1-1z" fill="currentColor" fill-rule="evenodd"></path></svg></button>
            <button type="button" title="List View" class="change-view{% if pageurl == 'list' %} active-view{% endif %}" data-view="list" style="color:var(--all_text);"><svg focusable="false" class="icon at-icon" viewBox="0 0 18 18" role="presentation"> <path d="M8 1.030067h9c.5522847 0 1 .44771525 1 1s-.4477153 1-1 1H8c-.55228475 0-1-.44771525-1-1s.44771525-1 1-1zm0 7h9c.5522847 0 1 .44771525 1 1s-.4477153 1-1 1H8c-.55228475 0-1-.44771525-1-1s.44771525-1 1-1zm0 7h9c.5522847 0 1 .4477153 1 1s-.4477153 1-1 1H8c-.55228475 0-1-.4477153-1-1s.44771525-1 1-1zm-7-15h2c.55228475 0 1 .44771525 1 1v2c0 .55228475-.44771525 1-1 1H1c-.55228475 0-1-.44771525-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.55228475 0 1 .44771525 1 1v2c0 .5522847-.44771525 1-1 1H1c-.55228475 0-1-.4477153-1-1v-2c0-.55228475.44771525-1 1-1zm0 7h2c.55228475 0 1 .4477153 1 1v2c0 .5522847-.44771525 1-1 1H1c-.55228475 0-1-.4477153-1-1v-2c0-.5522847.44771525-1 1-1z" fill="currentColor" fill-rule="evenodd"></path></svg></button>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture shorting -%}
    {%- if section_st.sortby -%}
        <div class="toolbar-item sorting{% if section_st.sbpos == 'top' %} fl f-aic tpShort{% endif %}">
            <label class="hidden_txt" for="sort-by">{{ 'collections.general.sort_by_label' | t }}</label>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select name="sort_by" class="select__select sort-by mb0 fs13" id="sort-by" form="CollectionFiltersForm">
                {%- for option in collection.sort_options -%}
                    <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected="selected"{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
            </select>
        </div>
    {%- endif -%}
{%- endcapture -%}
{%- capture productcount -%}
    {%- if section_st.pcount -%}
        <div id="itemsCount" class="toolbar-item hide-sm hide-md">
            <span class="toolbar__products-count collection-product-count light" role="status">
                {%- if collection.results_count -%}
                    {{ 'collections.general.product_count' | t: product_count: collection.terms, count: collection.results_count }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
                {%- else -%}
                    {{ 'collections.general.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
                {%- endif -%}
            </span>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture filter_button -%}
    {%- if section_st.filters -%}
        <button type="button" class="btn-filter fl f-aic text-upper fw-500 pd0 mr15 border-0{% if section_st.sbpos != 'popup' %} hide-lg{% endif %}" area-label="{{ 'collections.general.filter_button' | t }}">
            <svg class="at-icon mr5" fill="none" height="512" viewBox="0 0 24 24" width="512" xmlns="http://www.w3.org/2000/svg"><path d="m3 6.25c-.41421 0-.75.33579-.75.75s.33579.75.75.75zm0 10c-.41421 0-.75.3358-.75.75s.33579.75.75.75zm6 1.5c.41421 0 .75-.3358.75-.75s-.33579-.75-.75-.75zm12 0c.4142 0 .75-.3358.75-.75s-.3358-.75-.75-.75zm-6-11.5c-.4142 0-.75.33579-.75.75s.3358.75.75.75zm6 1.5c.4142 0 .75-.33579.75-.75s-.3358-.75-.75-.75zm-18 0h3v-1.5h-3zm0 10h6v-1.5h-6zm15 0h3v-1.5h-3zm-3-10h6v-1.5h-6zm2.25 9.25c0 1.2426-1.0074 2.25-2.25 2.25v1.5c2.0711 0 3.75-1.6789 3.75-3.75zm-2.25 2.25c-1.2426 0-2.25-1.0074-2.25-2.25h-1.5c0 2.0711 1.6789 3.75 3.75 3.75zm-2.25-2.25c0-1.2426 1.0074-2.25 2.25-2.25v-1.5c-2.0711 0-3.75 1.6789-3.75 3.75zm2.25-2.25c1.2426 0 2.25 1.0074 2.25 2.25h1.5c0-2.0711-1.6789-3.75-3.75-3.75zm-3.75-7.75c0 1.24264-1.0074 2.25-2.25 2.25v1.5c2.0711 0 3.75-1.67893 3.75-3.75zm-2.25 2.25c-1.24264 0-2.25-1.00736-2.25-2.25h-1.5c0 2.07107 1.67893 3.75 3.75 3.75zm-2.25-2.25c0-1.24264 1.00736-2.25 2.25-2.25v-1.5c-2.07107 0-3.75 1.67893-3.75 3.75zm2.25-2.25c1.2426 0 2.25 1.00736 2.25 2.25h1.5c0-2.07107-1.6789-3.75-3.75-3.75z" fill="#28303f"/></svg>
            {{ 'collections.general.filter_button' | t }}
        </button>
    {%- endif -%}
{%- endcapture -%}

{%- capture products_list -%}
    {%- if collection.products.size == 0 -%}
        <div id="collection-products" class="collection" data-id="{{ section.id }}">
            <div class="collection--empty">
                <p class="collection-product-count light hide" role="status">{{ 'collections.general.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}</p>
                <div class="title-wrapper w-100 fl f-jcc">
                    <div class="title title--primary">
                        <h3 class="mb5">{{ 'collections.general.empty' | t }}</h3>
                        <p>{{ 'collections.general.use_fewer_filters_html' | t: link: collection.url, class: "underlined-link link" }}</p>
                    </div>
                </div>
            </div>
        </div>
    {%- else -%}
        <div class="collection">
            {%- if pageurl == 'list' -%}
                <div id="collection-products" class="listview-items">
                    {%- for availability_pass in (1..2) -%}
                    {%- for product in collection.products -%}
                    {%- liquid
                        assign product_pass = 1
                        unless product.available
                            assign product_pass = 2
                        endunless
                        if product_pass != availability_pass
                            continue
                        endif
                    -%}
                    {%- assign all_variants_sold_out = true -%}
                    {%- for variant in product.variants -%}
                        {%- if variant.available -%}
                            {%- assign all_variants_sold_out = false -%}
                            {%- break -%}
                        {%- endif -%}
                    {%- endfor -%}
                    {%- if strict_oos and all_variants_sold_out == false -%}{%- continue -%}{%- endif -%}
                    <product-card class="listview-item fl f-row-md f-col mb20 {% render 'animate-data', css:true %}" data-availability="{{ product.available }}" data-all-variants-sold-out="{{ all_variants_sold_out }}" {% render 'animate-data' %}>{% render 'product-card-list', product: product, section_st: section_st, sizes:'(min-width:768px) 250px, 100vw'  %}</product-card>
                    {%- endfor -%}
                    {%- endfor -%}
                </div>
            {%- else -%}
                <div id="collection-products" class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products">
                    {%- for availability_pass in (1..2) -%}
                    {%- for product in collection.products -%}
                        {%- liquid
                            assign product_pass = 1
                            unless product.available
                                assign product_pass = 2
                            endunless
                            if product_pass != availability_pass
                                continue
                            endif
                        -%}
                        {%- capture sizes -%}
                            {%- if section_st.filters and section_st.sbpos != 'top' and section_st.sbpos != 'popup' -%}
                                (min-width:1024px) calc(({{ page_width }} - {{ settings.grid_space | times: section_st.grid | minus:settings.grid_space | plus:340 }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ settings.grid_space | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ settings.grid_spacem | times: section_st.gridmb | minus:settings.grid_spacem }}px) / {{ section_st.gridmb }})
                            {%- else -%}
                                (min-width:1024px) calc(({{ page_width }} - {{ settings.grid_space | times: section_st.grid | minus:settings.grid_space }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ settings.grid_space | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ settings.grid_spacem | times: section_st.gridmb | minus:settings.grid_spacem }}px) / {{ section_st.gridmb }})
                            {%- endif -%}
                        {%- endcapture -%}
                        {%- assign all_variants_sold_out = true -%}
                        {%- for variant in product.variants -%}
                            {%- if variant.available -%}
                                {%- assign all_variants_sold_out = false -%}
                                {%- break -%}
                            {%- endif -%}
                        {%- endfor -%}
                        {%- if strict_oos and all_variants_sold_out == false -%}{%- continue -%}{%- endif -%}
                        <div class="gitem fl {% render 'animate-data', css:true %}" data-availability="{{ product.available }}" data-all-variants-sold-out="{{ all_variants_sold_out }}" {% render 'animate-data' %}>{% render 'product-card-grid', product:product, section_st:section_st, sizes:sizes %}</div>
                    {%- endfor -%}
                    {%- endfor -%}
                </div>
            {%- endif -%}
        </div>
    {%- endif -%}

    <div id="pagination" class="pagination-wrapper mt30">
        {%- if section_st.pagination == "infinite" or section_st.pagination == "button" -%}
            {%- if paginate.next -%}
                <div class="infinitpagin tc">
                    {%-liquid
                        assign view_type = '&type=grid'
                        if pageurl == 'list'
                            assign view_type = '&type=list'
                        endif
                        assign pgurl = paginate.next.url
                        unless paginate.next.url contains "&type="
                            assign pgurl = paginate.next.url | append: view_type
                        endunless
                    -%}
                    {%- if section_st.pagination == "infinite" -%}
                        <a href="{{ pgurl }}" class="load-more infinite"><svg class="at-icon at-spin mb10" style="--icns:25px"><use xlink:href="#icon-loading"></use></svg><p>{{ 'general.pagination.loading' | t }}</p></a>
                    {%- else -%}
                        <a href="{{ pgurl }}" class="btn load-more"><span class="txt">{{ 'general.pagination.loadmore' | t }}</span><div class="loading__spinner"><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg></div></a>
                    {%- endif -%}
                </div>
            {%- endif -%}
        {%- else -%}
            {%- render 'pagination', paginate: paginate -%}
        {%- endif -%}
    </div>
{%- endcapture -%}

{%- capture block_data -%}
    {%- content_for 'blocks' -%}
{%- endcapture -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="facets{% if section_st.fullwidth %} fw-section{% if section_st.npd %} npd{% endif %}{% else %} page-width{% endif %}" id="Collection">
        <div class="{% unless section_st.sbpos == 'top' %}fl f-col f-ais f-row-md{% endunless %}">
            {%- if section_st.filters and section_st.sbpos != 'top' and section_st.sbpos != 'popup' -%}
                <script>
                    (function () {
                        /* Desktop: the filter sidebar starts hidden. Once the customer shows it, it stays shown for the
                           session (category, filter and page changes reload the page). Runs before the sidebar renders. */
                        var shown = false;
                        try { shown = sessionStorage.getItem('oth-filters-shown') === '1'; } catch (e) {}
                        if (!shown && window.matchMedia('(min-width: 1025px)').matches) document.getElementById('Collection').classList.add('filters-hidden');
                    })();
                </script>
            {%- endif -%}
            {%- if section_st.filters and section_st.sbpos != 'top' -%}
                <filters-form class="sidebar sidebar-filter fl f-col gap anim{% if section_st.sbpos == 'popup' %} sidebar-popup custom-scroll{% endif %}{% if section_st.sbpos == 'right' %} order2 sb_right{% endif %}" id="collection-filters" data-id="{{ section.id }}" data-url="{{ shop.url }}{{ collection.url | split: "?" | first }}" style="--gap:{{ section_st.sdgap }}px;--gapm:{{ section_st.sdgapm }}px;">
                    {{ block_data }}
                </filters-form>
            {%- endif -%}

            <div class="main-col fl1 w-100">
                <div class="fl f-col row-gap{% if section_st.talign %} tc{% endif %} mb10" style="--gap:15px;--gapm:10px">                  
                    {%- if section_st.climg and collection.image != blank -%}
                        {%- capture image_sizes -%}
                            {%- if section_st.filters and section_st.sbpos != 'top' and section_st.sbpos != 'popup' -%}
                                (min-width:1024px) calc({{ page_width }} - 340px), 100vw
                            {%- else -%}
                                (min-width:1024px) {{ page_width }}, 100vw
                            {%- endif -%}
                        {%- endcapture -%}
                        {{ collection.image | image_url: width: collection.image.width | image_tag: loading:'lazy', width:collection.image.width, height:collection.image.height, class:'img-auto cl_img mb10', sizes:image_sizes, widths:"400,550,700,900,1200,1500" }}
                    {%- endif -%}
                    {% comment %} {%- if section_st.clttl != blank -%}<h1 class="page-title m0{% if section_st.talign %} tc{% endif %}{% if settings.ttl_c %} text-upper{% endif %}">{{ collection.title }}</h1>{%- endif -%}
                    {%- if collection.description != blank and section_st.des_pos == "1" -%}<div class="rte mb5"> {{ collection.description }} </div>{%- endif -%} {% endcomment %}
                {%- if section_st.clttl != blank -%}<h1 class="page-title m0{% if section_st.talign %} tc{% endif %}{% if settings.ttl_c %} text-upper{% endif %}">{{ collection.title }}</h1>{%- endif -%}
                
                  </div>
                {%- if section_st.filters and section_st.sbpos == 'top' -%}
                    <filters-form class="anim fl f-aic f-jcs f-col f-row-md filter-horizontal mt25 mb20 sidebar-filter{% if section_st.flshadow %} items-shadow{% endif %}" id="collection-filters" data-id="{{ section.id }}" style="--gap:{{ section_st.sdgap }}px;--gapm:{{ section_st.sdgapm }}px;">
                        {{ block_data }}
                    </filters-form>
                {%- endif -%}

                <div class="toolbar fl f-jcsb f-aic mb15 fs13">
                    {%- if section_st.sbpos == 'popup' and section_st.filters -%}
                        <div class="fl f-aic gap" style="--gap:15px;">{{ filter_button }}{{ pr_view }}</div>
                    {%- elsif section_st.filters and section_st.sbpos != 'top' -%}
                        <div class="toolbar-start fl f-aic">
                            {%- comment -%} Desktop only: FILTERS shows/hides the sidebar; the grid widens to 4 columns while hidden. {%- endcomment -%}
                            <button type="button" class="filters-visibility-toggle" aria-controls="collection-filters" aria-expanded="true" hidden>
                                <span class="filters-visibility-toggle__hide">Hide filters</span><span class="filters-visibility-toggle__show">Filters</span>
                            </button>
                            <script>
                                (function () {
                                    var key = 'oth-filters-shown';
                                    var root = document.getElementById('Collection');
                                    var btn = document.currentScript.previousElementSibling;
                                    var desktop = window.matchMedia('(min-width: 1025px)');
                                    function shownStored() { try { return sessionStorage.getItem(key) === '1'; } catch (e) { return false; } }
                                    function sync() { btn.setAttribute('aria-expanded', root.classList.contains('filters-hidden') ? 'false' : 'true'); }
                                    btn.hidden = false;
                                    sync();
                                    btn.addEventListener('click', function () {
                                        var hide = !root.classList.contains('filters-hidden');
                                        var grid = document.getElementById('collection-products');
                                        if (grid) { grid.classList.remove('oth-reflow'); void grid.offsetWidth; grid.classList.add('oth-reflow'); }
                                        root.classList.toggle('filters-hidden', hide);
                                        try { sessionStorage.setItem(key, hide ? '0' : '1'); } catch (e) {}
                                        sync();
                                    });
                                    if (desktop.addEventListener) desktop.addEventListener('change', function () {
                                        root.classList.toggle('filters-hidden', desktop.matches && !shownStored());
                                        sync();
                                    });
                                })();
                            </script>
                            {{ filter_button }}{{ pr_view }}
                        </div>
                    {%- else -%}
                        {{ filter_button }}{{ pr_view }}
                    {%- endif -%}
                    {{- productcount -}}
                    {{ shorting }}
                </div>
                <div id="active-filters" class="active-facets fl f-wrap gap mb25" style="--gap:10px;">
                    <a href="{{ collection.url }}?sort_by={{ sort_by }}&pgview={% if pageurl == 'list' %}list{% else %}grid{% endif %}" class="active-fl clear-all border-0">{{ 'collections.general.clear_all' | t }}</a>
                    {%- for filter in collection.filters -%}
                        {%- for value in filter.active_values -%}
                            <a class="active-fl" href="{{ value.url_to_remove }}">{{ value.label | escape }} <svg class="at-icon"><use xlink:href="#icon-close"></use></svg></a>
                        {%- endfor -%}
                        {%- if filter.type == "price_range" and filter.min_value.value != nil or filter.max_value.value != nil -%}
                            <a class="active-fl" href="{{ filter.url_to_remove }}">
                                {% if filter.min_value.value %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %} - {% if filter.max_value.value %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %}
                                <svg class="at-icon"><use xlink:href="#icon-close"></use></svg>
                            </a>
                        {%- endif -%}
                    {%- endfor -%}
                </div>
                {{ products_list | strip_newlines }}
                <br/>
                {% comment %} {%- if collection.description != blank and section_st.des_pos == "2" -%}<div class="rte mt30">{{ collection.description }}</div>{%- endif -%}	 {% endcomment %}
            </div>          
        </div>
    </div>
</div>
{%- endpaginate -%}
{%- endcapture -%}
{{- collection_page | strip_newlines | remove: '  ' -}}

{%- for filter in collection.filters -%}
  {%- if filter.type == 'price_range' -%}
    <script src="{{ 'toolcool-range-slider.min.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
{%- endfor -%}
<script src="{{ 'collections.js' | asset_url }}" defer></script>

<style>
  /* Sold-out products stay visible in the grid. */
  #collection-products [data-availability="false"] {
    display: block !important;
  }

  /* Native pagination: filled current page, wraps on small screens. */
  #pagination .pagination ul {
    flex-wrap: wrap;
    row-gap: 8px;
  }

  #pagination .pagination li a {
    background: #fff;
    color: #111;
    border-color: #ddd;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }

  #pagination .pagination li:not(.ellipsis) a:hover,
  #pagination .pagination li.active a {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  #pagination .pagination li.active a {
    cursor: default;
  }

  #pagination .pagination li.ellipsis a {
    border-color: transparent;
    cursor: default;
  }

  @media (max-width: 767px) {
    #pagination .pagination li a {
      margin: 0 3px;
    }
  }
  /* Hide / show filters (desktop sidebar only) */
  .filters-visibility-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 24px 0 0;
    padding: 0;
    line-height: 1;
    border: 0;
    background: none;
    color: #111111;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .filters-visibility-toggle::before {
    content: "";
    width: 14px;
    height: 10px;
    background:
      linear-gradient(currentColor, currentColor) 0 0 / 14px 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) 0 50% / 10px 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) 0 100% / 6px 1.5px no-repeat;
  }

  .filters-visibility-toggle:hover {
    opacity: .6;
  }

  .filters-visibility-toggle:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 3px;
  }

  .filters-visibility-toggle__show,
  .filters-hidden .filters-visibility-toggle__hide {
    display: none;
  }

  .filters-hidden .filters-visibility-toggle__show {
    display: inline;
  }

  @media (max-width: 1024px) {
    .filters-visibility-toggle {
      display: none !important;
    }

    /* Mobile/tablet: the left group adds no box, so the toolbar lays out exactly as before */
    .toolbar-start {
      display: contents;
    }
  }

  /* Sidebar "Filters" text block: tighter gap under its title */
  #collection-filters .custom_bk .widget-title {
    padding-bottom: 6px;
  }

  @media (min-width: 1025px) {
    /* The sidebar column folds away (width, margin, opacity); its markup stays in the page.
       Visibility switches after the fold so hidden filters are not focusable. */
    #collection-filters {
      transition: width .3s ease, margin .3s ease, opacity .2s ease, visibility 0s linear 0s;
    }

    #collection-filters > * {
      min-width: 300px; /* content keeps its width while the column animates */
    }

    #Collection.filters-hidden #collection-filters {
      width: 0;
      margin-inline-start: 0;
      margin-inline-end: 0;
      opacity: 0;
      visibility: hidden;
      overflow: hidden;
      transition: width .3s ease, margin .3s ease, opacity .2s ease, visibility 0s linear .3s;
    }

    /* Hidden: the grid takes the full width (3 -> 4 columns); a short fade smooths the reflow */
    #Collection.filters-hidden #collection-products.rwcols-lg-3 > .gitem {
      width: 25%;
    }

    #collection-products.oth-reflow {
      animation: oth-grid-reflow .35s ease;
    }

    @keyframes oth-grid-reflow {
      from { opacity: .25; }
      to { opacity: 1; }
    }
  }

  @media (min-width: 1025px) and (prefers-reduced-motion: reduce) {
    #collection-filters,
    #Collection.filters-hidden #collection-filters {
      transition: none;
    }

    #collection-products.oth-reflow {
      animation: none;
    }
  }

  /* Sort: show the existing "Sort by" label as a small heading beside the dropdown (tablet and up) */
  @media (min-width: 768px) {
    .toolbar .sorting {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .toolbar .sorting label[for="sort-by"] {
      position: static !important;
      width: auto !important;
      height: auto !important;
      margin: 0 !important;
      overflow: visible !important;
      clip: auto !important;
      white-space: nowrap;
      color: #111111;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
  }
</style>

