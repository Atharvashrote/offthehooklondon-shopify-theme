{% if collection != blank and collection.description != blank %}
  <section class="collection-description-footer">
    <div class="collection-description-footer__inner">
      {{ collection.description }}
    </div>
  </section>
{% endif %}

<style>
  .collection-description-footer {
    margin: 0;
    padding: 5px 20px 10px;
    background: #fff;
  }

  .collection-description-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    font-size: 10px;
    line-height: 1.35;
    font-weight: 400;
    color: #777;
    text-align: justify;
  }

  .collection-description-footer__inner * {
    font-size: inherit !important;
    line-height: inherit !important;
    font-weight: 400 !important;
    text-align: justify !important;
    margin-top: 0 !important;
    margin-bottom: 3px !important;
  }

  .collection-description-footer__inner p {
    margin: 0 0 3px !important;
  }

  .collection-description-footer__inner ul,
  .collection-description-footer__inner ol {
    margin: 0 0 3px !important;
    padding-left: 15px;
  }

  @media screen and (max-width: 749px) {
    .collection-description-footer {
      padding: 3px 15px 8px;
    }

    .collection-description-footer__inner {
      font-size: 9px;
      line-height: 1.3;
    }
  }
</style>