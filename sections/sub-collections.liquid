{%- capture collection_list -%}
{%- if section.settings.cl != blank -%}
{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
  
    for collection in section_st.collection
        assign collection_image = collection.metafields.custom.custom_image.value | default:collection.image | default: collection.products.first.featured_image

        if section_st.ratio == 'img' and collection_image != blank
            assign img_ratio = 1 | divided_by: collection_image.aspect_ratio | times: 100
            break
        else
            assign img_ratio = section_st.ratio | default: 100
        endif
    endfor
-%}
{%- capture listclass -%}
    {% if section_st.style == '1' %} pa zi1 tc {{section_st.text_position}} {{ section_st.rounded }}{% endif %}
    {% if section_st.style == '2' %} w-100 t-{{section_st.align}}{% endif %}
    {% if section_st.style == '3' %} pa zi1 w-100 bottom-0 {{ section_st.text_align}}{% endif %}
{%- endcapture -%}
{%- capture sizes -%}
    (min-width:1024px) calc({{ page_width }} / {{ section_st.grid }}),(min-width:768px) calc(100vw / {{ section_st.gridtb }}), calc(100vw / {{ section_st.gridmb }})
{%- endcapture -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}--ratio:{{ img_ratio | default:100 }}%" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %} collection-list collection-list{{ section_st.style }} pr zi1" data-section-id="{{ section.id }}">   	
        {%- render 'sec-title' -%}
      
        {%- capture collection_data -%}        
          {%- for collection in section_st.collection -%}
              {%- assign cl_img = collection.metafields.custom.custom_image | default: collection.featured_image -%}
              {%- assign alt = cl_img.alt | default: collection.title | escape -%}
              {%- assign count = collection.all_products_count -%}
               <div class="gitem{% if section_st.carousel %} swiper-slide{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
                    <a href="{{ collection.url }}" class="db pr of-hidden{% if section_st.style == '2' %} {{ section_st.rounded }}{% else %} {{ section_st.irounded }}{% endif %}{% if section_st.zoom %} zoom-hov{% endif %}">
                        {% if cl_img != blank %}                          
                            <div class="oth-subcircle">
                              {{- cl_img | image_url: width:cl_img.width | image_tag: loading:'lazy', class:'oth-subcircle-img', alt:alt, sizes:sizes, widths:"180,320,400,560,740,900,1200" -}}</div>
                        {%- endif -%}
                       <div class="collection-details anim{{ listclass }}">
                        {%- if collection.title != blank -%}<div class="head {{ section_st.preset }}{% if section_st.text-upper %} text-upper{% endif %}">{{ collection.title }}</div>{%- endif -%}
                        {%- if section_st.count and count != blank -%}<span class="fs13 db op-9 mt5">{{ 'collections.general.items_with_count' | t: count: count }}</span>{%- endif -%}
                       </div>
                       
                    </a>
                </div>
          {%- endfor -%}
        {%- endcapture -%}

        {%- capture styles -%}
            --grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;
            --hdcl:{{ section_st.cl }};--cl:{{ section_st.cl }};
            {%- if section_st.preset == 'custom-hd' -%}
                --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }};--ls:{{ section_st.ls }}px;
            {%- endif -%}
            {%- if section_st.style != '3' -%}--bg:{{ section_st.tbg }};{%- endif -%}--overlay:{{ section_st.img_overlay }};--overlay-down:{{ section_st.img_overlay | color_to_hex }}00; 
            --text_padding:{{ section_st.text_padding }}px;--text_padding_y:{{ section_st.text_padding_tb }}px; {% if section_st.style == '1' %}--text_margin:{{section_st.text_margin}}px;--text_margin_mobile:{{section_st.text_margin_mobile}}px; {%  endif %}                             
        {%- endcapture -%}

        {%- if section_st.carousel -%}
            <slide-section class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} collection-grid swiper" style="{{ styles }}"
              data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                <div class="swiper-wrapper">{{ collection_data }}</div>
                {% render 'swiper-navigation', id:section.id, section_st:section_st %}
            </slide-section>
        {%- else -%}
            <div class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} collection-grid" style="{{ styles }}">
                {{ collection_data }}
            </div>
        {%- endif -%}
    </div>
</div>
{%- endif -%}
{%- endcapture -%}

<style>
/* Off The Hook — true circular sub-collections.
   Uses dedicated classes so Avone's .img/.img-fit rules cannot distort the circle. */
.subClwrap .collection-grid {
  display: grid !important;
  grid-template-columns: repeat(4, 150px) !important;
  justify-content: center !important;
  align-items: start !important;
  gap: 28px 58px !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

.subClwrap .collection-grid .gitem {
  width: 150px !important;
  min-width: 150px !important;
  margin: 0 !important;
  text-align: center !important;
}

.subClwrap .collection-grid .gitem > a {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  width: 150px !important;
  text-decoration: none !important;
}

/* Dedicated circle wrapper — no Avone .img class */
.subClwrap .oth-subcircle {
  display: block !important;
  position: relative !important;
  width: 130px !important;
  height: 130px !important;
  min-width: 130px !important;
  min-height: 130px !important;
  flex: 0 0 130px !important;
  margin: 0 auto !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 50% !important;
  overflow: hidden !important;
  clip-path: circle(50% at 50% 50%) !important;
  -webkit-clip-path: circle(50% at 50% 50%) !important;
  aspect-ratio: 1 / 1 !important;
  background: #f3f3f3 !important;
  box-sizing: border-box !important;
}

.subClwrap .oth-subcircle::before,
.subClwrap .oth-subcircle::after {
  content: none !important;
  display: none !important;
}

.subClwrap .oth-subcircle-img {
  position: absolute !important;
  inset: 0 !important;
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  max-height: none !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 50% !important;
  clip-path: circle(50% at 50% 50%) !important;
  -webkit-clip-path: circle(50% at 50% 50%) !important;
  object-fit: cover !important;
  object-position: center !important;
  box-sizing: border-box !important;
  transform: none !important;
}

.subClwrap .gitem > a:hover .oth-subcircle-img {
  transform: scale(1.04) !important;
  transition: transform .3s ease !important;
}

.subClwrap .collection-grid .collection-details {
  position: static !important;
  inset: auto !important;
  transform: none !important;
  width: 100% !important;
  padding: 10px 0 0 !important;
  margin: 0 !important;
  background: transparent !important;
  color: inherit !important;
  text-align: center !important;
}

.subClwrap .collection-grid .collection-details .head {
  font-size: 14px !important;
  line-height: 1.2 !important;
  font-weight: 600 !important;
  letter-spacing: .25px !important;
  white-space: nowrap !important;
}

.subClwrap .collection-grid .collection-details span {
  display: none !important;
}

@media (max-width: 1023px) and (min-width: 768px) {
  .subClwrap .collection-grid {
    grid-template-columns: repeat(4, 130px) !important;
    gap: 24px 35px !important;
  }
  .subClwrap .collection-grid .gitem,
  .subClwrap .collection-grid .gitem > a { width: 130px !important; min-width: 130px !important; }
  .subClwrap .oth-subcircle { width: 115px !important; height: 115px !important; min-width: 115px !important; min-height: 115px !important; flex-basis: 115px !important; }
}

@media (max-width: 767px) {
  .subClwrap .collection-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 16px 8px !important;
    width: 100% !important;
  }
  .subClwrap .collection-grid .gitem,
  .subClwrap .collection-grid .gitem > a { width: 100% !important; min-width: 0 !important; }
  .subClwrap .oth-subcircle {
    width: 82px !important;
    height: 82px !important;
    min-width: 82px !important;
    min-height: 82px !important;
    flex-basis: 82px !important;
  }
  .subClwrap .collection-grid .collection-details { padding-top: 7px !important; }
  .subClwrap .collection-grid .collection-details .head { font-size: 12px !important; }
}
</style>

{{- collection_list | strip_newlines | remove: '  ' | remove: '	' -}}

<style>
/* =========================================================
   OFF THE HOOK — MOBILE SUB-COLLECTIONS 2 × 2
   Scoped only to the Sub Collections section.
   ========================================================= */

@media (max-width: 767px) {

  .subClwrap .collection-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 22px 18px !important;
    width: 100%;
  }

  .subClwrap .collection-grid .gitem {
    width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
  }

  .subClwrap .collection-grid .gitem > a {
    display: block !important;
    width: 100% !important;
    text-align: center;
  }

  .subClwrap .collection-grid .oth-subcircle {
    width: 105px !important;
    height: 105px !important;
    aspect-ratio: 1 / 1 !important;
    margin: 0 auto !important;
    border-radius: 50% !important;
    overflow: hidden !important;
    clip-path: circle(50% at 50% 50%) !important;
  }

  .subClwrap .collection-grid .oth-subcircle-img {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
    object-fit: cover !important;
    object-position: center !important;
    border-radius: 50% !important;
    clip-path: circle(50% at 50% 50%) !important;
  }

  .subClwrap .collection-grid .collection-details {
    width: 100% !important;
    padding: 8px 0 0 !important;
    text-align: center !important;
  }

  .subClwrap .collection-grid .collection-details .head {
    font-size: 14px !important;
    line-height: 1.2 !important;
    font-weight: 600 !important;
    white-space: nowrap;
  }

}

/* Prevent the 2×2 rule from affecting tablet/desktop. */
@media (min-width: 768px) {
  .subClwrap .collection-grid {
    display: grid;
  }
}
</style>

{% schema %}
{
  "name": "Sub collections",
  "class": "subClwrap",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "collection_list",
      "id": "collection",
      "label": "Collections"
