{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
-%}
{%- capture sizes -%}
    {%- if section_st.sbposi == 'nosidebar' -%}
        (min-width:1024px) calc({{ page_width }} - 30px), calc(100vw - 30px)
    {%- else -%}
        (min-width:1024px) calc({{ page_width }} - 330px), calc(100vw - 30px)
    {%- endif -%}
{%- endcapture -%} 
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st: section_st, bgimage: true %}>
    <article class="{% if section_st.fullwidth %} fw-section{% else %} page-width{% endif %}" style="--comment_bg:{{ section_st.cbg }};--comment_cl:{{ section_st.ccl }};">
        <div class="fl f-col f-row-lg">
            <div class="fl1 w-100{% if section_st.sbposi == 'left' %} order2{% endif %}">   
                <div class="blog-listview">
                    {%- if section_st.post_ttl -%}
                        {%- capture title_styles -%}
                            {%- if section_st.preset == 'custom-hd' -%}
                                --fs:{{ section_st.tfs }}px;--fsm:{{ section_st.tfsm }}px;--ff:var(--{{ section_st.tff }});--fw:{{ section_st.tfw }};--lh:{{section_st.lh }};
                            {%- endif -%}
                        {%- endcapture -%}
                        <{{ section_st.htag }} class="mb10{% if section_st.tcase %} text-upper{% endif %} {{ section_st.preset }}" style="--hdcl:{{ section_st.hdcl }};{{ title_styles }}">{{ article.title }}</{{ section_st.htag }}>
                    {%- endif -%}
                    {%- if section_st.date or section_st.author or blog.comments_enabled? -%}
                        <ul class="fl mb20 blog-meta{% if section_st.post_case %} text-upper{% endif %}" style="--icns:14px;">
                            {%- if section_st.date -%}
                                <li>
                                    <span class="sep-{{ section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-date' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>
                                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'month_day_year' }}</time></li>
                            {%- endif -%}
                            {%- if section_st.author -%}
                                <li class="fl">
                                    <span class="sep-{{section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-user' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>
                                    {{ 'blogs.article.by_author' | t }} <span class="ml5">{{ article.author }}</span></li>
                            {%- endif -%}
                            {%- if blog.comments_enabled? and article.comments_count > 0 -%}
                                <li class="cmnt">
                                    <span class="sep-{{ section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-comment' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>           
                                    <a href="{{ article.url }}#comments">{{ 'blogs.comments.comments_with_count' | t: count: article.comments_count }}</a>
                                </li>
                            {%- endif -%}
                        </ul>
                    {%- endif -%}
                    {%- if article.image and section_st.ftimg -%}
                        <div class="mb20">
                            {%- assign img_class = "img-auto " | append: section_st.irounded -%}
                            {{ article.image | image_url: width: article.image.width | image_tag: loading:'lazy', width:article.image.width, height:article.image.height, class:img_class, sizes:sizes, widths:"400,560,740,980,1280,1600,2000" }}
                        </div>
                    {%- endif -%}
                    <div class="rte mb20">{{ article.content }}</div>

                    {%- if section_st.tags and article.tags.size > 0 -%}
                        <ul class="blog-tags fl f-aic f-wrap mb15">
                            <li>{{ 'blogs.article.posted_in' | t }}: &nbsp;</li>
                            {%- for tag in article.tags -%}
                                <li><a class="ml5" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a></li>
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}

                    {%- if section_st.show_share_buttons or blog.next_article or blog.previous_article -%}
                        <hr>
                        <div class="fl f-wrap f-jcsb">              	                
                            {% if section_st.show_share_buttons %}
                                <div class="mb20">{% render 'social-sharing', share_title: article.title, share_link: article.url, share_image: article.image, clname:'' %}</div>
                            {% endif %}
                            {% if blog.next_article or blog.previous_article %}
                                <div class="blog-nav mb20 fl f-jcc {% unless section_st.show_share_buttons %} fl1{% endunless %}">
                                    {% if blog.previous_article %}<a href="{{ blog.previous_article }}">{% render 'icon-arrowl', class: 'arwl left mr5' %}{{ 'blogs.article.previous' | t }}</a>{% endif %}
                                    <span class="m-auto"> &nbsp; &nbsp; </span>
                                    {% if blog.next_article %}<a href="{{ blog.next_article }}">{{ 'blogs.article.next' | t }}{% render 'icon-arrowl', class: 'arwl right ml5' %}</a>{% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                    {%- if section_st.show_rlpr and section_st.products != blank -%}
                        <div class="related-product" id="artcileProducts" data-section-id="artcileProducts" data-section-type="carousel">
                        {%- unless section_st.related_title == blank -%}
                            <div class="sec-ttl {{ settings.title_align}}">
                                <h3 class="h3">{{ section_st.related_title | escape }}</h3>
                                {%- if section_st.related_sub_title != blank -%}<span>{{section_st.related_sub_title}}</span>{%- endif -%}        
                            </div> 
                        {%- endunless -%}
                        <slide-section id="productSlider-artcileProducts" class="grid swiper rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }}" style="{{ styles }}"
              data-swiper='{ "slidesPerView":"auto", "loop":true, {% if section_st.rpauto %}"autoplay":{ "delay":"{{ section_st.auto_speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" }}'>
                            <div class="swiper-wrapper">
                                {%- for product in section_st.products -%}
                                    <div class="gitem swiper-slide">{% render 'product-card-grid', product: product, secSt: secSt, sizes: image_size %}</div>
                                {%- endfor -%}
                            </div>
                            <div class="swiper-arrows swiper-button-next swn{{ section.id }}"></div>
                            <div class="swiper-arrows swiper-button-prev swp{{ section.id }}"></div>
                        </slide-section><br><br>
                        </div>
                    {%- endif -%}

                <!-- Article comments --> 
                {%- assign number_of_comments = article.comments_count -%}
                {%- if comment and comment.created_at -%}
                    {%- assign number_of_comments = article.comments_count | plus: 1 -%}
                {%- endif -%}
                {%- if blog.comments_enabled? -%}
                    {%- if number_of_comments > 0 -%}<br>
                        <h2 class="sub-title mb0">{{ 'blogs.comments.comments_with_count' | t: count: number_of_comments }}</h2>
                        <hr />
                        {%- paginate article.comments by 10 -%}
                        {% comment %}#comments is required, it is used as an anchor link by Shopify.{% endcomment %}
                            <div id="comments">
                                <ul class="comments mb30">
                                    {% comment %}If a comment was just submitted with no blank field, show it.{% endcomment %}
                                    {%- if comment and comment.created_at -%}
                                        <li id="{{ comment.id }}" class="comment"> {% render 'comment' %}</li>
                                        <li><hr /></li>
                                    {%- endif -%}
                                    {%- for comment in article.comments -%}
                                        <li id="{{ comment.id }}" class="comment"> {% render 'comment', comment:comment %} </li>
                                        {%- unless forloop.last -%}<li><hr /></li>{%- endunless -%}
                                    {%- endfor -%}
                                </ul>
                                {%- if paginate.pages > 1 -%}{% render 'pagination' %}{%- endif -%}
                            </div>
                        {%- endpaginate -%}
                    {%- endif -%}
                    {%- form 'new_comment', article -%}
                        <h4 class="h3">{{ 'blogs.comments.title' | t }}</h4>
                        {% if comment and comment.created_at %}
                            <p class="border form-success">{% if blog.moderated? %}{{ 'blogs.comments.success_moderated' | t }}{% else %}{{ 'blogs.comments.success' | t }}{% endif %}</p>
                        {% endif %}
                        {{ form.errors | default_errors }}
                        <div class="grid">
                            <div class="gitem wd50-md">
                                <label for="CommentAuthor">{{ 'blogs.comments.name' | t }}</label>
                                <input type="text" name="comment[author]" id="CommentAuthor" class="input-full w-100{% if form.errors contains 'author' %} input--error{% endif %}" value="{{ form.author }}">
                            </div>
                            <div class="gitem wd50-md">
                                <label for="CommentEmail">{{ 'blogs.comments.email' | t }}</label>
                                <input type="email" name="comment[email]" id="CommentEmail" class="input-full w-100{% if form.errors contains 'email' %} input--error{% endif %}" value="{{ form.email }}" autocorrect="off" autocapitalize="off">
                            </div>
                            <div class="gitem">
                                <label for="CommentBody">{{ 'blogs.comments.message' | t }}</label>
                                <textarea name="comment[body]" id="CommentBody" class="input-full w-100{% if form.errors contains 'body' %} input--error{% endif %}">{{ form.body }}</textarea>
                            </div>
                        </div>
                        {% if blog.moderated? %}
                            <p class="fine-print mt0">{{ 'blogs.comments.moderated' | t }}</p>
                        {% endif %}
                        <input type="submit" class="btn" value="{{ 'blogs.comments.post' | t }}">
                    {% endform %}
                {%- endif -%}
            </div>
            <div class="tc mt30"><a href="{{ blog.url }}" class="btn">{% render 'icon-arrowl', class: 'arwl left' %} {{ 'blogs.article.back_to_blog' | t: title: blog.title }}</a></div>
        </div>

            <!-- sidebar --> 	  
            {%- if section_st.sidebar -%}
                {%- capture styles -%}
                    --gap:{{ section_st.sdgap }}px;--gapm:{{ section_st.sdgapm }}px;
                    --hdcl:{{ section_st.wdTtlcl }};--cl:{{ section_st.dtcl }};--clh:{{ section_st.dtclh }};--links_fs:{{ section_st.dtfs }}px;
                    {%- if section_st.bottom_border -%}--border:{{ section_st.ttlbdr }};{%- endif -%}
                {%- endcapture -%}
                {%- if section_st.ttlpreset == 'custom-hd' -%}<style>.widget-title{--fs:{{ section_st.wdTtl }}px;--fsm:{{ section_st.wdTtl }}px;--ff:var(--{{ section_st.wdTtlft }});--fw:{{ section_st.wdTtlwt }};--lh:1.2;}</style>{%- endif -%}
                <div class="sidebar fl f-col gap{% if section_st.sbposi == 'left' %} mr30{% else %} ml30{% endif %}{% if section_st.sidem %} hide-sm hide-md{% endif %}" style="{{ styles }}">
                    {%- content_for 'blocks' -%}
                </div>
            {%- endif -%}
        </div>
    </article>
</div>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": "{{ article.content | strip_html | escape }}",
    "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ shop.url }}{{ page.url }}"
  },
    "headline": "{{ article.title }}",
    {%- if article.excerpt != blank -%}
        "description": "{{ article.excerpt | strip_html }}",
    {%- endif -%}
    {%- if article.image -%}
        {% assign image_size = article.image.width | append: 'x' %}
        "image": [
            "https:{{ article | image_url: image_size }}"
        ],
    {%- endif -%}
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
  "dateCreated": "{{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
  "author": {
    "@type": "Person",
    "name": "{{ article.author }}"
  },
  "publisher": {
    "@type": "Organization",
    {%- if settings.share_image -%}
        {%- assign image_size = article | image_url: 'master' | append: 'x' -%}
        "logo": {
            "@type": "ImageObject",
            "height": "{{ settings.share_image.height }}",
            "url": "https:{{ settings.share_image | image_url: image_size }}",
            "width": "{{ settings.share_image.width }}"
        },
    {%- endif -%}
    "name": "{{ shop.name }}"
    }
  }
</script>
