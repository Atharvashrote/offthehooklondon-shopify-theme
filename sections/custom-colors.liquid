<style type="text/css">
    {%- for block in section.blocks -%}
        {%- for i in (1..15) -%}
            {%- assign color_key = "title" | append: i -%}
            {%- assign color_code = "color" | append: i -%}
            {%- assign color_img = "image" | append: i -%}
            {%- assign color_name = block.settings[color_key] | handleize -%}
            {%- if color_name != blank -%}
                .swatch-{{ color_name }}{
                    {%- if block.settings[color_img] == blank -%}
                        background-color:{{ block.settings[color_code] }};
                    {%- else -%}
                        background:{{ block.settings[color_code] }} url({{ block.settings[color_img] | image_url: width:80 }}) no-repeat 50% 50%/cover;
                    {%- endif -%}
                }
            {%- endif -%}
        {%- endfor -%}
    {%- endfor -%}
</style>
