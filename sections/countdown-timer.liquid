{%- capture countdown -%}
{% assign section_st = section.settings %}
<div class="section-cover{%  if section_st.ganim %} gr_bg{% endif %} {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}--as:{{ section_st.animsp }}s;" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}" id="{{ section.id }}">
        <div class="display-grid custom-cnt gap" style="--gap:{{ section_st.gspace }}px;--gapm:{{ section_st.gspacem }}px;">
          {% content_for 'blocks' %}
        </div>
	</div> 
</div>
{%- endcapture -%}
{{- countdown | strip_newlines | remove: '  ' | remove: '	' -}}
{% schema %}
{
  "name": "Countdown timer",
  "disabled_on": {
    "groups": ["header", "custom.overlay", "footer"]
  },
  "blocks": [
    {
      "type": "_column"
    }
  ],
  "settings": [   
    {
      "type": "range",
      "id": "gspace",
      "label": "Grid gap",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gspacem",
      "label": "Grid gap (mobile)",
      "default": 15,
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
     "id": "fullwidth",
      "label": "Full width",
      "default": false
    },    
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": true
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 30
    }    
  ],
  "presets": [
    {
      "name": "Countdown timer",
      "category": "Text",
      "blocks": [
        {
          "type": "_column",
          "settings": {
            "column_dk": "6",
            "column_tb": "6",
            "column_mb": "12",
            "pad_lr": 30,
            "pad_tb": 30,
            "pad_lrt": 30,
            "pad_tbt": 30,
            "pad_tbm": 0,
            "pad_lrm": 15,
            "position": "cl-psc",            
            "align": "left",
            "alignm": "center",
            "rounded": "none"
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "SPECIAL OFFER PRODUCTS",
                "mb":0,
                "mbm":0
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Share something about your limited offer or temporary promotion.</p>",
                "preset":"custom",
                "mb":10,
                "mbm":10
              }
            },
            {
              "type": "button",
              "settings": {
                "text":"Shop Collection",
                "hide_mb":true                
              }
            }
          ]
        },
        {
          "type": "_column",
          "settings": {
            "column_dk": "6",
            "column_tb": "6",
            "column_mb": "12",
            "pad_lr": 30,
            "pad_tb": 30,
            "pad_lrt": 30,
            "pad_tbt": 30,
            "pad_tbm": 0,
            "pad_lrm": 0,
            "position": "cl-psc",           
            "align": "right",
            "alignm": "center",
            "rounded": "none"
          },
          "blocks": [
            {
              "type": "countdown",
              "settings": {
                "date": "12/25/2026",
                "show_label":true,
                "cl":"#fff",
                "fs":25,
                "isbg":true,
                "bg":"#111",
                "rounded":"round-xs",
                "mbm":20
              }
            },
            {
              "type": "button",
              "settings": {
                "text":"Shop Collection",
                "hide_desk":true                
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
