  ],
  "presets": [
    {
      "name": "Video in background",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "AVONE - THE BEST SELLING SHOPIFY THEME",
            "preset": "h1",
            "cl":"#fff",

          }
        },
        {
          "type": "button",
          "settings": {
              "btn-style":"btn5"
          }          
        }
      ]
    }
  ]
}
{% endschema %}
