{%- capture logobar -%}
{%- liquid 
    assign section_st = section.settings
-%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}--logopa:{{ section_st.logopa }};{% if section_st.cardstyle %}--cardbg:{{ section_st.cardbg }};--cardpd:{{ section_st.cardpd }}px;--cardbdr:{% if section_st.cardborder %}1px solid {{ section_st.cardbordercl }}{% else %}0{% endif %};{% endif %}" {% render 'sec-settings', section_st: section_st, bgimage: true %}>
    <div class="logo-list{% if section_st.grayscale %} logo-grayscale{% endif %}{% if section_st.fullwidth %} fw-section{% if section_st.npd %} npd{% endif %}{% else %} page-width{% endif %}" id="carousel-{{ section.id }}">
        {%- render 'sec-title' -%}		
        {%- if section.blocks.size > 0 -%}
            {%- if section_st.layout == 'marquee' -%}
                <div class="fl w-100 of-hidden marquee-wrap{% if section_st.mqpause %} pause-hover{% endif %}" style="--text-speed:{{ section_st.mqspeed }}s;--text-speedm:{{ section_st.mqspeedm }}s;--grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--mqh:{{ section_st.mqheight }}px;--mqhm:{{ section_st.mqheightm }}px;">
                    {%- for i in (0..5) -%}
                    <div class="fl f-aic marquee{% if section_st.mqdir == 'right' %} reverse{% endif %}">
                        {%- for block in section.blocks -%}
                            <div class="marquee-text{% if section_st.cardstyle %} gcard {{ section_st.cardradius }}{% endif %}">
                                <a {% if block.settings.link != blank %}href="{{ block.settings.link }}" {% if block.settings.newtab %} target="_blank" {% endif %}{% else %}role="link" aria-disabled="true"{% endif %}>
                                    {% if block.settings.image != blank %}
                                        {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading:'lazy', class:'img-auto anim', widths:'200,300,400,500' }}
                                    {% else %}
                                        {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
                                    {% endif %}
                                </a>
                            </div>
                        {%- endfor -%}
                    </div>
                    {%- endfor -%}
                </div>
            {%- else -%}
            {% capture logo_data %}
              {% for block in section.blocks %}
                    <div class="gitem{% if section_st.layout == 'carousel' %} swiper-slide{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %} {{ block.shopify_attributes }}>
                        <div class="fl f-jcc f-aic h-100{% if section_st.cardstyle %} gcard {{ section_st.cardradius }}{% endif %}">
                            <a {% if block.settings.link != blank %}href="{{ block.settings.link }}" {% if block.settings.newtab %} target="_blank" {% endif %}{% else %}role="link" aria-disabled="true"{% endif %}>
                                {% if block.settings.image != blank %}
                                    {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading:'lazy', class:'img-auto anim', widths:'200,300,400,500' }}
                                {% else %}
                                    {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
                                {% endif %}
                            </a>
                        </div>
                    </div>
                {% endfor %}
            {% endcapture %}

             {%- capture styles -%}
             --grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;
            {%- endcapture -%}
                              
            {%- if section_st.layout == 'carousel' -%}
                <slide-section class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} swiper" style="{{ styles }}"
                  data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}","pauseOnMouseEnter":{{ section_st.pausehover }} },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                    <div class="swiper-wrapper h-auto">{{ logo_data }}</div>
                    {% render 'swiper-navigation', id:section.id, section_st:section_st %}
                </slide-section>
            {%- else -%}
                <div class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} f-jcc" style="{{ styles }}">{{ logo_data }}</div>
            {%- endif -%}
            {%- endif -%}
        {%- endif -%}
        {%- if section.blocks.size == 0 -%}{% render 'no-blocks' %}{%- endif -%}
    </div>
</div>
{%- endcapture -%}
{{- logobar | strip_newlines | remove: '	' -}}
{% schema %}
{
  "name": "Brands list",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
   {
      "type": "header",
      "content": "Section header"
    },
     {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Brands List"
    }, 
     {
      "type": "richtext",
      "id": "text",
      "label": "Description"      
    },  
    {
      "type": "header",
      "content": "Logo grid"
    },
    {
      "type": "range",
      "id": "gspace",
      "label": "Grid gap",
      "default": 15,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gspacem",
      "label": "Grid gap (mobile)",
      "default": 10,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Columns desktop",
      "default": 6,
      "min": 1,
      "max": 8,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridtb",
      "label": "Columns tablet",
      "default": 5,
      "min": 1,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridmb",
      "label": "Columns mobile",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "range",
      "id": "logopa",
      "label": "Logo opacity",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.1
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale logos, full color on hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Display style"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Show as",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" },
        { "value": "marquee", "label": "Continuous scroll (marquee)" }
      ]
    },
    {
      "type": "range",
      "id": "mqheight",
      "label": "Logo height",
      "default": 50,
      "min": 20,
      "max": 150,
      "step": 2,
      "unit": "px",
      "info": "Keeps large logo images from taking up too much space in the marquee",
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "mqheightm",
      "label": "Logo height (mobile)",
      "default": 34,
      "min": 15,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "mqspeed",
      "label": "Marquee speed",
      "default": 25,
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "s",
      "info": "Lower is faster",
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "mqspeedm",
      "label": "Marquee speed (mobile)",
      "default": 18,
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "s",
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "mqdir",
      "label": "Marquee direction",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "mqpause",
      "label": "Pause marquee on hover",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Infinite loop",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slide",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Autoplay speed",
      "default": 5,
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "Sec",
      "visible_if": "{{ section.settings.layout == 'carousel' and section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "pausehover",
      "label": "Pause autoplay on hover",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' and section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "arrow",
      "label": "Show arrows on desktop",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "arrowm",
      "label": "Show arrows on mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "dot",
      "label": "Show dots on desktop",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "dotm",
      "label": "Show dots on mobile",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "checkbox",
      "id": "cardstyle",
      "label": "Add card background",
      "default": false
    },
    {
      "type": "color",
      "id": "cardbg",
      "label": "Card background",
      "default": "#f5f5f5",
      "visible_if": "{{ section.settings.cardstyle }}"
    },
    {
      "type": "range",
      "id": "cardpd",
      "label": "Card padding",
      "default": 15,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.cardstyle }}"
    },
    {
      "type": "select",
      "id": "cardradius",
      "label": "Card corner radius",
      "default": "round-xs",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "round-xs", "label": "Extra small" },
        { "value": "round-sm", "label": "Small" },
        { "value": "round-md", "label": "Medium" },
        { "value": "round-lg", "label": "Large" },
        { "value": "round-full", "label": "Full" }
      ],
      "visible_if": "{{ section.settings.cardstyle }}"
    },
    {
      "type": "checkbox",
      "id": "cardborder",
      "label": "Add border",
      "default": false,
      "visible_if": "{{ section.settings.cardstyle }}"
    },
    {
      "type": "color",
      "id": "cardbordercl",
      "label": "Border color",
      "default": "#ddd",
      "visible_if": "{{ section.settings.cardstyle and section.settings.cardborder }}"
    },    
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "npd",
      "label": "Remove side margins",
      "default": false,
      "info": "Edit margin in [theme settings](/editor?context=theme&category=Layout)",
      "visible_if": "{{ section.settings.fullwidth }}"            
    },
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
   {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "default": "#00000050",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Image sizes are flexible. For the best results, upload all logos at the same size."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional"
        },
        {
          "type": "checkbox",
          "id": "newtab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands list",
      "category": "Image",
      "blocks": [
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        }
      ]
    }
  ]
}
{% endschema %}