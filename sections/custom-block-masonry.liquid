{%- capture custom_content -%}
{%- liquid 
    assign section_st = section.settings
-%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %} custom-block {{section_st.style }}">  
        {%- render 'sec-title' -%}
        <grid-masonary class="custom-cnt grid-masonary gspace fl f-wrap" style="--grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;">
            <div class="grid-sizer pa col-2 col-md-{{ section_st.gspace-col }}"></div>
            {%- content_for 'blocks' -%}
        </grid-masonary>
    </div>
</div>
{%- endcapture -%}
{{- custom_content | strip_newlines | remove: '	' -}}
{% schema %}
{
  "name": "Custom content : masonry",
  "class": "custom-cnt",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "blocks": [
    {
      "type": "_masonry-column"
    }
  ],
  "settings": [
     {
      "type": "header",
      "content": "Section header"
    },
     {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Custom content"
    },
     {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Create advanced layout using custom blocks</p> "
    },        
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "gspace",
      "label": "Gap",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gspacem",
      "label": "Gap (mobile)",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
	{
        "type": "range",
        "id": "gspace-col",
        "label": "Grid columns",
        "default": 2,
        "min": 2,
        "max": 5,
        "step": 1,
		"info":"[Column selection guide](https://www.adornthemes.com/masonry-column-selection/)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
     "id": "fullwidth",
      "label": "Full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "npd",
      "label": "Remove side margins",
      "default": false,
      "info": "Edit margin in [theme settings](/editor?context=theme&category=Layout)",
      "visible_if": "{{ section.settings.fullwidth }}"            
    },
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Custom content: Masonry",
      "category": "Layout",
      "blocks": [
        {
          "type": "_masonry-column",
          "blocks": [
                        {
                        "type": "heading",
                        "settings": {
                            "text": "BEST SELLING SHOPIFY THEME",
                            "preset": "h4",
                            "mb": 10,
                            "mbm":5
                          }
                        },
                        {
                        "type": "text",
                        "settings": {
                            "text": "<p>We at Adornthemes craft beautiful, user-friendly Shopify themes that turn your store visitors into customers</p>",
                            "mb": 25,
                            "mbm":15
                         }
                        },
                        {
                        "type": "button",
                        "settings": {
                            "text": "Shop Now",
                            "url": ""
                          }
                        }
          ],
          "settings": {
            "width": "wd50",
            "widthm": "wd50",
            "pad_lr": 20,
            "pad_tb": 20,
            "pad_tbm": 10,
            "pad_lrm": 10,
            "align": "center",
            "alignm": "center",
            "rounded": "none"
          }
        },
        {
          "type": "_masonry-column",
            "blocks": [
              {
              "type": "image-banner"
            }                                                
          ],
          "settings": {
            "width": "wd50",
            "widthm": "wd50",
            "pad_lr": 20,
