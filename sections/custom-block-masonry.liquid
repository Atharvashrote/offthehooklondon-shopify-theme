            "pad_tbm": 10,
            "pad_lrm": 10,
            "align": "center",
            "alignm": "center",
            "rounded": "none"
          }
        },
         {
          "type": "_masonry-column",
            "blocks": [
              {
              "type": "image-banner"
            }                                                
          ],
          "settings": {
            "width": "wd50",
            "widthm": "wd50",
            "pad_lr": 20,
            "pad_tb": 20,
            "pad_tbm": 10,
            "pad_lrm": 10,
            "align": "center",
            "alignm": "center",
            "rounded": "none"
          }
        },
        {
          "type": "_masonry-column",
          "blocks": [
                        {
                        "type": "heading",
                        "settings": {
                            "text": "BEST SELLING SHOPIFY THEME",
                            "preset": "h4",
                            "mb": 10,
                            "mbm":5
                          }
                        },
                        {
                        "type": "text",
                        "settings": {
                            "text": "<p>We at Adornthemes craft beautiful, user-friendly Shopify themes that turn your store visitors into customers</p>",
                            "mb": 25,
                            "mbm":15
                         }
                        },
                        {
                        "type": "button",
                        "settings": {
                            "text": "Shop Now",
                            "url": ""
                          }
                        }
          ],
          "settings": {
            "width": "wd50",
            "widthm": "wd50",
            "pad_lr": 20,
            "pad_tb": 20,
            "pad_tbm": 10,
            "pad_lrm": 10,
            "align": "center",
            "alignm": "center",
            "rounded": "none"
          }
        }        
      ]
    }
  ]
}
