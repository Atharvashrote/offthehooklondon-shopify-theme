            },
            {
              "value": "wd33",
              "label": "33%"
            },
            {
              "value": "wd40",
              "label": "40%"
            },
            {
              "value": "wd50",
              "label": "50%"
            },
            {
              "value": "wd60",
              "label": "60%"
            },
            {
              "value": "wd66",
