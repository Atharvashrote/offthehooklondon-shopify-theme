      "min": 0.7,
      "max": 2.0,
      "step": 0.1,      
      "visible_if": "{{ section.settings.tpreset == 'custom' }}"
    },
    {
          "type": "select",
          "id": "btn-size",
          "label": "Button size",
          "default": "btn-md",
          "options": [
            {
              "label": "Small",
              "value": "btn-sm"
            },
            {
              "label": "Medium",
              "value": "btn-md"
            },
            {
              "label": "Large",
              "value": "btn-lg"
            }
          ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
     "id": "fullwidth",
      "label": "Full width",
      "default": false
    }, 
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },  
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 15
