{%- capture text_bar -%}
{% assign section_st = section.settings %}
{%- capture style -%}
    --grsp:{{ section_st.col-gap | divided_by: 2.0 }}px;--grspm:{{ section_st.row-gap | divided_by: 2.0 }}px;
    {%- if section_st.tpreset == 'custom' -%}--fs:{{ section_st.tfs }}px;--fsm:{{ section_st.tfsm }}px;--ff:var(--{{ section_st.tff }});--fw:{{ section_st.tfw }};--lh:{{ section_st.tlh }};{%- endif -%}
{%- endcapture -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}">   
        <div class="grid gspace" style="{{ style }}">
            {%- for block in section.blocks limit: section.blocks.size -%}
                {%- assign block_st = block.settings -%}
                {%- capture block_style -%}
                  --gap:20px;--gapm:15px;--cl:{{block_st.cl }};--box_bg:{% if block_st.boxbgg != blank %}{{ block_st.boxbgg }}{% else %}{{ block_st.boxbg }}{% endif %};--border:{{ block_st.bdr }};--btn:{{ block_st.btn-cl }};--btnbg:{{ block_st.btn-bg }};--brds:{{ block_st.bdr-style }};--brad:{{ block_st.brad }}px;    	
                {%- endcapture -%}
                <div class="gitem {{ block_st.width }}-md reg-text {% render 'animate-data', css:true %}" {% render 'animate-data' %} {{ block.shopify_attributes }}>
                    <div class="offer-content fl f-aic f-col f-row-md {{ section_st.rounded }} t-center t-left-md h-100 gap" style="{{ block_style }}">
                        <div class="fl1{% if block_st.btn == blank and block_st.url == blank %} tc{% endif %}">
                            {% if block_st.title != blank %}<{{ section_st.htag }} class="head {{ section_st.preset }} mb0" {% if section_st.preset == 'custom-hd' %}style="--fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }};"{%- endif -%}>{{ block_st.title }}</{{ section_st.htag }}>{% endif %}
                            {% if block_st.text != blank %}<div class="reg-text">{{ block_st.text }}</div>{% endif %}
                        </div>
                        {%- if block_st.btn != blank and block_st.url != blank -%}
                          <a class="btn {{ section_st.btn-size }} border-0" {% if block_st.newtab1 %}target="_blank"{% endif %} href="{{ block_st.url }}">{{ block_st.btn }}</a>
                        {%- endif -%}
                    </div>
                </div>
            {%- endfor -%}
        </div>
        {%- if section.blocks.size == 0 -%}{%- render 'no-blocks' -%}{%- endif -%}
    </div>
</div>
{%- endcapture -%}
{{- text_bar | strip_newlines | remove: '  ' | remove: '	' -}}
{% schema %}
{
  "name": "Offer bar",
  "disabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "range",
      "id": "col-gap",
      "label": "Column gap",
      "default": 20,
      "min": 10,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "row-gap",
      "label": "Column gap (mobile)",
      "default": 10,
      "min": 10,
      "max": 50,
      "step": 1
    },
    {
      "type": "select",
      "id": "rounded",
      "label": "Corner radius",
      "default": "round-xs",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "round-xs",
          "label": "Extra small"
        },
        {
          "value": "round-sm",
          "label": "Small"
        },
        {
          "value": "round-md",
          "label": "Medium"
        },
        {
          "value": "round-lg",
          "label": "Large"
        },
        {
          "value": "round-full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "header",
      "content": "Text appearance"
    },
    {
      "type": "paragraph",
      "content": "Heading"
    },
    {
      "type": "select",
      "id": "htag",
      "label": "Heading tag",
      "info": "Specify heading type to improve SEO and accessibility.",
