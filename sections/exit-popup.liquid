      "visible_if": "{{ section.settings.sty == '2' }}"
    },
    {
      "type": "checkbox",
      "id": "arrow",
      "label": "Show arrows on desktop",
       "visible_if": "{{ section.settings.sty == '2' }}"
    },
    {
      "type": "checkbox",
      "id": "arrowm",
      "label": "Show arrows on mobile",
      "default": false,
       "visible_if": "{{ section.settings.sty == '2' }}"
