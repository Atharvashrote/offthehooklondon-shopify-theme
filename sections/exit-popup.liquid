    {
      "type": "header",
      "content": "Display on:"
    },
    {
      "type": "checkbox",
      "id": "index",
      "label": "Home page",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "product",
      "label": "Product page"
    },
    {
      "type": "checkbox",
      "id": "collection",
      "label": "Collection page"
    },
    {
      "type": "checkbox",
      "id": "article",
      "label": "Article page"
    },
    {
      "type": "checkbox",
      "id": "blog",
      "label": "Blog page"
    },
    {
      "type": "checkbox",
      "id": "cart",
      "label": "Cart page"
    },
    {
      "type": "checkbox",
      "id": "page",
