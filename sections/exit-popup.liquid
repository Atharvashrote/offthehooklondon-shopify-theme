    }
  ],
  "presets": [
    {
      "name": "Exit popup",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Wait ! Before you go... This might interest you.",
            "cl": "#111111",
            "mb": 10,
            "mbm": 10
