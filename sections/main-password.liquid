{%- assign section_st = section.settings -%}
<div class="password-header">
  <div class="page-width fl f-col f-aic gap" style="--gap:30px;">
    {% if section_st.logo %}
      <a href="/" itemprop="url" class="m0">
        {%- assign logo_alt = section_st.logo.alt | default: shop.name | escape -%}
        {% capture sizes %}(max-width: {{ section_st.logowd | times: 2 }}px) 50vw, {{ section_st.logowd }}px{% endcapture %}
        {% capture widths %}{{ section_st.logowd }}, {{ section_st.logowd | times: 1.5 | round }}, {{ section_st.logowd | times: 2 }}{% endcapture %}
        {%- assign logo_ht = section_st.logowd | divided_by: section_st.logo.aspect_ratio -%}
        {{
          section_st.logo
          | image_url: width: section_st.logo.width
          | image_tag:
            class: 'stlogo',
            widths: widths,
            height: logo_ht,
            width: section_st.logowd,
            alt: logo_alt,
            sizes: sizes,
            preload: true
        }}
      </a>
    {% else %}
        <h1 class="m0 logo" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</h1>
    {% endif %}
    {%- if shop.password_message != blank -%}
        <div class="tc m-auto" style="max-width:600px;">{{ shop.password_message }}</div>
    {%- endif -%}

    <div class="fl aic f-jcc gap" style="--gap:30px;--gapm:15px;--btn_link:{{ section_st.header-text }};">
        <a href="/admin" class="btn-link">{{ 'general.password_page.admin_link' | t }}</a>
        <a href="#LoginModal" class="js-modal-open-login-modal btn-link" aria-modal="true">{{- 'general.password_page.password_link' | t -}}</a>
    </div>
  </div>
</div>

<div class="password-main fl f-jcc f-aic fl1" role="main">
    <div class="passCnt tc">
        <h2 class="password__title mb10">{{ section_st.header }}</h2>
        
        {%- content_for 'block', type: 'countdown', id: 'countdown' -%}

    {%- if section_st.newsletter_enable -%}
        {% form 'customer' %}
            {{ form.errors | default_errors }}
            {% if form.posted_successfully? %}
                <p class="form-success">{{ 'general.password_page.signup_form_success' | t }}</p>
            {% else %}
                {% if section_st.newsletter_form_heading != blank %}
                    <p class="nwTxt mb30">{{ section_st.newsletter_form_heading }}</p>
                {% endif %}
                <input type="hidden" name="contact[tags]" value="prospect, password page">
                <label for="email" class="hidden_txt">{{ 'general.password_page.signup_form_email_label' | t }}</label>
                <div class="nw fl gap password_input mb30" style="--tf_bdr:{{ section_st.header-nwft | color_modify: 'alpha', 0.2 }};--gap:10px;">
                    <input class="fl1 newsletter-txt mb0" type="email" name="contact[email]" id="Email" placeholder="{{ section_st.newsletter_placeholder | escape }}">
                    <button type="submit" name="commit" class="btn {{ section_st.btn-style }}">{{ section_st.newsletter_button_text | escape }}</button>
                </div>
            {% endif %}
        {% endform %}
    {%- endif -%}
  </div>
</div>
<div class="password-footer tc">
  <div class="admin-login">
    {% if section_st.show_powered_by %}
      {% capture shopify %}<a class="text-underline shopify-link" href="//www.shopify.com" rel="nofollow" target="_blank" title="Create your own online store with Shopify">Shopify</a>{% endcapture %}
      <p class="mb5">
        <small>{{ 'general.password_page.powered_by_shopify_html' | t: shopify: shopify }}</small>
      </p>
    {% endif %}
  </div>
</div>

<style type="text/css">
  {% if section_st.image != blank %}
  	body, #LoginModal { background:url('{{ section_st.image | image_url: width: '2000x' }}') no-repeat center {{ section_st.alignment }}/cover {{ section_st.bgclr }}; }
    body:before, #LoginModal:before  { content: "";   position: absolute;   inset: 0;   background:{{section_st.ovr }}; z-index:-1; }
  {% else %}
  	body, #LoginModal { background-color:{{ section_st.bgclr }}; }
  {% endif %}

  .passwordPage { padding:50px 0; }

  .password-header { color:{{ section_st.header-text }}; padding:10px 15px; }

  .password__title { color:{{ section_st.header-ft }}; font-size:{{ section_st.hd2_fs }}px; font-family:var(--{{ section_st.hd2_fs_font }}); font-weight:{{ section_st.hd2_fsw }}; line-height:1.1; margin-bottom:40px; }
  .nwTxt, .password_heading, .passCnt a  { color:{{ section_st.header-nwft }}; }

  @media only screen and (max-width:766px){
    .password__title { font-size:{{ section_st.hd2_fsmb }}px; margin-bottom:25px; }
    .password-header {flex-direction:column; padding:15px;}
  }

  .passCnt { position:relative; z-index:2; padding:50px 10px; max-width:600px; margin:auto; }
  .passCnt .errors {max-width:300px; margin:0 auto; }
</style>
{% schema %}
{
  "name": "Password page",
  "class": "passwordPage fl f-col f-jcc f-aic h-100",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended width 2000 x 1000 px"
    },
     {
      "type": "color",
      "id": "ovr",
      "label": "Image overlay",
      "alpha": true,
      "default": "#00000060"     
    }, 
    {
      "type": "select",
      "id": "alignment",
      "label": "Image alignment",
      "default": "center",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "color",
      "id": "bgclr",
      "label": "Background",
      "default": "#fff",
      "visible_if": "{{ section.settings.image == blank }}"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logowd",
      "min": 50,
      "max": 500,
      "step": 5,
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "color",
      "id": "header-text",
      "label": "Logo text/links",
      "default": "#111"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "header",
      "label": "Heading",
      "default": "Coming Soon"
    },
    {
      "type": "color",
      "id": "header-ft",
      "label": "Color",
      "default": "#000"
    },
    {
      "type": "select",
      "id": "hd2_fs_font",
      "label": "Title font",
      "default": "ft1",
      "options": [
        {
          "value": "ft1",
          "label": "Body font"
        },
        {
          "value": "ft2",
          "label": "Heading font"
        },
        {
          "value": "ft3",
          "label": "Accent font"
        }
      ]
    },
    {
      "type": "select",
      "id": "hd2_fsw",
      "label": "Font weight",
      "default": "700",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "hd2_fs",
      "label": "Font size",
      "default": 54,
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "hd2_fsmb",
      "label": "Font size (mobile)",
      "default": 30,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "textarea",
      "id": "newsletter_form_heading",
      "label": "Newsletter text",
      "default": "Be the first to know when we launch.",
      "info": "[Tell your visitors about a launch day discount](https://www.shopify.com/blog/15514000-14-ways-to-use-offers-coupons-discounts-and-deals-to-drive-revenue-and-customer-loyalty)."
    },
    {
      "type": "color",
      "id": "header-nwft",
      "label": "Color",
      "default": "#000"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "placeholder text",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_button_text",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "select",
      "id": "btn-style",
      "label": "Button design",
      "default": "btn1",
      "options": [
        {
          "label": "Button 1",
          "value": "btn1"
        },
        {
          "label": "Button 2",
          "value": "btn2"
        },
        {
          "label": "Button 3",
          "value": "btn3"
        },
        {
          "label": "Outline Button 1",
          "value": "btn4"
        },
        {
          "label": "Outline Button 2",
          "value": "btn5"
        },       
        {
          "label": "Link",
          "value": "btn-link"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show powered by text",
      "default": true
    },
    {
      "type": "color",
      "id": "footer-text",
      "label": "Text",
      "default": "#111"
    }
  ]
}
{% endschema %}
