{%- liquid
    assign section_st = section.settings
    assign is_rtl = false
    assign list_rtl = 'ar,dv,ha,he,ku,fa,ur,ug' | split: ','
    if list_rtl contains request.locale.iso_code or settings.rtl
        assign is_rtl = true
    endif
    if is_rtl
        assign pm_left = 'right'
        assign pm_right = 'left'
    else
        assign pm_left = 'left'
        assign pm_right = 'right'
    endif

    assign giftpr = all_products[settings.gift_product]
    assign giftprc = giftpr.selected_or_first_available_variant.price | money
    assign gift_id = giftpr.selected_or_first_available_variant.id
    assign is_gift = true
  
    assign freeship_rate = settings.freeship | times: 100 | default: 0
    assign remain_amount = freeship_rate | minus: cart.total_price
    assign free_amount = remain_amount | money
    if settings.curCode
       assign free_amount = remain_amount | money_with_currency
    endif
    assign shipbar = remain_amount | times: 100 | divided_by: freeship_rate
    assign is_free_shipping = true

    assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
    for item in cart.items
      for allocation in item.line_level_discount_allocations
        if allocation.discount_application.type == 'discount_code'
          assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
        endif
      endfor
    endfor
    assign discount_codes = discount_codes | uniq
-%}
{%- style -%}
    #cartLink { pointer-events: none; }
    .cart-drawer__wrapper { display:none!important; }
    .cart-headings, .cart-headings th { font-size:{{ section_st.headings-fs }}px; font-weight:{{ section_st.headings-fw }}; text-transform:{{section_st.headings-case }};}
    .cart tr { border-bottom:1px solid {{ section_st.cart-border }}; }
    .cart td,.cart th { border:0; padding:10px 20px; } 
    .cart thead tr { font-weight:600;  border-bottom:1px solid {{ section_st.cart-border }};}
    .cart thead th, .cart td:not(.cart_details ) { padding-inline:0;} 

    .price { white-space:nowrap; font-weight:500; }  

    .cart_image { width:110px; padding:20px 0 !important;  }
    .cart_image img { border-radius:var(--thumb_rounded);}
    .cart_details { width:45%; max-width:300px }   
    .cart_meta-text { padding:5px 0; font-size:{{ settings.bodyfs | minus:2 }}px; font-style:italic }
    .cart_meta-text:empty { display:none; }
    .cart .cart_pr a { color:var(--body_color)}
 
    .shopify-cleanslate ul {justify-content:center;}
    .cart_summery .additional-checkout-button, .cart_summery .checkout { min-height:44px; width:100% !important; margin:0 0 10px !important }

    .borders { border-color:{{section_st.cart-summery  | color_darken : 2 }}; border-radius:{% if settings.btn_rad > 10 %}10px{% else %}{{settings.btn_rad}}px{% endif %}; }
    {% if section_st.layout == "1" %}
        .cart tbody tr:last-child { border:0;}              
        .cart .cart_footer  { margin:0 -15px;}
        .cart .cart_footer > li { flex:1; padding:0 15px; margin-bottom:15px;}      
        .cart .bdr-box { width:100%; padding:25px; background:{{section_st.cart-summery }}; height:100%; border-width:1px; border-style:solid}    
        #giftWrapProduct .cart-headings .at-icon { display:none}    
        #giftWrapProduct #Addgift { width:100%;}   
    {% else %}
        #giftWrapProduct { display:flex;}
        #giftWrapProduct .cart-headings { flex: 1; margin:0;}                         
        .cart .cart_footer { padding:20px 25px; background:{{ section_st.cart-summery }}; margin-left:15px; }
    {% endif %}
   
    #dynamic-checkout-cart .shopify-cleanslate li {flex-basis: 100% !important;}
    #dynamic-checkout-cart div[data-testid=GooglePay-button] {height: 45px !important; border-radius: {{ settings.btn_rad }}px !important ;}

    .cart__warnings:has(+ .cart__wrapper .is-empty) {display:block;}
    .cart__wrapper:has(.is-empty){ display:none; }
   
    .cart-countdown { background: {{ section_st.txtbg }};  color:{{ section_st.txtcl }}; padding: 15px 35px; max-width: max-content; margin-inline: auto; border:1px solid {{ section_st.timer_border }};}
    #cart-time {color:{{ section_st.timer }}}    
    
    @media only screen and (max-width:766px){             
      .cart.style1 .calculator { order:1;}   
      tr.cart-item { padding:20px 0; display:grid; grid-template: repeat(2,auto) / repeat(4,1fr); position:relative; } 
      .cart-items thead tr { display: flex; justify-content: space-between; }
      .cart_image { width:90px; grid-row:1 / 7; margin-{{ pm_right }}:20px; padding:0 !important;}     
      .cart_details { grid-column: 2 / 5; width:auto; }
      .cart_quantity { grid-column:2 / 5; grid-row:4; }
      .cart-item__price  { grid-column:2 / 5; grid-row:3; text-align:left !important;}
      .cart td { padding:0; line-height:1.3; }     
      .cart-item__price .loading__spinner { min-height:28px;}
           
      .cart__discount .ad_input {flex-direction: column;}
      .cart.style2 #giftWrapProduct {flex-direction: column; margin-bottom:20px;}  
      .cart.style2 #giftWrapProduct .cart-headings {  margin-bottom:20px;}  
      .cart.style2 .cart_footer  {margin-left:0;}     
    }

    /* =========================================================
   CART PRODUCT COLUMN ALIGNMENT
   ========================================================= */

@media screen and (min-width: 767px) {

    .cart.style2 .cart-items {
        width: 100% !important;
        table-layout: fixed !important;
    }

    /* Product image column */
    .cart.style2 .cart-items .cart_image {
        width: 140px !important;
        min-width: 140px !important;
        padding-right: 0 !important;
    }

    /* Product information column */
    .cart.style2 .cart-items .cart_details {
        width: auto !important;
        max-width: none !important;
        padding-left: 24px !important;
        padding-right: 20px !important;
        vertical-align: middle !important;
    }

    /* Price column */
    .cart.style2 .cart-items td:nth-child(3) {
        width: 110px !important;
        padding-left: 10px !important;
        padding-right: 10px !important;
        white-space: nowrap !important;
    }

    /* Quantity column */
    .cart.style2 .cart-items td.cart_quantity {
        width: 175px !important;
        padding-left: 10px !important;
        padding-right: 10px !important;
        white-space: nowrap !important;
    }

    /* Total column */
    .cart.style2 .cart-items td.cart-item__price {
        width: 115px !important;
        padding-left: 10px !important;
        padding-right: 10px !important;
        white-space: nowrap !important;
    }

    /* Product name */
    .cart.style2 .cart_details .product-title {
        display: block !important;
        margin-bottom: 10px !important;
        line-height: 1.3 !important;
    }

    /* Variant information */
    .cart.style2 .cart_details .cart_meta-text {
        padding: 0 !important;
        margin: 0 !important;
        line-height: 1.8 !important;
    }

    .cart.style2 .cart_details .cart_meta-text .product-option {
        margin-bottom: 2px !important;
    }

}

    /* =========================================================
       OFF THE HOOK - CART PAGE REDESIGN
       Uses the theme's existing font stack. No external font added.
       ========================================================= */

    .oth-cart-heading {
        display:flex;
        align-items:flex-end;
        justify-content:space-between;
        gap:30px;
        margin:0 0 30px;
    }

    .oth-cart-breadcrumb {
        display:flex;
        align-items:center;
        gap:10px;
        margin-bottom:12px;
        font-size:13px;
        color:#666;
    }

    .oth-cart-breadcrumb a {
        color:inherit;
        text-decoration:none;
    }

    .oth-cart-breadcrumb a:hover {
        text-decoration:underline;
    }

    .oth-cart-heading .page-title {
        margin:0 0 7px;
        text-align:left;
        font-size:42px;
        line-height:1.05;
        font-weight:500;
        letter-spacing:-.025em;
    }

    .oth-cart-count {
        font-size:.58em;
        font-weight:400;
        vertical-align:middle;
    }

    .oth-cart-subtitle {
        margin:0;
        color:#777;
        font-size:15px;
        line-height:1.5;
    }

    .oth-continue-shopping {
        flex:0 0 auto;
        color:#111;
        text-decoration:none;
        font-size:14px;
        padding-bottom:5px;
    }

    .oth-continue-shopping:hover {
        text-decoration:underline;
    }

    /* Main two-column layout */
    .cart.style2 {
        display:grid !important;
        grid-template-columns:minmax(0, 2fr) minmax(300px, 1fr);
        gap:20px;
        align-items:start;
    }

    .cart.style2 .oth-cart-left,
    .cart.style2 .oth-cart-right {
        width:auto !important;
        float:none !important;
    }

    .cart.style2 .oth-cart-right {
        position:sticky;
        top:20px;
    }

    /* Cart items card */
    .cart.style2 .cart__contents {
        border:1px solid #e9e9e9;
        border-radius:6px;
        overflow:hidden;
        background:#fff;
    }

    .cart.style2 .cart-items thead {
        background:#fafafa;
    }

    .cart.style2 .cart-items thead th {
        padding:15px 20px;
        font-size:12px;
        letter-spacing:.04em;
    }

    .cart.style2 .cart-items tbody td {
        padding-top:18px;
        padding-bottom:18px;
    }

    .cart.style2 .cart_image {
        width:120px;
        padding:15px 0 !important;
    }

    .cart.style2 .cart_image img {
        width:120px;
        height:120px;
        object-fit:cover;
        border-radius:4px;
    }

    .cart.style2 .cart_details {
        width:48%;
        max-width:none;
    }

    .cart.style2 .cart_pr a {
        font-size:15px;
        font-weight:600;
        text-decoration:none;
    }

    .cart.style2 .cart_meta-text {
        font-size:13px;
        line-height:1.45;
    }

    .cart.style2 .cart-item__price {
        font-size:15px;
    }

    /* Coupon + order note below products */
    .oth-cart-bottom-tools {
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:0;
        margin-top:18px;
        padding:22px;
        border:1px solid #e9e9e9;
        border-radius:6px;
        background:#fafafa;
    }

    .oth-cart-bottom-tools > * {
        min-width:0;
        padding:0 20px;
    }

    .oth-cart-bottom-tools > *:first-child {
        padding-left:0;
        border-right:1px solid #ddd;
    }

    .oth-cart-bottom-tools > *:last-child {
        padding-right:0;
    }

    .oth-cart-bottom-tools .cart-headings {
        font-size:14px;
        font-weight:600;
        margin-bottom:10px;
    }

    .oth-cart-bottom-tools textarea,
    .oth-cart-bottom-tools input {
        background:#fff;
        border:1px solid #ddd;
    }

    .oth-cart-bottom-tools .cart-discount__form .ad_input {
        display:flex;
    }

    .oth-cart-bottom-tools .cart-discount__button {
        min-width:95px;
    }

    /* Summary card */
    .cart.style2 .cart_footer {
        margin:0 !important;
        padding:0 !important;
        background:transparent !important;
    }

    .cart.style2 .cart_summery {
        padding:0 !important;
    }

    .cart.style2 .cart_summery > .bdr-box {
        padding:25px !important;
        background:#f7f7f7;
        border:1px solid #e9e9e9;
        border-radius:6px;
    }

    .cart.style2 .cart__blocks {
        border:0 !important;
    }

    .cart.style2 .cartTotal hr {
        margin:0 0 18px;
        border:0;
        border-top:1px solid #ddd;
    }

    .cart.style2 .cart-total {
        font-size:18px;
        margin-bottom:12px;
    }

    .cart.style2 .totalSave {
        font-size:13px;
        margin-bottom:14px;
    }

    .cart.style2 .cart__ctas .checkout {
        min-height:52px;
        font-size:13px;
        letter-spacing:.02em;
    }

    .cart.style2 .cart__ctas .btn {
        border-radius:4px;
    }

    .cart.style2 .paymnet-img {
        padding-top:5px;
    }

    .cart.style2 .paymnet-img svg {
        max-height:28px;
        width:auto;
        margin:3px;
    }

    /* Remove the old countdown even if the setting remains enabled */
    .cart-countdown {
        display:none !important;
    }

    @media only screen and (max-width: 991px) {
        .cart.style2 {
            grid-template-columns:1fr;
        }

        .cart.style2 .oth-cart-right {
            position:static;
        }
    }

    @media only screen and (max-width: 766px) {
        .oth-cart-heading {
            align-items:flex-start;
            flex-direction:column;
            gap:10px;
            margin-bottom:20px;
        }

        .oth-cart-heading .page-title {
            font-size:30px;
        }

        .oth-continue-shopping {
            padding:0;
        }

        .oth-cart-bottom-tools {
            grid-template-columns:1fr;
            gap:20px;
        }

        .oth-cart-bottom-tools > * {
            padding:0 !important;
        }

        .oth-cart-bottom-tools > *:first-child {
            padding-bottom:20px !important;
            border-right:0;
            border-bottom:1px solid #ddd;
        }

        .cart.style2 .cart_image,
        .cart.style2 .cart_image img {
            width:90px;
            height:90px;
        }

        .cart.style2 .cart_details {
            width:auto;
        }

        .cart.style2 .cart_summery > .bdr-box {
            padding:20px !important;
        }
    }

{%- endstyle -%}
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
{% capture free_shipping %}
  {%- if settings.freeship != blank and settings.free_ship_msg != blank -%}
    <div class="freeshipdata free-shipping mb15" style="--icns:18px">
        {% if settings.ship_ico %}<svg class="at-icon mr5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M382.2,118.3h-66V81.6c0-7-5.5-12.7-12.3-12.7H12.3C5.5,68.8,0,74.5,0,81.6v301.6c0,7,5.5,12.7,12.3,12.7h41.2 c5.7,27.5,29.3,47.3,56.7,47.3c27.3,0,50.9-19.8,56.7-47.3H345c5.7,27.5,29.3,47.3,56.7,47.3c27.3,0,50.9-19.8,56.7-47.3h41.2 c6.8,0,12.3-5.7,12.3-12.7V252.6C512,178.6,453.8,118.3,382.2,118.3z M406,241c-16.1,0-29.2-13.6-29.2-30.2v-66.9h5.4 c53.3,0,98.9,42.5,104.6,97.2H406z M406,266.5h81.3v103.9h-28.8c-5.7-27.5-29.3-47.3-56.7-47.3c-27.3,0-50.9,19.8-56.7,47.3h-28.9 V143.8h36v66.9C352.1,241.5,376.3,266.5,406,266.5z M435.1,383.2c0,19-15,34.5-33.4,34.5s-33.4-15.5-33.4-34.5s15-34.5,33.4-34.5 S435.1,364.1,435.1,383.2z M291.5,313.8v56.7H167c-5.7-27.5-29.3-47.3-56.7-47.3c-27.3,0-50.9,19.8-56.7,47.3H24.6v-56.7H291.5z M110.2,348.6c18.4,0,33.4,15.5,33.4,34.5s-15,34.5-33.4,34.5s-33.4-15.5-33.4-34.5S91.8,348.6,110.2,348.6z M291.5,94.3v194H24.6 v-194H291.5z"></path></svg> {% endif %}
        {% if remain_amount > 0 %}{{ settings.free_ship_msg | replace: '[price]', free_amount }}{% else %}{{ settings.got_free_ship }}{% endif %}
        {% if settings.progress_bar %}<div class="shipping-bar"><span class="db anim" style="width:calc(100% - {{ shipbar }}%);"></span></div>{% endif %}
    </div>
  {%- endif -%}
{% endcapture %}


{% capture cart_table %}
<cart-items class="db {% if cart == empty %}is-empty{% endif %}" >
    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
        <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
            <div class="js-contents">
                {%- if cart != empty -%}
                    <table class="cart-items w-100 {% if section_st.layout == "1" %}mb10{% endif %}">
                        <thead>
                            <tr class="hide-sm cart-headings">                            
                                <th colspan="2" scope="col">{{ 'cart.label.product' | t }}</th>
                                <th class="tc hide-sm" colspan="1" scope="col">{{ 'cart.label.price' | t }}</th>                               
                                <th class="hide-sm t-center" colspan="1" scope="col">{{ 'cart.label.quantity' | t }}</th>
                                <th class="hide-sm tr" colspan="1" scope="col">{{ 'cart.label.total' | t }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {%- for item in cart.items -%}
                                {% if item.id == gift_id %}{% assign is_gift = false %}{% endif %}
                                <tr class="cart-item" id="CartItem-{{ item.index | plus: 1 }}">
                                    <td class="cart_image">
                                        {% if item.image %}
                                            <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1">
                                                {{ item.image | image_url: width: item.image.width | image_tag: loading:'lazy', width:item.image.width, height:item.image.height, class:'img-fill', sizes:'150px', widths:"150,260,340" }}
                                            </a>
                                        {% endif %}
                                    </td>
                                    <td class="cart_details tl">
                                        <a href="{{ item.url }}" class="cart-item__name product-title">{{ item.product.title | escape }}</a>

                                        {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
                                            <div class="cart_meta-text">
                                                {%- if item.product.has_only_default_variant == false -%}
                                                    {%- for option in item.options_with_values -%}{{ option.name }}: {{ option.value }}<br/>{%- endfor -%}
                                                {%- endif -%}
                                                {%- for property in item.properties -%}
                                                    {%- assign property_first_char = property.first | slice: 0 -%}
                                                    {%- if property.last != blank and property_first_char != '_' -%}
                                                        <div class="product-option">
                                                            {{ property.first }}: {%- if property.last contains '/uploads/' -%}<a href="{{ property.last }}" class="link" target="_blank">{{ property.last | split: '/' | last }}</a>{%- else -%}{{ property.last }}{%- endif -%}
                                                        </div>
                                                    {%- endif -%}
                                                {%- endfor -%}
                                                {%- if item.selling_plan_allocation.selling_plan.name != blank -%}<p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
                                            </div>
                                        {%- endif -%}
                                        {%- if item.discounts.size > 0 -%}
                                            <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}" style="--icns:12px;">
                                                {%- for discount in item.discounts -%}<li class="discounts__discount mb5"><svg class="at-icon mr5"><use xlink:href="#icon-tag"></use></svg> {{ discount.title }}</li>{%- endfor -%}
                                            </ul>
                                        {%- endif -%}
                                    </td> 
                                    <td class="tc hide-sm">
                                            {%- if item.original_price != item.final_price -%}
                                                <div class="cart-item__discounted-prices">
                                                    <s class="product-price">{{ item.original_price | money }}</s><br/>
                                                    <span class="product-price sale">{{ item.final_price | money }}</span>
                                                </div>
                                            {%- else -%}
                                                <div class="product-price">{{ item.original_price | money }}</div>
                                            {%- endif -%}
                                        </td>                               
                                    {%- liquid
                                      assign has_qty_rules = false
                                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                                        assign has_qty_rules = true
                                      endif

                                      assign has_vol_pricing = false
                                      if item.variant.quantity_price_breaks.size > 0
                                        assign has_vol_pricing = true
                                      endif
                                    -%}
                                    <td class="cart_quantity">
                                        <quantity-popover class="m0">
                                            <div class="cart-item__quantity-wrapper quantity-popover-wrapper fl f-aic f-jcc-md" style="--icns:16px;">
                                                <label class="hidden" for="Quantity-{{ item.index | plus: 1 }}">{{ 'products.product.quantity.label' | t }}</label>
                                                <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                                    {%- if has_qty_rules or has_vol_pricing -%}
                                                        <button type="button" aria-expanded="false" class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide no-js-hidden">{{ 'icon-info.svg' | inline_asset_content }}</button>
                                                    {%- endif -%}
                                                    <quantity-input class="quantity cart-quantity qty-field mr10{% if item.id == gift_id %} hide{% endif %}">
                                                        <button type="button" class="qty-btn minus" name="minus" aria-label="Decrease quantity"><svg class="at-icon"><use xlink:href="#icon-minus"></use></svg></button>
                                                        <input class="quantity__input qty" data-quantity-variant-id="{{ item.variant.id }}" type="number" name="updates[]" value="{{ item.quantity }}"
                                                            data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}" min="{{ item.variant.quantity_rule.min }}" {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                                                            step="{{ item.variant.quantity_rule.increment }}" aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}" id="Quantity-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                                                        <button type="button" class="qty-btn plus" name="plus" aria-label="Increase quantity"><svg class="at-icon"><use xlink:href="#icon-plus"></use></svg></button>
                                                    </quantity-input>
                                                </div>
                                                <cart-remove-button  id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                                                    <a href="{{ item.url_to_remove }}" class="remove button--tertiary" aria-label="{{ 'cart.button.remove' | t: title: item.title }}">
                                                        <svg class="at-icon"><use xlink:href="#icon-remove"></use></svg>
                                                    </a>
                                                </cart-remove-button>
                                            </div>
                                            {%- if has_qty_rules or has_vol_pricing -%}
                                                <button type="button" class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary medium-hide large-up-hide" aria-expanded="false">
                                                    {{ 'icon-error.svg' | inline_asset_content }} <span>{%- if has_vol_pricing -%}{{ 'products.product.volume_pricing.note' | t }}{%- elsif has_qty_rules -%}{{ 'products.product.quantity.note' | t }}{%- endif -%}</span>
                                                </button>
                                            {%- endif -%}
                                            {%- if has_vol_pricing or has_qty_rules -%}
                                                <div class="cart-items__info global-settings-popup quantity-popover__info" tabindex="-1" hidden>
                                                    {%- if has_qty_rules == false -%}
                                                    <span class="volume-pricing-label caption">{{- 'products.product.volume_pricing.title' | t -}}</span>
                                                    {%- endif -%}
                                                    <div class="quantity__rules caption no-js-hidden">
                                                        {%- if item.variant.quantity_rule.increment > 1 -%}
                                                            <span class="divider">{{- 'products.product.quantity.multiples_of' | t: quantity: item.variant.quantity_rule.increment -}}</span>
                                                        {%- endif -%}
                                                        {%- if item.variant.quantity_rule.min > 1 -%}
                                                            <span class="divider">{{- 'products.product.quantity.minimum_of' | t: quantity: item.variant.quantity_rule.min -}}</span>
                                                        {%- endif -%}
                                                        {%- if item.variant.quantity_rule.max != null -%}
                                                            <span class="divider">{{- 'products.product.quantity.maximum_of' | t: quantity: item.variant.quantity_rule.max -}}</span>
                                                        {%- endif -%}
                                                    </div>
                                                    <button class="button-close button button--tertiary medium-hide large-up-hide" type="button" aria-label="{{ 'accessibility.close' | t }}"><svg class="at-icon"><use xlink:href="#icon-close"></use></svg></button>
                                                    {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                                        <volume-pricing class="parent-display">
                                                            <ul class="list-unstyled">
                                                                <li>
                                                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                                                    {%- assign price = item.variant.price | money_with_currency -%}
                                                                    <span> {{ 'sections.quick_order_list.each_html' | t: money: price }}</span>
                                                                </li>
                                                                {%- for price_break in item.variant.quantity_price_breaks -%}
                                                                    <li>
                                                                        <span>{{- price_break.minimum_quantity -}}<span aria-hidden="true">+</span></span>
                                                                        {%- assign price = price_break.price | money_with_currency -%}
                                                                        <span> {{ 'sections.quick_order_list.each_html' | t: money: price }}</span>
                                                                    </li>
                                                                {%- endfor -%}
                                                            </ul>
                                                        </volume-pricing>
                                                    {%- endif -%}
                                                </div>
                                            {%- endif -%}
                                            <div class="cart-item__error ermsg fl f-jcc" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                                                <small class="cart-item__error-text ctItem-error order1 ml5"></small> 
                                                                                        </div>
                                        </quantity-popover>
                                    </td>
                                    <td class="cart-item__price tr">
                                        <div class="loading__spinner loading-overlay hidden"><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg></div>
                                        <div class="cart-totals__price mb10 mb0-md">
                                            {%- if item.original_line_price != item.final_line_price -%}
                                                <dl class="cart-item__discounted-prices m0">
                                                    <span class="hidden_txt">{{ 'products.product.regular_price' | t }}</span>
                                                    <s class="price product-price">{{ item.original_line_price | money }}</s>
                                                    <span class="hidden_txt">{{ 'products.product.sale_price' | t }}</span>
                                                    <div class="price product-price sale">{{ item.final_line_price | money }}</div>
                                                </dl>
                                            {%- else -%}
                                                <span class="price product-price">{{ item.original_line_price | money }}</span>
                                            {%- endif -%}

                                            {%- if item.variant.available and item.unit_price_measurement -%}
                                                <div class="unit-price caption">
                                                    <span class="hidden_txt">{{ 'products.product.unit_price' | t }}</span>
                                                    {{ item.variant.unit_price | money }}
                                                    <span aria-hidden="true">/</span>
                                                    <span class="hidden_txt">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
                                                    {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                                                        {{ item.variant.unit_price_measurement.reference_value }}
                                                    {%- endif -%}
                                                    {{ item.variant.unit_price_measurement.reference_unit }}
                                                </div>
                                            {%- endif -%}
                                        </div>
                                    </td>
                                </tr>
                            {%- endfor -%}
                        </tbody>
                    </table>
                {%- endif -%}
            </div>
        </div>
        <p class="hidden_txt" id="cart-live-region-text" aria-live="polite" role="status"></p>
        <p class="hidden_txt" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
    </form>
</cart-items>
{% endcapture %}
{% capture coupon %}
    {% if settings.coupon %}              
            <cart-discount id="cartDiscount" class="cart__discount fl f-col mb10" data-id="{{ section.id }}">
                <form on:submit="/applyDiscount" onsubmit="return false;" class="cart-discount__form">
                    <label for="cart-discount" class="cart-headings mb10">{{ settings.cpnttl }}</label>
                    <div class="ad_input fl gap mb10" style="--gap:10px;">
                        <input id="cart-discount" class="fl1 mb0 input wd100 stopEv cart-discount-input" name="discount" placeholder="{{ 'cart.general.discount_code' | t }}">
                        <button type="submit" class="btn btn-sm cart-discount__button">
                            <span class="txt">{{ 'cart.button.apply' | t }}</span>
                            <div class="loading__spinner"><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg></div>
                        </button>
                    </div>
                </form>
                <div class="cart-discount__error fs12 ermsg hidden" role="alert" ref="cartDiscountError"></div>
                <ul class="cart-discount__codes fl f-wrap gap" style="--gap:10px;--icns:13px;">
                    {% for discount in discount_codes %}
                        <li class="discount-code fl f-aic" data-discount-code="{{ discount }}" aria-label="{{ 'cart.general.discount_applied' | t: code: discount }}">
                        <svg class="at-icon mr5"><use xlink:href="#icon-tag"></use></svg> {{ discount }}
                        <button type="button" on:click="/removeDiscount" class="grid-button btn-reset anim cart-discount-remove btnLink" aria-label="{{ 'cart.general.remove_discount' | t: code: discount }}">
                            <svg class="at-icon txt remove ml10" style="--icns:11px;" viewBox="0 0 384 512"><path d="M231.6 256l130.1-130.1c4.7-4.7 4.7-12.3 0-17l-22.6-22.6c-4.7-4.7-12.3-4.7-17 0L192 216.4 61.9 86.3c-4.7-4.7-12.3-4.7-17 0l-22.6 22.6c-4.7 4.7-4.7 12.3 0 17L152.4 256 22.3 386.1c-4.7 4.7-4.7 12.3 0 17l22.6 22.6c4.7 4.7 12.3 4.7 17 0L192 295.6l130.1 130.1c4.7 4.7 12.3 4.7 17 0l22.6-22.6c4.7-4.7 4.7-12.3 0-17L231.6 256z"/></svg> 
                            <svg class="at-icon at-spin ml10"><use xlink:href="#icon-loading"></use></svg>
                        </button>
                        </li>
                    {% endfor %}
                    </ul>
            </cart-discount>                         
      {%  endif %}                                               
{% endcapture %}


{% capture cart_summery %}
<li class="cart_summery">   
    <div class="bdr-box borders">
        <div class="cart__footer" id="main-cart-footer" data-id="{{ section.id }}">
            <div class="cart__blocks" style="--border_color:{{section_st.cart-summery  | color_darken : 5 }};">
                {% for block in section.blocks %}
                {%- assign block_st = block.settings -%}
                {%- if block.type == 'sub' -%}
                    <div class="cartTotal mb{{ block_st.bm }}">
                        <hr />
                        {%- if cart.cart_level_discount_applications.size > 0 -%}
                            <ul class="discounts list-unstyled mb10 tr" role="list" aria-label="{{ 'customer.order.discount' | t }}" style="--icns:12px;">
                                {%- for discount in cart.cart_level_discount_applications -%}
                                    <li class="discounts__discount fl f-aic f-jcsb mb5"><span><svg class="at-icon"><use xlink:href="#icon-tag"></use></svg> {{ discount.title }}</span> <span>-{{ discount.total_allocated_amount | money }}</span></li>
                                    {% assign discountcode_save = discount.total_allocated_amount %}
                                {%- endfor -%}
                            </ul>
                        {%- endif -%}
                    
                        <div class="totals cart-total fs15 fw-600 mb5 fl f-jcsb text-upper" role="status">
                            <span>{{ 'cart.general.total' | t }}</span>
                            <span>{{ cart.total_price | money_with_currency }}</span>
                        </div>

                        {% if block_st.save %}
                            {%- liquid
                                assign savings = 0
                                for item in cart.items
                                    if item.variant.compare_at_price > 0
                                        if item.original_price != item.final_price
                                            assign difference = item.variant.compare_at_price | minus: item.final_price
                                        else
                                            assign difference = item.variant.compare_at_price | minus: item.original_price
                                        endif
                                        assign savings = savings | plus: difference
                                        assign actual_saving = savings | times: item.quantity
                                    elsif item.original_price != item.final_price
                                        assign difference = item.original_price | minus: item.final_price
                                        assign savings = savings | plus: difference
                                        assign actual_saving = savings | times: item.quantity
                                    endif
                                endfor
                            -%}
                            {% if savings > 0 %}
                                <div class="fl totalSave f-jcsb em" style="color:{{ block_st.cl }}">
                                    <span>{{ 'cart.general.savings' | t }}:</span>
                                    <span>{{ actual_saving | plus: discountcode_save | money }}</span>
                                </div>
                            {% endif %}                      
                        {% endif %}

                        {%- if block_st.shippingTax -%}
                        <div class="small-font mt5">
                            {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                                {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                            {%- elsif cart.taxes_included -%}
                                {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
                            {%- elsif shop.shipping_policy.body != blank -%}
                                {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                            {%- else -%}
                                {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
                            {%- endif -%}
                        </div>
                        {%- endif -%}
                    
                    
                    </div>

                {%- elsif block.type == 'ship' -%}
                    {% assign is_free_shipping = false %}
                    <div class=" mb{{ block_st.bm }}">{{ free_shipping }}</div>
                {%- elsif block.type == 'btn' -%}
                    <div class="cart__ctas mb{{ block_st.bm }}">
                    {%- if settings.terms_checkbox -%}
                    <p class="cart-term">
                        <label for="cartTerms" class="fl">
                        <input type="checkbox" name="tearm" id="cartTerms" class="checkbox custCheck stopEv" value="tearm" required /><span class="checkbox"></span> {{ settings.terms_text}}
                        </label>
                    </p>
                    {%- endif -%}
        
                    <button type="submit" id="cartCheckout" class="btn checkout {{block_st.btnco}} btn-md cartCheckout" name="checkout" form="cart" {% if cart == empty or settings.terms_checkbox %} disabled{% endif %}>{{ 'cart.button.checkout' | t }}</button> 
                    {% if block_st.continue %}<a href="{{routes.root_url}}" class="btn btn-md w-100 mb10 {{ block_st.btncn }}">{{ 'cart.button.continue_shopping' | t}}</a>{% endif %}
                    {% if block_st.additionalCheckout and additional_checkout_buttons %}<div class="cart__dynamic-checkout-buttons additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>{% endif %}
                    </div>                      
                {%- elsif block.type == 'img' -%}
                    <div class="paymnet-img tc mb{{ block_st.bm }}">
                        {%- if block_st.shopp -%}
                                {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payment-item' }}{% endfor %}
                        {%- elsif block_st.payment != blank -%}
                            {{ block_st.payment | image_url: width: block_st.payment.width | image_tag: loading:'lazy', width:block_st.payment.width, height:block_st.payment.height, class:'img-fill', sizes:'400px', widths:"320,460,580,780" }}
                        {%- endif -%}
                    </div>
                {% elsif block.type == 'text' %}
                        <div class="reg-text mb{{ block_st.bm }}" style="--cl:{{ block_st.cl }};--fs:{{ block_st.fs }}px;--fsm:{{ block_st.fsm }}px;" {{ block.shopify_attributes }}>{{ block_st.text }}</div>
                {% elsif block.type == 'custom' %}
                        <div class="mb{{ block_st.bm }}" {{ block.shopify_attributes }}>{{ block_st.custom_liquid }}</div>
                {% endif %}
                {% endfor %}
                <div id="cart-errors" class="ermsg"></div>
            </div>
        </div>
    </div>
</li>
{% endcapture %}

{% capture gift_wrap %}
{% if is_gift and settings.giftwrap %}    
        {% if giftpr.title.size > 0 %}
        <div id="giftWrapcart">
            <product-form class="product-form">
                {%- form 'product', giftpr, id: 'giftWrapProduct', class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="text" id="ProductSelect" name="id" value="{{ giftpr.selected_or_first_available_variant.id }}" class="hide" />
                    <input type="text" id="quantity" name="quantity" value="1" class="hide" />
                    <div class="cart-headings fl f-aic mb15" style="line-height:1.2;--icns:20px">
                        <svg  class="at-icon mr15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M500.87,133.269H344.198c13.891-7.057,27.314-15.738,38.133-26.557c24.442-24.442,24.442-64.2,0-88.643 c-23.686-23.686-64.957-23.708-88.643,0C276.235,35.521,263.925,59.519,256,81.824c-7.925-22.305-20.235-46.303-37.688-63.755 c-23.708-23.708-65.002-23.686-88.643,0c-24.442,24.442-24.442,64.2,0,88.643c10.819,10.819,24.242,19.5,38.133,26.557H11.13 c-6.144,0-11.13,4.986-11.13,11.13v89.043c0,6.144,4.986,11.13,11.13,11.13h11.13v256c0,6.144,4.986,11.13,11.13,11.13h178.087 h89.043h178.087c6.144,0,11.13-4.986,11.13-11.13v-256h11.13c6.144,0,11.13-4.986,11.13-11.13v-89.043 C512,138.255,507.014,133.269,500.87,133.269z M200.348,489.443H44.522v-244.87h155.826V489.443z M200.348,222.312H33.391h-11.13 V155.53h178.087V222.312z M145.408,90.973c-15.761-15.761-15.761-41.405,0-57.166c7.635-7.658,17.786-11.843,28.583-11.843 s20.925,4.185,28.583,11.843c28.605,28.605,42.051,81.697,42.362,99.105c0,0.111-0.022,0.267-0.022,0.356h-1.224 C225.592,132.646,173.657,119.2,145.408,90.973z M289.391,489.443h-66.783v-244.87h66.783V489.443z M289.391,222.312h-66.783 V155.53h22.929h0.022h20.881h0.022h22.929V222.312z M268.31,133.269h-1.224c0-0.089-0.022-0.245-0.022-0.356 c0.312-17.408,13.757-70.5,42.362-99.105c7.658-7.658,17.786-11.843,28.583-11.843s20.948,4.185,28.583,11.843 c15.761,15.761,15.761,41.405,0,57.166C338.343,119.2,286.408,132.646,268.31,133.269z M467.478,489.443H311.652v-244.87h155.826 V489.443z M489.739,222.312h-11.13H311.652V155.53h178.087V222.312z"/></svg>
                        <span>{{ settings.gfwrtxt | replace: "$", giftprc }}</span>
                    </div>
                    <button type="submit" name="add" id="Addgift" class="btn {{ settings.gift-btn }}">
                        <span class="txt">{{ 'cart.button.gift_wrap' | t }}</span>
                        <div class="loading__spinner"><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg></div>
                    </button>
                {%- endform -%}
            </product-form>
        </div>
    {% endif %}   
{% endif %}
{% endcapture %}

{% capture cart_note %}
    {% if settings.cartnote %}      
            <cart-note class="db">
                <label class="cart-headings mb15" for="Cart-note">{{ 'cart.general.note' | t }}</label>
                <textarea class="text-area mb20 w-100" name="note" form="cart" id="Cart-note" placeholder=" ">{{ cart.note }}</textarea>
            </cart-note>      
    {% endif %}
{% endcapture %}
<div class="section-cover" style="--sst:{{ section_st.sst }}px;--ssb:{{ section_st.ssb }}px;--sstm:{{ section_st.sstm }}px;--ssbm:{{ section_st.ssbm }}px">
    <div class="db page-width {% if cart == empty %}is-empty{% endif %}" style="max-width:{{ section_st.pagewidth }}px">
        <div class="oth-cart-heading">
            <div>
                <div class="oth-cart-breadcrumb">
                    <a href="{{ routes.root_url }}">Home</a>
                    <span>›</span>
                    <span>{{ 'cart.general.title' | t }}</span>
                </div>
                <h1 class="page-title{% if settings.ttl_c %} text-upper{% endif %}">{{ 'cart.general.title' | t }} <span class="oth-cart-count">({{ cart.item_count }})</span></h1>
                <p class="oth-cart-subtitle">Almost there! Complete your order and step into something special.</p>
            </div>
            <a class="oth-continue-shopping" href="{{ routes.root_url }}">
                <span aria-hidden="true">←</span> Continue Shopping
            </a>
        </div>
        <div class="cart__warnings tc{% if cart != empty %} dn{% endif %}">
            <svg class="at-icon"><use xlink:href="#icon-cart"></use></svg>
            <p>{{ 'cart.general.empty' | t }}.</p> 
            {% if settings.empty_cart != blank %}<p><a href="{{ settings.empty_cart_url }}" class="btn">{{ settings.empty_cart }}</a></p>{% endif %}             
            {%- if shop.customer_accounts_enabled and customer == nil -%}
                <h2 class="mb5">{{ 'cart.login.title' | t }}</h2>
                <p>{{ 'cart.login.paragraph_html' | t: link: routes.account_login_url }}</p>
            {%- endif -%}
            <p>&nbsp;</p><p>&nbsp;</p>
        </div>
 
        <div class="cart__wrapper">
            <div class="cart{% if section_st.layout == "2" %} grid style2{% else %} style1{% endif %}">
            {% if section_st.layout == "1" %}
                {{ cart_table }}    
                <ul class="fl cart_footer f-col f-row-md">
                    <li><div class="bdr-box borders">{{ coupon }} {{ cart_note }} {{ gift_wrap }}</div> </li>
                    {{ cart_summery }}
                </ul>
            {% else %}
                <div class="gitem wd66-lg oth-cart-left">
                    {{ cart_table }}
                    <div class="oth-cart-bottom-tools">
                        {{ coupon }}
                        {{ cart_note }}
                        {{ gift_wrap }}
                    </div>
                </div>
                <div class="gitem wd33-lg oth-cart-right" id="main-cart-footer" data-id="{{ section.id }}">
                    <ul class="cart_footer borders">
                        {{ cart_summery }}
                    </ul>
                </div>
            {% endif %}
            </div> 
        </div>   

    </div>
</div>
{%- if is_free_shipping -%}<div class="hide">{{ free_shipping }}</div>{%- endif -%}
{% schema %}
  {
    "name": "Cart page",
    "settings": [
      {
        "type": "select",
        "id": "layout",
        "label": "Layout",
        "default": "1",
        "options": [
          {
            "value": "1",
            "label": "Style 1"
          },
          {
            "value": "2",
            "label": "Style 2"
          }
        ]
      },
       {
        "type": "range",
        "id": "pagewidth",
        "label": "Page width",
        "default": 1200,
        "min": 800,
        "max": 1600,
        "step": 10,
        "unit": "px"
      },
      {
        "type": "color",
        "id": "cart-border",
        "label": "Cart border",
        "default": "#eee"
      },
      {
        "type": "color",
        "id": "cart-summery",
        "label": "Cart summery background",
        "default": "#f5f5f5"
      },
      {
        "type": "range",
        "id": "headings-fs",
        "label": "Headings font size",
        "default": 15,
        "min": 10,
        "max": 20,
        "step": 1,
        "unit": "px"
      },     
      {
        "type": "select",
        "id": "headings-fw",
        "label": "Font weight",
        "default": "600",
        "options": [
          {
            "value": "300",
            "label": "Light"
          },
          {
            "value": "400",
            "label": "Regular"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semi bold"
          },
          {
            "value": "700",
            "label": "Bold"
          }
        ]
      },
      {
        "type": "select",
        "id": "headings-case",
        "label": "Font case",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }          
        ]
      },
	  {
        "type": "header",
        "content": "Countdown"
      },
 	  {
        "type": "checkbox",
        "id": "cart-count",
        "label": "Show countdown",
        "default": true
      },
      {
        "type": "range",
        "id": "countTime",
        "label": "Time",
        "default": 30,
        "min": 1,
        "max": 60,
        "step": 1,
        "unit": "Min",
        "visible_if": "{{ section.settings.cart-count }}"
      },
      {
        "type": "textarea",
        "id": "countMsg",
        "label": "Urgency text",
        "default": "These products are limited, checkout within [time] ",
        "info": "Use [time] tag to show timer in message",
        "visible_if": "{{ section.settings.cart-count }}"
      },
       {
        "type": "color",
        "id": "txtcl",
        "label": "Text",
        "default": "#333",
        "visible_if": "{{ section.settings.cart-count }}"
      },
      {
        "type": "color",
        "id": "timer",
        "label": "Timer",
        "default": "#CA192C",
        "visible_if": "{{ section.settings.cart-count }}"
      }, 
       {
        "type": "color",
        "id": "txtbg",
        "label": "Background",
        "default": "#fff",
        "visible_if": "{{ section.settings.cart-count }}"
      }, 
     {
        "type": "color",
        "id": "timer_border",
        "label": "Border",
        "default": "#eee",
        "visible_if": "{{ section.settings.cart-count }}"
      }, 
	  {
        "type": "header",
        "content": "Shipping rates calculator"
      },
	  {
        "type": "checkbox",
        "id": "shipCalc",
        "label": "Show shipping calculator",
        "default": false
      },
      {
        "type": "text",
        "id": "shipTtl",
        "label": "Heading text",
        "default": "Get Shipping Estimates",
        "visible_if": "{{ section.settings.shipCalc }}"
      },	
      {
        "type": "text",
        "id": "default_country",
        "label": "Default country selection",
        "default": "United States",
        "info": "If your customer is logged-in, the country in his default shipping address will be selected. If you are not sure about the  spelling to use here, refer to the first checkout page.",
        "visible_if": "{{ section.settings.shipCalc }}"
