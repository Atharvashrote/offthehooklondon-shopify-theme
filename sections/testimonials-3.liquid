{%- capture quotes -%}
{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
-%}
<svg style="position:absolute;width:0;height:0;" width="0" height="0" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <defs>
        <symbol id="icon-star1" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><polygon points="512,197.816 325.961,185.585 255.898,9.569 185.835,185.585 0,197.816 142.534,318.842 95.762,502.431 255.898,401.21 416.035,502.431 369.263,318.842"/></symbol>
        <symbol id="icon-star" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M512,197.819l-185.933-12.228L256,9.571l-70.067,176.021L0,197.82l142.658,120.93L95.856,502.429L256,401.214 l160.144,101.215l-46.8-183.671L512,197.819z M256,365.724l-112.464,71.08l32.827-128.831L75.829,222.888l130.971-8.603 L256,90.687l49.2,123.599l131.124,8.602l-100.689,85.077l32.829,128.839L256,365.724z"/></symbol>
    </defs>
</svg>
{%- if section_st.hpreset == 'custom-hd' or section_st.preset == 'custom-hd' -%}
    <style>
        {%- if section_st.hpreset == 'custom-hd' -%}
            #{{ section.id }} .rwhead { --fs:{{ section_st.hfs }}px;--fsm:{{ section_st.hfsm }}px;--ff:var(--{{ section_st.hff }});--fw:{{ section_st.hfw }};--lh:{{ section_st.hlh }}; }
        {%- endif -%}
        {%- if section_st.preset == 'custom-hd' -%}
            #{{ section.id }} .rwttl { --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }}; }
        {%- endif -%}
    </style>
{%- endif -%}
{%- capture style -%}
    --cl:{{ section_st.cl }};--gap:{{ section_st.gspace }}px;--gapm:0;--bg:{{ section_st.bbg }};--bpd:{{ section_st.bpd }}px;
    {%- if section_st.isratings -%}--rating:{{ section_st.icon_cl }};--icns:{{ section_st.icon_size }}px;{% endif %}
    {%- if section_st.tpreset == 'custom' -%}--fs:{{ section_st.tfs }}px;--fsm:{{ section_st.tfsm }}px;--ff:var(--{{ section_st.tff }});--fw:{{ section_st.tfw }};--lh:{{ section_st.tlh }};{%- endif -%}
{% endcapture %}
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %}" data-section-id="{{ section.id }}" data-section-style="quote{{ section_st.style }}">
        <div class="product-review inline-product">
            {%- capture testimonialdata -%}
                {% for block in section.blocks %}
                    {%-liquid
                        assign block_st = block.settings
                        assign sindex = forloop.index0
                        capture start_ratings
                            for i in (1..5)
                            assign num = forloop.index
                            if num <= block_st.rating
                                echo '<svg class="at-icon" style="enable-background:new 0 0 512 512;"><use xlink:href="#icon-star1"></use></svg>'
                            else
                                echo '<svg class="at-icon" style="enable-background:new 0 0 512 512;"><use xlink:href="#icon-star"></use></svg>'
                            endif
                            endfor
                        endcapture
                    -%}
                    <div class="fl f-col f-row-md w-100 gap fckSl{% if block_st.author_pic != blank %} apic{% endif %}{% if section_st.carousel %} swiper-slide{% endif %}" id="{{ block.id }}" data-slide="{{ sindex }}" {{ block.shopify_attributes }}>
                        <div class="product-review__image pr of-hidden{% if block_st.layout == 'right' %} order2-md{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %} style="--wd:{{ section_st.bnrwd }}%;--rounded:{{ section_st.rounded }}px">
                            {% if block_st.image != blank %}
                                {%- capture sizes -%}(min-width:1024px) calc({{ page_width }} / 2), 100vw{%- endcapture -%}
                                {{- block_st.image | image_url: width: block_st.image.width | image_tag: loading:'lazy', width:block_st.image.width, height:block_st.image.height, class:'img-auto m-auto', sizes:sizes, widths:"400,600,800,1000,1200,1500" -}}
                            {% else %}
                                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                            {% endif %}
                        </div>
                        <div class="product-review__content fl fl1 f-col {% render 'animate-data', css:true %}" {% render 'animate-data' %} style="--rating:{{ section_st.icon_cl }};--icns:{{ section_st.icon_size }}px;">
                            <div class="pr fl {{ section_st.alignment }} f-col product-review__text m-auto h-100">
                                {%- if section_st.title !=blank -%}<p class="head rwhead {{ section_st.hpreset }} mb15" style="--hdcl:{{ section_st.cl }};">{{ section_st.title }}</p>{%- endif -%}
                                {%- if section_st.isratings and section_st.rating == '1' -%}<p class="ratings mb15">{{ start_ratings }}</p>{%- endif -%}
                                {%- if block_st.title != blank -%}<div class="head {{ section_st.preset }} rwttl mb15">{{ block_st.title }}</div>{%- endif -%}
                                {%- if block_st.text != blank -%}<div class="{{ section_st.tpreset }} rte mb20 reg-text">{{ block_st.text }}</div>{%- endif -%}
                                {%- if section_st.isratings and section_st.rating == '2' -%}<p class="ratings mb15">{{ start_ratings }}</p>{%- endif -%}
                                
                                {%- if block_st.author != blank -%}<div class="small-font fw-600 mt10">{{ block_st.author }}</div>{%- endif -%}
                                {%- if block_st.author_bio != blank -%}<div class="small-font">{{ block_st.author_bio }}</div>{%- endif -%}

                                {%- if  block_st.product !=blank -%}
                                    <product-card class="review-product fl f-aic" style="--gap:20px;--border:{{ section_st.cl | color_lighten:70 }};">
                                        <div class="mini-products__img mr15">   
                                            <a class="grid-image" href="{{ block_st.product.url }}">
                                                {{- block_st.product.featured_image | image_url: width: block_st.product.featured_image.width | image_tag: loading:'lazy', class:'img-fit', sizes:'60px', widths:"80,140,200" -}}
                                            </a>
                                        </div>
                                        <div class="fl1 grid-meta t-left" style="--fs:14px;">
                                            <p class="mb5"><a href="{{ block_st.product.url }}" title="{{ block_st.product.title }}">{{ block_st.product.title }}</a></p>
                                            {%- unless settings.hide-price -%}<div class="grid-price">{% render 'product-price', product: block_st.product %}</div>{%- endunless -%}
                                        </div>
                                    </product-card>
                                {%- endif -%}
                            </div>
                            {%- if section_st.dot or section_st.dotm -%}
                              <div class="swiper-pagination m-auto mt15 swpg{{ section.id }} fl f-wrap{% unless section_st.dotm %} hide-sm{% endunless %}{% unless section_st.dot %} hide-md hide-lg{% endunless %}"></div>
                            {%- endif -%}
                        </div>
                    </div>
                {%- endfor -%}
            {%- endcapture -%}
            {%- if section.blocks.size > 0 -%}
                {%- if section_st.carousel -%}
                    <slide-section class="swiper" style="{{ style }}" data-swiper='{ "slidesPerView":1, "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                        <div class="swiper-wrapper h-auto">{{ testimonialdata }}</div>                       
                    </slide-section>
                {%- else -%}
                    <div class="fl f-col gap" style="{{ style }}"> {{ testimonialdata }}</div>
                {%- endif -%}
            {%- endif -%}
            {%- if section.blocks.size == 0 -%}{%- render 'no-blocks' -%}{%- endif -%}
        </div>
    </div>
</div>
{%- endcapture -%}
{{- quotes | strip_newlines | remove: '  ' | remove: '	' -}}
