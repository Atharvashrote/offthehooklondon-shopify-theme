{%- capture logobar -%}
{%- liquid 
    assign section_st = section.settings
-%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st: section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %} page-width{% endif %}" id="carousel-{{ section.id }}">
        {%- render 'sec-title' -%}		
        {%- if section.blocks.size > 0 -%}
            {% capture logo_data %}
              {% for block in section.blocks %}
                    <div class="gitem{% if section_st.carousel %} swiper-slide{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %} {{ block.shopify_attributes }}>                      
                      <div class="h-100 pr"> 
                          <a class="fl f-jcc f-aic {{ section_st.irounded }} of-hidden" {% if block.settings.link != blank %}href="{{  block.settings.link }}" {% if  block.settings.newtab %} target="_blank" {% endif %}{% else %}role="link" aria-disabled="true"{% endif %}>
                                {% if block.settings.image != blank %}
                                    {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading:'lazy', class:'img-auto', widths:'100,200,300,400,500' }}
                                {% else %}
                                    {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}{{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}  
                                {% endif %}
                                {%- if section_st.icon != 'none'-%}
                                    <span class="pa db tc anim img-icon round-full{% if section_st.show_icon == '2' %} visible{% endif %}" style="--icon-clr:{{ section_st.icon_cl }};--icon-bg:{{ section_st.icon_bg }}"> 
                                    {% if section_st.sicon != blank %}<img loading="lazy" class="at-icon" src="{{ section_st.sicon | image_url: width: '60' }}" width="18" height="18" alt="" />
                                      {% else %}
                                    {% render 'icons', icon: section_st.icon %} {% endif %}   
                                  </span> 
                                {%- endif -%} 
                            </a>  
                        </div>                      
                    </div>
                {% endfor %}
            {% endcapture %}

             {%- capture styles -%}
             --grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;
            {%- endcapture -%}
                              
            {%- if section_st.carousel -%}
                <slide-section class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} swiper" style="{{ styles }}"
                  data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                    <div class="swiper-wrapper h-auto">{{ logo_data }}</div>
                    {% render 'swiper-navigation', id:section.id, section_st:section_st %}
                </slide-section>
            {%- else -%}
                <div class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} f-jcc" style="{{ styles }}">{{ logo_data }}</div>
            {%- endif -%}
        {%- endif -%}
        {%- if section.blocks.size == 0 -%}{% render 'no-blocks' %}{%- endif -%}
    </div>
</div>
{%- endcapture -%}
{{- logobar | strip_newlines | remove: '  ' | remove: '	' -}}
