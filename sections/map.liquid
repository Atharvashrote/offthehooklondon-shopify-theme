{% assign section_st = section.settings %}
<div class="section-cover{% if section_st.hidem %} hide-sm{% endif %}{% if section_st.hided %} hide-md hide-lg{% endif %}" style="--sbg:{{ section_st.bg }};--sst:{{ section_st.sst }}px;--ssb:{{ section_st.ssb }}px;--sstm:{{ section_st.sstm }}px;--ssbm:{{ section_st.ssbm }}px">
  <div class="{% if section.settings.fullwidth %}fw-section npd{% else %}page-width{% endif %} {% render 'animate-data', css:true, text:true %}" id="{{ section.id }}" style="font-size:0;">
    {{- section.settings.gmap -}}
  </div>
</div>
{% schema %}
{
  "name": "Map",
  "class": "gMap",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "gmap",
      "label": "Google iframe code",
      "info": "[Guide to Embed map](https://support.google.com/maps/answer/144361?co=GENIE.Platform%3DDesktop&hl=en#). In the iframe code, set width = '100%' and height as needed."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },   
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Map",
      "category": "Contact"
    }
  ]
}
{% endschema %}