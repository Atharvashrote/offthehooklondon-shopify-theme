{% capture upsell_bundel %}
{%- liquid
    assign section_st = section.settings
    assign current_product = product
    assign meta_products = section_st.products | where: 'available', true
    assign fbt_products = current_product | concat: meta_products
    assign price = 0
    assign cm_price_total = 0
-%}
{% if meta_products != blank %}
{% style %}
    .sep-plus { min-width:22px; }
    .upsell-bundle__product-meta:not(.checked), .upsell-bundle__image.disable { opacity:0.3; }
    .upsell-bundle__products { overflow:auto; scrollbar-color:grey transparent; scrollbar-width: thin; }
    .upsell-bundle__product { width:150px; }  
    .upsell-bundle__image { background:#fff; padding:6px; border:1px solid #eee;} 
    .upsell-bundle__current-item { pointer-events:none; }
    .upsell-bundle__product-meta .price { color:{{ settings.grid_product_price_cl }}; }    
    .upsell-bundle__variant { padding:8px 30px 8px 15px; } 

    .upsell-bundle__label span.checkbox { width:25px; height:25px; }

    .upsell-bundle__total { border-radius:5px; margin-top:30px; margin-inline-start:40px; }
    .upsell-bundle__total-price { font-size:22px; color:{{settings.grid_product_price_sale}};} 
    .upsell-addcart { margin:0 auto; white-space:nowrap; }
   @media only screen and (max-width:990px){
      .upsell-bundle { flex-direction: column; margin:10px 0 0; }
      .upsell-bundle__total { text-align:center; margin:10px 0 0; background-color:#fff; padding:25px 30px 30px; border: 1px solid #eee; }
   }
{% endstyle %}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}" id="{{ section.id }}">
        <div class="section-header" style="--headings_cl:{{ section_st.headings_cl }};margin-lef:-10px;">
            {%- if section_st.subtitle != blank -%}<div class="section-header__subtitle">{{ section_st.subtitle }}</div>{%- endif -%}
            <{{ settings.section_title_tag }} class="section-header__title {{ settings.sechdft }}"><span class="dbi pr">{{ section_st.title }}</span></{{ settings.section_title_tag }}>            
            {%- if section.settings.text != blank -%}<div class="mb0">{{ section.settings.text }}</div>{%- endif -%}
        </div>
        <product-bundel>
            {%- assign product_form_id = 'product-upsell-' | append: section.id -%}
            {%- form 'product', product, id: product_form_id, class:'form', novalidate:'novalidate', data-type:'add-to-cart-form' -%}
                <div class="upsell-bundle fl">
                    <div class="upsell-bundle__products-column">
                        <div class="upsell-bundle__products">
                          <div class="fl f-aic gap" style="--gap:5px;">
                              {% for product in fbt_products %}
                                  {%- assign current_variant = product.selected_or_first_available_variant -%}
                                    <div class="upsell-bundle__product {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
                                        <a class="grid-image" href="{{ product.url }}" title="{{ product.title }}">
                                            {% assign img_id = 'img' | append: product.id %}
                                            {{ product.featured_image | image_url: width: 250 | image_tag: loading:'lazy', class:'img-fit upsell-bundle__image', id:img_id }}
                                        </a>
                                    </div>
                                    {% unless forloop.last %}<svg class="at-icon sep-plus" style="--icns:12px;"><use xlink:href="#icon-plus"></use></svg>{% endunless %}
                              {% endfor %}
                          </div>
                        </div>
                        <div class="w-100 mt25 mb0-md {% render 'animate-data', css:true, text:true %}">
                            {%- for product in fbt_products -%}
                                {%- liquid
                                    assign current_variant = product.selected_or_first_available_variant
                                    assign index = forloop.index
                                    assign rg_price = current_variant.price
                                    assign price = price | plus:rg_price
                                    assign cm_price = current_variant.compare_at_price | default: current_variant.price
                                    assign cm_price_total = cm_price_total | plus: cm_price
                                    assign is_variants = product.variants | where: 'available', true
                                -%}
                                <div class="upsell-bundle__product-meta fl f-wrap f-aic gap mb15 checked" style="--gap:10px;">
                                    <label class="fl upsell-bundle__label cpointer mb0{% if current_product == product %} upsell-bundle__current-item{% endif %}">
                                        <input type="checkbox" id="fbtCk{{ index }}" class="custCheck fbtCheck" checked="checked"><span class="checkbox m0"></span>
                                    </label>
                                    {% if current_product == product %}
                                        <span><b>{{ 'products.upsell.this_item' | t }}:</b> {{ product.title }}</span>
                                    {% else %}
                                        <a href="{{ product.url }}" title="{{ product.title }}">{{ product.title }}</a>
                                    {% endif %}
                                    <div class="fl">
                                        <div>
                                            <label class="hidden_txt" for="PrSelect-{{ product.id }}">Select Variant</label>
                                            <select name="items[][id]" id="PrSelect-{{ product.id }}" 
                                                class="w-100 mb0 upsell-bundle__variant{% if product.variants[0].title == 'Default Title' or is_variants == blank %} hide{% endif %}{% unless current_variant.available %} disable{% endunless %}"
                                                data-id="img{{ product.id }}">
                                                {%- for variant in product.variants -%}
                                                    {%- if variant.available -%}
                                                        <option{% if variant == current_variant %} selected="selected"{% endif %} value="{{ variant.id }}" 
                                                        {%- if variant.image -%}data-img="{{ variant.image | image_url: width: '250' }}"{% endif %}
                                                        data-price="{{ variant.price }}"
                                                        data-cmprice="{{ variant.compare_at_price | default: variant.price }}">{{ variant.title }}</option>
                                                    {%- endif -%}
                                                {%- endfor -%}
                                            </select>
                                        </div>
                                        <div class="fl f-aic ml10">
                                            <span class="price fw-600 mr5 fs15">{{ current_variant.price | money }}</span>
                                            <s class="cmprice{% if current_variant.compare_at_price < current_variant.price %} hide{% endif %}">{{ current_variant.compare_at_price | money }}</s>
                                        </div>
                                    </div>
                                </div>
                            {%- endfor -%}
                        </div>
                    </div>
                    <div class="upsell-bundle__total fl f-col {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
                            <div class="mb20">
                              <span class="fw-600 db text-upper fs15">{{ 'products.upsell.total' | t }}:</span> 
                              <div class="fl f-aic">  
                                <span class="fw-500 upsell-bundle__total-price mr5">{{ price | money }}</span>
                                <s class="upsell-bundle__old-price fs15">{{ cm_price_total | money }}</s>
                              </div>
                            </div>
                            <div class="pform-error-wrap errors" role="alert" hidden>{{ 'icon-error.svg' | inline_asset_content }} <span class="ml5 pform-error-msg"></span></div>
                            <button type="submit" name="add" id="AddToCart-{{ section.id }}" class="btn upsell-addcart">
                                <span class="txt">{{ 'products.upsell.button' | t }}</span>
                                <div class="loading-overlay__spinner hidden"><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg></div>
                            </button>
                        </div>
                </div>
            {%- endform -%}
        </product-bundel>
    </div>
</div>
<script src="{{ 'upsell-bundle.js' | asset_url }}" defer="defer"></script>
{% endif %}
{% endcapture %}
{{ upsell_bundel | strip_newlines | remove: '  ' | remove: '	' }}
{% schema %}
{
  "name": "Upsell product bundle",
  "class": "upsell-product-bundle",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Follow steps from given [article](https://www.adornthemes.com/knowledge-base/guide-to-setting-up-upsell-products-bundle/) to show Upsell product bundle"
    },
    {
      "type": "header",
      "content": "Section header"
    },
     {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Subheading"
    },
     {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
     {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Shows related products customers often buy together, making shopping easier and boosting sales.</p> "
    },         
    {
      "id": "products",
      "type": "product_list",
      "label": "Products"
    },
   {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },    
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },    
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Upsell Product Bundle"
    }
  ]
}
{% endschema %}