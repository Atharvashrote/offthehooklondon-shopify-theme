{% assign section_st = section.settings %}
{%- capture store_features -%}
{%- capture style -%}
    --grsp:{{ section_st.col-gap | divided_by: 2.0 }}px;--grspm:{{ section_st.row-gap | divided_by: 2.0 }}px;--cl:{{section_st.cl }};
    {%- if section_st.showicn -%}--icns:{{ section_st.icns }}px;--icnsm:{{ section_st.icnsm }}px;--icncl:{{ section_st.icn_cl }};{%- endif -%}
    {%- if section_st.box -%}--box_bg:{{ section_st.boxbg }};--border:{{ section_st.bdr }};--border_hover:{{ section_st.bdr | color_darken:5 }};{%- endif -%}
{%- endcapture -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}"  data-section-id="{{ section.id }}">   
        {%- render 'sec-title' -%}

        {%- capture data %}
            {%- for block in section.blocks limit: section.blocks.size -%}
                {%- assign block_st = block.settings -%}
                <div class="gitem{% if section_st.carousel %} swiper-slide{% endif %} reg-text{% if section_st.style == 'stl1' %} tc{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %} {{ block.shopify_attributes }}>
                    <a {% if block_st.url != blank %}href="{{ block_st.url }}"{% else %}role="link" aria-disabled="true"{% endif %} class="db {{ section_st.rounded }}{% if section_st.box %} at-box pd30{% endif %}{% if section_st.style != 'stl1' %} fl f-jcc f-aic{% endif %}">
                        {%- if section_st.showicn -%}
                        <div class="at-box__icons{% if section_st.style == 'stl1' %} mb15{% else %} mr10{% endif %}">
                            {%- if block_st.icon == 'custom' and block_st.image != blank -%}
                                {%- liquid
                                   assign img_alt = block_st.image.alt | default: block_st.title | escape
                                   assign icon_class = 'at-icon'
                                   if block_st.image.src contains '.svg'
                                    assign icon_class = 'at-icon svg-icon'
                                   endif
                                -%}
                                {%- capture icnsizes -%}((min-width:1024px) {{ section_st.icns }}px, {{ section_st.icnsm }}px{%- endcapture -%}
                                {%- capture widths -%}{{ section_st.icns }}, {{ section_st.icns | times: 1.5 | round }}, {{ section_st.icns | times: 2 }}{%- endcapture -%}
                                {{ block_st.image | image_url: width:block_st.image.width | image_tag: loading:'lazy', width:section_st.icns, height:section_st.icns, class:icon_class, sizes:icnsizes, widths:widths, alt: img_alt }}
                            {%- else -%}
                                {%- render 'icons', icon: block_st.icon -%}
                            {%- endif -%}
                        </div>
                        {%- endif -%}
                        <div class="fl1{% if block_st.hide_br %} hide_br{% endif %}">
                            {%- if block_st.title != blank -%}<{{ section_st.htag }} class="head {{ section_st.preset_ttl }}{% if section_st.style == 'stl1' %} mb5{% else %} mb0{% endif %}" style="{%- if section_st.preset_ttl == 'custom-hd' -%}--ff:var(--{{ section_st.ttl_ff }});--fs:{{ section_st.ttl_fs }}px;--fsm:{{ section_st.ttl_fsm }}px;--lh:{{ section_st.ttl_lh }};--fw:{{ section_st.ttl_fw }};{% endif %}">{{ block_st.title }}</{{ section_st.htag }}>{%- endif -%}
                            {%- if section_st.style != 'stl3' and block_st.textsub != blank %}<div class="reg-text {{ section_st.preset_text }}" style="{%- if section_st.preset_text == 'custom' -%}--fs:{{ section_st.text_fs }}px;--fsm:{{ section_st.text_fsm }}px;--lh:{{ section_st.text_lh }};--fw:{{ section_st.text_fw }};{% endif %}">{{ block_st.textsub }}</div>{% endif %}
                        </div>
                    </a>
                </div>
            {%- endfor -%}
        {%- endcapture -%}

        {%- if section_st.carousel -%}
            <slide-section class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} swiper {{ section_st.style }}" style="{{ style }}"
                data-swiper='{ "slidesPerView":"auto", "loop":false, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                <div class="swiper-wrapper">{{ data }}</div>
                {%- render 'swiper-navigation', id:section.id, section_st:section_st -%}
            </slide-section>
        {%- else -%}
            <div class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} {{ section_st.style }}" style="{{ style }}">
               {{- data -}}
            </div>
        {%- endif -%}

        {%- if section.blocks.size == 0 -%}{%- render 'no-blocks' -%}{%- endif -%}
    </div>
</div>
{%- endcapture -%}
{{- store_features | strip_newlines | remove: '	' -}}
