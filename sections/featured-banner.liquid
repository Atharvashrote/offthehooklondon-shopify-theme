{%- liquid
  assign section_st = section.settings
  assign page_width = settings.cntwd | append: 'px'
  if section_st.sw
    assign page_width = '100vw'
  endif
-%}
{%- capture info_banner -%}  
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st: section_st, bgimage: true %}>
        <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %}">
            <div class="image-text__row fl f-aist f-jcsb w-100 row-{{ section.id }} f-col f-row-md of-hidden{% if section_st.npd == false or section_st.fullwidth == false %} {{ section_st.rounded }}{% endif %}"  style="--bg:{% if section_st.tbgg != blank %}{{ section_st.tbgg }}{% else %}{{ section_st.tbg }}{% endif %};--mwd:{{ section_st.image.width }}px;">				
				<div class="fl fl1 f-aic jcc tc{% if section_st.layout == 'right' %} order2-md{% endif %} w-100 of-hidden {{ section_st.irounded }} {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
                    {% if section_st.image != blank %}
                        {%- capture sizes -%} (min-width:1024px) calc({{ page_width }} / 2),(min-width:768px) calc(100vw / 2), calc(100vw - 30px){%- endcapture -%}
                        {% if section_st.link != blank %}<a class="db w-100" href="{{ section_st.link }}">{% endif %}
                            {{ section_st.image | image_url: width: section_st.image.width | image_tag: loading:'lazy', width:section_st.image.width, height:section_st.image.height, class:'h-auto', sizes:sizes, widths:"1500,1200,900,740,560,400" }}
                        {% if section_st.link != blank %}</a>{% endif %}
                    {% else %}
                        {{ 'blog-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                </div>				
                <div class="image-text__content fl fl1 of-hidden w-100 {{ section_st.talignv }}" style="--cl:{{ section_st.cl }};--text-width:70ch;">
                     <div class="image-text__content-inner {{ section_st.talign }}{% if section_st.txtpd %} nobg{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
						
                        {% if section_st.title != blank %}
                            <h3 class="head {{ section_st.preset }} mb15" style="{%- if section_st.preset == 'custom-hd' -%}--fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }};--ls:{{ section_st.ls }}px;{%- endif -%}">{{ section_st.title }}</h3>
                        {% endif %}
                        {% if section_st.text != blank %}
                            <div class="reg-text rte mb30" style="{%- if section_st.tpreset == 'custom' -%}--fs:{{ section_st.tfs }}px;--fsm:{{ section_st.tfsm }}px;--fw:{{ section_st.tfw }};--lh:{{ section_st.tlh }};{%- endif -%}">{{ section_st.text }}</div>
                        {% endif %}

                        {% if section.blocks.size > 0 %}
                        <ul class="grid {{ section_st.style }} rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }}{% if section_st.talign == 'tc' %} tc{% endif %}"  {%- if section_st.showicn -%} style="--icns:{{ section_st.icns }}px;--icnsm:{{ section_st.icnsm }}px;--icncl:{{ section_st.icn_cl }};"{%- endif -%}>
                            {% for block in section.blocks limit: section.blocks.size %}
                                {%- assign block_st = block.settings -%}
                                <li class="reg-text gitem mb25" {{ block.shopify_attributes }} >
                                    <div class="{% if section_st.style == 'stl2' %} fl{% elsif section_st.style == 'stl3'%} fl f-aic{% endif %}">                                          
                                        {% if section_st.showicn %}
                                        <div class="at-box__icons{% if section_st.style == 'stl1' %} mb15{% else %} mr15{% endif %}{% if section_st.style == 'stl2' %} mt4{% endif %}">
                                          {%- if block_st.icon == 'custom' and block_st.image != blank -%}
                                                {% assign img_alt = block_st.image.alt | default: block_st.title | escape %}
                                                {% capture icnsizes %}((min-width:1024px) {{ section_st.icns }}px, {{ section_st.icnsm }}px{% endcapture %}
                                                {% capture widths %}{{ section_st.icns }}, {{ section_st.icns | times: 1.5 | round }}, {{ section_st.icns | times: 2 }}{% endcapture %}
                                                {{ block_st.image | image_url: width:block_st.image.width | image_tag: loading:'lazy', width:section_st.icns, height:section_st.icns, class:'img-fill svg-icon', sizes:icnsizes, widths:widths, alt: img_alt }}
                                            {%- else -%}
                                                {% render 'icons', icon: block_st.icon %}                                                                                                     
                                            {%- endif -%}
                                        </div>
                                        {% endif %}                                                                                                        
                                        <div class="fl1">
                                            {% if block_st.title %}<div class="head {{ section_st.preset_ttl }} mb5" style="{%- if section_st.preset_ttl == 'custom-hd' -%}--ff:var(--{{ section_st.ttl_ff }});--fs:{{ section_st.ttl_fs }}px;--fsm:{{ section_st.ttl_fsm }}px;--lh:{{ section_st.ttl_lh }};--fw:{{ section_st.ttl_fw }};{% endif %}">{{ block_st.title }}</div>{% endif %}
                                            {% if section_st.style != 'stl3' and block_st.text != blank %}<div class="reg-text {{ section_st.preset_text }}" style="{%- if section_st.preset_text == 'custom' -%}--fs:{{ section_st.text_fs }}px;--fsm:{{ section_st.text_fsm }}px;--lh:{{ section_st.text_lh }};--fw:{{ section_st.text_fw }};{% endif %}">{{ block_st.text }}</div>{% endif %}
                                        </div>                              
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                        <br />
						{% endif %}
                        {% if section_st.btn != blank and section_st.link != blank %}
                            <a href="{{ section_st.link }}" class="btn {{ section_st.btn-size }} {{ section_st.btn-style }}">{{ section_st.btn }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
</div>
{%- endcapture -%}
{{ info_banner | strip_newlines | remove: '  ' | remove: '	' }}
{% schema %}
{
  "name": "Featured banner",
  "class": "featured-banner",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "irounded",
      "label": "Corner radius",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "round-xs",
          "label": "Extra small"
        },
        {
          "value": "round-sm",
          "label": "Small"
        },
        {
          "value": "round-md",
          "label": "Medium"
        },
        {
          "value": "round-lg",
          "label": "Large"
        },
        {
          "value": "round-full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "color",
      "id": "tbg",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color_background",
      "id": "tbgg",
      "label": "Background gradient"
    },
    {
      "type": "select",
      "id": "talign",
      "label": "Text alignment",
      "default": "tl",
      "options": [
        { "value": "tl", "label": "Left" },
        { "value": "tc", "label": "Center" },
        { "value": "tr", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "talignv",
      "label": "Text position",
      "default": "f-aic",
      "options": [
        { "value": "f-ais", "label": "Top" },
        { "value": "f-aic", "label": "Middle" },
        { "value": "f-aie", "label": "Bottom" }
      ]
    },   
    {
      "type": "checkbox",
      "id": "txtpd",
      "label": "Remove text padding on mobile",
      "info": "Text left and right space for mobile view",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "----------------------------------------------"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Story, Our Promise"
    },
    {
      "type": "select",
      "id": "preset",
