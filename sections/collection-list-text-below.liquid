{%- capture collection_list -%}
{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
    for block in section.blocks
        assign block_st = block.settings
         
        assign collection = collections[block_st.collection]
        assign collection_image = block_st.image | default:collection.image | default: collection.products.first.featured_image

        assign img_ratio = 100
        if section_st.ratio == 'img' and collection_image
            assign img_ratio = 1 | divided_by: collection_image.aspect_ratio | times: 100
            break
        elsif section_st.ratio != 'img'
            assign img_ratio = section_st.ratio
        endif
    endfor
-%}
{%- capture listclass -%}
    {% if section_st.style == '1' %} pa zi1 tc {{section_st.text_position}} {{ section_st.rounded }}{% endif %}
    {% if section_st.style == '2' %} w-100 t-{{section_st.align}}{% endif %}
    {% if section_st.style == '3' %} pa zi1 w-100 bottom-0 {{ section_st.text_align}}{% endif %}
{%- endcapture -%}
{%- capture sizes -%}
  (min-width:1024px) calc({{ page_width }} / {{ section_st.grid }}),(min-width:768px) calc(100vw / {{ section_st.gridtb }}), calc(100vw / {{ section_st.gridmb }})
{%- endcapture -%}
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}--ratio:{{ img_ratio | default:100 }}%" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %} collection-list collection-list-below collection-list{{ section_st.style }} pr zi1" data-section-id="{{ section.id }}">   	
        {%- render 'sec-title' -%}
        {%- capture collection_data -%}
          {%- for block in section.blocks -%}     
                {%- liquid
                  assign block_st = block.settings                   
                  assign collection = collections[block_st.collection]
                  assign collection_image = block_st.image | default:collection.image | default: collection.products.first.featured_image
                  assign img_alt = collection_image.alt | default: block_st.title | default: collection.title
                  assign count = collection.all_products_count                
                -%}
                
                <div class="gitem{% if section_st.carousel %} swiper-slide{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %} {{ block.shopify_attributes }}>
                    <a href="{{ block_st.url | default:collection.url }}" class="db pr of-hidden{% if section_st.style == '2' %} {{ section_st.rounded }}{% else %} {{ section_st.irounded }}{% endif %}{% if section_st.zoom %} zoom-hov{% endif %}{% if section_st.cardstyle %} gcard {{ section_st.cardradius }}{% endif %}{% if section_st.hover_border %} hover-corner{% endif %}" title="{{ block_st.title }}">                    
                      <div class="img pr of-hidden overlay {{ section_st.ovr-direction }}{% if section_st.style == '2' %} {{ section_st.irounded }}{% endif %}">
                        {%- if collection_image != blank -%}
                          {{ collection_image | image_url: width: collection_image.width | image_tag: loading:'lazy', class:'img-fit', alt: img_alt, sizes:sizes, widths:"180,320,400,560,740,900,1200" }}
                        {%- else -%}
                          {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}{{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg img-fit' }}
                        {%- endif -%}
                      </div>
                      <div class="collection-details anim{{ listclass }}">
                      {% if block_st.title != blank %}<div class="head {{ section_st.preset }}">{{ block_st.title }}</div>{% endif %}
                      {% if block_st.text != blank %}<div class="reg-text {{ section_st.preset_text }} mt5 {{ section_st.ff_text }}">{{ block_st.text }}</div>{% endif %}
                      {% if section_st.count and count != blank %}<span class="fs13 db op-9 mt5">{{ 'collections.general.items_with_count' | t: count: count }}</span>{% endif %}                                      
                      {% if block_st.button_label != blank %}<button class="btn {{ section_st.btn-style }} {{ section_st.btn-size-desk }} mt20" href="{{ block_st.url }}">{{- block_st.button_label -}}</button>{% endif %}     
                    </div>
                    </a>
                </div>
            {%- endfor -%}
            {%- if section.blocks.size == 0 -%}{%- render 'no-blocks' -%}{%- endif -%}
        {%- endcapture -%}
         <style>
          {%- if section_st.preset == 'custom-hd' -%}
          #{{ section.id }} .head { --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }};--ls:{{ section_st.ls }}px; }
          {%- endif -%}
          </style>
        {%- capture styles -%}
          --grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;
          --hdcl:{{ section_st.cl }};--cl:{{ section_st.cl }};        
          {%- if section_st.preset_text == 'custom' -%}
           --fs:{{ section_st.fs_text }}px;--fsm:{{ section_st.fsm_text }}px;--lh:{{ section_st.lh_text }};--fw:{{ section_st.fw_text }};
          {%- endif -%}
          {%- if section_st.style != '3' -%} --bg:{{ section_st.tbg }};{% endif %} --overlay:{{ section_st.img_overlay }};--overlay-down:{{ section_st.img_overlay | color_to_hex }}00; 
          --text_padding:{{ section_st.text_padding }}px;--text_padding_y:{{ section_st.text_padding_tb }}px; {% if section_st.style == '1' %}--text_margin:{{section_st.text_margin}}px;--text_margin_mobile:{{section_st.text_margin_mobile}}px; {%  endif %}
          --img-bdr-w:{% if section_st.img_border %}{{ section_st.img_border_width }}px{% else %}0px{% endif %};--img-bdr-cl:{{ section_st.img_border_cl }};
          {%- if section_st.cardstyle -%}--cardbg:{{ section_st.cardbg }};--cardpd:{{ section_st.cardpd }}px;--cardbdr:{% if section_st.cardborder %}1px solid {{ section_st.cardbordercl }}{% else %}0{% endif %};{%- endif -%}
          {%- if section_st.hover_border -%}--hbdr-w:{{ section_st.hover_border_width }}px;--hbdr-cl:{{ section_st.hover_border_cl }};{%- endif -%}
        {%- endcapture -%}
        {%- if section_st.carousel -%}
            <slide-section class="grid gspace collection-grid swiper rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }}" style="{{ styles }}"
              data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                <div class="swiper-wrapper">{{ collection_data }}</div>
                {%- render 'swiper-navigation', id:section.id, section_st:section_st -%}
            </slide-section>
        {%- else -%}
            <div class="grid gspace collection-grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }}" style="{{ styles }}">
                {{- collection_data -}}
            </div>
        {%- endif -%}
    </div>
</div>
{%- endcapture -%}
{{- collection_list | strip_newlines | remove: '  ' | remove: '	' -}}
