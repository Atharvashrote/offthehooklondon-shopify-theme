{%- capture muticolumn -%}
{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
-%}
{%- capture sizes -%}
  (min-width:1024px) calc(({{ page_width }} - {{ section_st.gspace | times: section_st.grid | minus:section_st.gspace }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ section_st.gspace | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ section_st.gspacem | times: section_st.gridmb | minus:section_st.gspacem }}px) / {{ section_st.gridmb }})
{%- endcapture -%}
{%- if section_st.preset == 'custom-hd' -%}
<style>#{{ section.id }} .head { --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }}; }</style>
{%- endif -%}
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %}">
        {%- render 'sec-title' -%}
            {%- capture collection_data -%}
            {%- for block in section.blocks -%}
                {%- assign block_st = block.settings -%}
                <div class="gitem{% if section_st.carousel %} swiper-slide{% endif %} {{ section_st.align }} {% render 'animate-data', css:true %}" {% render 'animate-data' %} style="--bg:{{ section_st.text_bg }};--cl:{{ section_st.tcl }};">
                    <div class="of-hidden {{ section_st.rounded }}">
                        {% if section_st.show_img %}
                            {%- if block_st.image != blank -%}
                                {% if block_st.link != blank %}<a href="{{ block_st.link }}" class="top-img">{% endif %}
                                {{ block_st.image | image_url: width: block_st.image.width | image_tag: loading:'lazy', class:'img-auto', sizes:sizes, widths:"180,320,400,560,740,900,1200" }}
                                {% if block_st.link != blank %}</a>{% endif %}
                            {%- else -%}
                                <div class="img-wrapper">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                            {%- endif -%}
                        {% endif %}
                        <div class="txt-wrapper{% if section_st.add_bg %} bg{% endif %}">
                            {% if block_st.title != blank %}
                                <{{ section_st.htag }} class="head {{ section_st.preset }} mb5" style="--cl:{{ section_st.tcl }};">
                                    {% if block_st.link != blank %}<a href="{{ block_st.link }}">{% endif %}{{ block_st.title }}{% if block_st.link != blank %}</a>{% endif %}                                                                          
                                </{{ section_st.htag }}>
                            {% endif %}
                            {% if block_st.text != blank %}<div class="rte mb20 reg-text" style="--cl:{{ section_st.cl }};">{{ block_st.text }}</div>{% endif %}
                            {% if block_st.btn != blank and block_st.link != blank %}
                                <a href="{{ block_st.link }}" class="btn {{ section_st.btn-size }} {{ section_st.btn-style }}">{{ block_st.btn }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {%- endfor -%}
          {%- endcapture -%}
          {%- capture styles -%}
          --grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;{%- if section_st.tpreset == 'custom' -%}--fs:{{ section_st.tfs }}px;--fsm:{{ section_st.tfsm }}px;--ff:var(--{{ section_st.tff }});--fw:{{ section_st.tfw }};--lh:{{ section_st.tlh }};{%- endif -%}
          {%- endcapture -%}
          {%- if section_st.carousel -%}                 
              <slide-section class="grid gspace swiper rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }}" style="{{ styles }}"
                data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                  <div class="swiper-wrapper">{{ collection_data }}</div>
                  {%- render 'swiper-navigation', id:section.id, section_st:section_st -%}
              </slide-section>
          {%- else -%}
              <div class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }}" style="{{ styles }}">
                  {{- collection_data -}}
              </div>
          {%- endif -%}
          {%- if section.blocks.size == 0 -%}{% render 'no-blocks' %}{%- endif -%}
    </div>
</div>
{%- endcapture -%}
{{- muticolumn | strip_newlines | remove: '  ' | remove: '	' -}}
{% schema %}
{
  "name": "Multicolumn",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
     {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Multicolumn"
    }, 
     {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Highlight the best collections or describe inspiration, promotions.</p> "
