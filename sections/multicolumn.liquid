    {
      "type": "header",
      "content": "Grid appearance"
    },     
    {
      "type": "range",
      "id": "gspace",
      "label": "Grid gap",
      "default": 30,
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gspacem",
      "label": "Grid gap (mobile)",
      "default": 15,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px"
    },   
    {
      "type": "range",
      "id": "grid",
      "label": "Columns (desktop)",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridtb",
       "label": "Columns   (tablet)",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridmb",
      "label": "Columns (mobile)",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1
    },      
    {
      "type": "select",
      "id": "rounded",
      "label": "Corner radius",
