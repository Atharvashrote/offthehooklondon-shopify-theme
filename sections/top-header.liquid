{%- capture site_top_header -%}
{%- assign section_st = section.settings -%}
{%- if section.blocks.size > 0 -%}
<div class="section-cover border-bottom zi2 {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}--sbg:{% if section_st.bgg != blank %}{{ section_st.bgg }}{% else %}{{ section_st.bg }}{% endif %};--cl:{{ section_st.cl }};--clh:{{ section_st.clh }};--fs:{{ section_st.fs }}px;--fsm:{{ section_st.fs }}px;--fw:{{ section_st.fw }};--lh:1.2;--icns:{{ section_st.icns}}px;--border:{{ section_st.bottom_border }};--gap:10px;--gapm:7px;">
    <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %} reg-text gap pr fl f-col f-row-md f-aic{% if section_st.tu %} text-upper{% endif %}">
        {%- for block in section.blocks limit: section.blocks.size -%}
            {%- assign block_st = block.settings -%}
            {%- if block.type == 'menu' -%}
                <div class="tmenu fl1 f-aic {{ block_st.al }}{% if block_st.hdm %} hide-sm hide-md{% endif %}">
                    {%- for link in linklists[block_st.menu].links -%}
                        <a href="{{ link.url }}">{{ link.title }}</a>{% unless forloop.last %}<span></span>{% endunless %}
                    {%- endfor -%}
                </div>
            {%- elsif block.type == 'text' and block_st.txt != blank -%}
                <div class="ttxt fl1 {{ block_st.al }} fl f-aic{% if block_st.hdm %} hide-sm hide-md{% endif %} gap f-wrap" style="--gap:15px;--gapm:8px;">
                    {%- liquid 
                        assign tag = 'p'
                        assign href = ''
                        assign tag2 = 'p'
                        assign href2 = ''
                        if block_st.url1 != blank
                          assign tag = 'a'
                          assign href = 'href="' | append: block_st.url1 | append: '"'
                        endif
                        if block_st.url2 != blank
                          assign tag2 = 'a'
                          assign href2 = 'href="' | append: block_st.url2 | append: '"'
                        endif
                    -%}
                       {% if block_st.txt != blank %} <{{ tag }} {{ href }}{% if block_st.newtab1 %} target="_blank"{% endif %} class="fl f-aic m0 gap" style="gap:5px;">
                        {% if block_st.image != blank %}<img loading="lazy" class="at-icon" src="{{ block_st.image | image_url: width: '60' }}" width="18" height="18" alt="" />{% else %}{% render 'icons', icon: block_st.icon %} {% endif %}                                                                                         
                        {{ block_st.txt }}
                       </{{ tag }}>
                     {%- endif -%}
                     {% if block_st.txt1 != blank %}<{{ tag2 }} {{ href2 }}{% if block_st.newtab2 %} target="_blank"{% endif %} class="fl f-aic gap" style="gap:5px;"> 
                       {% if block_st.image1 != blank %}<img loading="lazy" class="at-icon" src="{{ block_st.image1 | image_url: width: '60' }}" width="18" height="18" alt="" />{% else %}{% render 'icons', icon: block_st.icon2 %}{% endif %}                                                                                        
                       {{ block_st.txt1 }}</{{ tag2 }}>
                     {%- endif -%}
                </div>
            {%- elsif block.type == 'sc' -%}
                <div class="fl fl1 {{ block_st.al }}{% if block_st.hdm %} hide-sm hide-md{% endif %} gap" style="gap:15px;">
                    {% render 'social-media' %}
                </div>
            {%- elsif block.type == 'cl' -%}
                <div class="tcrlg fl1 {{ block_st.al }} fl f-aic gap{% if block_st.hdm %} hide-sm hide-md{% endif %}" style="gap:20px;">
                    {%- if block_st.menu != blank -%}
                        <div class="tmenu f-aic">{% for link in linklists[block_st.menu].links %}<a href="{{ link.url }}">{{ link.title }}</a>{% unless forloop.last %}<span></span>{% endunless %}{% endfor %}</div>
                        <span class="dbi devider"></span>
                    {%- endif -%}
                      {%- if block_st.sc -%}<ul class="fl f-wrap social-icons gap" style="--gap:10px;">{% render 'social-media' %}</ul>{%- endif -%}
                    {%- if block_st.txt != blank -%}<div class="txt">{{ block_st.txt }}</div><span class="dbi hide-sm hide-md devider"></span>{%- endif -%}
                    {% if settings.mlcurrency or settings.mlLang %}{% render 'currencyLang' %}{% endif %}
                </div>
            {%- endif -%}
        {%- endfor -%}
    </div>
</div>
{%- endif -%}
{%- endcapture -%}
{{- site_top_header | strip_newlines | remove: '	' | replace: "  "," " | replace: "  "," " -}}
