<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %} pr zi1" data-section-id="{{ section.id }}">
        <div class="fl w-100 of-hidden marquee-wrap{% if section_st.spause %} pause-hover{% endif %}{% if section_st.fade %} fade-edge{% endif %}" style="--cl:{{ section_st.cl }};--fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--fw:{{ section_st.fw }};--text-speed:{{ section_st.speed }}s;--text-speedm:{{ section_st.speedm }}s;--grsp:{{ section_st.space }}px;--icns:{{ section_st.icon-size }}px;--icnsm:{{ section_st.icon-sizem }}px;--fadew:{{ section_st.fadew }}px;">
            {%- for i in (0..5) -%}
            <div class="fl f-aic f-jcc marquee reg-text{% if section_st.sdir == 'right' %} reverse{% endif %}">
                {%- for block in section.blocks -%}
                <div class="fl f-aic tc marquee-text {{ section_st.ff }}{% if block.settings.outline %} outline{% endif %}">
                    {%- if block.settings.icon != 'none' %}
                        {%- if block.settings.image != blank and block.settings.icon == 'custom'-%}
                        {% assign img_alt = block.settings.image.alt %}
                            <div class="img of-hidden {{ block.settings.rounded }}" style="--width:{{section_st.icon-size}}px;--width-mob:{{section_st.icon-sizem}}px;">
                            {{ block.settings.image | image_url: width:block.settings.image.width | image_tag: loading:'lazy', class:'img-auto', alt:img_alt, sizes:'300px', widths:'50,100,150,200,300' }}
                            </div>                       
                        {%- else -%}
                            {%- render 'icons', icon: block.settings.icon -%}
                        {%- endif -%}
                    {%- endif -%}
                    <span>{{ block.settings.text }}</span>
                    {%- if section_st.icon != 'none' -%}<svg class="at-icon" style="--icns:{{ section_st.icns }}px;--icnsm:{{ section_st.icns }}px;"><use xlink:href="#seprat-icon"></use></svg>{%- endif -%}
                    </div>
                {%- endfor -%}
            </div>
            {%- endfor -%}
        </div>
    </div>
</div>
{%- endcapture -%}
{{- textline | strip_newlines | remove: '  ' | remove: '	' -}}
{% schema %}
{
  "name": "Scrolling content",
  "class": "scrolTxt",
  "disabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text appearance"
    },
    {
      "type": "select",
      "id": "ff",
      "label": "Font",
      "default": "ft1",
      "options": [
        {
          "value": "ft1",
          "label": "Body font"
        },
        {
          "value": "ft2",
          "label": "Heading font"
        },
        {
          "value": "ft3",
          "label": "Accent font"
        }
      ]
    },
    {
      "type": "range",
      "id": "fs",
      "label": "Font size",
      "default": 30,
      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "fsm",
      "label": "Font size (mobile)",
      "default": 20,
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "fw",
      "label": "Font weight",
      "default": "500",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "cl",
      "label": "Color",
      "default": "#000"
    },
    {
      "type": "range",
      "id": "space",
      "label": "Text gap",
      "default": 35,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Text divider",
      "default": "sparkle",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "sparkle",
          "label": "Sparkle"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "flower",
          "label": "Flower"
        }
      ]
    },
    {
      "type": "range",
      "id": "icns",
      "label": "Icon size (divider)",
      "default": 16,
      "min": 10,
      "max": 50,
      "step": 1,
      "visible_if": "{{ section.settings.icon != 'none' }}"
    },
     {
          "type": "range",
          "id": "icon-size",
          "min": 20,
          "max": 300,
          "step": 5,
          "label": "Icon size (block)",
          "default": 35,
          "unit": "px"         
    }, 
    {
          "type": "range",
          "id": "icon-sizem",
          "min": 20,
          "max": 200,
          "step": 5,
          "label": "Icon size (block)",
          "info":"mobile",
          "default": 35,
          "unit": "px"         
    },          
    {
      "type": "header",
      "content": "Scrolling"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "default": 20,
      "min": 5,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "speedm",
      "label": "Speed (mobile)",
      "default": 15,
      "min": 5,
      "max": 100,
      "step": 1
    },
    {
      "type": "select",
      "id": "sdir",
      "label": "Direction",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "spause",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fade",
      "label": "Edge fade effect",
      "info": "Fades the text out at both edges of the section",
      "default": true
    },
    {
      "type": "range",
      "id": "fadew",
      "label": "Fade width",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.fade }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": true
    },
     {
      "type": "checkbox",
      "id": "npd",
      "label": "Remove side margins",
      "default": true,
      "info": "Edit margin in [theme settings](/editor?context=theme&category=Layout)",
      "visible_if": "{{ section.settings.fullwidth }}"            
    },
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
