{{ 'category-cards.css' | asset_url | stylesheet_tag }}

<section
  class="category-cards-section"
  id="category-cards-{{ section.id }}"
>

  <div class="category-cards-container">

    {% if section.settings.eyebrow != blank %}
      <div class="category-cards-eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="category-cards-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="category-cards-description">
        {{ section.settings.description }}
      </div>

       <div class="category-cards-divider"></div>
    {% endif %}

    <div class="category-cards-grid">

      {% for block in section.blocks %}

        <div
          class="category-card"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="category-card-link"
            >
          {% else %}
            <div class="category-card-link">
          {% endif %}

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    class: 'category-card-image',
                    alt: block.settings.title
                }}

              {% else %}

                {{ 'collection-1' | placeholder_svg_tag: 'category-card-image placeholder' }}

              {% endif %}


              <div class="category-card-overlay"></div>


              {% if block.settings.icon != 'none' or block.settings.badge != blank %}

                <div class="category-card-top">

                  {% if block.settings.icon != 'none' %}
                    <div class="category-card-icon">

                      {% case block.settings.icon %}

                        {% when 'star' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3.5l2.6 5.3 5.9.9-4.25 4.15 1 5.85L12 16.95 6.75 19.7l1-5.85L3.5 9.7l5.9-.9L12 3.5z"/>
                          </svg>

                        {% when 'tag' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 13l-7 7-9-9V4h7l9 9z"/>
                            <circle cx="8" cy="8" r="1.4"/>
                          </svg>

                        {% when 'bag' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 8h14l1 13H4L5 8z"/>
                            <path d="M8 8V6a4 4 0 018 0v2"/>
                          </svg>

                        {% when 'heart' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20.8 8.8c0 5.2-8.8 10.2-8.8 10.2S3.2 14 3.2 8.8A4.8 4.8 0 018 4c1.6 0 3.1.8 4 2 0.9-1.2 2.4-2 4-2a4.8 4.8 0 014.8 4.8z"/>
                          </svg>

                        {% when 'shoe' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 17c3.5-.2 5.5-1.8 7-5l1.2-3.2 2.2 2.7c1.4 1.7 3.2 2.8 5.6 3.5 1 .3 1.7 1.2 1.7 2.2V19H4v-2z"/>
                          </svg>

                      {% endcase %}

                    </div>
                  {% endif %}


                  {% if block.settings.badge != blank %}
                    <div class="category-card-badge">
                      {{ block.settings.badge }}
                    </div>
                  {% endif %}

                </div>

              {% endif %}


              <div class="category-card-content">

                {% if block.settings.title != blank %}
                  <h3 class="category-card-title">
                    {{ block.settings.title }}
                  </h3>
                {% endif %}

                {% if block.settings.button_text != blank %}
                  <span class="category-card-button">
                    {{ block.settings.button_text }}
                    <span class="category-card-arrow">→</span>
                  </span>
                {% endif %}

              </div>


          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>

</section>


{% schema %}

{
  "name": "Category Cards",
  "tag": "section",
  "class": "category-cards-section-wrapper",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP BY CATEGORIES"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Perfect Pair"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our handpicked collections designed to match every mood, style and occasion."
    }

  ],

  "blocks": [

    {
      "type": "category",
      "name": "Category",
      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "BEST SELLERS"
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "SHOP NOW"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        },

        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Example: NEW"
        },

        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "star",

          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "tag",
              "label": "Tag"
            },
            {
              "value": "bag",
              "label": "Bag"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "shoe",
              "label": "Shoe"
            }
          ]
        }

      ]
    }

  ],

  "presets": [

    {
      "name": "Category Cards",

      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "BEST SELLERS",
            "icon": "star"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "NEW IN",
            "icon": "tag",
            "badge": "NEW"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "ON SALE",
            "icon": "tag"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "BAGS",
            "icon": "bag"
          }
        }
      ]

    }

  ]

}

{% endschema %}