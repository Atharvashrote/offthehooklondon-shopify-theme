{%- liquid
    assign section_st = section.settings

    assign cnt_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign cnt_width = '100vw'
    endif

    assign is_rtl = false
    assign list_rtl = 'ar,dv,ha,he,ku,fa,ur,ug' | split: ','
    if list_rtl contains request.locale.iso_code or settings.rtl
        assign is_rtl = true
    endif

    assign logo = section_st.logo
    assign istrnsparent = false
    assign page_type = request.page_type
    if page_type == 'index' and section_st.trhead
        assign istrnsparent = true
    elsif page_type == 'collection' and section_st.trheadcl
        assign istrnsparent = true
    elsif page_type == 'blog' and section_st.trheadbg
        assign istrnsparent = true
    elsif page_type == 'article' and section_st.trheadar and article.image != blank
        assign istrnsparent = true
    endif
    if istrnsparent
        assign logo = section_st.trLogo | default: logo
    endif

    assign search_type = 'drawer'
    if section_st.leftcol == '4'
        assign search_type = 'inline'
    endif
-%}
{%- capture header_styles -%}
    {%- style -%}
        .hdr_bottom { --header_height:{{ section_st.ht }}px;--header_height_mob:{{ section_st.htm }}px;--logowd:{{ section_st.logowd }}px;--logowdm:{{ section_st.logowdm }}px;
            {%- if section_st.hdrbd -%}
                border-bottom:1px solid {{ section_st.hdrbd_cl }};
            {%- endif -%}
            {%- if section_st.bg-image != blank -%}
                background:{{ section_st.bg }} url({{ section_st.bg-image | image_url: width:section_st.bg-image.width }}) {{ section_st.bgrepeat }} {{ section_st.bgposition | replace:"_", " " }}/{{ section_st.bgsize }};
            {%- elsif section_st.bgg != blank -%}
                background:{{ section_st.bgg }};
            {%- else -%}
                background-color:{{ section_st.bg }};
            {%- endif -%}
            --cl:{{ section_st.cl }};--clh:{{ section_st.clh }};--icns:{{ section_st.icon }}px;--icnsm:16px;--fs:{{ section_st.fs }}px;
        }
        .template-index .hdr_bottom { border:0;}
        {%- if section_st.cntlogo -%}
            .mbnavCol { min-width:35px; margin-inline-start:-5px }
        {%- else -%}
            .nav_toggle { margin-inline-end:-5px }
        {%- endif -%}
        
        @media only screen and (max-width:1024px){
            {%- if section_st.cntlogo -%}
                .icons-col { flex:1 }
            {%- endif -%}
        }

        {%- if section_st.hdrStyle == '3' -%}
            #header .cur_lang_ttl { font-size:{{ settings.navfs }}px; font-weight:{{ settings.navfw }};  {% if settings.nav_case %} text-transform: uppercase; {% endif %} font-family:var(--{{ settings.navft }}); }
            #header .cur_lang_ttl { color:var(--cl); }
            #header .cur_lang_ttl:after { background-color:var(--cl); }
        {%- endif -%}

        {%- if section_st.icntyp == '3' -%}
            .cart-count.pp { margin:-2px 0 0 4px }
        {%- endif -%}

        #header .cur_lang_ttl,
        #header .social-icons a { color:var(--cl); font-weight:{{ settings.navfw }}; }
        #header .cur_lang_ttl:after { background-color:var(--cl); }
        #main-nav.f-jcs > li:first-child > a { padding-inline-start:0; }

        {%- if istrnsparent -%}
            .header-wrap:not(.sticky-header) { position:absolute; left:0; right:0; }
            .header-wrap.sticky-header, .header-wrap.header-hidden { position:fixed; }
            html:not(.searchact) .header-wrap:not(.sticky-header,:hover) { background-color:transparent; border-color:transparent; }
            .header-wrap:not(.sticky-header):not(:hover) .hdicon,
            .header-wrap:not(.sticky-header):not(:hover) .lvl1 > a,
            .header-wrap:not(.sticky-header):not(:hover) .cur_lang_ttl { color:{{ section_st.thcl }}!important; }
            .header-wrap:not(.sticky-header):not(:hover) .stlogo,
            .header-wrap.sticky-header .trlogo,
            .header-wrap:hover .trlogo { display:none !important; }
            .header-wrap:not(.sticky-header):not(:hover) #main-nav__wrap { background-color:transparent; border:0 none; }
            .header-wrap:hover #header, .searchact #header { background:var(--hdrbg); }
            #main-nav__wrapper { transition: all 0.2s ease-in-out; }
            #PageContainer { --hdht:{{ section_st.ht | plus:40 }}px;--hdhtm:{{ section_st.htm }}px; }
        {%- endif -%}

      {%- if page_type != 'index' -%}

    /* Normal header */
    .header-wrap:not(.sticky-header) #header .luxury-logo {
        display: inline-block !important;
        visibility: visible !important;
        opacity: 1 !important;
        color: #222 !important;
    }

    /* Sticky header */
    .header-wrap.sticky-header #header .luxury-logo {
        display: inline-block !important;
        visibility: visible !important;
        opacity: 1 !important;
        color: #222 !important;
    }

    /* Navigation */
    .header-wrap #header .hdicon,
    .header-wrap #header .lvl1 > a,
    .header-wrap #header .cur_lang_ttl {
        color: #222 !important;
    }

    /* Icons */
    .header-wrap #header .hdicon svg,
    .header-wrap #header .hdicon svg path {
        fill: #222 !important;
        stroke: #222 !important;
    }

{%- endif -%}

        {%- if section_st.leftcol == '4' -%}
            .hdSearch { max-width:280px; }
            .search-drawer { position:absolute; top:100%; padding:15px 0; max-height:70vh;  }   
            @media only screen and (min-width:1024px){
                .search-drawer { padding:30px 15px; border-radius:0 0 10px 10px; width:100vw; left: 50%;   transform: translateX(-50%) !important; }
            }
            @media only screen and (max-width:1024px){
               .search-drawer { transform:none; }
            }
        {%- endif -%}
    {%- endstyle -%}
{%- endcapture -%}

{%- capture logo -%}
    <div class="header-logo">
        <a href="{{ routes.root_url }}" itemprop="url" class="logo_link" title="{{ shop.name }}">
            {%- assign logo_alt = logo.alt | default: shop.name | escape -%}
            {%- capture sizes -%}(max-width: {{ section_st.logowd | times: 2 }}px) 50vw, {{ section_st.logowd }}px{%- endcapture -%}
            {%- capture widths -%}{{ section_st.logowd }}, {{ section_st.logowd | times: 1.5 | round }}, {{ section_st.logowd | times: 2 }}{% endcapture -%}
            {%- if istrnsparent and logo != blank -%}
                {%- assign trlogo_ht = section_st.logowd | divided_by: logo.aspect_ratio -%}
                {{- logo | image_url: width: 600 | image_tag: class: 'img-auto trlogo db', widths: widths, height: trlogo_ht, width: section_st.logowd, alt: logo_alt, sizes: sizes, preload: true -}}
            {%- endif -%}
      <span class="luxury-logo">
    OFF THE HOOK
</span>
        </a>
    </div>
{%- endcapture -%}

{%- capture promo -%}
    {%- if section_st.promo_head != blank or section_st.promo_text != blank -%}
        <div class="fl f-aic promo_txt hide-sm hide-md gap" style="--icns:{{ section_st.icon_size }}px;gap:10px;">
            {%- if section_st.image != blank and section_st.pricon == 'custom' -%}
                 {{- section_st.image | image_url: width: 100 | image_tag: class: 'at-icon', height:section_st.icon_size, width:section_st.icon_size, alt:section_st.prico.alt -}}
            {%- else -%}
                 {%- render 'icons', icon: section_st.pricon -%}
            {%- endif -%}
            <div style="color:{{ section_st.prcl }}; font-size:{{ section_st.prfs }}px; line-height:1.1;">
                {%- if section_st.promo_head != blank -%}<p style="color:{{ section_st.prtcl }}; font-size:{{ section_st.prtfs }}px; font-weight:{{ section_st.prfw }};margin-bottom:2px;">{{ section_st.promo_head }}</p>{%- endif -%}
                {%- if section_st.promo_text != blank -%}<span>{{ section_st.promo_text }}</span>{%- endif -%}
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture nav_toggle -%}
    <a href="#" class="hdicon nav_toggle hide-lg" role="button" title="{{ 'sections.navigation.menu' | t }}"><svg class="at-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 464.205 464.205"><path d="m435.192 406.18h-406.179c-16.024 0-29.013-12.99-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.99 29.013 29.013-.001 16.023-12.99 29.013-29.014 29.013z"/><path d="m435.192 261.115h-406.179c-16.024 0-29.013-12.989-29.013-29.012s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.012-29.014 29.012z"/><path d="m435.192 116.051h-406.179c-16.024 0-29.013-12.989-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.013-29.014 29.013z"/></svg></a>
{%- endcapture -%}

{%- capture site_header -%}
    {{- header_styles -}}
    <header id="header" class="main-header fl f-aic col-gap pr zi2{% if section_st.fullwidth %} fw-section{% else %} page-width{% endif %}{% if istrnsparent %} transparent{% endif %}" data-sticky="{{ section_st.sticky_type }}" data-section-id="header" style="{% if section_st.trhead %}--thcl:{{ section_st.thcl }};{% endif %}--gap:{{ section_st.gap }}px;">
        {%- if section_st.cntlogo -%}
            <div class="fl1 mbnavCol fl hide-lg cnt">
                {{- nav_toggle -}}
                {%- if settings.enable_search and section_st.cntlogo -%}
                    <a class="hdicon searchIcn" href="{{ routes.search_url }}" title="{{ 'sections.header.search' | t }}"><svg class="at-icon"><use xlink:href="#icon-search"></use></svg></a>
                {%- endif -%}
            </div>
        {%- endif -%}
        <div class="header-row">

    <div class="header-left">
        <!-- Left Menu -->
        {% comment %} <div class="fl1 leftcol fl f-aic hide-sm hide-md">
           
            <ul class="luxury-left-menu">

              {% for link in linklists['left-menu'].links %}

                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>

              {% endfor %}

            </ul>

          </div> {% endcomment %}
          <nav id="main-nav__wrapper" class="{% if istrnsparent %}transparent{% endif %} hide-sm hide-md" role="navigation">
    <div class="{% if section_st.fullwidth %} fw-section{% else %} page-width{% endif %}">
        {%- render 'navigation', section_st:section_st, secblk:section.blocks, cnt_width:cnt_width -%}
    </div>
</nav>
    </div>

    <div class="header-center">
        {{- logo -}}
    </div>

    {% comment %} <div class="header-right">
        <!-- Right Menu -->
        <div class="fl1 rightcol fl f-aic f-jce">

    <ul class="luxury-right-menu">

        {% for link in linklists['right-menu'].links %}
            <li>
                <a href="{{ link.url }}">
                    {{ link.title }}
                </a>
            </li>
        {% endfor %}

    </ul>

</div> {% endcomment %}
        <!-- Icons -->

        <div class="fl f-jce icons-col fl1">
            {%- if settings.enable_search -%}
                <a class="hdicon searchIcn{% if section_st.cntlogo %} hide-sm hide-md{% endif %}{% if section_st.leftcol == '4' %} hide-lg{% endif %}" href="{{ routes.search_url }}" title="{{ 'sections.header.search' | t }}">
                    <svg class="at-icon{% if section_st.icntyp == '3' %} hide-lg{% endif %}"><use xlink:href="#icon-search"></use></svg>
                    <p class="m0{% if section_st.icntyp == '1' %} hide{% else %} hide-sm hide-md{% endif %}{% if section_st.icntyp == '2' %} pdt5{% endif %}">{{ 'sections.header.search' | t }}</p>
                </a>
            {%- endif -%}
            {%- if shop.customer_accounts_enabled -%}
                <a class="hdicon user-menu" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" title="{{ 'sections.header.account' | t }}">
                    {%- render 'icon-account',  icntyp: section_st.icntyp -%}
                    <p class="m0{% if section_st.icntyp == '1' %} hide{% else %} hide-sm hide-md{% endif %}{% if section_st.icntyp == '2' %} pdt5{% endif %}">{{ 'sections.header.account' | t }}</p>
                </a>
            {%- endif -%}

           {%- if settings.wishlist -%}
    <a class="hdicon wishlist-header-link"
       href="{{ pages[settings.wishlist_page].url }}?view=wishlist"
       title="{{ 'sections.header.wishlist' | t }}"
       aria-label="{{ 'sections.header.wishlist' | t }}">

        <svg class="at-icon wishlist-header-icon" aria-hidden="true">
            <use xlink:href="#icon-wishlist"></use>
        </svg>

        <b id="wishlistItems" class="cart-count pp">0</b>

       

    </a>
{%- endif -%}

            {%- unless settings.catalog-mode -%}						
                <a href="{{ routes.cart_url }}" class="hdicon" id="cartLink" title="{{ 'sections.header.cart' | t }}">
                    <svg class="at-icon{% if section_st.icntyp == '3' %} hide-lg{% endif %}"><use xlink:href="#icon-cart"></use></svg>
                    {%- if section_st.icntyp != '3' -%}<b id="cart-icon-bubble" class="cart-count pp">{{ cart.item_count }}</b>{%- endif -%}
                    <p class="m0{% if section_st.icntyp == '1' %} hide{% else %} hide-sm hide-md{% endif %}{% if section_st.icntyp == '2' %} pdt5{% endif %}">{{ 'sections.header.cart' | t }}{% if section_st.icntyp == '3' %}<b id="cart-icon-bubble" class="cart-count pp">{{ cart.item_count }}</b>{% endif %}</p>
                </a>
            {%- endunless -%}
            {%- unless section_st.cntlogo -%}
                <a href="#" class="hdicon nav_toggle hide-lg" title="{{ 'sections.navigation.menu' | t }}"><svg class="at-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 464.205 464.205"><path d="m435.192 406.18h-406.179c-16.024 0-29.013-12.99-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.99 29.013 29.013-.001 16.023-12.99 29.013-29.014 29.013z"/><path d="m435.192 261.115h-406.179c-16.024 0-29.013-12.989-29.013-29.012s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.012-29.014 29.012z"/><path d="m435.192 116.051h-406.179c-16.024 0-29.013-12.989-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.013-29.014 29.013z"/></svg></a>
            {%- endunless -%}
        </div>
        {%- liquid
            if search_type == 'inline' 
                render 'search-drawer', search_type:search_type, cnt_width:cnt_width, is_rtl:is_rtl
            endif
        -%}
    </div>

</div>
                
    </header>
   


    <!--mmobile-->
    {%- render 'mobile-nav', section_st:section_st, secblk:section.blocks -%}
{%- endcapture -%}
{{- site_header | replace: '<!--mmobile-->', '</div>' | strip_newlines | remove: '  ' | remove: '	' -}}
{%- liquid
  if search_type == 'drawer'
    render 'search-drawer', search_type: search_type, cnt_width: cnt_width, is_rtl: is_rtl
  endif
-%}
