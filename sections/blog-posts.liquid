{%- capture featured_blog -%}
{%- liquid
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
-%}
{%- capture sizes -%}
  (min-width:1024px) calc(({{ page_width }} - {{ 30 | times: section_st.grid | minus:30 }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ 15 | times: section_st.gridtb | minus:15 }}px) / {{ section_st.gridtb }}), calc(100vw - 30px)
{%- endcapture -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
	<div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}" id="blogSlider-{{ section.id }}">
      {%- render 'sec-title' -%}
      {%- assign blog = blogs[section_st.blog] -%}
      {%- capture blog_data -%}
        {%- if section_st.blog != blank and section_st.blog.articles_count > 0 -%}
            {% for article in blog.articles limit: section_st.limit %}
                <div class="{% if section_st.carousel %}swiper-slide{% endif %} gitem {% render 'animate-data', css:true %}" {% render 'animate-data', i:forloop.index %}>{% render 'blog-card-grid', blog: blog, article: article, section_st:section_st, sizes:sizes %}</div>
            {% endfor %}
        {%- else -%}
            {%- for i in (1..section_st.limit) -%}
                <div class="swiper-slide gitem {% render 'animate-data', css:true %}" {% render 'animate-data', i:forloop.index %}>
                    <div class="pr brad of-hidden {{ section_st.blog_align }} of-hidden" style="--rounded:{{ section_st.bbrad }}px">
                        <a class="db pr of-hidden brad mb20" href="{{ article.url }}" style="padding-bottom:{{ section_st.img_ratio }}%;--rounded:{{ section_st.bbrad }}px;" title="{{ article.title | escape }}">
                            {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}{{ 'blog-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg img-fit' }}
                        </a>
                        <div class="blog-content {{ section_st.blog_align }}">
                            <{{ section_st.htag }} class="reg-text mb10 {{ section_st.tff }}{% if section_st.tcase %} text-upper{% endif %}"><a href="#">{{ 'homepage.onboarding.blog_title' | t }}</a></{{ section_st.htag }}>
                            {% if section_st.author %}<span class="color-body">{{ 'homepage.onboarding.blog_author' | t }}</span>{% endif %}
                            {% if section_st.des %}<div class="rte mb25">An excerpt of your blog post's content</div> {% endif %}
                            {% if section_st.more %}<p class="mb10"><a href="{{ article.url }}" class="btn-link">{{ 'blogs.article.read_more' | t }}</a></p>{% endif %}
                        </div>
                    </div>
                </div>
            {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- capture styles -%}
          --grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;--hdcl:{{ section_st.cl }};
          {%- if section_st.preset == 'custom-hd' -%}
            --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }};--ls:{{ section_st.ls }};
          {%- endif -%}
      {%- endcapture -%}

      {%- if section_st.carousel -%}
          <slide-section class="homeblog grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} swiper" style="{{ styles }}"
            data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
            <div class="swiper-wrapper">{{ blog_data }}</div>
            {% render 'swiper-navigation', id:section.id, section_st:section_st %}
          </slide-section>
      {%- else -%}
          <div class="homeblog grid gspace blog{{ section_st.grids }} rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }}" style="{{ styles }}">{{ blog_data }}</div>                    
      {%- endif -%}
      {% if section_st.viewall != blank %}<div class="tc mt20"><a href="{{ blog.url }}" class="btn {{ section_st.btn-style }} {{ section_st.btn-size }}">{{ section_st.viewall }}</a></div>{% endif %}
    </div>
</div>
{%- endcapture -%}
{{- featured_blog | strip_newlines | remove: '	' -}}
