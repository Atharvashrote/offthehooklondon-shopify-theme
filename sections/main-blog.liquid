{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
-%}
{%- capture styles -%}
    --grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;--hdcl:{{ section_st.cl }};
    {%- if section_st.preset == 'custom-hd' -%}
    --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }};--ls:{{ section_st.ls }};
    {%- endif -%}
{%- endcapture -%}
{%- paginate blog.articles by section_st.posts -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st: section_st, bgimage: true %}>
	<div class="{% if section_st.fullwidth %} fw-section{% else %} page-width{% endif %}">
        {%- if section_st.page_ttl %}
        <h1 class="page-title mb40 tc{% if section_st.tcase %} text-upper{% endif %}">{{ blog.title }}</h1>
        {%- endif %}
       <div class="fl f-col f-row-lg">
        <div class="blog-{{ section_st.layout }} fl1 w-100{% if section_st.sbposi == 'left' %} order2{% endif %}" style="{{ styles }}">
            <div class="{% if section_st.layout == 'list' %}blog-listview{% endif %}">
                {% if section_st.layout == 'grid-1' or section_st.layout == 'grid-2' %}
                    <div class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }}">
                        {% for article in blog.articles %}
                            {%- capture sizes -%}
                              {% if section_st.sbposi == 'nosidebar' %}
                                  (min-width:1024px) calc(({{ page_width }} - {{ 30 | times: section_st.grid | minus:30 }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ 15 | times: section_st.gridtb | minus:15 }}px) / {{ section_st.gridtb }}), calc((100vw - {{ 10 | times: section_st.gridmb | minus:10 }}px) / {{ section_st.gridmb }})
                              {%- else -%}
                                  (min-width:1024px) calc(({{ page_width }} - {{ 30 | times: section_st.grid | minus:30 | plus:340 }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ 15 | times: section_st.gridtb | minus:15 }}px) / {{ section_st.gridtb }}), calc((100vw - {{ 10 | times: section_st.gridmb | minus:10 }}px) / {{ section_st.gridmb }})
                              {%- endif -%}
                            {%- endcapture -%}
                            <div class="gitem blog-{{ section_st.layout }}__item {% render 'animate-data', css:true %}" {% render 'animate-data' %}>{% render 'blog-card-grid', article:article, section_st:section_st, sizes:sizes %}</div>
                        {% endfor %}
                    </div>
                {% else %}
                    {% for article in blog.articles %}
                        <div class="mb40 blog-{{ section_st.layout }}__item{% if section_st.layout == 'list-1' or section_st.layout == 'list-2' %} fl-md f-aic gap{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %} style="{% if section_st.layout == 'list-1' or section_st.layout == 'list-2' %}--gap:50px;--gapm:0;{% endif %}"> 
                            {% if article.image %}
                                <div class="article-image of-hidden mb20 {{ section_st.rounded }}{% if section_st.layout == 'list-1' or section_st.layout == 'list-2' %} wd40-md mb0-md{% endif %}">
                                    <a class="db pr" href="{{ article.url }}" style="padding-bottom:{{ section_st.img_ratio }}%;">
                                        {{ article.image | image_url: width: article.image.width | image_tag: loading:'lazy', class:'img-fit brad' , sizes: sizes, widths:"320,460,600,780,900" }}
                                    </a>
                                </div>
                            {% endif %}
                            <div {% if section_st.layout == 'list-1' or section_st.layout == 'list-2' %} class="fl1-md"{% endif %}>
                                {% if section_st.tags and article.tags.size > 0 %}
                                    <div class="blog-tags fl f-wrap mb15 col-gap" style="gap:10px;">{% for tag in article.tags %}<a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% endfor %}</div>
                                {% endif %}
                                <{{ section_st.htag }} class="head {{ section_st.preset }} mb10{% if section_st.tcase %} text-upper{% endif %}"><a href="{{ article.url }}">{{ article.title }}</a></{{ section_st.htag }}>

                                {% if section_st.date or section_st.author or section_st.comment %}
                                    <ul class="fl blog-meta mb15" style="--icns:14px;">                                               
                                        {%- if section_st.date -%}
                                            <li><time class="fl f-ais" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                                            <span class="sep-{{ section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-date' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>
                                            {{ article.published_at | date: format: 'month_day_year' }}</time></li>
                                        {%- endif -%}
                                        {%- if section_st.author -%}
                                            <li class="fl">
                                            <span class="sep-{{section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-user' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>
                                            {{ 'blogs.article.by_author' | t }} <span class="ml5">{{ article.author }}</span></li>
                                        {%- endif -%}
                                        {%- if section_st.comment and article.comments_count > 0 -%}
                                            <li class="cmnt fl"><a href="{{ article.url }}#comments">
                                            <span class="sep-{{ section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-comment' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>
                                            {{ 'blogs.comments.comments_with_count' | t: count: article.comments_count }}</a></li>
                                        {%- endif -%}
                                    </ul>
                                {% endif %}
                                {% if section_st.desc %}
                                    <div class="rte mb25">
                                        {%- if article.excerpt.size > 0 -%}
                                            {{ article.excerpt | truncatewords: section_st.dwords }}
                                        {%- else -%}
                                            {{ article.content | strip_html | truncatewords: section_st.dwords }}
                                        {%- endif -%}
                                    </div>
                                {% endif %}
                                {% if section_st.more %}<p><a href="{{ article.url }}" class="btn btn-sm">{{ 'blogs.article.read_more' | t }}</a></p>{% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
                {% if paginate.pages > 1 %}{% render 'pagination', paginate:paginate %}{% endif %}
            </div>
        </div>
        {%- if section_st.sidebar -%}
          {%- capture sd_styles -%}
              --gap:{{ section_st.sdgap }}px;--gapm:{{ section_st.sdgapm }}px;
              --hdcl:{{ section_st.wdTtlcl }};--cl:{{ section_st.dtcl }};--clh:{{ section_st.dtclh }};--fs:{{ section_st.dtfs }}px;
              {%- if section_st.bottom_border -%}--border:{{ section_st.ttlbdr }};{%- endif -%}
              --links_fs:{{ section_st.dtfs }}px;--links_cl:{{ section_st.dtcl }};--links_cl_hov:{{ section_st.dtclh }};
          {%- endcapture -%}
          {%- if section_st.ttlpreset == 'custom-hd' -%}<style>.widget-title{--fs:{{ section_st.wdTtl }}px;--fsm:{{ section_st.wdTtl }}px;--ff:var(--{{ section_st.wdTtlft }});--fw:{{ section_st.wdTtlwt }};--lh:1.2;}</style>{%- endif -%}
          <div class="sidebar fl f-col gap{% if section_st.sbposi == 'left' %} mr30{% else %} ml30{% endif %}{% if section_st.sidem %} hide-sm hide-md{% endif %}" style="{{ sd_styles }}">
              {%- content_for 'blocks' -%}
          </div>
        {%- endif -%}
     </div>
    </div> 
</div>
{%- endpaginate -%}
{% schema %}
{
  "name": "Blog page",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "page_ttl",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Blog design",
      "default": "list-1",
      "options": [
        {
          "value": "grid-1",
          "label": "Grid"
        },
        {
          "value": "list-1",
          "label": "List"
        },
        {
          "value": "s",
          "label": "List standard"
        },
        {
          "value": "grid-2",
          "label": "Mask"
        },
        {
          "value": "list-2",
          "label": "Modern"
        }
      ]
    },
    {
      "type": "select",
      "id": "img_ratio",
      "label": "Images ratio",
      "default": "60",
      "options": [
        { "group": "Landscape", "value": "30", "label": "0:3" },
        { "group": "Landscape", "value": "40", "label": "0:4" },
        { "group": "Landscape", "value": "50", "label": "0:5" },
        { "group": "Landscape", "value": "60", "label": "0:6" },
        { "group": "Landscape", "value": "70", "label": "0:7" },
        { "group": "Landscape", "value": "80", "label": "0:8" },
        { "group": "Landscape", "value": "90", "label": "0:9" },
        { "group": "Squared", "value": "100", "label": "1:1" },
        { "group": "Portrait", "value": "110", "label": "1:1" },
        { "group": "Portrait", "value": "120", "label": "1:2" },
        { "group": "Portrait", "value": "130", "label": "1:3" },
        { "group": "Portrait", "value": "140", "label": "1:4" },
        { "group": "Portrait", "value": "150", "label": "1:5" }
      ]
    },
    {
      "type": "select",
      "id": "rounded",
      "label": "Image corner radius",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "round-xs",
          "label": "Extra small"
        },
        {
          "value": "round-sm",
          "label": "Small"
        },
        {
          "value": "round-md",
          "label": "Medium"
        },
        {
          "value": "round-lg",
          "label": "Large"
        },
        {
          "value": "round-full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "header",
      "content": "Post per row",
      "visible_if": "{{ section.settings.layout == 'grid-1' or section.settings.layout == 'grid-2' }}"
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Desktop",
      "default": 2,
      "min": 2,
      "max": 4,
      "step": 1,
      "visible_if": "{{ section.settings.layout == 'grid-1' or section.settings.layout == 'grid-2' }}"
    },
    {
      "type": "range",
      "id": "gridtb",
      "label": "Tablet",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1,
      "visible_if": "{{ section.settings.layout == 'grid-1' or section.settings.layout == 'grid-2' }}"
    },
    {
      "type": "range",
      "id": "gridmb",
      "label": "Mobile",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 1,
      "visible_if": "{{ section.settings.layout == 'grid-1' or section.settings.layout == 'grid-2' }}"
    },
    {
      "type": "range",
      "id": "posts",
      "label": "Posts limit",
      "default": 6,
      "min": 2,
      "max": 40,
      "step": 1      
    },
    {
      "type": "header",
      "content": "Post title"
    },
    {
      "type": "select",
      "id": "htag",
      "label": "Title tag",
       "info": "Specify heading type to improve SEO and accessibility.",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "P"
        }
      ]
    },
    {
      "type": "select",
      "id": "preset",
      "label": "Preset",
      "info": "Edit presets in [theme settings](/editor?context=theme)",
      "default": "h5",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
       {
          "value": "text-1",
          "label": "Text 1"
        },
        {
          "value": "text-2",
          "label": "Text 2"
        },
        {
          "value": "custom-hd",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "ff",
      "label": "Font",
      "default": "ft2",
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}",
      "options": [
        {
          "value": "ft1",
          "label": "Body font"
        },
        {
          "value": "ft2",
          "label": "Heading font"
        },
        {
          "value": "ft3",
          "label": "Accent font"
        }
      ]
    },
    {
      "type": "range",
      "id": "fs",
      "label": "Font size",
      "default": 20,
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}"
    },
    {
      "type": "range",
      "id": "fsm",
      "label": "Font size (mobile)",
      "default": 18,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}"
    },    
    {
      "type": "select",
      "id": "fw",
      "label": "Font weight",
      "default": "600",
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "lh",
      "label": "Line height",
      "default": 1.2,
      "min": 0.7,
      "max": 2.0,
      "step": 0.1,      
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}"
    },
    {
      "type": "checkbox",
      "id": "tcase",
      "label": "Use uppercase text"
    },
    {
      "type": "header",
      "content": "Post meta"
    },
    {
      "type": "checkbox",
      "id": "tags",
      "label": "Show blog tags",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "comment",
      "label": "Show comment",
      "default": true
    },
    {
      "type": "select",
      "id": "post_sep",
      "label": "Separator",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Icons"
        },
        {
          "value": "2",
          "label": "Pipe"
        },
        {
          "value": "3",
          "label": "Bullets"
        },
        {
          "value": "4",
          "label": "Dash"
        },
        {
          "value": "5",
          "label": "none"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "post_case",
      "label": "Use uppercase text",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "----------------------------------------------"
    },
    {
      "type": "checkbox",
      "id": "desc",
      "label": "Short description",
      "default": true
    },
     {
      "type": "range",
      "id": "dwords",
      "label": "Display words",
      "default": 40,
      "min": 10,
      "max": 100,
      "step": 5,
      "visible_if": "{{ section.settings.desc }}"
    },
    {
      "type": "checkbox",
      "id": "more",
      "label": "Show read more button",
      "default": true
    },   
    {
      "type": "header",
      "content": "Sidebar"
    },
    {
      "type": "checkbox",
      "id": "sidebar",
      "label": "Enable sidebar",
      "default": true
    },
    {
      "type": "select",
      "id": "sbposi",
      "label": "Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "visible_if": "{{ section.settings.sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "sidem",
      "label": "Hide on mobile",
      "default": true,
      "visible_if": "{{ section.settings.sidebar }}"
    },
    {
      "type": "range",
      "id": "sdgap",
      "label": "Block gap",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.sidebar }}"
    },
    {
      "type": "range",
      "id": "sdgapm",
      "label": "Block gap (mobile)",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.sidebar }}"
    },    
    {
      "type": "color",
      "id": "wdTtlcl",
      "label": "Block title",
      "default": "#000",
      "visible_if": "{{ section.settings.sidebar }}"
    },
    {
      "type": "select",
      "id": "ttlpreset",
      "label": "Title preset",
      "info": "Edit presets in [theme settings](/editor?context=theme&category=Typography and Colors)",
      "default": "h4",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "text-1",
          "label": "Text 1"
        },
        {
          "value": "text-2",
          "label": "Text 2"
        },        
        {
          "value": "custom-hd",
          "label": "Custom"
        }
      ],
      "visible_if": "{{ section.settings.sidebar }}"
    },   
    {
      "type": "select",
      "id": "wdTtlft",
      "label": "Font",
      "default": "ft1",
      "options": [
        {
          "value": "ft1",
          "label": "Body font"
        },
        {
          "value": "ft2",
          "label": "Heading font"
        },
        {
          "value": "ft3",
          "label": "Accent font"
        }
      ],
      "visible_if": "{{ section.settings.sidebar and section.settings.ttlpreset == 'custom-hd' }}"
    },
     {
      "type": "range",
      "id": "wdTtl",
      "label": "Font size",
      "default": 15,
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.sidebar and section.settings.ttlpreset == 'custom-hd' }}"
    },
    {
      "type": "select",
      "id": "wdTtlwt",
      "label": "Font weight",
      "default": "700",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "visible_if": "{{ section.settings.sidebar and section.settings.ttlpreset == 'custom-hd' }}"
    },
     {
      "type": "checkbox",
      "id": "text-upper",
      "label": "Use uppercase text",
      "default": false      
    },
    {
      "type": "checkbox",
      "id": "bottom_border",
      "label": "Show border below title",
      "default": false,
      "visible_if": "{{ section.settings.sidebar }}"
    },
    {
      "type": "color",
      "id": "ttlbdr",
      "label": "Border color",
      "default": "#f5f5f5",
      "visible_if": "{{ section.settings.sidebar and section.settings.bottom_border }}"
    },   
    {
      "type": "range",
      "id": "dtfs",
      "label": "Block details font",
      "default": 12,
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.sidebar }}"
    },
    {
      "type": "color",
      "id": "dtcl",
      "label": "Text/links color",
      "default": "#000",
      "visible_if": "{{ section.settings.sidebar }}"
    },
    {
      "type": "color",
      "id": "dtclh",
      "label": "Links hover",
      "default": "#EC9090",
      "visible_if": "{{ section.settings.sidebar }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
