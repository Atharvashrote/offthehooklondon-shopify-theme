    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "select",
      "id": "ppreset",
      "label": "Preset",
      "info": "Edit presets in [theme settings](/editor?context=theme&category=Typography and Colors)",
      "default": "text-1",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
       {
          "value": "text-1",
          "label": "Text 1"
        },
        {
          "value": "text-2",
          "label": "Text 2"
        }, 
        {
          "value": "custom-hd",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "pff",
      "label": "Font",
      "default": "ft2",
      "visible_if": "{{ section.settings.ppreset == 'custom-hd' }}",
      "options": [
        {
          "value": "ft1",
          "label": "Body font"
        },
        {
          "value": "ft2",
          "label": "Heading font"
        },
        {
          "value": "ft3",
          "label": "Accent font"
        }
      ]
    },
    {
      "type": "range",
      "id": "pfs",
      "label": "Font size",
      "default": 16,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.ppreset == 'custom-hd' }}"
    },
    {
      "type": "range",
      "id": "pfsm",
      "label": "Font size (mobile)",
      "default": 14,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.ppreset == 'custom-hd' }}"
    },    
    {
      "type": "select",
      "id": "pfw",
      "label": "Font weight",
      "default": "700",
      "visible_if": "{{ section.settings.ppreset == 'custom-hd' }}",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "plh",
