<script src="{{ 'scrolling-image-list.js' | asset_url }}" defer></script>
{%- capture info_banner -%}
{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
    assign img_class = "img-auto m-auto " | append: section_st.rounded
-%}
<style>
  {%- if section.settings.ppreset == 'custom-hd' -%}
    #{{ section.id }} .si-pre-head { --fs:{{ section_st.pfs }}px;--fsm:{{ section_st.pfsm }}px;--ff:var(--{{ section_st.pff }});--fw:{{ section_st.pfw }};--lh:{{ section_st.plh }};--ls:{{ section_st.pls }}px }
  {%- endif -%}
  {%- if section.settings.preset == 'custom-hd' -%}
    #{{ section.id }} .si-head { --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }};--ls:{{ section_st.ls }}px }
  {%- endif -%}
</style>
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}{%- if section_st.tpreset == 'custom' -%}--fs:{{ section_st.tfs }}px;--fsm:{{ section_st.tfsm }}px;--ff:var(--{{ section_st.tff }});--fw:{{ section_st.tfw }};--lh:{{ section_st.tlh }};{%- endif -%}">
    <div class="{% if section_st.fullwidth %} fw-section{% if section_st.npd %} npd{% endif %}{% else %} page-width{% endif %} hide-md hide-lg">
        <slide-section class="image-with-text swiper" data-swiper='{ "slidesPerView":"1", "loop":true, "preloadImages":false, "lazy":true, "pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
            <div class="swiper-wrapper">
              {% for block in section.blocks limit: section.blocks.size %}
                  {% assign block_st = block.settings %}
                  {% assign sindex = forloop.index %}
                    <div class="swiper-slide scroll-img-slide w-100 of-hidden" style="--bg:{% if block_st.bgg != blank %}{{ block_st.bgg }}{% else %}{{ block_st.txtbg }}{% endif %};--mwd:{{ block_st.image.width }}px;" data-slide="{{ sindex }}" id="{{ block.id }}" {{ block.shopify_attributes }}>
                      <div class="of-hidden fl f-aic {{ section_st.rounded }} {% render 'animate-data', css:true %}">
                          {% if block_st.image != blank %}
                              {% if block_st.link != blank %}<a class="db w-100" href="{{ block_st.link }}">{% endif %}
                                  {%- liquid
                                      assign column = 100.00 | divided_by: 50 | times: 1
                                      assign divide_colunm = 1.00 | divided_by: column | round: 2
                                  -%}
                                  {%- capture sizes -%}(min-width:1024px) calc(({{ page_width }} - 30px * {{ column | minus: 1 }}) * {{ divide_colunm }}), calc(100vw - 30px){%- endcapture -%}
                                  {%- assign img_alt = block_st.image.alt | default: block_st.title | default: block_st.titles -%}
                                  {{- block_st.image | image_url: width: block_st.image.width | image_tag: loading:'lazy', class:img_class, alt:img_alt, sizes:sizes, widths:"320,400,560,740,900,1200" -}}
                              {% if block_st.link != blank %}</a>{% endif %}
                          {% else %}
                              {{- 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' -}}
                          {% endif %}
                      </div>
                      <div class="image-text__content">
                             <div class="image-text__content-inner w-100 t-{{ section_st.align }}{% if section_st.txtpd %} nobg{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
                              {%- if block_st.titles != blank -%}<p class="head {{ section_st.ppreset }} si-pre-head mb5" style="--cl:{{ block_st.scl }};">{{ block_st.titles }}</p>{%- endif -%}
                              {%- if block_st.title != blank -%}<{{ section_st.htag }} class="head {{ section_st.preset }} si-head mb{{ section_st.head_mbm }}" style="--cl:{{ block_st.cl }};">{{ block_st.title }}</{{ section_st.htag }}>{%- endif -%}
                              {%- if block_st.text != blank -%}<div class="reg-text rte mb{{ section_st.text_mbm }}"  style="--cl:{{ block_st.tcl }};">{{ block_st.text }}</div>{%- endif -%}
                              {%- if block_st.btn != blank and block_st.link != blank -%}
                                  <a href="{{ block_st.link }}" class="btn {{ section_st.btn-size }} {{ block_st.btn-style }}">{{ block_st.btn }}</a>
                              {%- endif -%}
                          </div>
                      </div>
                  </div>        
              {% endfor %}
            </div>
            <div class="swiper-pagination swpg{{ section.id }} fl f-wrap f-jcc tc"></div>
      </slide-section>
    </div>
    <scrolling-image-list id="{{ section.id }}" data-current-index="1" class="db scrolling-image-list pr hide-sm">
        {%- for block in section.blocks -%}
            {%- assign block_st = block.settings -%}
            {%- assign sindex = forloop.index -%}
            <div class="scroll-slide-bg pa w-100 h-100 setAct{% if forloop.first %} active{% endif %}" data-index="{{ sindex }}" style="--bg:{% if block_st.bgg != blank %}{{ block_st.bgg }}{% else %}{{ block_st.txtbg }}{% endif %};"></div>
        {%- endfor -%}
    
        <div class="fl gap{% if section_st.fullwidth %} fw-section{% if section_st.npd %} npd{% endif %}{% else %} page-width{% endif %}" style="--gap:50px;">
            <div class="fl1">
              {% for block in section.blocks %}
                  {% assign block_st = block.settings %}
                  {% assign index = forloop.index %}
                  <div class="scrolling-image-list__image setAct{% if forloop.first %} active{% endif %}" data-index="{{ index }}" tabindex="0">
                       <div class="pr tc {{ section_st.rounded }}">
                           {% if block_st.image != blank %}
                              {% if block_st.link != blank %}<a class="db w-100" href="{{ block_st.link }}">{% endif %}
                                  {%- liquid
                                      assign column = 100.00 | divided_by: 50 | times: 1
                                      assign divide_colunm = 1.00 | divided_by: column | round: 2
                                  %}
                                  {%- capture sizes -%}
                                    (min-width:1024px) calc(({{ page_width }} - 30px * {{ column | minus: 1 }}) * {{ divide_colunm }}), calc(100vw - 30px)
                                  {%- endcapture -%}
                                  {% assign img_alt = block_st.image.alt | default: block_st.title | default: block_st.titles %}
                                  {{ block_st.image | image_url: width: block_st.image.width | image_tag: loading:'lazy', class:img_class, alt:img_alt, sizes:sizes, widths:"320,400,560,740,900,1200" }}
                              {% if block_st.link != blank %} </a> {% endif %}
                          {% else %}
                              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}   
                       </div>
                  </div>
              {% endfor %}
            </div>
    
            <div class="fl1 scroll-content-col pr zi1">
              <div class="scrolling-image-list__content-area">
                <div class="feature-text-paired pr">
                    {% for block in section.blocks %}
                      {% assign block_st = block.settings %}
                      {% assign index = forloop.index %}
                      <div class="image-text__content scrolling-image-list__content setAct{% if forloop.first %} active{% endif %}" data-index="{{ index }}" tabindex="0">
                            <div class="image-text__content-inner w-100 t-{{ section_st.align }}{% if section_st.txtpd %} nobg{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
                                {%- if block_st.titles != blank -%}<p class="head {{ section_st.ppreset }} si-pre-head mb5" style="--hdcl:{{ block_st.scl }};">{{ block_st.titles }}</p>{%- endif -%}
                                {%- if block_st.title != blank -%}<{{ section_st.htag }} class="head {{ section_st.preset }} si-head mb{{ section_st.head_mb }}-md" style="--cl:{{ block_st.cl }};">{{ block_st.title }}</{{ section_st.htag }}>{%- endif -%}
                                {%- if block_st.text != blank -%}<div class="reg-text rte mb{{ section_st.text_mb }}-md" style="--cl:{{ block_st.tcl }};">{{ block_st.text }}</div>{% endif %}
                                {%- if block_st.btn != blank and block_st.link != blank -%}
                                    <a href="{{ block_st.link }}" class="btn {{ section_st.btn-size }} {{ block_st.btn-style }}">{{ block_st.btn }}</a>
                                {%- endif -%}
                            </div>
                      </div>
                    {% endfor %}
                </div>
              </div>
            </div>
        </div>
    </scrolling-image-list>
</div>
{%- endcapture -%}
{{- info_banner | strip_newlines | remove: '  ' | remove: '	' -}}
{% schema %}
{
  "name": "Scrolling images",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "select",
      "id": "rounded",
      "label": "Image corner",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "round-xs",
          "label": "Extra small"
        },
        {
          "value": "round-sm",
          "label": "Small"
        },
        {
          "value": "round-md",
          "label": "Medium"
        },
        {
          "value": "round-lg",
          "label": "Large"
        },
        {
          "value": "round-full",
          "label": "Full"
        }
      ]
    },    
    {
      "type": "text_alignment",
      "id": "align",
      "label": "Alignment",
      "default": "left"
    },
       {
      "type": "checkbox",
      "id": "txtpd",
      "label": "Remove text padding on mobile",
      "info": "text side space if no background color",
      "default": false
