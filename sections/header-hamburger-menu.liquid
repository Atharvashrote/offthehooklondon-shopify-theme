{%- liquid
    assign section_st = section.settings

    assign cnt_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign cnt_width = '100vw'
    endif

    assign is_rtl = false
    assign list_rtl = 'ar,dv,ha,he,ku,fa,ur,ug' | split: ','
    if list_rtl contains request.locale.iso_code or settings.rtl
        assign is_rtl = true
    endif

    assign logo = section_st.logo
    assign istrnsparent = false
    assign page_type = request.page_type
    if page_type == 'index' and section_st.trhead
        assign istrnsparent = true
    elsif page_type == 'collection' and section_st.trheadcl
        assign istrnsparent = true
    elsif page_type == 'blog' and section_st.trheadbg
        assign istrnsparent = true
    elsif page_type == 'article' and section_st.trheadar and article.image != blank
        assign istrnsparent = true
    endif
    if istrnsparent
        assign logo = section_st.trLogo | default: logo
    endif

    assign search_type = 'drawer'
    if section_st.leftcol == '3'
        assign search_type = 'inline'
    endif
-%}
{% capture header_styles %}
    {%- style -%}
        .hdr_Hamburger {
            --header_height:{{ section_st.ht }}px;--header_height_mob:{{ section_st.htm }}px;--logowd:{{ section_st.logowd }}px;--logowdm:{{ section_st.logowdm }}px;
            {%- if section_st.bg-image != blank -%}
                background:{{ section_st.bg }} url({{ section_st.bg-image | image_url: width:section_st.bg-image.width }}) {{ section_st.bgrepeat }} {{ section_st.bgposition | replace:"_", " " }}/{{ section_st.bgsize }};
            {%- elsif section_st.bgg != blank -%}
                background:{{ section_st.bgg }};
            {%- else -%}
                background-color:{{ section_st.bg }};
            {%- endif -%}
            {%- if section_st.hdrbd -%}
                border-bottom:1px solid {{ section_st.hdrbd_cl }};
            {%- endif -%}
            --cl:{{ section_st.cl }};--clh:{{ section_st.clh }};--icns:{{ section_st.icon }}px;--icnsm:16px;--fs:{{ section_st.fs }}px;
        }

        {%- if section_st.cntlogo -%}
            .mbnavCol { margin-inline-start:-5px; }
        {%- else -%}
            .nav_toggle { margin-inline-end:-5px; }
        {%- endif -%}

        @media only screen and (max-width:1024px){
            {%- if section_st.cntlogo -%}
                .icons-col { flex:1; }
            {%- endif -%}
        }

        {%- if section.settings.hdrStyle == '3' -%}
            #header .cur_lang_ttl { font-size:{{ settings.navfs }}px; font-weight:{{ settings.navfw }}; font-family:var(--{{ settings.navft }});{% if settings.nav_case %}text-transform:uppercase;{% endif %} }
            #header .cur_lang_ttl { color:var(--cl); }
            #header .cur_lang_ttl:after { background-color:var(--cl); }
        {%- endif -%}

        .icons-col .hdicon p { font-family:var(--{{ settings.navft }}); font-weight:{{ settings.navfw }}; {% if settings.nav_case %}text-transform:uppercase;{% endif %} }
        {%- if section.settings.icntyp == '3' -%}
            .cart-count.pp { margin:-4px 0 0 4px }
        {%- endif -%}

        #header .cur_lang_ttl,
        #header .social-icons a { color:var(--cl) }
        #header .cur_lang_ttl:after { background-color:var(--cl) }
        .hdSearch { max-width:280px }

        {%- if istrnsparent -%}
            .header-wrap:not(.sticky-header) { position:absolute; left:0; right:0; }
            .header-wrap.sticky-header, .header-wrap.header-hidden { position:fixed; }
            html:not(.active-hamburger, .searchact) .header-wrap:not(.sticky-header, :hover) { background-color:transparent; border-color:transparent; }
            html:not(.active-hamburger, .searchact) .header-wrap:not(.sticky-header, :hover) .hdicon,
            html:not(.active-hamburger, .searchact) .header-wrap:not(.sticky-header, :hover) .cur_lang_ttl { color:{{ section_st.thcl }}!important; }
            html:not(.active-hamburger, .searchact) .header-wrap:not(.sticky-header, :hover) .stlogo,
            :is(.header-wrap, .sticky-header):hover .trlogo, .sticky-header .trlogo,
            :is(.active-hamburger, .searchact) .header-wrap .trlogo { display:none !important; }
            #PageContainer { --hdht:{{ section_st.ht }}px;--hdhtm:{{ section_st.htm }}px; }
        {%- endif -%}

        .leftcol .search-result {width:400px !important}

        .hmbToggle:not(.active) .close, .hmbToggle.active .bar { display:none }
        .hmbMenu { height:0; overflow:hidden; z-index:667; {% if istrnsparent %}top:{{ section_st.ht }}px;{% else %}top:100%;{% endif %}; border:0 none!important; }
        .active-hamburger .hmbMenu { height:calc(100vh - var(--header_height, 80px)); overflow:auto; box-shadow:inset 0 0 15px #00000010; }
        .hmbMenu #main-nav { padding:25px 0; width:250px }
        .hmbMenu #main-nav > li { border-bottom:1px solid {{ settings.navcl | color_modify:'alpha', 0.10 }} }
        .hmbMenu #main-nav > li > a { justify-content:space-between }
        .hmbMenu #main-nav .mgmenu { inset-inline-start:260px; top:0; width:calc({{ cnt_width }} - 260px); height:calc(100% - 60px); max-height:100%; background:none; box-shadow:none; }

        {%- if section_st.leftcol == '3' -%}
            .search-drawer { position:absolute; top:100%; padding:15px 0; max-height:70vh; }
            @media only screen and (min-width:1024px){
                .search-drawer { padding:30px 15px; border-radius:0 0 10px 10px; }
            }
        {% endif %}

        {%- unless section_st.cntlogod -%}
            @media only screen and (min-width:1024px){
                .mbnavCol { flex:inherit }
            }
        {%- endunless -%}
    {%- endstyle -%}
{%- endcapture -%}

{%- capture logo -%}
    <div class="header-logo">
        <a href="{{ routes.root_url }}" itemprop="url" class="logo_link" title="{{ shop.name }}">
            {%- assign logo_alt = logo.alt | default: shop.name | escape -%}
            {%- capture sizes -%}(max-width: {{ section_st.logowd | times: 2 }}px) 50vw, {{ section_st.logowd }}px{%- endcapture -%}
            {%- capture widths -%}{{ section_st.logowd }}, {{ section_st.logowd | times: 1.5 | round }}, {{ section_st.logowd | times: 2 }}{% endcapture -%}
            {%- if istrnsparent and logo != blank -%}
                {%- assign trlogo_ht = section_st.logowd | divided_by: logo.aspect_ratio -%}
                {{- logo | image_url: width: 600 | image_tag: class: 'img-auto trlogo db fw700', widths: widths, height: trlogo_ht, width: section_st.logowd, alt: logo_alt, sizes: sizes, preload: true -}}
            {%- endif -%}
            {%- if section_st.logo != blank -%}
                {%- assign logo_ht = section_st.logowd | divided_by: section_st.logo.aspect_ratio -%}
                {{- section_st.logo | image_url: width: 600 | image_tag: class: 'img-auto stlogo db fw700', widths: widths, height: logo_ht, width: section_st.logowd, alt: logo_alt, sizes: sizes, preload: true -}}
            {%- else -%}
                {{ shop.name }}
            {%- endif -%}
        </a>
    </div>
{%- endcapture -%}

{%- capture promo -%}
    {%- if section_st.promo_head != blank or section_st.promo_text != blank -%}
        <div class="fl f-aic promo_txt hide-sm hide-md" style="--icns:{{ section_st.prisz }}px">
            {%- if section_st.prico != blank -%}
                {%- capture prico_width -%}{{ section_st.prisz }}, {{ section_st.prisz | times: 1.5 | round }}, {{ section_st.prisz | times: 2 }}{%- endcapture -%}
                {{- section_st.prico | image_url: width: 100 | image_tag: class: 'at-icon mr10', widths:prico_width, height:section_st.prisz, width:section_st.prisz, alt:section_st.prico.alt -}}
            {%- endif -%}
            <div style="color:{{ section_st.prcl }}; font-size:{{ section_st.prfs }}px; line-height:1.1;">
                {%- if section.settings.promo_head != blank -%}<p style="color:{{ section_st.prtcl }}; font-size:{{ section_st.prtfs }}px; font-weight:{{ section_st.prfw }};margin-bottom:2px;">{{ section.settings.promo_head }}</p>{%- endif -%}
                {%- if section.settings.promo_text != blank -%}<span>{{ section.settings.promo_text }}</span>{%- endif -%}
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture nav_toggle -%}
    <a href="#" class="hdicon hmbToggle mr30 hide-sm hide-md" role="button" title="{{ 'sections.navigation.menu' | t }}">
        <svg class="at-icon bar" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 464.205 464.205"><path d="m435.192 406.18h-406.179c-16.024 0-29.013-12.99-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.99 29.013 29.013-.001 16.023-12.99 29.013-29.014 29.013z"/><path d="m435.192 261.115h-406.179c-16.024 0-29.013-12.989-29.013-29.012s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.012-29.014 29.012z"/><path d="m435.192 116.051h-406.179c-16.024 0-29.013-12.989-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.013-29.014 29.013z"/></svg>
        <svg class="at-icon close"><use xlink:href="#icon-close"></use></svg>
        <p class="m0{% if section_st.icntyp == '1' %} hide{% else %} hide-sm hide-md{% endif %}{% if section_st.icntyp == '2' %} pdt5{% endif %}">{{ 'sections.navigation.menu' | t }}</p>
    </a>
    <a href="#" class="hdicon nav_toggle hide-lg" role="button" title="{{ 'sections.navigation.menu' | t }}"><svg class="at-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 464.205 464.205"><path d="m435.192 406.18h-406.179c-16.024 0-29.013-12.99-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.99 29.013 29.013-.001 16.023-12.99 29.013-29.014 29.013z"/><path d="m435.192 261.115h-406.179c-16.024 0-29.013-12.989-29.013-29.012s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.012-29.014 29.012z"/><path d="m435.192 116.051h-406.179c-16.024 0-29.013-12.989-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.013-29.014 29.013z"/></svg></a>
{%- endcapture -%}

{%- capture extra_data -%}
    {%- if section_st.leftcol == '1' -%}
        {{ promo }}
    {%- elsif section_st.leftcol == '2' -%}
        <div class="fl1 leftcol fl f-aic gap hide-sm hide-md" style="--gap:15px;">
            {% if settings.mlcurrency or settings.mlLang %}{%- render 'currencyLang' -%}{% endif %}
        </div>
    {%- elsif section_st.leftcol == '3' -%}
        <div class="searchinline hide-sm hide-md">{%- render 'search-form', formClass: 'hdSearch' -%}</div>
    {%- endif -%}
{%- endcapture -%}

{% capture site_header %}
    {{- header_styles -}}
    <header id="header" class="main-header fl f-aic col-gap pr{% if section_st.fullwidth %} fw-section{% else %} page-width{% endif %}{% if istrnsparent %} transparent{% endif %}" data-sticky="{{ section_st.sticky_type }}" data-section-id="header" style="{% if section_st.trhead %}--thcl:{{ section_st.thcl }};{% endif %}--gap:{{ section_st.gap }}px;">
        <div class="mbnavCol fl f-aic fl1{% unless section_st.cntlogo %} hide-sm hide-md{% endunless %}">
            {{- nav_toggle -}}
            {%- if settings.enable_search and section_st.cntlogo -%}
                <a class="hdicon searchIcn hide-lg" href="{{ routes.search_url }}" title="{{ 'sections.header.search' | t }}"><svg class="at-icon"><use xlink:href="#icon-search"></use></svg></a>
            {%- endif -%}
            {%- if section_st.cntlogod -%}{{ extra_data }}{%- endif -%}
        </div>

        {{- logo -}}

        <div class="fl f-aic f-jce icons-col fl1">
            {%- unless section_st.cntlogod -%}<div class="mr20 hide-sm hide-md">{{ extra_data }}</div>{% endunless %}
            {%- if settings.enable_search -%}
                <a class="hdicon searchIcn{% if section_st.cntlogo %} hide-sm hide-md{% endif %}{% if section_st.leftcol == '3' %} hide-lg{% endif %}" href="{{ routes.search_url }}" title="{{ 'sections.header.search' | t }}">
                    <svg class="at-icon{% if section_st.icntyp == '3' %} hide-lg{% endif %}"><use xlink:href="#icon-search"></use></svg>
                    <p class="m0{% if section_st.icntyp == '1' %} hide{% else %} hide-sm hide-md{% endif %}{% if section_st.icntyp == '2' %} pdt5{% endif %}">{{ 'sections.header.search' | t }}</p>
                </a>
            {%- endif -%}
            {%- if shop.customer_accounts_enabled -%}
                <a class="hdicon user-menu" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" title="{{ 'sections.header.account' | t }}">
                    {%- render 'icon-account',  icntyp: section_st.icntyp -%}
                    <p class="m0{% if section_st.icntyp == '1' %} hide{% else %} hide-sm hide-md{% endif %}{% if section_st.icntyp == '2' %} pdt5{% endif %}">{{ 'sections.header.account' | t }}</p>
                </a>
            {%- endif -%}

            {%- if settings.wishlist -%}
                <a class="hdicon" href="{{ pages[settings.wishlist_page].url }}" title="{{ 'sections.header.wishlist' | t }}">
                    <svg class="at-icon{% if section_st.icntyp == '3' %} hide-lg{% endif %}"><use xlink:href="#icon-wishlist"></use></svg>
                    {%- if section_st.icntyp != '3' -%}<b id="wishlistItems" class="cart-count pp">0</b>{%- endif -%}
                    <p class="m0{% if section_st.icntyp == '1' %} hide{% else %} hide-sm hide-md{% endif %}{% if section_st.icntyp == '2' %} pdt5{% endif %}">{{ 'sections.header.wishlist' | t }}</p>
                </a>
            {%- endif -%}

            {%- unless settings.catalog-mode -%}						
                <a href="{{ routes.cart_url }}" class="hdicon" id="cartLink" title="{{ 'sections.header.cart' | t }}">
                    <svg class="at-icon{% if section_st.icntyp == '3' %} hide-lg{% endif %}"><use xlink:href="#icon-cart"></use></svg>
                    {%- if section_st.icntyp != '3' -%}<b id="cart-icon-bubble" class="cart-count pp">{{ cart.item_count }}</b>{%- endif -%}
                    <p class="m0{% if section_st.icntyp == '1' %} hide{% else %} hide-sm hide-md{% endif %}{% if section_st.icntyp == '2' %} pdt5{% endif %}">{{ 'sections.header.cart' | t }}{% if section_st.icntyp == '3' %}<b id="cart-icon-bubble" class="cart-count pp">{{ cart.item_count }}</b>{% endif %}</p>
                </a>
            {%- endunless -%}
            {%- unless section_st.cntlogo -%}
                <a href="#" class="hdicon nav_toggle hide-lg" title="{{ 'sections.navigation.menu' | t }}"><svg class="at-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 464.205 464.205"><path d="m435.192 406.18h-406.179c-16.024 0-29.013-12.99-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.99 29.013 29.013-.001 16.023-12.99 29.013-29.014 29.013z"/><path d="m435.192 261.115h-406.179c-16.024 0-29.013-12.989-29.013-29.012s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.012-29.014 29.012z"/><path d="m435.192 116.051h-406.179c-16.024 0-29.013-12.989-29.013-29.013s12.989-29.013 29.013-29.013h406.18c16.023 0 29.013 12.989 29.013 29.013s-12.99 29.013-29.014 29.013z"/></svg></a>
            {%- endunless -%}
        </div>
        {%- liquid
            if settings.enable_search and section_st.leftcol == '3'  
                render 'search-drawer', search_type:search_type, cnt_width:cnt_width, is_rtl:is_rtl
            endif
        -%}
    </header>
    <nav id="main-nav__wrapper" class="hmbMenu anim pa w-100 hide-sm hide-md" role="navigation">
        <div class="pr h-100{% if section_st.fullwidth %} fw-section{% else %} page-width{% endif %}">
            {%- render 'navigation', section_st:section_st, secblk:section.blocks, cnt_width:cnt_width, ishmb:true -%}
        </div>
    </nav>
    <!--mmobile-->
    {%- render 'mobile-nav', section_st:section_st, secblk:section.blocks -%}
{%- endcapture -%}
{{- site_header | replace: '<!--mmobile-->', '</div>' | strip_newlines | remove: '  ' | remove: '	' -}}
{%- liquid
    if settings.enable_search and section_st.leftcol != '3'
        render 'search-drawer', search_type: search_type, cnt_width: cnt_width, is_rtl: is_rtl
    endif
-%}
{% schema %}
{
  "name": "Header - hamburger menu",
  "limit": 1,
  "class": "header-wrap pr hdr_Hamburger anim",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "ht",
      "min": 50,
      "max": 150,
      "step": 1,
      "label": "Height",
      "default": 70
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logowd",
      "min": 50,
      "max": 500,
      "step": 5,
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "cntlogod",
      "label": "Show logo in center",
      "default": false
    },
    {
      "type": "select",
      "id": "icntyp",
      "label": "Addons",
      "default": "1",
      "options": [
        {
          "label": "Icons only",
          "value": "1"
        },
        {
          "label": "Icon with text",
          "value": "2"
        },
        {
          "label": "Text only",
          "value": "3"
        }
      ]
    },
    {
      "type": "range",
      "id": "icon",
      "min": 12,
      "max": 50,
      "step": 1,
      "label": "Icon size",
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "fs",
      "min": 10,
      "max": 20,
      "step": 1,
      "label": "Font size",
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "cl",
      "label": "Icon and text",
      "default": "#555"
    },
    {
      "type": "color",
      "id": "clh",
      "label": "Icon and text hover",
      "default": "#000"
    },
    {
      "type": "select",
      "id": "leftcol",
      "label": "Extra Option",
      "default": "3",
      "info": "Enable currency & language from [theme settings](/editor?context=theme&category=currency and language)",
      "options": [
        {
          "label": "Promotional text",
          "value": "1"
        },
        {
          "label": "Currency & language",
          "value": "2"
        },
        {
          "label": "Search box",
          "value": "3"
        }
      ]
    },
    {
      "type": "header",
      "content": "Promotional text"
    },
    {
      "type": "checkbox",
      "id": "dislay_promo",
      "label": "Show",
      "default": true,
      "info": "Only for desktop and ipad view"
    },
    {
      "type": "image_picker",
      "id": "prico",
      "label": "Image/svg icon",
      "info": "[Available SVG icons.](https://adornthemes.com/documentation/vogal/svg-icons.html)",
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "range",
      "id": "prisz",
      "label": "Icon size",
      "default": 30,
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "text",
      "id": "promo_head",
      "label": "Heading",
      "default": "Expert Support",
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "color",
      "id": "prtcl",
      "label": "Color",
      "default": "#444",
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "range",
      "id": "prtfs",
      "label": "Font size",
      "default": 15,
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "select",
      "id": "prfw",
      "label": "Font weight",
      "default": "500",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Text",
      "default": "Available 24\/7 via chat",
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "color",
      "id": "prcl",
      "label": "Color",
      "default": "#111",
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "range",
      "id": "prfs",
      "label": "Font size",
      "default": 12,
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "visible_if": "{{section.settings.dislay_promo  }}"
    },
    {
      "type": "header",
      "content": "Sticky header"
    },
    {
      "type": "select",
      "id": "sticky_type",
      "label": "Sticky header",
      "default": "top",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "top",
          "label": "On scroll up"
        }
      ]
    },
    {
      "type": "header",
      "content": "Transparent header"
    },
    {
      "type": "checkbox",
      "id": "trhead",
      "label": "Enable for home page",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "trheadcl",
      "label": "Enable for collection page",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "trheadbg",
      "label": "Enable for blog page",
      "default": false
    },
