{{ 'premium-hero-slider.css' | asset_url | stylesheet_tag }}
{{ 'premium-hero-slider.js' | asset_url | script_tag }}

<div class="premium-hero">

  <div class="swiper premiumHeroSwiper">

    <div class="swiper-wrapper">

      {% for block in section.blocks %}

        <div class="swiper-slide" {{ block.shopify_attributes }}>

          <div class="hero-slide">

            {% if block.settings.desktop_image != blank %}

              <img
                src="{{ block.settings.desktop_image | image_url: width:2200 }}"
                alt="{{ block.settings.heading }}"
                class="hero-image desktop-image">

            {% endif %}

            {% if block.settings.mobile_image != blank %}

              <img
                src="{{ block.settings.mobile_image | image_url: width:900 }}"
                alt="{{ block.settings.heading }}"
                class="hero-image mobile-image">

            {% endif %}

            <div class="hero-overlay"></div>

            <div class="hero-content hero-{{ block.settings.alignment }}">

              {% if block.settings.subheading != blank %}
                <span class="hero-subtitle">
                  {{ block.settings.subheading }}
                </span>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h1>{{ block.settings.heading }}</h1>
              {% endif %}

              {% if block.settings.description != blank %}
                <p>{{ block.settings.description }}</p>
              {% endif %}

              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.button_link }}" class="hero-btn">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}

            </div>

          </div>

        </div>

      {% endfor %}

    </div>


    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>

  </div>

</div>

{% schema %}
{
  "name": "Premium Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Sub Heading",
          "default": "NEW ARRIVALS"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Luxury Footwear Collection"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Discover premium styles crafted for everyday comfort."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Content Alignment",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Hero Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}