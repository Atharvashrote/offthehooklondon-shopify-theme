{{- 'customer.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'customer.js' | asset_url }}" defer></script>
{%- assign section_st = section.settings -%}
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="page-width" style="--cl:{{ section_st.cl }};--fbg:{{ section_st.fbg }};--border_color:{{ section_st.bd }};max-width:600px;">
        <h1 class="page-title tc{% if settings.ttl_c %} text-upper{% endif %}">{{ 'customer.register.page_title' | t }}</h1>
        <div class="customerform form-vertical">
            {%- form 'create_customer' -%}
                {{- form.errors | default_errors -}}
                <div class="grid">
                    <div class="gitem wd50-md">
                        <label for="FirstName" class="hide">{{ 'customer.register.first_name' | t }}</label>
                        <input type="text" name="customer[first_name]" placeholder="{{ 'customer.register.first_name' | t }}" id="FirstName" {% if form.first_name %}value="{{ form.first_name }}"{% endif %} autofocus>
                    </div> 
                    <div class="gitem wd50-md">
                        <label for="LastName" class="hide">{{ 'customer.register.last_name' | t }}</label>
                        <input type="text" name="customer[last_name]" placeholder="{{ 'customer.register.last_name' | t }}" id="LastName" {% if form.last_name %}value="{{ form.last_name }}"{% endif %}>
                    </div>
                </div>
                <label for="Email" class="hide">{{ 'customer.register.email' | t }}</label>
                <input type="email" name="customer[email]" id="Email" placeholder="{{ 'customer.register.email' | t }}" class="{% if form.errors contains 'email' %} input--error{% endif %}" {% if form.email %} value="{{ form.email }}"{% endif %} autocorrect="off" autocapitalize="off">

                <label for="CreatePassword" class="hide">{{ 'customer.register.password' | t }}</label>
                <input type="password" name="customer[password]" placeholder="{{ 'customer.register.password' | t }}" id="CreatePassword" class="{% if form.errors contains 'password' %} input--error{% endif %}">

                <p class="mt20 mb20">
                    <input type="hidden" name="customer[accepts_marketing]" value="">
                    <label for="accepts_marketing" class="fl">
                    <input type="checkbox" id="accepts_marketing" name="customer[accepts_marketing]" class="custCheck" checked="checked">
                    <span class="checkbox"></span>  {{ 'customer.register.accepts_marketing' | t }}</label>
                </p>
                <button type="submit" class="btn {{ section_st.btn-submit }} {{ section_st.btn-size }} w-100">{{ 'customer.register.submit' | t }}</button>
            {%- endform -%}
        </div>
    </div>
</div>
<script src="{{ 'customer.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "Register page",
  "settings": [
        {
      "type": "header",
      "content": "Box"
    },
    {
      "type": "color",
      "id": "cl",
      "label": "Text",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "bd",
      "label": "Border",
      "default": "#eee"
    },
    {
      "type": "color",
      "id": "fbg",
      "label": "Background",
      "default": "#f4f4f4"
    },   
    {
      "type": "select",
      "id": "btn-submit",
      "label": "Submit button",
      "default": "btn1",
      "options": [
         {
          "label": "Button 1",
          "value": "btn1"
        },
        {
          "label": "Button 2",
          "value": "btn2"
        },
        {
          "label": "Button 3",
          "value": "btn3"
        },
        {
          "label": "Outline Button 1",
          "value": "btn4"
        },
        {
          "label": "Outline Button 2",
          "value": "btn5"
        },       
        {
          "label": "Link",
          "value": "btn-link"
        }
      ]
    },          
    {
      "type": "select",
      "id": "btn-size",
      "label": "Button size",
      "default": "btn-sm",
      "options": [
        {
          "label": "Small",
          "value": "btn-sm"
        },
        {
          "label": "Medium",
          "value": "btn-md"
        },
        {
          "label": "Large",
          "value": "btn-lg"
        }
      ]
    },
		{
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 25
    }
  ] 
}
{% endschema %}