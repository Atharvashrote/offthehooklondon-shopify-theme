{%- liquid
  assign is_rtl = false
  assign list_rtl = 'ar,dv,ha,he,ku,fa,ur,ug' | split: ','
  if list_rtl contains request.locale.iso_code or settings.rtl
    assign is_rtl = true
  endif
  if is_rtl
    assign left_right = 'right'
  else
    assign left_right = 'left'
  endif

  assign section_st = section.settings
  assign page_width = settings.cntwd | append: 'px'
  if section_st.sw
    assign page_width = '100vw'
  endif
  assign pageurl = canonical_url | split: '?type=' | last
-%}

{%- capture sct_styles -%}
{%- style -%}
    :root {
        --tfilter_bdr:{{ section_st.flbdr }};--filterby:{{ section_st.ttl_fs | minus:1 }}px;
        --opt_fs:{{ section_st.opt_fs }}px; --optp:{{ section_st.opt_fs | plus : 1 }}px;--hdcl:{{ section_st.ttl_cl }};--bubblebg:{{ section_st.ttl_cl | color_modify: 'alpha', 0.15 }};--opt_cl:{{ section_st.opt_cl }};--opt_clh:{{ section_st.opt_cl_hov }};
        --filter_bdr:{{ section_st.sw_bdr }}; --act_filter_bdr:{{ section_st.sw_bdra }};
        --swatch_size :{{section_st.swatch_size}}px; --swatch_rounded:{{section_st.swatch_rounded}}px;
         --active_filter_lbl:{{ section_st.active_filter_lbl }}; --active_filter_border:{{ section_st.active_filter_lbl }}; --clear_btn:{{ section_st.clear_btn }};--clear_btn_bg:{{ section_st.clear_btn_bg }};

    }
    {%- if section_st.bottom_border -%}.widget-title { --border:{{ section_st.flbtmbdr }} }{%- endif -%}
    {%- if section_st.ttlpreset == 'custom-hd' -%}
        .widget-title { --fs:{{ section_st.wdTtl }}px;--fsm:{{ section_st.wdTtlm }}px;--ff:var(--{{ section_st.wdTtlft }});--fw:{{ section_st.wdTtlwt }};--lh:1.2; }
    {%- endif -%}
    {%- if section_st.tbdr -%}
        .filter-horizontal { border-top:1px solid var(--tfilter_bdr); border-bottom:1px solid var(--tfilter_bdr) }
        .filter-horizontal .sidebar-widget { padding:15px 0 }
    {%- endif -%}
     price-range.filters-select__list .field:before { content:'{{ cart.currency.symbol }}'; position:absolute; top:7px; {{ left_right }}:15px; }  
{%- endstyle -%}
{%- endcapture -%}
{{- sct_styles | strip_newlines | remove: '	' -}}
{% capture seach_result %}

<div id="{{ section.id }}" data-section-type="collection-template">
{% paginate search.results by section_st.prpp %}
	{% unless search.results_count == 0 or search.performed == false %}
        <h1 class="page-title tc{% if settings.ttl_c %} text-upper{% endif %} mb25 mb40-md">{{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}</h1>
	{% endunless %}
  
{%- capture active_filters -%}
  	<div id="active-filters" class="active-facets fl f-wrap mb25 gap" style="--gap:10px">
        <a href="{{ search.url }}?q={{ search.terms }}" class="active-fl clear-all border-0">{{ 'collections.general.clear_all' | t }}</a>
        {%- for filter in search.filters -%}
            {%- for value in filter.active_values -%}
                <a class="active-fl" href="{{ value.url_to_remove }}">{{ value.label | escape }} <svg class="at-icon"><use xlink:href="#icon-close"></use></svg></a>
            {%- endfor -%}
            {%- if filter.type == "price_range" and filter.min_value.value != nil or filter.max_value.value != nil -%}
                <a class="active-fl" href="{{ filter.url_to_remove }}">
                  {% if filter.min_value.value %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %} - {% if filter.max_value.value %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %}
                  <svg class="at-icon"><use xlink:href="#icon-close"></use></svg>
                </a>
            {%- endif -%}
        {%- endfor -%}
	</div>
{%- endcapture -%}

{% capture product_list %}
	{% if search.performed  %}
		<div class="collection">
			<div id="collection-products" data-id="{{ section.id }}" class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products">
            	{% for item in search.results %}
                    {%- capture sizes -%}
                          {%- if section_st.filters and section_st.sbpos != 'top' and section_st.sbpos != 'popup' -%}
                              (min-width:1024px) calc(({{ page_width }} - {{ settings.grid_space | times: section_st.grid | minus:settings.grid_space | plus:340 }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ settings.grid_space | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ settings.grid_spacem | times: section_st.gridmb | minus:settings.grid_spacem }}px) / {{ section_st.gridmb }})
                          {%- else -%}
                              (min-width:1024px) calc(({{ page_width }} - {{ settings.grid_space | times: section_st.grid | minus:settings.grid_space }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ settings.grid_space | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ settings.grid_spacem | times: section_st.gridmb | minus:settings.grid_spacem }}px) / {{ section_st.gridmb }})
                          {%- endif -%}
                      {%- endcapture -%}
                    <div class="gitem {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
                      {%- case item.object_type -%}
                        {%- when 'product' -%}
                          {%- capture sizes -%}
                              {%- if section_st.filters and section_st.sbpos != 'top' and section_st.sbpos != 'popup' -%}
                                  (min-width:1024px) calc(({{ page_width }} - {{ settings.grid_space | times: section_st.grid | minus:settings.grid_space | plus:340 }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ settings.grid_space | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ settings.grid_spacem | times: section_st.gridmb | minus:settings.grid_spacem }}px) / {{ section_st.gridmb }})
                              {%- else -%}
                                  (min-width:1024px) calc(({{ page_width }} - {{ settings.grid_space | times: section_st.grid | minus:settings.grid_space }}px) / {{ section_st.grid }}),(min-width:768px) calc((100vw - {{ settings.grid_space | times: section_st.gridtb | minus:section_st.gspace }}px) / {{ section_st.gridtb }}), calc((100vw - {{ settings.grid_spacem | times: section_st.gridmb | minus:settings.grid_spacem }}px) / {{ section_st.gridmb }})
                              {%- endif -%}
                          {%- endcapture -%}
                          {% render 'product-card-grid', product: item, section_st: section.settings, sizes:sizes %}
                        {%- when 'article' -%}
                          {%- assign article = item -%}
                          <div class="grid-content">
                            <div class="grid-image__wrapper mb15">
                              <a class="grid-image" href="{{ item.url }}">
                                {% if article.image != blank %}
                                  {{ article.image | image_url: width: article.image.width | image_tag: loading:'lazy', class:'img-fit', sizes:sizes, widths:"180,320,400,560,740,900" }}
                                  <span class="pageLbl">{{ 'general.search.article_label' | t }}</span>
                                {% else %}
                                  <img class="img-fill" loading="lazy" src="https://dummyimage.com/600x600/f4f4f4/cccccc.png&text=+++{{ 'general.search.article_label' | t }}+++" width="600" height="600" alt="{{ article.title }}">
                                {% endif %}
                              </a>
                            </div>
                            <div class="grid-meta">
                              <div class="grid-title"><a href="{{ item.url }}">{{ item.title }}</a></div>
                            </div>
                          </div>
                      {%- when 'page' -%}
                        <div class="grid-content">
                          <div class="grid-image__wrapper mb15">
                            <a class="grid-image" href="{{ item.url }}">
                              <img class="img-fill" loading="lazy" src="https://dummyimage.com/600x600/f4f4f4/cccccc.png&text=+++{{ 'general.search.article_label' | t }}+++" width="600" height="600" alt="{{ item.title }}">
                              {{ 'general.search.page_label' | t }}
                            </a>
                          </div>
                          <div class="grid-meta"><div class="grid-title"><a href="{{ item.url }}">{{ item.title }}</a></div></div>
                        </div>
                        {%- endcase -%}
                    </div>
                {% endfor %}
			</div>
		</div>
  		<div id="pagination" class="pagination-wrapper">
            {%- if section_st.pagination == "infinite" or section_st.pagination == "button" -%}
                {%- if paginate.next -%}
                    <div class="infinitpagin tc">
                        {%-liquid
                          assign view_type = '&type=grid'
                          if pageurl == 'list'
                             assign view_type = '&type=list'
                          endif
                          assign pgurl = paginate.next.url
                          unless paginate.next.url contains "&type="
                            assign pgurl = paginate.next.url | append: view_type
                          endunless
                        -%}
                        {%- if section_st.pagination == "infinite" -%}
                            <a href="{{ pgurl }}" class="load-more infinite"><svg class="at-icon at-spin mb10" style="--icns:30px"><use xlink:href="#icon-loading"></use></svg><p>{{ 'general.pagination.loading' | t }}</p></a>
                        {%- else -%}
                            <a href="{{ pgurl }}" class="btn load-more"><span class="txt">{{ 'general.pagination.loadmore' | t }}</span><div class="loading__spinner"><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg></div></a>
                        {%- endif -%}
                    </div>
                {%- endif -%}
            {%- else -%}
                {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
        </div>
	{% endif %}
{% endcapture %}
  
	<collection-filters-form class="facets db {% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}" id="Collection">
      	{%- if search.performed and search.results.size > 0 -%}
            <div class="{% unless section_st.sbpos == 'top' %}fl f-col f-ais f-row-md{% endunless %}">
                {%- capture sidebar_blocks -%}
                    {%- content_for 'blocks' -%}
                {%- endcapture -%}
              {%- if section_st.filters and section_st.sbpos != 'top' -%}
    				  <filters-form class="sidebar sidebar-filter fl f-col gap anim{% if section_st.sbpos == 'popup' %} sidebar-popup custom-scroll{% endif %}{% if section_st.sbpos == 'right' %} order2 sb_right{% endif %}" id="collection-filters" data-id="{{ section.id }}" style="--gap:{{ section_st.sdgap }}px;--gapm:{{ section_st.sdgapm }}px;">
                    {{- sidebar_blocks -}}
                </filters-form>

    			{%- endif -%}

              <div class="main-col fl1 w-100">

                    {%- if section_st.filters and section_st.sbpos == 'top' -%}
    					<filters-form class="anim fl f-aic f-jcs f-col f-row-md filter-horizontal mb20 sidebar-filter{% if section_st.flshadow %} items-shadow{% endif %}" id="collection-filters" data-id="{{ section.id }}" style="--gap:{{ section_st.sdgap }}px;--gapm:{{ section_st.sdgapm }}px;">
                          {{- sidebar_blocks -}}
                        </filters-form>
    				{%- endif -%}

                    <div class="toolbar fl f-jcsb f-aic mb15 fs13">                  	
                       {%- if section_st.filters -%}
                     	 <button type="button" class="btn-filter fl f-jcc f-aic-md text-upper fw-500 pd0 mr15 border-0{% if section_st.sbpos != 'popup' %} hide-lg{% endif %}" area-label="{{ 'collections.general.filter_button' | t }}">
                          <svg class="at-icon mr5" fill="none" height="512" viewBox="0 0 24 24" width="512" xmlns="http://www.w3.org/2000/svg"><path d="m3 6.25c-.41421 0-.75.33579-.75.75s.33579.75.75.75zm0 10c-.41421 0-.75.3358-.75.75s.33579.75.75.75zm6 1.5c.41421 0 .75-.3358.75-.75s-.33579-.75-.75-.75zm12 0c.4142 0 .75-.3358.75-.75s-.3358-.75-.75-.75zm-6-11.5c-.4142 0-.75.33579-.75.75s.3358.75.75.75zm6 1.5c.4142 0 .75-.33579.75-.75s-.3358-.75-.75-.75zm-18 0h3v-1.5h-3zm0 10h6v-1.5h-6zm15 0h3v-1.5h-3zm-3-10h6v-1.5h-6zm2.25 9.25c0 1.2426-1.0074 2.25-2.25 2.25v1.5c2.0711 0 3.75-1.6789 3.75-3.75zm-2.25 2.25c-1.2426 0-2.25-1.0074-2.25-2.25h-1.5c0 2.0711 1.6789 3.75 3.75 3.75zm-2.25-2.25c0-1.2426 1.0074-2.25 2.25-2.25v-1.5c-2.0711 0-3.75 1.6789-3.75 3.75zm2.25-2.25c1.2426 0 2.25 1.0074 2.25 2.25h1.5c0-2.0711-1.6789-3.75-3.75-3.75zm-3.75-7.75c0 1.24264-1.0074 2.25-2.25 2.25v1.5c2.0711 0 3.75-1.67893 3.75-3.75zm-2.25 2.25c-1.24264 0-2.25-1.00736-2.25-2.25h-1.5c0 2.07107 1.67893 3.75 3.75 3.75zm-2.25-2.25c0-1.24264 1.00736-2.25 2.25-2.25v-1.5c-2.07107 0-3.75 1.67893-3.75 3.75zm2.25-2.25c1.2426 0 2.25 1.00736 2.25 2.25h1.5c0-2.07107-1.6789-3.75-3.75-3.75z" fill="#28303f"/></svg>
                           {{ 'collections.general.filter_button' | t }}
                        </button>
                       {%- endif -%}                     
                	</div>
                    {{ active_filters }}
                    {{ product_list }}
                    <br/>
                </div>          
            </div>
      	{%- else -%}
            <div class="noresult">
                <h1 class="page-title tc{% if settings.ttl_c %} text-upper{% endif %} mb25 mb40-md">{{ settings.search_ttl }}</h1>
                <p class="tc">{{ 'general.search.no_results_html' | t: terms: search.terms }}</p>
                <form action="{{ routes.search_url }}" method="get" class="search pr searchInPage wd50-md m-auto" role="search" style="box-shadow:0 0 25px 5px {{ settings.bodycl | color_modify:'alpha', 0.1 }};border-radius:{{ settings.search_rad }}px;">
                    <div class="adth-inputs fl">
                        <input class="search-input w-100" type="search" name="q" placeholder="{{ settings.search_ph }}" value="{{ search.terms | escape }}" autocomplete="off" />
                        <button class="btn search-submit" type="submit"><svg class="at-icon"><use xlink:href="#icon-search"></use></svg> <span class="fallback_txt">{{ 'general.search.submit' | t }}</span></button>
                    </div>
                </form>
            </div>
      		<p>&nbsp;</p><p>&nbsp;</p>
      	{%- endif -%}
      	
 	</collection-filters-form>
{%- endpaginate -%}
</div>
{% endcapture %}
<div
  class="section-cover"
  style="--sbg:{{ section_st.bg }};--sst:{{ section_st.sst }}px;--ssb:{{ section_st.ssb }}px;--sstm:{{ section_st.sstm }}px;--ssbm:{{ section_st.ssbm }}px"
>
  {{ seach_result | strip_newlines | remove: '	' }}
</div>
{%- for filter in search.filters -%}
  {% if filter.type == 'price_range' %}
    <script src="{{ 'toolcool-range-slider.min.js' | asset_url }}" defer="defer"></script>
  {% endif %}
{%- endfor -%}
<script src="{{ 'collections.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Search page",
  "enabled_on": {"templates": ["search"]},
  "settings": [
    {
      "type": "header",
      "content": "Products toolbar"
    },
    {
      "type": "checkbox",
      "id": "pcount",
      "label": "Show product count",
      "default": true
    },       
    {
      "type": "header",
      "content": "Products per row"
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Desktop",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridtb",
      "label": "Tablet",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridmb",
      "label": "Mobile",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1
    },
    {
      "type": "range",
      "id": "prpp",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 12,
      "label": "Products limit (per page)"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination",
      "default": "button",
      "options": [
        { "value": "default", "label": "Classic" },
        { "value": "infinite", "label": "Infinite scroll" },
        { "value": "button", "label": "Load more button" }
      ]
    },
    {
      "type": "header",
      "content": "Sidebar and filters"
    },
    {
      "type": "checkbox",
      "id": "filters",
      "default": true,
      "label": "Enable sidebar"
    },
    {
      "type": "select",
      "id": "sbpos",
      "label": "Filters position",
      "default": "left",
      "options": [
        { "value": "top", "label": "Horizontal" },
        { "value": "left", "label": "Left sidebar" },
        { "value": "right", "label": "Right sidebar" },
        { "value": "popup", "label": "Drawer" }
      ],
      "visible_if": "{{ section.settings.filters }}"
    },
    {
        "type": "paragraph",
        "content": "Horizontal will display dynamic filters block only.",
        "visible_if": "{{ section.settings.filters and section.settings.sbpos == 'top' }}"
    },
    {
      "type": "header",
      "content": "Horizontal",
      "visible_if": "{{ section.settings.filters and  section.settings.sbpos == 'top' }}"
    },
    {
      "type": "color",
      "id": "flbdr",
      "label": "Blocks border",
      "default": "#eee",
      "visible_if": "{{ section.settings.filters and  section.settings.sbpos == 'top'}}"
    },
    {
      "type": "checkbox",
      "id": "flshadow",
      "label": "Enable shadow",
      "default": true,
      "visible_if": "{{ section.settings.filters and  section.settings.sbpos == 'top' }}"
    },
    {
      "type": "range",
      "id": "sdgap",
      "label": "Block gap",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.filters }}"
    },
    {
      "type": "range",
      "id": "sdgapm",
      "label": "Block gap (mobile)",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.filters }}"
    },
    {
      "type": "checkbox",
      "id": "show_toggle_icon",
      "label": "Show toggle icon",
      "default": true,
      "visible_if": "{{ section.settings.filters }}"
    },
    {
      "type": "header",
      "content": "Block titles"
    },
    {
      "type": "color",
      "id": "ttl_cl",
      "label": "Color",
      "default": "#000"
    },
    {
      "type": "select",
      "id": "ttlpreset",
      "label": "Preset",
      "info": "Edit presets in [theme settings](/editor?context=theme&category=Typography and Colors)",
      "default": "custom-hd",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "text-1",
          "label": "Text 1"
        },
        {
          "value": "text-2",
          "label": "Text 2"
        },
        {
          "value": "custom-hd",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "wdTtlft",
      "label": "Font",
      "default": "ft1",
      "options": [
        {
          "value": "ft1",
          "label": "Body font"
        },
        {
          "value": "ft2",
          "label": "Heading font"
        },
        {
          "value": "ft3",
          "label": "Accent font"
        }
      ],
      "visible_if": "{{ section.settings.ttlpreset == 'custom-hd' }}"
    },
    {
      "type": "range",
      "id": "wdTtl",
      "label": "Font size",
      "default": 15,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.ttlpreset == 'custom-hd' }}"
    },
    {
      "type": "range",
      "id": "wdTtlm",
      "label": "Font size (mobile)",
      "default": 15,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.ttlpreset == 'custom-hd' }}"
    },    
    {
      "type": "select",
      "id": "wdTtlwt",
      "label": "Font weight",
      "default": "600",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "visible_if": "{{ section.settings.ttlpreset == 'custom-hd' }}"
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Text case",
      "default": "text-upper",
      "options": [
        { "value": "text-upper", "label": "Uppercase" },
        { "value": "ttn", "label": "Default" }
      ]
    },
    {
      "type": "checkbox",
      "id": "bottom_border",
      "label": "Bottom border",
      "default": false
    },
    {
      "type": "color",
      "id": "flbtmbdr",
      "label": "Border color",
      "default": "#eee",
      "visible_if": "{{ section.settings.bottom_border }}"
    },

    {
      "type": "header",
      "content": "Filters & links"
    },
    {
      "type": "range",
      "id": "opt_fs",
      "label": "Font size",
      "default": 13,
      "min": 10,
      "max": 25,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "opt_text_case",
      "label": "Text case",
      "default": "ttn",
      "options": [
        { "value": "text-upper", "label": "Uppercase" },
        { "value": "ttn", "label": "Default" }
      ]
    },
    {
      "type": "color",
      "id": "opt_cl",
      "label": "Text/links color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "opt_cl_hov",
      "label": "Links color (active)",
      "default": "#fe877b"
    },
    {
      "type": "color",
