{%- capture quotes -%}
{%- assign section_st = section.settings -%}
<svg style="position:absolute;width:0;height:0;" width="0" height="0" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <defs>
        <symbol id="icon-star1" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><polygon points="512,197.816 325.961,185.585 255.898,9.569 185.835,185.585 0,197.816 142.534,318.842 95.762,502.431 255.898,401.21 416.035,502.431 369.263,318.842"/></symbol>
        <symbol id="icon-star" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M512,197.819l-185.933-12.228L256,9.571l-70.067,176.021L0,197.82l142.658,120.93L95.856,502.429L256,401.214 l160.144,101.215l-46.8-183.671L512,197.819z M256,365.724l-112.464,71.08l32.827-128.831L75.829,222.888l130.971-8.603 L256,90.687l49.2,123.599l131.124,8.602l-100.689,85.077l32.829,128.839L256,365.724z"/></symbol>
    </defs>
</svg>
{%- if section_st.preset == 'custom-hd' -%}
<style>#{{ section.id }} .head { --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }}; }</style>
{%- endif -%}
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    {%- capture style -%}
        --img_size:{{ section_st.img_size }}px;--rating:{{ section_st.icon_cl }};--icns:{{ section_st.icon_size }}px;--bg:{{ section_st.bbg }};--border:{{ section_st.box_bdr }};--bpd:{{ section_st.bpd }}px;--fsa:{{ section_st.tfs | minus : 2 }}px;
        {%- if section_st.tpreset == 'custom' -%}--fs:{{ section_st.tfs }}px;--fsm:{{ section_st.tfsm }}px;--ff:var(--{{ section_st.tff }});--fw:{{ section_st.tfw }};--lh:{{ section_st.tlh }};{%- endif -%}
    {%- endcapture -%}	
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %}" data-section-id="{{ section.id }}" data-section-style="quote{{ section_st.style }}">
        <div class="quotes quote{{ section_st.style }}" style="{{ style }}">
            {%- if section.blocks.size > 0 -%}
                {%- render 'sec-title' -%}
                {%- capture testimonialdata -%}
                  {%- for block in section.blocks -%}
                    {%- liquid
                        assign block_st = block.settings
                        assign slide_index = forloop.index0
                        capture start_ratings
                            for i in (1..5)
                            assign num = forloop.index
                            if num <= block_st.rating
                                echo '<svg class="at-icon" style="enable-background:new 0 0 512 512;"><use xlink:href="#icon-star1"></use></svg>'
                            else
                                echo '<svg class="at-icon" style="enable-background:new 0 0 512 512;"><use xlink:href="#icon-star"></use></svg>'
                            endif
                            endfor
                        endcapture
                        assign image_size = section_st.img_size | plus: 50 | append: 'px'
                        assign image_alt = block_st.image.alt | default: block_st.author
                    -%}
                        {%- if section_st.style == '4' -%}
                            <div class="testi-marquee-item fl f-col f-jcs" id="{{ block.id }}" data-slide="{{ slide_index }}" {{ block.shopify_attributes }}>
                                <div class="quote-content fl f-col f-jcs w-100 h-100 border {{ section_st.rounded }} t-{{ section_st.align }}" style="--cl:{{ section_st.cl }};">
                                    {%- if block_st.rat -%}<span class="ratings mb15 db">{{ start_ratings }}</span>{% endif %}
                                    {%- if block_st.title != blank -%}<{{ section_st.htag }} class="head {{ section_st.preset }} mb10">{{ block_st.title }}</{{ section_st.htag }}>{% endif %}
                                    {%- if block_st.text != blank -%}<div class="rte reg-text mb20">{{ block_st.text }}</div>{% endif %}
                                    {%- assign product = all_products[block_st.prod] -%}
                                    {%- if product.title.size > 0 -%}
                                        <div class="review-product">
                                            <div class="fl f-aic">
                                                <div class="mini-products__img mr15">
                                                    <a class="db grid-image" href="{{ product.url | within: collection }}">
                                                        {{ product.featured_image | image_url: width: product.featured_image.width | image_tag: loading:'lazy', width:product.featured_image.width, height:product.featured_image.height, class:'img-fit', sizes:'80px', widths:"100,200,320" }}
                                                    </a>
                                                </div>
                                                <a href="{{ product.url | within: collection }}" class="grid-meta t-left">{{ product.title }}</a>
                                            </div>
                                        </div>
                                    {%- endif -%}
                                    <div class="testi-marquee-author fl f-aic mt-auto">
                                        {%- if block_st.image != blank -%}
                                            <div class="testi-marquee-avatar pr of-hidden">
                                                {{ block_st.image | image_url: width: block_st.image.width | image_tag: loading:'lazy', class:'img-fit', sizes: '60px', widths:"60,100,120", alt:image_alt }}
                                            </div>
                                        {%- endif -%}
                                        {%- if block_st.author != blank -%}<div class="reg-text fw-600" style="--lh:1.3;">{{ block_st.author }}</div>{%- endif -%}
                                    </div>
                                </div>
                            </div>
                        {%- else -%}
                        <div class="{% if section_st.style != '3' %}swiper-slide {% endif %}gitem fckSl{% if section_st.style != '1' %} wd50-md wd33-lg{% endif %}{% if section_st.style == '3' %} wd33-md msitem{% endif %}{% if block.settings.author_pic != blank %} apic{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %} id="{{ block.id }}" data-slide="{{ slide_index }}" {{ block.shopify_attributes }}>
                            <div class="quote-content fl f-col f-jcs m-auto w-100 h-100 border {{ section_st.rounded }} t-{{ section_st.align }}" style="--cl:{{ section_st.cl }};"> 
                                {%- if block_st.image != blank -%}
                                    <div class="quote-img pr of-hidden{% if section_st.align == 'left' %} ml0{% elsif section_st.align == 'right' %} mr0{% endif %}">
                                        {{ block_st.image | image_url: width: block_st.image.width | image_tag: loading:'lazy', class:'img-fit', sizes: image_size, widths:"100,200,300", alt:image_alt }}
                                    </div>
                                {%- endif -%}

                                {%- if block_st.title != blank -%}<{{ section_st.htag }} class="head {{ section_st.preset }} mb10">{{ block_st.title }}</{{ section_st.htag }}>{% endif %}
                                {%- if block_st.text != blank -%}<div class="rte reg-text mb20">{{ block_st.text }}</div>{% endif %}
                                {%- if block_st.rat -%}<span class="ratings">{{ start_ratings }}</span>{% endif %}
                                {%- if block_st.author != blank -%}<div class="reg-text mt10">{{ block_st.author }}</div>{%- endif -%}                              

                                {%- assign product = all_products[block_st.prod] -%}
								{%- if product.title.size > 0 -%}
								<div class="review-product">
									<div class="fl f-aic">
										<div class="mini-products__img mr15">
    										<a class="db grid-image" href="{{ product.url | within: collection }}">
                              {{ product.featured_image | image_url: width: product.featured_image.width | image_tag: loading:'lazy', width:product.featured_image.width, height:product.featured_image.height, class:'img-fit', sizes:'80px', widths:"100,200,320" }}
    										</a>
										</div>
										<a href="{{ product.url | within: collection }}" class="grid-meta t-left">{{ product.title }}</a>
									</div>
								</div>
								{%- endif -%}
                            </div>
                        </div>
                        {%- endif -%}
                    {%- endfor -%}
                {%- endcapture -%}

                {%- if section_st.style == '4' -%}
                    <div class="testi-marquee-wrap{% if section_st.spause %} pause-hover{% endif %}" style="--tmgap:{{ section_st.mgap }}px;--tmspeed:{{ section_st.sspeed }}s;--tmspeedm:{{ section_st.sspeedm }}s;--cardw:{{ section_st.scardw }}px;--cardwm:{{ section_st.scardwm }}px;">
                        {%- for i in (0..3) -%}
                            <div class="testi-marquee{% if section_st.sdir == 'right' %} reverse{% endif %}">{{ testimonialdata }}</div>
                        {%- endfor -%}
                    </div>
                {%- elsif section_st.style != '3' -%}
                    <slide-section class="grid swiper{% if section_st.box_shadow %} has-shadow{% endif %}" data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                        <div class="swiper-wrapper h-auto mb15">{{ testimonialdata }}</div>
                        {% render 'swiper-navigation', id:section.id, section_st:section_st %}
                    </slide-section>
                {%- else -%}
                    <grid-masonary class="grid grid-masonary{% if section_st.box_shadow %} has-shadow{% endif %}">
                        <div class="grid-sizer wd33 pa"></div>
                        {{ testimonialdata }}
                    </grid-masonary>
                {%- endif -%}
            {%- endif -%}
            {%- if section.blocks.size == 0 -%}{%- render 'no-blocks' -%}{%- endif -%}
        </div>
    </div>
</div>
{%- endcapture -%}
{{- quotes | strip_newlines | remove: '  ' | remove: '	' -}}
{%- schema -%}
{
  "name": "Testimonials",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Testimonials"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Highlight the experiences and satisfaction of clients</p>"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "3 Columns"
        },
        {
          "value": "3",
          "label": "3 Columns (masonry)"
        },
        {
          "value": "4",
          "label": "Scrolling (autoplay)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Text appearance"
    },
    {
      "type": "text_alignment",
      "id": "align",
      "label": "Alignment",
      "default": "center"
    },
    {
      "type": "select",
      "id": "htag",
      "label": "Heading tag",
      "info": "Specify heading type to improve SEO and accessibility.",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "P"
        }
      ]
    },
    {
      "type": "select",
      "id": "preset",
      "label": "Heading preset",
      "info": "Edit presets in [theme settings](/editor?context=theme&category=Typography and Colors)",
      "default": "h5",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "text-1",
          "label": "Text 1"
        },
        {
          "value": "text-2",
          "label": "Text 2"
        },
        {
          "value": "custom-hd",
          "label": "Custom"
        }
      ]
    },
     {
      "type": "select",
      "id": "ff",
      "label": "Font",
      "default": "ft2",
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}",
      "options": [
        {
          "value": "ft1",
          "label": "Body font"
        },
        {
          "value": "ft2",
          "label": "Heading font"
        },
        {
          "value": "ft3",
          "label": "Accent font"
        }
      ]
    },
    {
      "type": "range",
      "id": "fs",
