    },
    {
      "type": "range",
      "id": "fsm",
      "label": "Font size (mobile)",
      "default": 18,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}"
    },   
    {
      "type": "select",
      "id": "fw",
      "label": "Font weight",
      "default": "600",
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
