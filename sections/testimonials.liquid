      "default": 1.2,
      "min": 0.7,
      "max": 2.0,
      "step": 0.1,
      "visible_if": "{{ section.settings.preset == 'custom-hd' }}"
    },
    {
      "type": "select",
      "id": "tpreset",
      "label": "Text preset",
      "info": "Edit presets in [theme settings](/editor?context=theme&category=Typography and Colors)",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "tff",
      "label": "Font",
      "default": "ft1",
      "visible_if": "{{ section.settings.tpreset == 'custom' }}",
      "options": [
        {
          "value": "ft1",
          "label": "Body font"
        },
        {
          "value": "ft2",
          "label": "Heading font"
        },
        {
          "value": "ft3",
          "label": "Accent font"
        }
      ]
    },
    {
      "type": "range",
      "id": "tfs",
      "label": "Font size",
      "default": 13,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.tpreset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "tfsm",
      "label": "Font size (mobile)",
      "default": 13,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.tpreset == 'custom' }}"
    },    
    {
      "type": "select",
      "id": "tfw",
      "label": "Font weight",
      "default": "400",
      "visible_if": "{{ section.settings.tpreset == 'custom' }}",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "tlh",
      "label": "Line height",
      "default": 1.5,
      "min": 0.7,
      "max": 2.0,
      "step": 0.1,
      "visible_if": "{{ section.settings.tpreset == 'custom' }}"
    },
    {
      "type": "paragraph",
      "content": "----------------------------------------------"
    },
    {
      "type": "range",
      "id": "img_size",
      "label": "Image icon size",
      "default": 90,
      "min": 50,
      "max": 200,
      "step": 5
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Rating icon size",
      "default": 14,
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "icon_cl",
      "label": "Rating icon color",
      "default": "#EBB868"
    },
    {
      "type": "paragraph",
      "content": "----------------------------------------------"
    },
    {
      "type": "color",
      "id": "cl",
      "label": "Text color",
      "default": "#333"
    },
    {
      "type": "color",
      "id": "bbg",
      "label": "Background",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "box_bdr",
      "label": "Border",
      "default": "#eee"
    },
    {
      "type": "range",
      "id": "bpd",
      "label": "Text padding",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "rounded",
