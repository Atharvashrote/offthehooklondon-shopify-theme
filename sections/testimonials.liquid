      "default": true,
      "visible_if": "{{ section.settings.style != '4' }}"
    },
    {
      "type": "checkbox",
      "id": "arrowm",
      "label": "Show arrows on mobile",
      "default": false,
      "visible_if": "{{ section.settings.style != '4' }}"
    },
    {
      "type": "checkbox",
      "id": "dot",
      "label": "Show dots on desktop",
      "default": false,
      "visible_if": "{{ section.settings.style != '4' }}"
    },
    {
      "type": "checkbox",
      "id": "dotm",
      "label": "Show dots on mobile",
      "default": true,
      "visible_if": "{{ section.settings.style != '4' }}"
    },
    {
      "type": "header",
      "content": "Scrolling settings",
      "visible_if": "{{ section.settings.style == '4' }}"
    },
    {
      "type": "select",
      "id": "sdir",
      "label": "Direction",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "visible_if": "{{ section.settings.style == '4' }}"
    },
    {
      "type": "range",
      "id": "sspeed",
      "label": "Scroll speed",
      "info": "Lower is faster",
      "default": 30,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.style == '4' }}"
    },
    {
      "type": "range",
      "id": "sspeedm",
      "label": "Scroll speed (mobile)",
      "info": "Lower is faster",
      "default": 20,
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.style == '4' }}"
    },
    {
      "type": "checkbox",
      "id": "spause",
      "label": "Pause on hover",
      "default": true,
      "visible_if": "{{ section.settings.style == '4' }}"
    },
    {
      "type": "range",
      "id": "scardw",
      "label": "Card width",
      "default": 380,
      "min": 250,
      "max": 550,
      "step": 10,
      "unit": "px",
      "visible_if": "{{ section.settings.style == '4' }}"
    },
    {
      "type": "range",
      "id": "scardwm",
      "label": "Card width (mobile)",
      "default": 280,
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "visible_if": "{{ section.settings.style == '4' }}"
    },
    {
      "type": "range",
      "id": "mgap",
      "label": "Gap between cards",
      "default": 24,
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "visible_if": "{{ section.settings.style == '4' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },
    {
        "type": "checkbox",
        "id": "npd",
        "label": "Remove side margins",
