{% comment %}
  ============================================================
  QUICK LINKS GRID
  ============================================================

  Metaobject type:
  quick_link

  Fields:
  - title
  - featured_image
  - quicklink_short_description
  - main_content
  - seo_title
  - seo_description

  Layout:
  - 3 columns desktop
  - 2 columns tablet
  - 1 column mobile
  - Text links only
  - Arrow icon
  - No images
  - No cards
  - No date
  - No Read More
{% endcomment %}


<section
  id="quick-links-grid-{{ section.id }}"
  class="quick-links-grid"
>

  <div class="quick-links-grid__container">

    {% comment %}
      =========================
      HEADER
      =========================
    {% endcomment %}

    {% if section.settings.heading != blank or section.settings.subheading != blank %}

      <div class="quick-links-grid__header">

        {% if section.settings.heading != blank %}

          <h2 class="quick-links-grid__heading">
            {{ section.settings.heading }}
          </h2>

        {% endif %}


        {% if section.settings.subheading != blank %}

          <p class="quick-links-grid__subheading">
            {{ section.settings.subheading }}
          </p>

        {% endif %}

      </div>

    {% endif %}


    {% comment %}
      =========================
      QUICK LINKS
      =========================
    {% endcomment %}

    {% assign quick_links = metaobjects.quick_link.values %}


    {% if quick_links != blank %}

      <div class="quick-links-grid__items">

        {% for quick_link in quick_links %}

          {% assign quick_link_title = quick_link.title.value %}
          {% assign quick_link_url = quick_link.system.url %}


          {% if quick_link_url != blank and quick_link_title != blank %}

            <a
              href="{{ quick_link_url }}"
              class="quick-links-grid__link"
            >

              <span
                class="quick-links-grid__arrow"
                aria-hidden="true"
              >
                →
              </span>

              <span class="quick-links-grid__text">
                {{ quick_link_title }}
              </span>

            </a>

          {% endif %}

        {% endfor %}

      </div>


    {% else %}

      <div class="quick-links-grid__empty">

        <p>
          No Quick Links are available yet.
        </p>

      </div>

    {% endif %}

  </div>

</section>


<style>

/* ============================================================
   SECTION
   ============================================================ */

#quick-links-grid-{{ section.id }} {

  width:100%;

  background:
    {{ section.settings.background_color }};

  padding-top:
    {{ section.settings.desktop_padding }}px;

  padding-bottom:
    {{ section.settings.desktop_padding }}px;

  box-sizing:border-box;
}


/* ============================================================
   CONTAINER
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__container {

  width:100%;

  max-width:1400px;

  margin:0 auto;

  padding-left:35px;

  padding-right:35px;

  box-sizing:border-box;
}


/* ============================================================
   HEADER
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__header {

  width:100%;

  text-align:center;

  margin:0 0 35px;
}


/* ============================================================
   HEADING
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__heading {

  display:block !important;

  margin:0 !important;

  padding:0 !important;

  color:
    {{ section.settings.heading_color }} !important;

  font-family:inherit !important;

  font-size:30px !important;

  line-height:1.3 !important;

  font-weight:500 !important;

  letter-spacing:-0.2px !important;
}


/* ============================================================
   SUBHEADING
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__subheading {

  display:block !important;

  max-width:650px;

  margin:9px auto 0 !important;

  padding:0 !important;

  color:
    {{ section.settings.text_color }} !important;

  font-family:inherit !important;

  font-size:15px !important;

  line-height:1.5 !important;

  font-weight:400 !important;
}


/* ============================================================
   GRID
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__items {

  display:grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  column-gap:55px;

  row-gap:24px;

  width:100%;
}


/* ============================================================
   LINK
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__link {

  display:flex !important;

  align-items:flex-start !important;

  gap:14px;

  width:100%;

  margin:0 !important;

  padding:0 !important;

  color:
    {{ section.settings.link_color }} !important;

  font-family:inherit !important;

  font-size:16px !important;

  line-height:1.5 !important;

  font-weight:400 !important;

  text-decoration:none !important;

  text-transform:none !important;

  background:transparent !important;

  border:0 !important;

  box-shadow:none !important;

  transition:
    color .2s ease;
}


/* ============================================================
   ARROW
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__arrow {

  display:inline-block;

  flex:0 0 auto;

  width:18px;

  color:
    {{ section.settings.arrow_color }};

  font-size:19px;

  line-height:1.35;

  font-weight:400;

  text-align:left;

  transition:
    transform .2s ease,
    color .2s ease;
}


/* ============================================================
   TEXT
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__text {

  display:block;

  flex:1 1 auto;

  min-width:0;

  color:
    {{ section.settings.link_color }};

  font-size:16px;

  line-height:1.5;

  font-weight:400;

  text-decoration:none;

  transition:
    color .2s ease;
}


/* ============================================================
   HOVER
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__link:hover {

  color:
    {{ section.settings.link_hover_color }} !important;

  text-decoration:none !important;
}


#quick-links-grid-{{ section.id }}
.quick-links-grid__link:hover
.quick-links-grid__text {

  color:
    {{ section.settings.link_hover_color }};
}


#quick-links-grid-{{ section.id }}
.quick-links-grid__link:hover
.quick-links-grid__arrow {

  color:
    {{ section.settings.link_hover_color }};

  transform:translateX(3px);
}


/* ============================================================
   EMPTY STATE
   ============================================================ */

#quick-links-grid-{{ section.id }}
.quick-links-grid__empty {

  width:100%;

  padding:40px 20px;

  text-align:center;
}


#quick-links-grid-{{ section.id }}
.quick-links-grid__empty p {

  margin:0;

  color:
    {{ section.settings.text_color }};

  font-size:15px;

  line-height:1.5;
}


/* ============================================================
   TABLET
   ============================================================ */

@media screen and (max-width:991px) {

  #quick-links-grid-{{ section.id }} {

    padding-top:
      {{ section.settings.mobile_padding }}px;

    padding-bottom:
      {{ section.settings.mobile_padding }}px;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__container {

    padding-left:25px;

    padding-right:25px;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__items {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    column-gap:40px;

    row-gap:22px;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__link {

    font-size:15px !important;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__text {

    font-size:15px;
  }

}


/* ============================================================
   MOBILE
   ============================================================ */

@media screen and (max-width:767px) {

  #quick-links-grid-{{ section.id }} {

    padding-top:
      {{ section.settings.mobile_padding }}px;

    padding-bottom:
      {{ section.settings.mobile_padding }}px;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__container {

    padding-left:18px;

    padding-right:18px;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__header {

    margin-bottom:28px;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__heading {

    font-size:25px !important;

    line-height:1.3 !important;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__subheading {

    font-size:14px !important;

    line-height:1.5 !important;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__items {

    grid-template-columns:1fr;

    column-gap:0;

    row-gap:18px;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__link {

    gap:12px;

    font-size:15px !important;

    line-height:1.5 !important;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__arrow {

    width:17px;

    font-size:18px;
  }


  #quick-links-grid-{{ section.id }}
  .quick-links-grid__text {

    font-size:15px;

    line-height:1.5;
  }

}

</style>


{% schema %}

{
  "name": "Quick Links Grid",

  "tag": "section",

  "class": "quick-links-grid-section",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick Links"
    },

    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our helpful guides and information."
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Subheading color",
      "default": "#555555"
    },

    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#222222"
    },

    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#555555"
    },

    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#222222"
    },


    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "desktop_padding",
      "label": "Desktop top/bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 45,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile top/bottom padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "px"
    }

  ],


  "presets": [
    {
      "name": "Quick Links Grid"
    }
  ]

}

{% endschema %}