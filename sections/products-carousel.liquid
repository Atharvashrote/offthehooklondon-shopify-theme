{%- capture productslider -%}
{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
-%}
{%- capture sizes -%}
  {%- if section_st.peek -%}
  (min-width:1025px) calc(100vw / 4.6),(min-width:767px) calc(100vw / 3.2), calc(100vw / 1.6)
  {%- else -%}
  (min-width:1024px) calc({{ page_width }} / {{ section_st.grid }}),(min-width:768px) calc(100vw / {{ section_st.gridtb }}), calc(100vw / {{ section_st.gridmb }})
  {%- endif -%}
{%- endcapture -%}
{%- if section_st.peek -%}
{%- liquid
  assign glide_ms = section_st.speed | at_least: 4 | times: 1000
  if section_st.products != blank
    assign peek_count = section_st.products.size
  else
    assign peek_count = section_st.collection.products_count | default: 0
  endif
  assign peek_count = peek_count | at_most: section_st.rows
  # Swiper 8 with slidesPerView auto clones only one set of slides; when that set is narrower than the window the loop jams at the end. Clone at least 6.
  assign peek_clones = peek_count | at_least: 6
  # Peek cards are ~290px (desktop) / ~225px (mobile) wide; these steps cover 2x-3x screens. Other modes keep the card default.
  assign card_widths = '320,460,640,800,960,1200'
-%}
<script src="{{ 'products-carousel-peek.js' | asset_url }}" defer></script>
<style>
  /* Peek layout: left-aligned header, cards run off the right edge so the next one peeks in.
     Cards are 382:575 portrait; square product shots sit inside with contain on their own #f3f3f1 background. */
  .pc-peek { --pc-n:1.6; --grid-img_ratio:150.524%; --grid-img_size:contain; }
  .pc-peek > .page-width { --pc-pl:max(var(--site_gutter), calc((100vw - {{ settings.cntwd }}px) / 2 + var(--site_gutter))); max-width:none; padding-right:0; padding-left:var(--pc-pl); }
  .pc-peek .section-header, .pc-peek .section-header.tc { text-align:start !important; align-items:flex-start; padding-right:var(--site_gutter); }
  .pc-peek .section-header:after { margin-left:0; margin-right:0; }
  /* Slider window bleeds to the screen's left edge (cards sliding out are not clipped at the gutter);
     the padding keeps the first card on the content edge. Swiper subtracts container padding. */
  .pc-peek .grid-products { margin-right:0; margin-left:calc(-1 * var(--pc-pl)); padding-left:calc(var(--pc-pl) - var(--grid_productsm)); container-type:inline-size; }
  .pc-peek .grid-products .gitem { width:calc(100% / var(--pc-n)); }
  .pc-peek .grid-image { background:#f3f3f1; }
  .pc-peek.pc-glide .swiper-wrapper { transition-timing-function:linear; }
  .pc-peek .grid-content .grid-meta { text-align:center; }
  .pc-peek .swiper-arrows { top:calc((100cqw / var(--pc-n) - 2 * var(--grid_productsm)) * 1.50524 / 2); }
  .pc-peek .swiper-button-next { right:15px; }
  .pc-peek .swiper-button-prev { left:calc(var(--pc-pl) + 10px); }
  @media (min-width:767px) { .pc-peek { --pc-n:3.2; } }
  @media (min-width:1025px) {
    .pc-peek { --pc-n:4.6; }
    .pc-peek .swiper-arrows { top:calc((100cqw / var(--pc-n) - 2 * var(--grid_products)) * 1.50524 / 2); }
    .pc-peek .grid-products { padding-left:calc(var(--pc-pl) - var(--grid_products)); }
    .pc-peek .swiper-button-prev { left:calc(var(--pc-pl) + 15px); }
    .pc-peek .swiper-button-next { right:25px; }
  }
</style>
{%- endif -%}
{%- comment -%} DEMO-ONLY START: remove this block and the "demo_hide_sold_out" schema setting after the client demo. {%- endcomment -%}
{%- if section_st.demo_hide_sold_out -%}
<style>
  /* Visual only, this section only: no faded image or "Sold out" badge. Sold-out cards still hide their add-to-cart button (theme.css). */
  #shopify-section-{{ section.id }} .sold-out .grid-image { opacity:1; }
  #shopify-section-{{ section.id }} .lbl.sold-out { display:none; }
</style>
{%- endif -%}
{%- comment -%} DEMO-ONLY END {%- endcomment -%}
<div id="{{ section.id }}"{% if section_st.peek and section_st.autoplay %} data-glide-ms="{{ glide_ms }}"{% endif %} class="section-cover{% if section_st.peek %} pc-peek{% if section_st.autoplay %} pc-glide{% endif %}{% endif %} {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %}" id="{{ section.id }}">
	    {%- render 'sec-title' -%}

        <slide-section class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products swiper"
            data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }},{% if section_st.peek and section_st.loop %}"loopedSlides":{{ peek_clones }},"loopedSlidesLimit":false,{% endif %}{% if section_st.peek and section_st.autoplay %}"autoplay":{ "delay":0, "disableOnInteraction":false, "pauseOnMouseEnter":true }, "speed":{{ glide_ms }},{% elsif section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
            <div class="swiper-wrapper">
                {%- if section_st.products != blank or section_st.collection != blank -%}                   
                    {%- if section_st.products != blank -%}                                        
                        {%- for product in section_st.products limit: section_st.rows -%}                      
                              <div class="swiper-slide gitem">{% render 'product-card-grid', product: product, section_st:section_st, sizes: sizes, widths: card_widths %}</div>
                        {%- endfor -%}                   
                    {%- else -%}
                        {%- for product in section_st.collection.products limit: section_st.rows -%}
                          <div class="swiper-slide gitem {% render 'animate-data', css:true %}" {% render 'animate-data', i:forloop.index %}>{% render 'product-card-grid', product: product, section_st: section_st, sizes: sizes, widths: card_widths %}</div>
                        {%- endfor -%}
                    {%- endif -%}
                {%- else -%}
                    {%- for i in (1..section_st.rows) -%}
                        <div class="swiper-slide gitem {% render 'animate-data', css:true %}" {% render 'animate-data', i:forloop.index %}>
                            <div class="grid-content">
                                <a href="#" class="grid_lnk">
                                    <div class="grid-image__wrapper">{% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}{{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}</div><br/>
                                    <div class="h5 grid-title">{{ 'homepage.onboarding.product_title' | t }}</div>
                                    <div class="grid-price">{% render 'product-price' %}</div>
                                </a>
                            </div>
                        </div>
                    {%- endfor -%}
                {%- endif -%}
            </div>
            {%- render 'swiper-navigation', id:section.id, section_st:section_st -%}
        </slide-section>

        {%- if section_st.show_view_all != blank and section_st.collection != blank -%}
            <div class="tc"><a href="{{ section_st.collection.url }}" class="mt30 btn {{ section_st.btn-size }} {{ section_st.btn-style }}">{{ section_st.show_view_all }}</a></div>
        {%- endif -%}
    </div>
</div>
{%- endcapture -%}
{{- productslider | strip_newlines | remove: '	' | replace: "  "," " | replace: "  "," " -}}
{% schema %}
{
  "name": "Products: Carousel",
  "class": "grid_products",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "id": "collection",
      "type": "collection",
      "label": "Collection"
    },
    {
      "id": "products",
      "type": "product_list",
      "label": "Products",
      "info": "replace collection"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "TOP RATED"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Most-Loved Products"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Explore the top-rated and most popular picks that everyone’s talking about.</p> "
    },   
    {
      "type": "header",
      "content": "Grid appearance"
    },
    {
      "type": "select",
      "id": "prbox_style",
      "label": "Style",
      "default": "grid-1",
      "options": [
        {
          "value": "grid-1",
          "label": "Icons - bottom center"
        },
        {
          "value": "grid-2",
          "label": "Content on image hover"
        },
        {
          "value": "grid-3",
          "label": "Icons - bottom Left"
        },
        {
          "value": "grid-4",
          "label": "Icons - top right"
        },
         {
          "value": "grid-5",
          "label": "Icons - below image"
        },
         {
          "value": "grid-6",
          "label": "Text button "
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "peek",
      "label": "Portrait peek layout",
      "default": false,
      "info": "Tall 2:3 cards, about 4.6 on desktop, 3.2 on tablet and 1.6 on mobile, with the next card peeking in on the right. Overrides the column settings below. With auto-rotate on, cards glide continuously (one card per autoplay-speed seconds, minimum 4) and pause on hover; reduced-motion visitors get no glide."
    },
    {
      "type": "checkbox",
      "id": "demo_hide_sold_out",
      "label": "DEMO ONLY: hide sold-out styling",
      "default": false,
      "info": "Temporary, for client demos. Removes the faded image and Sold out badge in this section only. Does not change stock, and sold-out products still cannot be added to cart."
    },
    {
      "type": "checkbox",
      "id": "show_color_swatch",
      "label": "Show color swatch",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },   
    {
      "type": "range",
      "id": "grid",
      "label": "Columns (desktop)",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridtb",
      "label": "Columns (tablet)",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridmb",
      "label": "Columns (mobile)",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Products to show",
      "default": 5,
      "min": 2,
      "max": 50,
      "step": 1
    },
    {
      "type": "paragraph",    
      "content": "Find additional grid options under [theme settings](/editor?context=theme&category=Products grid)",
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Infinite loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slide",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Autoplay speed",
      "default": 5,
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "Sec",
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "arrow",
      "label": "Show arrows on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "arrowm",
      "label": "Show arrows on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dot",
      "label": "Show dots on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dotm",
      "label": "Show dots on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Button",
      "visible_if": "{{ section.settings.collection != blank }}"
    },
    {
      "type": "text",
      "id": "show_view_all",
      "label": "Button label",   
      "visible_if": "{{ section.settings.collection != blank }}"
    },
    {
      "type": "select",
      "id": "btn-style",
      "label": "Button design",
      "default": "btn1",
      "options": [
        {
          "label": "Button 1",
          "value": "btn1"
        },
        {
          "label": "Button 2",
          "value": "btn2"
        },
        {
          "label": "Button 3",
          "value": "btn3"
        },
        {
          "label": "Outline Button 1",
          "value": "btn4"
        },
        {
          "label": "Outline Button 2",
          "value": "btn5"
        },       
        {
          "label": "Link",
          "value": "btn-link"
        }
      ],
      "visible_if": "{{ section.settings.collection != blank and section.settings.show_view_all != blank}}"
    },
    {
      "type": "select",
      "id": "btn-size",
      "label": "Button size",
      "default": "btn-md",
      "options": [
        {
          "label": "Small",
          "value": "btn-sm"
        },
        {
          "label": "Medium",
          "value": "btn-md"
        },
        {
          "label": "Large",
          "value": "btn-lg"
        }
      ],
      "visible_if": "{{ section.settings.collection != blank and section.settings.show_view_all != blank}}"
    },
   {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
     "id": "fullwidth",
      "label": "Full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "npd",
      "label": "Remove side margins",
      "default": false,
      "info": "Edit margin in [theme settings](/editor?context=theme&category=Layout)",
      "visible_if": "{{ section.settings.fullwidth }}"            
    },
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 20
    }  
  ],
  "presets": [
    {
      "name": "Products: Carousel",
      "category": "Products"
    }
  ]
}
{% endschema %}
