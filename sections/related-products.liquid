{%- capture related_products -%}
{%- liquid 
    assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif

    assign current_product = product
-%}
{%- capture sizes -%}(min-width:1024px) calc({{ page_width }} / {{ section_st.grid }}),(min-width:768px) calc(100vw / {{ section_st.gridtb }}), calc(100vw / {{ section_st.gridmb }}){%- endcapture -%}
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="related-product{% if section_st.fullwidth %} fw-section{% else %} page-width{% endif %}">
        {%- if section_st.type == '1' -%}
            {%- liquid
                assign number_of_rows = section_st.rows | plus:1
                assign exclusions = 'frontpage,all' | split: ','
                assign collection_found = false
                assign same_vendor = false
                assign same_type = false

                if collection and collection.all_products_count > 1
                    unless exclusions contains collection.handle
                        assign collection_found = true
                    endunless
                endif
                unless collection_found
                    for c in product.collections limit: number_of_rows
                        unless exclusions contains c.handle or c.all_products_count < 2
                        assign collection_found = true
                        assign collection = c
                        break
                        endunless
                    endfor
                endunless
            -%}
            {%- if collection_found -%}
                {%- capture related_items -%}
                    {%- for product in collection.products limit: number_of_rows -%}
                        {%- unless product.handle == current_product.handle -%}
                            {%- unless same_vendor and current_product.vendor != product.vendor -%}
                                {% unless same_type and current_product.type != product.type %}
                                    <div class="{% if section_st.carousel %}swiper-slide {% endif %}gitem {% render 'animate-data', css:true %}" {% render 'animate-data' %}>{% render 'product-card-grid', product: product, section_st:section_st, sizes:sizes %}</div>
                                {% endunless %}
                            {%- endunless -%}
                        {%- endunless -%}
                    {%- endfor -%}
                {%- endcapture -%}
            {%- endif -%}
        {%- elsif section_st.type == '2' -%}
            {%- capture related_items -%}
                {%- for product in product.metafields.custom.related_products.value -%}
                    <div class="{% if section_st.carousel %}swiper-slide {% endif %}gitem {% render 'animate-data', css:true %}" {% render 'animate-data' %}>{% render 'product-card-grid', product: product, section_st:section_st, sizes:sizes %}</div>
                {%- endfor -%}
            {%- endcapture -%}
        {%- elsif section_st.type == '3' -%}
            {%- assign number_of_rows = section_st.limit | plus:0 -%}
            {%- assign product_count = 0 -%}
            {%- paginate collections.all.products by 50 -%}
            {%- capture related_items -%}
                    {% for product in collections.all.products %}
                        {% if product.handle != current_product.handle and product.type == current_product.type %}
                            <div class="{% if section_st.carousel %}swiper-slide {% endif %}gitem {% render 'animate-data', css:true %}" {% render 'animate-data' %}>{% render 'product-card-grid', product: product, section_st:section_st, sizes:sizes %}</div>
                            {% assign product_count = product_count | plus: 1 %}
                        {% endif %}
                        {% if product_count == number_of_rows %}{% break %}{% endif %}
                    {% endfor %}
                {%- endcapture -%}
            {% endpaginate %}
        {%- elsif section_st.type == '4' -%}
            {%- assign number_of_rows = section_st.limit | plus:0 -%}
            {%- assign product_count = 0 -%}
            {%- paginate collections.all.products by 50 -%}
            {%- capture related_items -%}
                    {%- for product in collections.all.products -%}
                        {%- if product.handle != current_product.handle and product.vendor == current_product.vendor -%}
                            <div class="{% if section_st.carousel %}swiper-slide {% endif %}gitem {% render 'animate-data', css:true %}" {% render 'animate-data' %}>{% render 'product-card-grid', product: product, section_st:section_st, sizes:sizes %}</div>
                            {% assign product_count = product_count | plus: 1 %}
                        {%- endif -%}
                        {%- if product_count == number_of_rows -%}{% break %}{%- endif -%}
                    {%- endfor -%}
                {%- endcapture -%}
            {%- endpaginate -%}
        {%- endif -%}

        {%- unless related_items == blank -%}
            {% render 'sec-title' %}
            <div id="products-{{ section.id }}">
            {%- if section_st.carousel -%}
                <slide-section class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products swiper"
                    data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":false }}'>
                    <div class="swiper-wrapper">{{ related_items }}</div>
                    {% render 'swiper-navigation', id:section.id, section_st:section_st %}
                </slide-section>
            {%- else -%}
                <div class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products">
                    {{ related_items }}
                </div>
            {%- endif -%}
            </div>
        {%- endunless -%}
    </div>
</div>
{%- endcapture -%}
{{- related_products | strip_newlines | remove: '  ' | remove: '	' -}}
{% schema %}
{
  "name": "Related products",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
     {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading"    
    },
     {
      "id": "title",
      "type": "text",
      "label": "Title",
      "default": "Related products"
    },
     {
      "type": "richtext",
      "id": "text",
      "label": "Description"    
    },     
    {
      "type": "select",
      "id": "type",
      "label": "Show products",
      "options": [
        { "value": "1", "label": "By Collection" },
        { "value": "2", "label": "By Metafields" },
        { "value": "3", "label": "By Product Type" },
        { "value": "4", "label": "By Product Vendor" }
      ],
      "default": "1",
      "info": "[Learn more](https://www.adornthemes.com/knowledge-base/related-products-shopify/)"
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Columns (desktop)",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridtb",
      "label": "Columns (tablet)",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridmb",
      "label": "Columns (mobile)",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Products to show",
      "default": 5,
      "min": 2,
      "max": 50,
      "step": 1
    },
    {
      "type": "paragraph",
      "content": "Find additional grid options under [theme settings](/editor?context=theme&category=Products grid)",
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Enable carousel",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Infinite loop",
      "default": true,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slide",
      "default": false,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Autoplay speed",
      "default": 5,
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "Sec",
      "visible_if": "{{ section.settings.carousel and section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "arrow",
      "label": "Show arrows on desktop",
      "default": true,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "checkbox",
      "id": "arrowm",
      "label": "Show arrows on mobile",
      "default": false,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "checkbox",
      "id": "dot",
      "label": "Show dots on desktop",
      "default": false,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "checkbox",
      "id": "dotm",
      "label": "Show dots on mobile",
      "default": true,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },    
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },    
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
     {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
