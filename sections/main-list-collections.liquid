{%- liquid
  assign section_st = section.settings
  assign page_width = settings.cntwd | append: 'px'
  if section_st.sw
    assign page_width = '100vw'
  endif

  case section.settings.sort
    when 'products_high', 'products_low'
      assign collections = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign collections = collections | sort: 'published_at'
  endcase

  if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
    assign collections = collections | reverse
  endif

  for collection in collections
    assign collection_image = collection.metafields.custom.custom_image.value | default: collection.image | default: collection.products.first.featured_image

    assign img_ratio = 100
    if section_st.ratio == 'img' and collection_image
      assign img_ratio = 1 | divided_by: collection_image.aspect_ratio | times: 100
      break
    elsif section_st.ratio != 'img'
      assign img_ratio = section_st.ratio
    endif
  endfor
-%}
{% capture listclass %}
  {% if section_st.style == '1' %} pa zi1 tc {{section_st.text_position}} {{ section_st.rounded }}{% endif %}
  {% if section_st.style == '2' %} w-100 t-{{section_st.align}}{% endif %}
  {% if section_st.style == '3' %} pa zi1 w-100 bottom-0 {{ section_st.text_align}}{% endif %}
{% endcapture %}
{%- capture sizes -%}
  (min-width:1024px) calc({{ page_width }} / {{ section_st.grid }}),(min-width:768px) calc(100vw / {{ section_st.gridtb }}), calc(100vw / {{ section_st.gridmb }})
{%- endcapture -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}--ratio:{{ img_ratio | default:100 }}%" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
  <div class="collection-list collection-list{{ section_st.style }}{% if section_st.fullwidth %} fw-section{% else %} page-width{% endif %}">
    {%- render 'sec-title' -%}
    {%- capture styles -%}
          --grsp:{{ section_st.gspace | divided_by: 2.0 }}px;--grspm:{{ section_st.gspacem | divided_by: 2.0 }}px;
          --hdcl:{{ section_st.cl }};--cl:{{ section_st.cl }};
          --overlay:{{ section_st.img_overlay }};--overlay-down:{{ section_st.img_overlay | color_to_hex }}00;
          {%- if section_st.preset == 'custom-hd' -%}
            --fs:{{ section_st.fs }}px;--fsm:{{ section_st.fsm }}px;--ff:var(--{{ section_st.ff }});--fw:{{ section_st.fw }};--lh:{{ section_st.lh }};--ls:{{ section_st.ls }}px;
          {%- endif -%}
          --text_margin:{{section_st.text_margin}}px; --text_margin_mobile:{{section_st.text_margin_mobile}}px; --text_padding:{{ section_st.text_padding }}px; --text_padding_y:{{ section_st.text_padding_tb }}px;
          {%- if section_st.style != '2' -%}--text_margin:{{section_st.text_margin}}px;{%- endif -%}
          {%- if section_st.style != '3' -%}--bg:{{ section_st.tbg }};{%- endif -%}
          {%- if section_st.style == '3' -%}--bg:transparent; {%- endif -%}           
       
        {%- endcapture -%}
    <div class="grid gspace rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} {{ section_st.style }} mr-{{ section_st.gspace }}" style="{{ styles }}">
      {%- for collection in collections -%}
        {%- liquid
          assign collection_image = collection.metafields.custom.custom_image.value | default: collection.image | default: collection.products.first.featured_image
          assign img_alt = collection_image.alt | default: collection.title
          assign count = collection.all_products_count          
        %}
        <div class="gitem{% if section_st.carousel %} swiper-slide{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
          <a href="{{ collection.url }}" class="db pr of-hidden{% if section_st.style == '2' %} {{ section_st.rounded }}{% else %} {{ section_st.irounded }}{% endif %}{% if section_st.zoom %} zoom-hov{% endif %}" title="{{ collection.title }}">
            <div class="img pr overlay {{ section_st.ovr-direction }} of-hidden{% if section_st.style == '2' %} {{ section_st.irounded }}{% endif %}">
              {%- if collection_image != blank -%}
                {{ collection_image | image_url: width:collection_image.width | image_tag: loading:'lazy', class:'img-fit', alt:img_alt, sizes:sizes, widths:'180,350,460,600,800,1000' }}
              {%- else -%}
                {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture -%}
                {{- 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg img-fit' }}
              {%- endif -%}
            </div>
            <div class="collection-details {{ listclass }}">
              <div class="head {{ section_st.preset }}">{{ collection.title }}</div>
              {% if section_st.count and count != blank -%}
                <span class="fs13 db op-9 mt5">{{- 'collections.general.items_with_count' | t: count: count -}}</span>
              {%- endif %}
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
