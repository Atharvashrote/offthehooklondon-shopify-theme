{%- assign section_st = section.settings -%}
{%- if section_st.hide_hdft -%}
  <style>
    #shopify-section-top-header,
    #shopify-section-header-1,
    #shopify-section-header-2,
    #shopify-section-header-3 #shopify-section-header-4,
    .shopify-section-group-footer-group,
    .adth-footer { display:none; }
  </style>
{%- endif -%}
{% unless section_st.fullwidth %}<style>.main-content { --page-width:{{ section_st.maxwd }}px }</style> {%- endunless -%}
<div class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st: section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% else %}page-width{% endif %}">
        {%- unless section_st.hidettl -%}
            <h1 class="page-title tc{% if settings.ttl_c %} text-upper{% endif %}">{{ page.title }}</h1>
        {%- endunless -%}
        {%- unless page.content == blank -%}
            <div class="rte">{{ page.content }}</div>
        {%- endunless -%}
    </div>
</div>
{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "hidettl",
      "label": "Hide page title",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_hdft",
      "label": "Hide header and footer",
      "default": false,
      "info": "You can use this option when creating a landing page without a header or footer."
    },
    {
      "type": "range",
      "id": "maxwd",
      "label": "Page width",
      "default": 1300,
      "min": 800,
      "max": 2000,
      "step": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },   
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 25
    }
  ]
}
{% endschema %}
