        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products: Tabs",
      "category": "Products",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}
