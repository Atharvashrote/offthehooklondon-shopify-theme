  "blocks": [
    {
      "type": "tab",
      "name": "Collection",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab name",
          "default": "Tab Name"
        },
        {
          "id": "collection",
          "type": "collection",
          "label": "Collection"
