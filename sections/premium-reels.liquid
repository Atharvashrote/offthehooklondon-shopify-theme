{{ 'premium-reels.css' | asset_url | stylesheet_tag }}
{{ 'premium-reels.js' | asset_url | script_tag }}

<div class="premium-reels-section">

   <div class="premium-reels-heading">

    <h2>{{ section.settings.heading }}</h2>

    <p>{{ section.settings.subheading }}</p>

    {% if section.settings.instagram_id != blank %}
        <a
            href="{{ section.settings.instagram_url }}"
            class="premium-instagram"
            target="_blank"
            rel="noopener"
        >
            <span class="instagram-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="1"></circle>
                </svg>
            </span>

            <span>{{ section.settings.instagram_id }}</span>
        </a>
    {% endif %}

    <span class="heading-line"></span>

</div>

    <div class="premium-reels-carousel">

    <div class="swiper premiumReels">

        <div class="swiper-wrapper">

            {% for block in section.blocks %}

    {% if block.settings.video != blank %}

        <div class="swiper-slide">

            <a
                href="{{ block.settings.link }}"
                class="reel-card"
            >

                {{
                    block.settings.video
                    | video_tag:
                    autoplay: true,
                    muted: true,
                    loop: true,
                    controls: false,
                    playsinline: true,
                    class: 'reel-video'
                }}

                <div class="reel-overlay">

                    <div class="reel-brand">
                        {{ block.settings.brand }}
                    </div>

                    <div class="reel-button">
                        {{ block.settings.button }}
                    </div>

                </div>

            </a>

        </div>

    {% endif %}

{% endfor %}
        </div>

    </div>

        <div class="swiper-button-prev" aria-label="Previous"></div>
        <div class="swiper-button-next" aria-label="Next"></div>

    </div>

</div>

{% schema %}
{
  "name":"Premium Reels",
  "settings":[
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"Shop The Look"
    },
    {
      "type":"textarea",
      "id":"subheading",
      "label":"Sub Heading",
      "default":"Watch our latest styling videos"
    },
    {
  "type": "text",
  "id": "instagram_id",
  "label": "Instagram ID",
  "default": "@offthehooklondon"
},
{
  "type": "url",
  "id": "instagram_url",
  "label": "Instagram Profile URL"
}
  ],
  "blocks":[
    {
      "type":"reel",
      "name":"Reel",
      "settings":[
        {
          "type":"video",
          "id":"video",
          "label":"Video"
        },
        {
          "type":"text",
          "id":"brand",
          "label":"Brand Text",
          "default":"Off The Hook"
        },
        {
          "type":"text",
          "id":"button",
          "label":"Button Text",
          "default":"Shop Now"
        },
        {
          "type":"url",
          "id":"link",
          "label":"Link"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"Premium Reels"
    }
  ]
}
{% endschema %}