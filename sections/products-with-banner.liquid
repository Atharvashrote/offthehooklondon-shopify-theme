{%- capture productslider -%}
{%- liquid 
   assign section_st = section.settings
    assign page_width = settings.cntwd | append: 'px'
    if section_st.sw
        assign page_width = '100vw'
    endif
-%}
{%- capture sizes -%}
  (min-width:1024px) calc({{ page_width }} / {{section_st.grid }}),(min-width:768px) calc(100vw / {{section_st.gridtb }}), calc(100vw / {{section_st.gridmb }})
{%- endcapture -%}  
<div id="{{ section.id }}" class="section-cover {% render 'sec-settings', section_st:section_st, class: true %}" style="{% render 'sec-settings', section_st:section_st, styles: true %}" {% render 'sec-settings', section_st:section_st, bgimage: true %}>
    <div class="{% if section_st.fullwidth %}fw-section{% if section_st.npd %} npd{% endif %}{% else %}page-width{% endif %}" id="{{ section.id }}">        
        {%- render 'sec-title' -%}
        <div class="fl f-jcsb f-col f-row-md f-aic custom-banner">
            <div class="mb20 mb0-lg{% if section_st.pos %} img-order{% endif %}{% if section_st.bnrhm %} hide-sm{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %} style="--wd:{{ section_st.bnrwd }}%;">
                {% content_for 'block', type: 'image-banner', id: 'image-banner' %}
            </div>
            <div class="{% if section_st.carousel %}pr f-asc{% endif %}" style="--wd:calc({{ 100 | minus: section_st.bnrwd }}% - 30px);--cwd:{{ section_st.maxwd }}px">
                {%- capture product_data -%}
                    {% if section_st.products != blank %}
                        {%- capture sizes -%}
                            (min-width:1024px) calc(({{ page_width }} / 2) / {{ section_st.grid }}),(min-width:768px) calc(100vw / {{ section_st.gridtb }}), calc(100vw / {{ section_st.gridmb }})
                        {%- endcapture -%}
                        {% for product in section_st.products %}
                            <div class="{% if section_st.carousel %}swiper-slide{% endif %} gitem {% render 'animate-data', css:true %}" {% render 'animate-data', i:forloop.index %}>{% render 'product-card-grid', product:product, section_st:section_st, sizes:sizes %}</div>
                        {% endfor %}
                    {% else %}
                        {% for i in (1..4) %}
                            <div class="{% if section_st.carousel %}swiper-slide{% endif %} gitem {% render 'animate-data', css:true %}" {% render 'animate-data', i:forloop.index %}>
                                <div class="grid-content">
                                    <a href="#" class="grid_lnk">
                                        <div class="grid-image__wrapper">{% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}{% capture pl_class %}placeholder-svg svgcl{{ current }}{% endcapture %}{{ 'product-' | append: current | placeholder_svg_tag: pl_class }}</div><br/>
                                        <div class="h5 fw-500 grid-title">{{ 'homepage.onboarding.product_title' | t }}</div>
                                        <div class="grid-price"> {% render 'product-price' %} </div>
                                    </a>
                                    </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                {%- endcapture -%}

                {%- if section_st.carousel -%}
                    <slide-section class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products swiper" 
                        data-swiper='{ "slidesPerView":"auto", "loop":{{ section_st.loop }}, {% if section_st.autoplay %}"autoplay":{ "delay":"{{ section_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":true }}'>
                        <div class="swiper-wrapper">{{ product_data }}</div>
                        {% render 'swiper-navigation', id:section.id, section_st:section_st %}
                    </slide-section>
                {%- else -%}
                    <div class="grid rwcols-{{ section_st.gridmb }} rwcols-md-{{ section_st.gridtb }} rwcols-lg-{{ section_st.grid }} grid-products">
                        {{- product_data -}}
                    </div>
                {%- endif -%}

            </div>         
        </div>    
    </div>  
</div>
{%- endcapture -%}
{{- productslider | strip_newlines | remove: '  ' | remove: '	' -}}
{% schema %}
{
  "name": "Products: With banner",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Trending Look"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Most Wanted Styles"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Explore trending pieces that are turning heads and selling fast</p> "
    },
    {
      "type": "header",
      "content": "Image banner"
    },
    {
      "type": "range",
      "id": "bnrwd",
      "min": 20,
      "max": 70,
      "step": 1,
      "label": "Column width",
      "default": 50,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "pos",
      "label": "Show banner on right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bnrhm",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "maxwd",
      "label": "Column width",
      "default": 400,
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px"
    },
    {
      "id": "products",
      "type": "product_list",
      "label": "Products"
    },
     {
      "type": "select",
      "id": "prbox_style",
      "label": "Style",
      "default": "grid-1",
      "options": [
        {
          "value": "grid-1",
          "label": "Icons - bottom center"
        },
        {
          "value": "grid-2",
          "label": "Content on image hover"
        },
        {
          "value": "grid-3",
          "label": "Icons - bottom Left"
        },
        {
          "value": "grid-4",
          "label": "Icons - top right"
        },
         {
          "value": "grid-5",
          "label": "Icons - below image"
        },
         {
          "value": "grid-6",
          "label": "Text button "
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_color_swatch",
      "label": "Show color swatch",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Columns (desktop)",
      "default": 2,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridtb",
      "label": "Columns (tablet)",
      "default": 2,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "gridmb",
      "label": "Columns (mobile)",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Products to show",
      "default": 4,
      "min": 2,
      "max": 50,
      "step": 1
    },
    {
      "type": "paragraph",
      "content": "Find additional grid options under [theme settings](/editor?context=theme&category=Products grid)"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Enable",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Autoplay speed",
      "default": 5,
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "sec",
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "checkbox",
      "id": "fade",
      "label": "Slide fade effect",
      "default": false,
      "visible_if": "{{ section.settings.carousel }}"
    },

    {
      "type": "checkbox",
      "id": "arrow",
      "label": "Show arrows on desktop",
      "default": true,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "checkbox",
      "id": "arrowm",
      "label": "Show arrows on mobile",
      "default": false,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "checkbox",
      "id": "dot",
      "label": "Show dots on desktop",
      "default": false,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "checkbox",
      "id": "dotm",
      "label": "Show dots on mobile",
      "default": true,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "npd",
      "label": "Remove side margins",
      "default": false,
      "info": "Edit margin in [theme settings](/editor?context=theme&category=Layout)",
      "visible_if": "{{ section.settings.fullwidth }}"
    },
    {
      "type": "checkbox",
      "id": "addbg",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f7f7",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background image",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay",
      "alpha": true,
      "visible_if": "{{ section.settings.addbg and section.settings.bg-image != blank }}"
    },
    {
      "type": "color",
      "id": "headings_cl",
      "label": "Text",
      "visible_if": "{{ section.settings.addbg }}"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Top padding (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Products: With banner",
      "category": "Products"         
    }
  ]
}
{% endschema %}
