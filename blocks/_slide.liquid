{%- liquid
    assign section_st = section.settings
    assign block_st = block.settings
    assign block_index = section.blocks | find_index: 'id', block.id

    assign videotype = "video"
    if block_st.source == "url" 
        if block_st.video_url.type == "youtube"
            assign videotype = "youtube"
        elsif block_st.video_url.type == "vimeo"
            assign videotype = "vimeo"
        endif
    endif

    assign block_link = false
    if block_st.ol_link and block_st.slide_link != blank
        assign block_link = true
    endif
-%}
<div class="swiper-slide sslide{% if section_st.ht == '1' %} im{% else %} ct{% endif %} w-100 of-hidden" data-type="{{ block_st.type }}" {% if block_st.type == 'video' %} data-video="{{ videotype }}"{% endif %} data-slide="{{ block_index }}" id="{{ block.id }}" {{ block.shopify_attributes }}>
    {%- if block_index == 0 and section_st.ht == '1' -%}
        <style>
            #{{ section.id }}{
                {%- if block_st.image != blank -%}
                    --slht:{{ 1 | divided_by: block_st.image.aspect_ratio | times: 100 }}%;
                    {%- if block_st.imagem != blank -%}
                        --slhtm:{{ 1 | divided_by: block_st.imagem.aspect_ratio | times: 100 }}%;
                    {%- else -%}
                        --slhtm:{{ 1 | divided_by: block_st.image.aspect_ratio | times: 100 }}%;
                    {%- endif -%}
                {%- else -%}
                    --slht:40%;--slhtm:40%;
                {%- endif -%}
            }
        </style>
    {%- endif -%}
    {%- if block_st.display_btn != true and block_st.link != blank and block_st.type != 'video' -%}<a href="{{ block_st.link }}" class="ss_link">{%- endif -%}
    {%- if block_st.type == 'image' and block_st.image != blank -%}
        {%- liquid
            assign img_class = "ssimg img-fit"
            assign lazy_img = 'lazy'
            assign fetch_priority = 'auto'
            assign banner_img = block_st.image
            assign banner_imgm = block_st.imagem
            assign banner_img_fp = banner_imgm.presentation.focal_point
            assign banner_img_src = banner_imgm | image_url: width: banner_imgm.width | image_tag: widths: '400,560,760,1000' | split: 'srcset="' | last | split: '"' | first

            if banner_imgm != blank and banner_imgm.presentation.focal_point != blank
               assign img_class = "ssimg img-fit mbFocal"
            endif
            if section_st.imganim
               assign img_class = img_class | append: ' anim'
            endif
            if section.index < 2
                assign lazy_img = 'eager'
                assign fetch_priority = 'high'
            endif
        -%}
        <picture class="" {% if banner_imgm != blank and banner_img_fp != blank %}style="--fp:{{ banner_img_fp }}"{% endif %}>
            {%- if block_st.imagem != blank -%}
                <source media="(max-width: 767px)" srcset="{{ banner_img_src }}" width="{{ banner_imgm.width }}" height="{{ banner_imgm.height }}">
            {%- endif -%}
            {{- banner_img | image_url: width: banner_img.width | image_tag: class:img_class, loading: lazy_img, fetchpriority: fetch_priority, sizes:"100vw", widths:"400,600,800,1000,1200,1400,1600,2000,2400,3000" -}}
        </picture>
    {%- elsif block_st.type == 'video' and block_st.source == "url" and block_st.video_url != blank -%}
        {%- if block_st.video_url.type == "youtube" -%}
            <iframe class="embed-player slide-media" width="1920" height="1080" src="https://www.youtube.com/embed/{{ block_st.video_url.id }}?enablejsapi=1&controls=0&fs=0&iv_load_policy=3&rel=0&showinfo=0&loop=1&playlist={{ block_st.video_url.id }}&playsinline=1&autoplay=1&mute=1" allow="autoplay" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>
        {%- elsif block_st.video_url.type == "vimeo" -%}
            <iframe class="embed-player slide-media" src="https://player.vimeo.com/video/{{ block_st.video_url.id }}?api=1&byline=0&portrait=0&title=0&background=1&mute=1&loop=1&autoplay=0&id={{ block_st.video_url.id }}" width="1920" height="1080" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>
        {%- endif -%}
    {%- elsif block_st.type == 'video' and block_st.source == "uploaded" and block_st.video != blank -%}
        {%- liquid
            assign video_lg = ''
            assign video_mb = ''
            if block_st.videom != blank
                assign video_lg = 'hide-sm'
                assign video_mb = block_st.videom | video_tag: image_size:"1000x", loop:true, controls:false, muted:true, autoplay:true, playsinline: true, class: 'hide-md hide-lg'
            endif
        -%}
        {{- block_st.video | video_tag: image_size:"2000x", loop:true, controls:false, muted:true, autoplay:true, playsinline: true, class: video_lg -}}
        {{- video_mb -}}
    {%- else -%}
        <div class="ss_img js">
            <div class="ph_bg">{% capture current %}{% cycle 1, 2 %}{% endcapture %}{{ 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}</div>
        </div>
    {%- endif -%}

    {%- if block_link -%}
        <a href="{{ block_st.slide_link }}" class="pa all0 zi0"></a>
    {%- endif -%}

    <div class="content-wraper {{ block_st.ovr-direction }} {% if block_link %} link-over{% endif %}" style="--page-width:{{ block_st.contwd }}px;--overlay:{{ block_st.ovr }};--overlay-down:{{ block_st.ovr | color_to_hex }}00;">
        <div class="page-width fl h-100 {{ block_st.txtpos }} {{ block_st.txtposm }}">
            <div class="group-bk fl f-col gap {{ block_st.rounded }} t-{{ block_st.alignm }} t-{{ block_st.align }}-md {% if section_st.txtanimation %} slide-anim{% endif %} {% render 'group-settings', section_st:block_st, class: true %}" style="{% render 'group-settings', section_st:block_st, styles:true %}">
                {%- content_for 'blocks' -%}
            </div>
        </div>
    </div>             
    {%- if block_st.display_btn != true and block_st.link != blank and block_st.type != 'video' -%}</a>{%- endif -%}
</div>
{% schema %}
  {
    "name": "Slide",
    "tag": null,
    "blocks": [
        {
          "type": "@theme"
        },
    ],
    "settings": [
        {
          "type": "select",
          "id": "type",
          "label": "Type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Desktop image",
            "info": "Recommended size 2000 x 900 px or higher",
            "visible_if": "{{ block.settings.type == 'image' }}"
        },
        {
            "type": "image_picker",
            "id": "imagem",
            "label": "Mobile image",
            "info": "Recommended size 760 x 760 px or higher",
            "visible_if": "{{ block.settings.type == 'image' }}"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Source",
          "default": "uploaded",
          "options": [
            {
              "value": "uploaded",
              "label": "Uploaded"
            },
            {
              "value": "url",
              "label": "External URL"
            }
          ],
          "visible_if": "{{ block.settings.type == 'video' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.source == 'uploaded' and block.settings.type == 'video' }}"
        },
        {
            "type": "video",
            "id": "videom",
            "label": "Mobile video",
            "visible_if": "{{ block.settings.source == 'uploaded' and block.settings.type == 'video' }}"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Use a YouTube or Vimeo URL",
          "accept": ["youtube", "vimeo"],
          "visible_if": "{{ block.settings.source == 'url' and block.settings.type == 'video' }}"
        },       
        {
            "type": "color",
            "id": "ovr",
            "label": "Overlay color",
            "alpha": true,
            "default": "#00000060"           
        }, 
        {
          "type": "select",
          "id": "ovr-direction",
          "label": "Overlay direction",
          "default": "full",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "full", "label": "Full" }
          ]
        },
        {
        "type": "checkbox",
        "id": "ol_link",
        "label": "Enable click on slide",
        "default": false
        },  
        {
        "type": "url",
        "id": "slide_link",
        "label": "Add url",
        "visible_if": "{{ block.settings.ol_link }}"
        },       
        {
            "type": "header",        
            "content": "Caption" 			
        },
         {
            "type": "range",
            "id": "contwd",
            "min": 1000,
            "max": 2000,
            "step": 10,
            "label": "Container width",
            "unit": "px",
            "default": 1400,
            "info": "Apply for desktop only"
        },  
        {
            "type": "select",
            "id": "txtpos",
            "label": "Position",
            "default": "f-aic-md f-jcs-md",
            "options": [
                { "label": "Top left",      "value": "f-ais-md f-jcs-md" },
                { "label": "Top center",    "value": "f-ais-md f-jcc-md" },
                { "label": "Top right",     "value": "f-ais-md f-jce-md" },             
                { "label": "Left",  		    "value": "f-aic-md f-jcs-md" },
                { "label": "Center", 		    "value": "f-aic-md f-jcc-md" },
                { "label": "Right",  		    "value": "f-aic-md f-jce-md" },
                { "label": "Bottom left",   "value": "f-aie-md f-jcs-md" },						 
                { "label": "Bottom center", "value": "f-aie-md f-jcc-md" }, 						 
                { "label": "Bottom right",  "value": "f-aie-md f-jce-md" }
            ]
        },        
        {
            "type": "select",
            "id": "txtposm",
            "label": "Position (mobile)",
            "default": "f-aic f-jcc",            
            "options": [ 			
                { "label": "Top left",      "value": "f-ais f-jcs" },
                { "label": "Top center",    "value": "f-ais f-jcc" },
                { "label": "Top right",     "value": "f-ais f-jce" },
                { "label": "Left",          "value": "f-aic f-jcs" },
                { "label": "Center",        "value": "f-aic f-jcc" },
                { "label": "Right",         "value": "f-aic f-jce" },
                { "label": "Bottom left",   "value": "f-aie f-jcs" },
                { "label": "Bottom center", "value": "f-aie f-jcc" },
                { "label": "Bottom right",  "value": "f-aie f-jce" }
            ]
        },
         {
            "type": "text_alignment",
            "id": "align",
            "label": "Alignment",
            "default": "left"
        },           
         {
            "type": "text_alignment",
            "id": "alignm",
            "label": "Alignment (mobile)",
            "default": "left"
        },  
        {
            "type": "header",        
            "content": "Content box" 			
        },                                
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "custom",
          "options": [
            {
              "value": "fit",
              "label": "Fit"
            },
            {
              "value": "fill",
              "label": "Fill"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ]
        },
        {
            "type": "range",
            "id": "ct_width",
            "min": 300,
            "max": 1300,
            "step": 10,
            "label": "Custom width",
            "unit": "px",
            "default": 500,
            "visible_if": "{{ block.settings.width == 'custom' }}"
        },        
        {
          "type": "select",
          "id": "widthm",
          "label": "Width (mobile)",
          "default": "fit",
          "options": [
            {
              "value": "fit",
              "label": "Fit"
            },
            {
              "value": "fill",
              "label": "Fill"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ]
        },
        {
            "type": "range",
            "id": "ct_widthm",
            "min": 100,
            "max": 600,
            "step": 5,
            "label": "Custom width",
            "unit": "px",
            "default": 300,
            "visible_if": "{{ block.settings.widthm == 'custom' }}"
        },                    
        {
            "type": "checkbox",
            "id": "isbg",
            "label": "Add background",
            "default": false
        },
      {
        "type": "color",
        "id": "box_bg",
        "label": "Background",
        "alpha": true,
        "default":"#fff",
        "visible_if": "{{ block.settings.isbg }}"
      },
      {
          "type": "color_background",
          "id": "box_bgg",
          "label": "Background gradient",
          "visible_if": "{{ block.settings.isbg }}"
      },
      {
        "type": "select",
        "id": "bdr",
        "label": "Borders",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "solid",
            "label": "Solid"
          }
        ],
        "visible_if": "{{ block.settings.isbg }}"
      },
      {
            "type": "range",
            "id": "brd_sz",
            "label": "Border thickness",
            "default":1,
            "min": 0,
            "max": 10,
            "step": 1,
            "unit":"px",
            "visible_if": "{{ block.settings.isbg and block.settings.bdr == 'solid' }}"
      },
      {
        "type": "color",
        "id": "bdr-cl",
        "label": "Border color",
        "alpha": true,
        "visible_if": "{{ block.settings.isbg and block.settings.bdr == 'solid' }}"
      }, 
      {
      "type": "select",
      "id": "rounded",
      "label": "Corner radius",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "round-xs",
          "label": "Extra small"
        },
        {
          "value": "round-sm",
          "label": "Small"
        },
        {
          "value": "round-md",
          "label": "Medium"
        },
        {
          "value": "round-lg",
          "label": "Large"
        },
        {
          "value": "round-full",
          "label": "Full"
        }
      ],
      "visible_if": "{{ block.settings.isbg }}"
    },  
    {
        "type": "range",
        "id": "gap",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Gap",
        "default": 0
      },
      {
        "type": "range",
        "id": "gapm",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Gap (mobile)",
        "default": 0
      },   
      {
        "type": "header",
        "content": "Text padding"
      },
      {
          "type": "checkbox",
          "id": "ispd",
          "label": "Add padding",
          "default": false
      },      
      {
            "type": "range",
            "id": "pd-lr",
            "label": "Horizontal",
            "default":35,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit":"px",
            "visible_if": "{{ block.settings.ispd }}"
      },
      {
            "type": "range",
            "id": "pd-tb",
            "label": "Vertical",
            "default":30,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit":"px",
            "visible_if": "{{ block.settings.ispd }}"
      },      
      {
            "type": "range",
            "id": "pd-lrm",
            "label": "Horizontal (mobile)",
            "default":25,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit":"px",
            "visible_if": "{{ block.settings.ispd }}"
      },
      {
            "type": "range",
            "id": "pd-tbm",
            "label": "Vertical (mobile)",
            "default":20,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit":"px",
            "visible_if": "{{ block.settings.ispd }}"
      }
    ],
    "presets": [
      {
        "name": "Slide",
         "blocks": {
            "heading": {
              "type": "heading",
              "settings": {
                 "text": "BEST SELLING SHOPIFY THEME",
                  "preset": "h3",
                  "mb": 10,
                  "mbm":5
              }
            },
            "text": {
              "type": "text",
              "settings": {
                  "text": "<p>We at Adornthemes craft beautiful, user-friendly Shopify themes that turn your visitors into customers</p>",
                  "mb": 25,
                  "mbm":15
              }
            },
            "buttons": {
              "type": "buttons"              
            }
          },
          "block_order": ["heading", "text", "buttons"]
      }
    ]
  }
{% endschema %}