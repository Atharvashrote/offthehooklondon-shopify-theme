{%- liquid
    assign block_st = block.settings
-%}
{%- unless block_st.hide and block_st.richtxt == blank -%}
    <details class="sumtabs" {% if block.settings.tbopen %}open=""{% endif %} {{ block.shopify_attributes }}>
        <summary class="head [ttl-preset] pr fl f-aic col-gap" style="--gap:10px;">
            {%- if block_st.sicon != blank and block_st.icon == "custom" -%}
                <img loading="lazy" class="at-icon" src="{{ block_st.sicon | image_url: width: '60' }}" width="18" height="18" alt="">
            {%- else -%}
                {%- render 'icons', block_st: block_st, icon: block_st.icon -%}
            {%- endif -%}
            {{ block_st.title }} [icon]
        </summary>
        <div class="details-content rte{% if block_st.tabicon != blank %} pdside{% endif %}">{{ block_st.richtxt }}</div>
    </details>
{%- endunless -%}
