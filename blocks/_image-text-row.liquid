{%- liquid
  assign section_st = section.settings
  assign block_st = block.settings
  assign sindex = section.blocks | find_index: 'id', block.id

  assign page_width = settings.cntwd | append: 'px'
  if section_st.sw
    assign page_width = '100vw'
  endif
-%}
<div class="{% if section_st.carousel %}swiper-slide{% endif %} image-text__row fl f-col f-row-md f-aist w-100 mb{{ block_st.mbm }} mb{{ block_st.mb }}-md {% if section_st.npd == false or section_st.fullwidth == false %}{{ section_st.srounded }}{% endif %}" style="--bg:{% if block_st.bgg != blank %}{{ block_st.bgg }}{% else %}{{ block_st.bg }}{% endif %};--mwd:{{ block_st.image.width }}px;" data-slide="{{ sindex }}" id="{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="fl f-aic{% if block_st.layout == 'right' %} order2-md{% endif %} image-text__image zi1 tc {{ block_st.rounded }} {% render 'animate-data', css:true %}" {% render 'animate-data' %} style="--wd:{{ block_st.bnrwd }}%;">
    {%- if block_st.image != blank -%}
      {%- if block_st.link != blank -%}<a class="db w-100" href="{{ block_st.link }}">{%- endif -%}
        {%- liquid
          assign column = 100.00 | divided_by: block_st.bnrwd | times: 1
          assign divide_colunm = 1.00 | divided_by: column | round: 2
        -%}
        {%- capture sizes -%}
            (min-width:1024px) calc(({{ page_width }} - 30px * {{ column | minus: 1 }}) * {{ divide_colunm }}), calc(100vw - 30px)
        {%- endcapture -%}
        {%- assign img_alt = block_st.image.alt | default: block_st.title | default: block_st.titles -%}
        {%- assign img_class = 'img-auto m-auto ' | append: block_st.rounded -%}
        {{ block_st.image | image_url: width: block_st.image.width | image_tag: loading: 'lazy', class: img_class, alt: img_alt, sizes: sizes, widths: '320,400,560,740,900,1200' }}
      {%- if block_st.link != blank -%}</a>{%- endif -%}
    {%- else -%}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="image-text__content fl1 fl {{ block_st.position }} zi2">
    <div class="image-text__content-inner w-100 fl f-col t-{{ block_st.align }}{% if block_st.align == 'center' %} f-aic{%  elsif block_st.align == 'right' %} f-aie{% endif %}{% if block_st.txtpd %} nobg{% endif %} {% render 'animate-data', css:true %}" {% render 'animate-data' %}>
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Row",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Image size is flexible. However, it should be big enough to fit with content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "bnrwd",
      "min": 25,
      "max": 75,
      "step": 1,
      "label": "Image width",
      "default": 50,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "rounded",
      "label": "Corner radius",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "round-xs",
          "label": "Extra small"
        },
        {
          "value": "round-sm",
          "label": "Small"
        },
        {
          "value": "round-md",
          "label": "Medium"
        },
        {
          "value": "round-lg",
          "label": "Large"
        },
        {
          "value": "round-full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "url",
      "id": "link",
      "label": "Image link"
    },
    {
      "type": "paragraph",
      "content": "----------------------------------------------"
    },   
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "f-aic",
      "options": [
        { "label": "Top", "value": "f-ais" },
        { "label": "Middle", "value": "f-aic" },
        { "label": "Bottom", "value": "f-aie" }       
      ]
    },  
    {
      "type": "text_alignment",
      "id": "align",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "txtpd",
      "label": "Remove text padding on mobile",
      "info": "Text left/right space for mobile view",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "-----------------------------------------------"
    },
    {
      "type": "range",
      "id": "mb",
      "label": "Bottom margin",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mbm",
      "label": "Bottom margin (mobile)",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Row",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Spring Summer New Arrival",
            "mb": 15,
            "mbm": 10
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Pair large text with an image to give focus to your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
            "mb": 20,
            "mbm": 15
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "text": "Shop now",
            "url": "shopify://collections/all"
          }
        }
      },
      "block_order": ["heading", "text", "button"]
    }
  ]
}
{% endschema %}