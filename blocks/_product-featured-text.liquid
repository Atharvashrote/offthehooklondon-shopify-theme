{%- liquid
  assign block_st = block.settings
-%}
<div class="featured-text mb{{ block_st.mbm }} mb{{ block_st.mb }}-md reg-text fl f-jcc" style="--icns:{{ block_st.fs | plus: 7 }}px;--cl:{{ block_st.cl }};--clbg:{{ block_st.clbg }}; --fs:{{ block_st.fs }}px;--fsm:{{ block_st.fsm }}px;--pd-y:{{ block_st.tpd }}px;--pd-x:{{ block_st.tpd | plus : 5 }}px;" {{ block.shopify_attributes }}>
    {%- if block_st.text != blank -%}
        <div class="tc fl1 {{block_st.rounded}}">
            {%- if block_st.sicon != blank and block_st.icon == 'custom'-%}
                <img class="at-icon mb5" loading="lazy" src="{{ block_st.sicon | image_url: width: '60' }}" width="18" height="18" alt="{{ block_st.sicon.alt }}" />
            {%- else -%}
                {%- render 'icons', icon: block_st.icon -%}
            {%- endif -%}
            <p>{{ block_st.text }}</p>
        </div>
    {%- endif -%}
    {%- if block_st.text2 != blank -%}
        <div class="tc fl1 {{block_st.rounded}}">
            {%- if block_st.sicon2 != blank and block_st.icon2 == 'custom' -%}
                <img loading="lazy" class="at-icon mb5" src="{{ block_st.sicon2 | image_url: width: '60' }}" width="18" height="18" alt="{{ block_st.sicon2.alt }}" />
            {%- else -%}
                {%- render 'icons', icon: block_st.icon2 -%}
            {%- endif -%}
            <p>{{ block_st.text2 }}</p>
        </div>
    {%- endif -%}
    {%- if block_st.text3 != blank -%}
        <div class="tc fl1 {{block_st.rounded}}">
            {%- if block_st.sicon3 != blank and block_st.icon3 == 'custom' -%}
                <img loading="lazy" class="at-icon mb5" src="{{ block_st.sicon3 | image_url: width: '60' }}" width="18" height="18" alt="{{ block_st.sicon3.alt }}" />
            {%- else -%}
                {%- render 'icons', icon: block_st.icon3 -%}
            {%- endif -%}
            <p>{{ block_st.text3 }}</p>
        </div>
    {%- endif -%}
</div>
