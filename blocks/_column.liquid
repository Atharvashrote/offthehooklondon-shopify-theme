{% liquid
    assign block_st = block.settings
    assign block_align = 't-' | append: block_st.align | append: '-md'
    if block_st.align == 'left'
        assign block_align = block_align | append: ' f-ais-md'
    elsif block_st.align == 'center'
        assign block_align = block_align | append: ' f-aic-md'
    elsif block_st.align == 'right'
        assign block_align = block_align | append: ' f-aie-md'
    endif
    assign block_align_mb = 't-' | append: block_st.alignm
    if block_st.alignm == 'left'
        assign block_align_mb = block_align_mb | append: ' f-ais'
    elsif block_st.alignm == 'center'
        assign block_align_mb = block_align_mb | append: ' f-aic'
    elsif block_st.alignm == 'right'
        assign block_align_mb = block_align_mb | append: ' f-aie'
    endif
%}
{%- capture styles -%}
    --gap:{{ block_st.gap }}px;--gapm:{{ block_st.gapm }}px;
    --cl_bg:{{ block_st.bg }};--cl_pdm:{{ block_st.pad_tbm }}px {{ block_st.pad_lrm }}px;--cl_pdt:{{ block_st.pad_tbt }}px {{ block_st.pad_lrt }}px;--cl_pd:{{ block_st.pad_tb }}px {{ block_st.pad_lr }}px;
{%- endcapture -%}
<div id="{{ block.id }}" class="grid-column gcol-{{ block_st.column_mb }} gcol-{{ block_st.column_tb }}-md gcol-{{ block_st.column_dk }}-lg {{ block_st.rounded }}{% if block_st.hidem %} hide-sm{% endif %}{% if block_st.hided %} hide-md hide-lg{% endif %}" style="{{ styles | strip_newlines }}" {{ block.shopify_attributes }}>
    <div class="column-inner fl f-col gap {{ block_st.position }} {{ block_align_mb }} {{ block_align }}">
        {%- content_for 'blocks' -%}
    </div>
</div>
