{%- if settings.wishlist -%}
    <product-card class="fl">
        <button type="button" class="fl f-aic pr grid-button wishlist addwishlist border-0 [linkclass]" data-url="{{pages[settings.wishlist_page].url}}" data-id="{{ product.id }}" aria-label="{{ 'products.wishlist.add_to_wishlist' | t }}">
            <div>
                <span class="txt"><svg class="at-icon wishicon"><svg class="wish-fill" viewBox="0 0 36 32" display="none" aria-hidden="true"><path d="M25.9,0.2c-2.9,0-5.7,1.8-7.9,3.7c-2.2-2-5-3.7-7.9-3.7C3.9,0.2,0,4,0,10.3c0,5,4.3,9,4.6,9.4l11.6,11.5c1,0.9,2.5,1,3.5,0 l11.6-11.5c1.1-1.1,4.6-4.8,4.6-9.4C36,4,32.1,0.2,25.9,0.2z"/></svg><use class="add" xlink:href="#icon-wishlist"></use><use class="added" xlink:href="#icon-remove"></use></svg></span>
                <svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg>
            </div>
            <span class="wish-txt">{{ 'products.wishlist.add_to_wishlist' | t}}</span>
        </button>
    </product-card>
{%- endif -%}
{% schema %}
{
  "name": "Wishlist link",
  "tag": null, 
  "settings": [
    {
        "type": "paragraph",
        "content": "Change link text from theme default content"
    }
  ],
  "presets": [
    {
      "name": "Wishlist link",
      "category": "Product"
    }
  ]
}
{% endschema %}
