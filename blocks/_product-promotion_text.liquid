{%- liquid
    assign block_st = block.settings
    assign showblock = true
    if block_st.hide_empty and block_st.text == blank
        assign showblock = false
    endif
-%}
{%- if showblock -%}
<div class="salepoint reg-text fl mb{{ block_st.mbm }} mb{{ block_st.mb }}-md{%  if block_st.atc and block_st.icon == 'none'%} f-jcc t-center{% endif %} {{ block_st.rounded }}" style="--icns:{{ block_st.icon-size }}px;--cl:{{ block_st.cl }}; --clbg:{{ block_st.clbg }}; --fs:{{ block_st.fs }}px;--fsm:{{ block_st.fsm }}px;--pd-x:{{ block_st.pd-x}}px;--lh:1.4;--pd-y:{{ block_st.pd-y }}px;" {{ block.shopify_attributes }}>
    {%- if block_st.sicon != blank and block_st.icon == 'custom' -%}
        <img loading="lazy" class="at-icon" src="{{ block_st.sicon | image_url: width: '18' }}" width="18" height="18" alt="{{ block_st.sicon.alt }}" />
    {%- else -%}
        {%- render 'icons', icon: block_st.icon -%}
    {%- endif -%}
    <div class="fl1">{{ block_st.text }}</div>
</div>
{%- endif -%}
