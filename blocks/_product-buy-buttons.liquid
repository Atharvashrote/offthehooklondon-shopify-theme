    .product-form .product-form__buttons > .fl.gap.mb10.pd-utility-row > .product-form__submit,
    .product-form .product-form__buttons:has(> .pd-utility-row) > .buy-now-button,
    .product-form .product-form__buttons > .fl.gap.mb10.pd-utility-row.has-notify-me > .ot-custom-notify-me {
        font-size: 12px !important;
        letter-spacing: .04em !important;
    }
}

@media (max-width: 749px) {
    .product-form .product-form__buttons > .fl.gap.mb10.has-notify-me {
        grid-template-columns: 1fr 1.25fr 1.25fr !important;
        gap: 8px !important;
    }

    .product-form .product-form__buttons > .fl.gap.mb10.has-notify-me > quantity-input.quantity,
    .product-form .product-form__buttons > .fl.gap.mb10.has-notify-me > .product-form__submit,
    .product-form .product-form__buttons > .fl.gap.mb10.has-notify-me > .ot-custom-notify-me {
        height: 60px !important;
        min-height: 60px !important;
    }
</style>

<script>
(function () {
  'use strict';

  var updateTimer = null;
  var observer = null;

  function normalizeText(element) {
    return (element && element.textContent || '')
      .replace(/\s+/g, ' ')
      .trim()
      .toUpperCase();
  }

  function findNotifyButton() {
    var candidates = document.querySelectorAll(
      '.product-form button, .product-form a, .product-form [role="button"], ' +
      'product-form button, product-form a, button, a, [role="button"]'
    );

    for (var i = 0; i < candidates.length; i++) {
      if (normalizeText(candidates[i]) === 'NOTIFY ME') {
        return candidates[i];
      }
    }

    return null;
  }

  function findProductRoot(notify, formButtons) {
    return (notify && notify.closest('product-form')) ||
      (formButtons && formButtons.closest('product-form')) ||
      (notify && notify.closest('.product-form')) ||
      (formButtons && formButtons.closest('.product-form')) ||
      null;
  }

  function getSelectedVariant(productRoot) {
    if (!productRoot) return null;

    var variantInput = productRoot.querySelector(
      'input.product-variant-id[name="id"], input[name="id"]'
    );
    var buyNowButton = productRoot.querySelector('[data-buy-now]');

    if (!variantInput || !variantInput.value || !buyNowButton) {
      return null;
    }

    var variants;
    try {
      variants = JSON.parse(buyNowButton.getAttribute('data-variants') || '[]');
    } catch (error) {
      console.error('Notify Me: Could not read product variants.', error);
      return null;
    }

    for (var i = 0; i < variants.length; i++) {
      if (String(variants[i].id) === String(variantInput.value)) {
        return variants[i];
      }
    }

    return null;
  }

  function updateNotifyMe() {
    var notify = findNotifyButton();
    if (!notify) return;

    var formButtons = notify.closest('.product-form__buttons');
    if (!formButtons) {
      var form = notify.closest('form');
      formButtons = form && form.querySelector('.product-form__buttons');
    }
    if (!formButtons) {
      var nearestProductRoot = notify.closest('product-form');
      formButtons = nearestProductRoot && nearestProductRoot.querySelector('.product-form__buttons');
    }
    if (!formButtons) return;

    var actionRow = formButtons.querySelector('.fl.gap.mb10');
    if (!actionRow) return;

    /* Move the existing app button; do not clone or recreate it. */
    if (notify.parentElement !== actionRow) {
      var wrapper = notify.parentElement;
      if (wrapper && wrapper !== actionRow && wrapper.children.length === 1) {
        wrapper.classList.add('ot-notify-original-wrapper');
      }

      notify.classList.add('ot-custom-notify-me');
      actionRow.appendChild(notify);
    } else {
      notify.classList.add('ot-custom-notify-me');
    }

    var productRoot = findProductRoot(notify, formButtons);
    var selectedVariant = getSelectedVariant(productRoot);

    /*
     * Hide only when we positively confirm that the selected variant is
     * available. If variant data is not ready, leave Notify Me visible.
     */
    if (selectedVariant && selectedVariant.available === true) {
      notify.style.setProperty('display', 'none', 'important');
      actionRow.classList.remove('has-notify-me');
    } else {
      notify.style.removeProperty('display');
      actionRow.classList.add('has-notify-me');
    }
  }

  function scheduleUpdate() {
    window.clearTimeout(updateTimer);
    updateTimer = window.setTimeout(updateNotifyMe, 150);
  }

  function init() {
    updateNotifyMe();

    /* Avone updates the selected variant after picker events. */
    document.addEventListener('variant:change', scheduleUpdate);
    document.addEventListener('change', function (event) {
      if (event.target && event.target.closest && event.target.closest('.product-form')) {
        scheduleUpdate();
        window.setTimeout(updateNotifyMe, 350);
      }
    });

    /* Re-check if the theme or back-in-stock app rerenders its button. */
    if (!observer && document.body) {
      observer = new MutationObserver(scheduleUpdate);
      observer.observe(document.body, {
        childList: true,
        subtree: true
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
</script>
