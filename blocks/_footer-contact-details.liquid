{%- liquid
  assign block_st = block.settings
-%}

<div
  class="gitem adth-footer__block wd50-md {{ block_st.width }}-lg{% if block_st.hidem %} hide-sm{% endif %}{% if block_st.hide_desk %} hide-md hide-lg{% endif %}"
  style="
    --contact-heading-color: {{ block_st.heading_color }};
    --contact-text-color: {{ block_st.text_color }};
    --contact-hover-color: {{ block_st.hover_color }};
    --contact-divider-color: {{ block_st.divider_color }};
    --contact-heading-size: {{ block_st.heading_size }}px;
    --contact-heading-mobile: {{ block_st.heading_size_mobile }}px;
    --contact-text-size: {{ block_st.text_size }}px;
    --contact-text-mobile: {{ block_st.text_size_mobile }}px;
    --social-size: {{ block_st.social_size }}px;
    --social-gap: {{ block_st.social_gap }}px;
    --social-color: {{ block_st.social_color }};
    --social-hover: {{ block_st.social_hover }};
  "
  {{ block.shopify_attributes }}
>

  <!-- =========================================
       HEADING
  ========================================== -->

  {% if block_st.title != blank %}
    <div class="custom-contact-heading">

      {% if block_st.show_icon %}
        <svg
          class="custom-contact-heading-icon"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M20 4H4C2.9 4 2 4.9 2 6v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 2v.5l-8 6.2-8-6.2V6h16zM4 18V9.1l7.4 5.7c.35.27.85.27 1.2 0L20 9.1V18H4z"/>
        </svg>
      {% endif %}

      <span>{{ block_st.title }}</span>

    </div>
  {% endif %}


  <!-- =========================================
       CONTACT INFORMATION
  ========================================== -->

  <div class="custom-contact-items">

    <!-- CONTACT 1 -->

    {% if block_st.contact_1_text != blank %}
      <div class="custom-contact-item">

        {% if block_st.contact_1_link != blank %}

          <a
            href="{{ block_st.contact_1_link }}"
            {% if block_st.contact_1_link contains 'http' %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >

            <span class="custom-contact-item__label">
              {{ block_st.contact_1_label }}
            </span>

            <span class="custom-contact-item__text">
              {{ block_st.contact_1_text }}
            </span>

          </a>

        {% else %}

          <span class="custom-contact-item__label">
            {{ block_st.contact_1_label }}
          </span>

          <span class="custom-contact-item__text">
            {{ block_st.contact_1_text }}
          </span>

        {% endif %}

      </div>
    {% endif %}


    <!-- CONTACT 2 -->

    {% if block_st.contact_2_text != blank %}
      <div class="custom-contact-item">

        {% if block_st.contact_2_link != blank %}

          <a
            href="{{ block_st.contact_2_link }}"
            {% if block_st.contact_2_link contains 'http' %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >

            <span class="custom-contact-item__label">
              {{ block_st.contact_2_label }}
            </span>

            <span class="custom-contact-item__text">
              {{ block_st.contact_2_text }}
            </span>

          </a>

        {% else %}

          <span class="custom-contact-item__label">
            {{ block_st.contact_2_label }}
          </span>

          <span class="custom-contact-item__text">
            {{ block_st.contact_2_text }}
          </span>

        {% endif %}

      </div>
    {% endif %}


    <!-- CONTACT 3 -->

    {% if block_st.contact_3_text != blank %}
      <div class="custom-contact-item">

        {% if block_st.contact_3_link != blank %}

          <a
            href="{{ block_st.contact_3_link }}"
            {% if block_st.contact_3_link contains 'http' %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >

            <span class="custom-contact-item__label">
              {{ block_st.contact_3_label }}
            </span>

            <span class="custom-contact-item__text">
              {{ block_st.contact_3_text }}
            </span>

          </a>

        {% else %}

          <span class="custom-contact-item__label">
            {{ block_st.contact_3_label }}
          </span>

          <span class="custom-contact-item__text">
            {{ block_st.contact_3_text }}
          </span>

        {% endif %}

      </div>
    {% endif %}


    <!-- CONTACT 4 -->

    {% if block_st.contact_4_text != blank %}
      <div class="custom-contact-item">

        {% if block_st.contact_4_link != blank %}

          <a
            href="{{ block_st.contact_4_link }}"
            {% if block_st.contact_4_link contains 'http' %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >

            <span class="custom-contact-item__label">
              {{ block_st.contact_4_label }}
            </span>

            <span class="custom-contact-item__text">
              {{ block_st.contact_4_text }}
            </span>

          </a>

        {% else %}

          <span class="custom-contact-item__label">
            {{ block_st.contact_4_label }}
          </span>

          <span class="custom-contact-item__text">
            {{ block_st.contact_4_text }}
          </span>

        {% endif %}

      </div>
    {% endif %}


    <!-- CONTACT 5 -->

    {% if block_st.contact_5_text != blank %}
      <div class="custom-contact-item">

        {% if block_st.contact_5_link != blank %}

          <a
            href="{{ block_st.contact_5_link }}"
            {% if block_st.contact_5_link contains 'http' %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >

            <span class="custom-contact-item__label">
              {{ block_st.contact_5_label }}
            </span>

            <span class="custom-contact-item__text">
              {{ block_st.contact_5_text }}
            </span>

          </a>

        {% else %}

          <span class="custom-contact-item__label">
            {{ block_st.contact_5_label }}
          </span>

          <span class="custom-contact-item__text">
            {{ block_st.contact_5_text }}
          </span>

        {% endif %}

      </div>
    {% endif %}

  </div>


  <!-- =========================================
       CUSTOM SOCIAL MEDIA
  ========================================== -->

  {% if block_st.show_social %}

    <div class="custom-footer-social">

      <!-- INSTAGRAM -->

      {% if block_st.instagram_url != blank %}

        <a
          href="{{ block_st.instagram_url }}"
          class="custom-social-icon custom-social-instagram"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >

          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >

            <rect
              class="instagram-outline"
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              ry="5"
            />

            <circle
              class="instagram-camera"
              cx="12"
              cy="12"
              r="4"
            />

            <circle
              class="instagram-dot"
              cx="17.3"
              cy="6.7"
              r="1.1"
            />

          </svg>

        </a>

      {% endif %}


      <!-- FACEBOOK -->

      {% if block_st.facebook_url != blank %}

        <a
          href="{{ block_st.facebook_url }}"
          class="custom-social-icon custom-social-facebook"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >

          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >

            <path d="M14.2 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H8v3h2.8v8h3.4z"/>

          </svg>

        </a>

      {% endif %}


      <!-- YOUTUBE -->

      {% if block_st.youtube_url != blank %}

        <a
          href="{{ block_st.youtube_url }}"
          class="custom-social-icon custom-social-youtube"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
        >

          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >

            <path
              class="youtube-background"
              d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8z"
            />

            <path
              class="youtube-play"
              d="M9.5 8.3v7.4l6.2-3.7-6.2-3.7z"
            />

          </svg>

        </a>

      {% endif %}


      <!-- TIKTOK -->

      {% if block_st.tiktok_url != blank %}

        <a
          href="{{ block_st.tiktok_url }}"
          class="custom-social-icon custom-social-tiktok"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
        >

          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >

            <path d="M15.5 3c.2 2.3 1.5 4 3.8 4.3v3.2c-1.4-.1-2.7-.6-3.8-1.4v6.1c0 3.5-2.7 5.8-6.1 5.8-3.1 0-5.5-2.4-5.5-5.3 0-3.1 2.6-5.4 5.8-5.4.3 0 .7 0 1 .1v3.2c-.3-.1-.6-.2-1-.2-1.4 0-2.5 1-2.5 2.3 0 1.2 1 2.2 2.3 2.2 1.5 0 2.5-1 2.5-2.8V3h3.5z"/>

          </svg>

        </a>

      {% endif %}


      <!-- PINTEREST -->

      {% if block_st.pinterest_url != blank %}

        <a
          href="{{ block_st.pinterest_url }}"
          class="custom-social-icon custom-social-pinterest"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Pinterest"
        >

          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >

            <path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-1.6 0-3.3.4-4.8l1.1-4.5s-.3-.7-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.4-.3 1 .5 1.8 1.5 1.8 1.8 0 3.2-1.9 3.2-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.6 2.2-4.6 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.4l-.3 1.2c-.1.4-.4.5-.7.3-1.3-.6-2.1-2.4-2.1-3.9 0-3.2 2.3-6.2 6.8-6.2 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.5 6.5-1.1 0-2.1-.5-2.4-1.3l-.7 2.7c-.3 1-.9 2.2-1.3 3.1.9.3 1.9.4 2.9.4A10 10 0 1 0 12 2z"/>

          </svg>

        </a>

      {% endif %}


      <!-- X / TWITTER -->

      {% if block_st.twitter_url != blank %}

        <a
          href="{{ block_st.twitter_url }}"
          class="custom-social-icon custom-social-x"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X"
        >

          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >

            <path d="M5 4L19 20M19 4L5 20"/>

          </svg>

        </a>

      {% endif %}


      <!-- LINKEDIN -->

      {% if block_st.linkedin_url != blank %}

        <a
          href="{{ block_st.linkedin_url }}"
          class="custom-social-icon custom-social-linkedin"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >

          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >

            <path d="M5 4.5A2.5 2.5 0 1 1 5 9a2.5 2.5 0 0 1 0-4.5zM3 10h4v11H3V10zm6 0h4v1.5c.8-1.1 2-1.9 3.8-1.9 3.5 0 4.2 2.3 4.2 5.3V21h-4v-5.4c0-1.3 0-3-1.9-3s-2.1 1.5-2.1 2.9V21H9V10z"/>

          </svg>

        </a>

      {% endif %}

    </div>

  {% endif %}


  <!-- =========================================
       DIVIDER
  ========================================== -->

  {% if block_st.show_divider %}
    <div class="custom-contact-divider"></div>
  {% endif %}

</div>


<style>

/* =========================================
   MAIN CONTACT BLOCK
========================================= */

.custom-contact-heading {
  display: flex;
  align-items: center;
  gap: 11px;

  margin: 0 0 28px;

  color: var(--contact-heading-color);

  font-size: var(--contact-heading-size);
  font-weight: 700;
  line-height: 1.2;
}

.custom-contact-heading-icon {
  width: 27px;
  height: 27px;

  min-width: 27px;

  display: block;

  fill: currentColor;
}


/* =========================================
   CONTACT ITEMS
========================================= */

.custom-contact-items {
  display: flex;
  flex-direction: column;

  gap: 16px;
}

.custom-contact-item {
  margin: 0;
  padding: 0;

  color: var(--contact-text-color);

  font-size: var(--contact-text-size);
  line-height: 1.5;
}

.custom-contact-item a {
  color: var(--contact-text-color);

  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;

  transition:
    color .25s ease,
    opacity .25s ease;
}

.custom-contact-item a:hover {
  color: var(--contact-hover-color);

  opacity: .8;
}

.custom-contact-item__label {
  font-weight: 700;
}

.custom-contact-item__text {
  font-weight: 400;
}


/* =========================================
   SOCIAL MEDIA
========================================= */

.custom-footer-social {
  display: flex;
  align-items: center;

  gap: var(--social-gap, 18px);

  margin-top: 28px;
}

.custom-social-icon {
  width: var(--social-size, 22px);
  height: var(--social-size, 22px);

  min-width: var(--social-size, 22px);

  display: inline-flex;
  align-items: center;
  justify-content: center;

  color: var(--social-color, #ffffff);

  text-decoration: none !important;

  line-height: 0;

  transition:
    transform .25s ease,
    color .25s ease,
    opacity .25s ease;
}

.custom-social-icon:hover {
  color: var(--social-hover, #cccccc);

  transform: translateY(-3px);

  opacity: 1;
}


/* =========================================
   ALL SOCIAL SVG
========================================= */

.custom-social-icon svg {
  display: block !important;

  width: 100% !important;
  height: 100% !important;

  max-width: none !important;
  max-height: none !important;

  overflow: visible !important;
}


/* =========================================
   INSTAGRAM
========================================= */

.custom-social-instagram svg {
  fill: none !important;
  stroke: none !important;
}

.custom-social-instagram .instagram-outline {
  fill: none !important;

  stroke: currentColor !important;

  stroke-width: 1.8 !important;
}

.custom-social-instagram .instagram-camera {
  fill: none !important;

  stroke: currentColor !important;

  stroke-width: 1.8 !important;
}

.custom-social-instagram .instagram-dot {
  fill: currentColor !important;

  stroke: none !important;
}


/* =========================================
   FACEBOOK
========================================= */

.custom-social-facebook svg {
  fill: currentColor !important;

  stroke: none !important;
}

.custom-social-facebook path {
  fill: currentColor !important;

  stroke: none !important;
}


/* =========================================
   YOUTUBE
========================================= */

.custom-social-youtube svg {
  overflow: visible !important;
}

.custom-social-youtube .youtube-background {
  fill: currentColor !important;

  stroke: none !important;
}

.custom-social-youtube .youtube-play {
  fill: #111111 !important;

  stroke: none !important;
}


/* =========================================
   TIKTOK
========================================= */

.custom-social-tiktok svg {
  fill: currentColor !important;

  stroke: none !important;
}

.custom-social-tiktok path {
  fill: currentColor !important;

  stroke: none !important;
}


/* =========================================
   PINTEREST
========================================= */

.custom-social-pinterest svg {
  fill: currentColor !important;

  stroke: none !important;
}

.custom-social-pinterest path {
  fill: currentColor !important;

  stroke: none !important;
}


/* =========================================
   X / TWITTER
========================================= */

.custom-social-x svg {
  fill: none !important;

  stroke: currentColor !important;

  stroke-width: 1.8 !important;

  stroke-linecap: round !important;

  stroke-linejoin: round !important;
}

.custom-social-x path {
  fill: none !important;

  stroke: currentColor !important;

  stroke-width: 1.8 !important;
}


/* =========================================
   LINKEDIN
========================================= */

.custom-social-linkedin svg {
  fill: currentColor !important;

  stroke: none !important;
}

.custom-social-linkedin path {
  fill: currentColor !important;

  stroke: none !important;
}


/* =========================================
   DIVIDER
========================================= */

.custom-contact-divider {
  width: 100%;
  max-width: 360px;

  height: 1px;

  margin-top: 40px;

  background: var(--contact-divider-color);
}


/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 767px) {

  .custom-contact-heading {
    margin-bottom: 22px;

    font-size: var(--contact-heading-mobile);
  }

  .custom-contact-heading-icon {
    width: 23px;
    height: 23px;

    min-width: 23px;
  }

  .custom-contact-items {
    gap: 13px;
  }

  .custom-contact-item {
    font-size: var(--contact-text-mobile);
  }

  .custom-footer-social {
    gap: 16px;

    margin-top: 24px;
  }

  .custom-contact-divider {
    margin-top: 30px;
  }

}

</style>


{% schema %}

