{%- liquid
  assign block_st = block.settings
-%}

<div class="fl f-aic free-delivery-text">
  {%- render 'icons', icon: 'truck' -%}
  <span>Free Delivery</span>
</div>


<div id="pop{{ block.id }}" class="tinglebox pp-hide cm rte">
  {% if block_st.opt == 'page' %}{{ pages[block_st.page].content }}{% else %}{{ block_st.poptext }}{% endif %}
</div>
