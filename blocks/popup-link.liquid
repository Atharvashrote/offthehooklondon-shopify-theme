{% liquid
    assign block_st = block.settings
    assign link_class = 'btn-link'
    if block_st.lstyle == 'button'
        assign link_class = 'btn'
    elsif block_st.lstyle == 'none'
        assign link_class = 'btn-link btn-reset anim'
    endif   
-%}
{%- capture styles -%}
    --icns:{{ block_st.fs | plus: 1 }}px;   
    {%- if block_st.lstyle == 'button' -%}
        --btn_cl:{{ block_st.cl }};--btn_clh:{{ block_st.clh }};--btn_fs:{{ block_st.fs }}px;--btn_fsm:{{ block_st.fsm }}px;--btn_fw:{{ block_st.fw }};
        --btn_bg:{{ block_st.bg }};--btn_bgh:{{ block_st.bgh }};--btn_radius:{{ block_st.brad }}px;--btn_bd_sz:0;
    {%- else -%}
        --btn_link:{{ block_st.cl }};
    {%- endif -%}    
{%- endcapture -%}
<div class="poplink fl mb{{ block_st.mbm }} mb{{ block_st.mb }}-md" style="{{ styles }}" {{ block.shopify_attributes }}>
    <a href="#lp{{ block.id }}" class="fl f-aic popup-link {{ link_class }}" data-popup="lp{{ block.id }}" aria-haspopup="dialog">
       {% if block_st.image != blank and block_st.icon == 'custom' -%}
        <img loading="lazy" class="at-icon" src="{{ block_st.image | image_url: width: '60' }}" width="18" height="18" alt="" >
      {%- else -%}
        {%- render 'icons', icon: block_st.icon %}
      {% endif %}
        {{ block_st.text }}
    </a>
    <div id="lp{{ block.id }}" class="tinglebox pp-hide cm">
        {%  if block_st.opt == "page" %}{{ pages[block_st.page].content }}{%  else %}{{ block_st.poptext }}{%  endif %}
    </div>
</div>
