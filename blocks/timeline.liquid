{{ 'timeline.css' | asset_url | stylesheet_tag: preload: true }}
{%- liquid
  assign block_st = block.settings

  capture inner_classes
    if block_st.isbg
      echo 'bg-custom '
    endif
    if block_st.ispd
      echo 'pd-custom '
    endif
    echo block_st.rounded
  endcapture
-%}
{%- capture inner_styles -%}
  {%- if block_st.isbg -%}
    --gr_bg:{% if block_st.bgg != blank %}{{ block_st.bgg }}{% else %}{{ block_st.bg }}{% endif %};
    --gr_bd:{% if block_st.bdr == 'solid' %}{{ block_st.brd_sz }}px solid {{ block_st.bdr-cl }}{% else %}0{% endif %};
  {%- endif -%}
  {%- if block_st.ispd -%}
    --gr_pd:{{ block_st.pd-tb }}px {{ block_st.pd-lr }}px;--gr_pdm:{{ block_st.pd-tbm }}px {{ block_st.pd-lrm }}px;
  {%- endif -%}
{%- endcapture -%}

{%- capture connector_line -%}
--y_pos:{{ block_st.icon_size | divided_by: 2 }}px;--x_pos:{{ block_st.icon_size | divided_by: 2 }}px;--cl:{{ block_st.connector_color }};--line_width:{{ block_st.line_width }}px;--height:calc(100% - {{ block_st.icon_size }}px);
{%- endcapture -%}

<div id="timeline-block" class="wd100 reg-text db pd0 mb{{ block_st.mbm }} mb{{ block_st.mb }}-md{% if block_st.hide_mb %} hide-sm{% endif %}" {{ block.shopify_attributes }}>
  <timeline-progress class="db" style="--cl-progress: {{ block_st.progress_color }};">
    <div class="timeline-inner {{ inner_classes }}" style="{{ inner_styles | strip_newlines }}">
      <div class="timeline-steps fl f-col pr gap" style="--gap:50px;--gapm:40px">
        <div class="timeline-connector pa" style="{{ connector_line | strip_newlines }}"></div>
        {%- for i in (1..4) -%}
          {%- liquid
            assign step_title_key = 'step_' | append: i | append: '_title'
            assign step_description_key = 'step_' | append: i | append: '_description'
            assign step_title = block.settings[step_title_key]
            assign step_description = block.settings[step_description_key]
          -%}
          <div class="timeline-step fl f-ais pr zi1 gap {% render 'animate-data', css: true %}" data-step="{{ i }}" {% render 'animate-data' %} style="--gap:25px;--gapm:20px;">
            <div class="timeline-icon pr round-full anim" style="--icon_size:{{ block_st.icon_size }}px;--icon_bg:{{ block_st.icon_bg_color }};--icon-bd:{{ block_st.icon_border_width }}px;--icon-bd-cl:{{ block_st.icon_border_color }};--progress-text-cl:{{ block_st.progress_text_color }};">
              <span class="timeline-icon__number pa fl f-aic f-jcc fw-600" style="--number-size:{{ block_st.icon_size | times: 0.4 }}px;--number-cl:{{ block_st.icon_color }}">{{ i }}</span>
              <span class="timeline-icon__check pa left-50 top-50" aria-hidden="true" style="--icon-check-w:{{ block_st.icon_size | times: 0.32 }}px;--icon-check-h:{{ block_st.icon_size | times: 0.18 }}px;"></span>
            </div>
            <div class="timeline-step-content">
              {%- if step_title != blank -%}
                <h3 class="head {{ block_st.step_ttl_preset }} timeline-step-title mb10" style="{%- if block_st.step_ttl_preset == 'custom-hd' -%}--fs:{{ block_st.step_ttl_fs }}px;--fsm:{{ block_st.step_ttl_fsm }}px;--ff:var(--{{ block_st.step_ttl_ff }});--fw:{{ block_st.step_ttl_fw }};--lh:{{ block_st.step_ttl_lh }};--hdcl:{{ block_st.step_title_color }};{% else %}--hdcl:{{ block_st.step_title_color }};{% endif %}">
                  {{- step_title -}}
                </h3>
              {%- endif -%}
              {%- if step_description != blank -%}
                <div class="reg-text {{ block_st.step_txt_preset }} timeline-step-description"  style="{%- if block_st.step_txt_preset == 'custom' -%}--fs:{{ block_st.step_txt_fs }}px;--fsm:{{ block_st.step_txt_fsm }}px;--lh:{{ block_st.step_txt_lh }};--fw:{{ block_st.step_txt_fw }};{% endif %}--cl:{{ block_st.step_description_color }};">
                  {{ step_description | newline_to_br }}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </timeline-progress>
</div>

<script>
  (function () {
    if (customElements.get('timeline-progress')) return;
    class TimelineProgress extends HTMLElement {
      connectedCallback() {
        this._steps = Array.from(this.querySelectorAll('.timeline-step'));
        this._connector = this.querySelector('.timeline-connector');
        this._raf = null;
        this._onScroll = this._onScroll.bind(this);
        this._onResize = this._onResize.bind(this);
        this._recompute = this._recompute.bind(this);

        this._stepCenters = [];
        this._startY = 0;
        this._endY = 0;

        window.addEventListener('scroll', this._onScroll, { passive: true });
        window.addEventListener('resize', this._onResize, { passive: true });
        this._recompute();
        this._update();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this._onScroll);
        window.removeEventListener('resize', this._onResize);
        if (this._raf) cancelAnimationFrame(this._raf);
      }

      _onScroll() {
        if (this._raf) return;
        this._raf = requestAnimationFrame(() => {
          this._raf = null;
          this._update();
        });
      }

      _onResize() {
        this._recompute();
        this._update();
      }

      _recompute() {
        if (!this._steps || this._steps.length === 0) return;
        const viewportH = Math.max(window.innerHeight || 0, 1);
        const anchorY = window.scrollY + viewportH * 0.45;

        this._stepCenters = this._steps.map((step) => {
          const rect = step.getBoundingClientRect();
          return window.scrollY + rect.top + rect.height * 0.5;
        });

        this._startY = this._stepCenters[0];
        this._endY = this._stepCenters[this._stepCenters.length - 1];

        if (this._endY <= this._startY) this._endY = this._startY + 1;
        this._anchorRatio = anchorY;
      }

      _update() {
        if (!this._steps || this._steps.length === 0) return;
        const viewportH = Math.max(window.innerHeight || 0, 1);
        const anchorY = window.scrollY + viewportH * 0.45;

        const progress = Math.min(1, Math.max(0, (anchorY - this._startY) / (this._endY - this._startY)));

        const root = this.closest('[id^=\"blk-\"]') || this;
        root.style.setProperty('--timeline-progress', progress.toFixed(4));

        let activeIndex = 0;
        for (let i = 0; i < this._stepCenters.length; i++) {
          if (anchorY >= this._stepCenters[i]) activeIndex = i;
        }

        this._steps.forEach((step, i) => {
          step.classList.toggle('is-complete', i < activeIndex);
          step.classList.toggle('is-active', i === activeIndex);
          step.classList.toggle('is-upcoming', i > activeIndex);
        });
      }
    }
    customElements.define('timeline-progress', TimelineProgress);
  })();
</script>

