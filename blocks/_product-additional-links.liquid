{% liquid
    assign block_st = block.settings
    assign link_class = 'btn-link'
    if block_st.lstyle == 'button'
        assign link_class = 'btn'
    elsif block_st.lstyle == 'none'
        assign link_class = 'btn-link btn-reset anim'
    endif
    capture classes
        if block_st.direction == 'f-row-md' and block_st.wrap
            echo 'f-wrap '
        endif
    endcapture
-%}
{%- capture styles -%}
    --gap:{{ block_st.gap }}px;--gapm:{{ block_st.gapm }}px;--icns:{{ block_st.fs | plus: 3 }}px;--icnsm:{{ block_st.fsm | plus: 3 }}px; {% if block_st.text-upper %} --btn_tt:uppercase;{% endif %}
    {%- if block_st.direction_mobile == 'f-row' and block_st.wrapm -%} 
        --flexwrapm: wrap;
    {%- endif -%}
    {%- if block_st.lstyle == 'button' -%}
        --btn_cl:{{ block_st.cl }};--btn_clh:{{ block_st.clh }};--btn_fs:{{ block_st.fs }}px;--btn_fsm:{{ block_st.fsm }}px;--btn_fw:{{ block_st.fw }};
        --btn_bg:{{ block_st.bg }};--btn_bgh:{{ block_st.bgh }};--btn_radius:{{ block_st.brad }}px;--btn_bd_sz:0;
    {%- else -%}
        --btn_link:{{ block_st.cl }};--btn_linkh:{{ block_st.clh }};--btn_fs:{{ block_st.fs }}px;--btn_fsm:{{ block_st.fsm }}px;--btn_fw:{{ block_st.fw }};
    {%- endif -%}
{%- endcapture -%}
<div id="{{ block.id }}" class="group-bk additonal-links fl gap {{ block_st.direction_mobile }} {{ block_st.direction }} mb{{ block_st.mbm }} mb{{ block_st.mb }}-md {{ classes }}{% if block_st.text-upper %} text-upper{% endif %}"  style="{{ styles }}" {{ block.shopify_attributes }}>
    {%- capture block_content -%}
        {%- content_for 'blocks' -%}
    {%- endcapture -%}
    {{- block_content | replace: '[linkclass]', link_class -}}
</div>
{% schema %}
{
  "name": "Additonal links",
  "tag": null,   
  "blocks": [
    { "type": "_product-link-inquiry" },
    { "type": "_product-link-wishlist" },
    { "type": "_product-link-popup" },
    { "type": "_product-link-share" },
    { "type": "_product-link-custom" },
    { "type": "_product-link-sizechart" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "f-row-md",
      "options": [
        { "label": "Horizontal", "value": "f-row-md" },
        { "label": "Vertical", "value": "f-col-md" }
      ]
    },
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "Wrap items",
      "default": false,
      "visible_if": "{{ block.settings.direction == 'f-row-md' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Gap",
      "default": 15
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "direction_mobile",
      "label": "Direction",
      "default": "f-row",
      "options": [
        { "label": "Horizontal", "value": "f-row" },
        { "label": "Vertical", "value": "f-col" }
      ]
    },
    {
      "type": "checkbox",
      "id": "wrapm",
      "label": "Wrap Items",
      "default": false,
      "visible_if": "{{ block.settings.direction_mobile == 'f-row' }}"
    },
    {
      "type": "range",
      "id": "gapm",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Gap (mobile)",
      "default": 10
    },
    {
        "type": "header",
        "content": "Links appearance"
    },
    {
      "type": "select",
      "id": "lstyle",
      "label": "Links design",
      "default": "none",
      "options": [
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "bottom_bdr",
          "label": "Border bottom"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "range",
      "id": "fs",
      "min": 10,
      "max": 60,
      "step": 1,
      "label": "Font size",
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "fsm",
      "min": 10,
      "max": 60,
      "step": 1,
      "label": "Font size (mobile)",
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "fw",
      "label": "Font weight",
      "default": "500",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
     {
      "type": "checkbox",
      "id": "text-upper",
      "label": "Use uppercase text",
      "default": false      
    },
    {
      "type": "color",
      "id": "cl",
      "label": "Text color",
      "default": "#555"
    },
    {
      "type": "color",
      "id": "clh",
      "label": "Text hover",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f5f5f5",
      "visible_if": "{{ block.settings.lstyle == 'button' }}"
    },
    {
      "type": "color",
      "id": "bgh",
      "label": "Background (links hover)",
      "default": "#eeeeee",
      "visible_if": "{{ block.settings.lstyle == 'button' }}"
    },
    {
      "type": "range",
      "id": "brad",
      "min": 0,
      "max": 30,
      "step": 1,
      "label": "Corner radius",
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.lstyle == 'button' }}"
    },
    {
      "type": "paragraph",
      "content": "-----------------------------------------------"
    },
    {
      "type": "range",
      "id": "mb",
      "label": "Bottom margin",
      "default": 20,
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mbm",
      "label": "Bottom margin (mobile)",
      "default": 15,
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Additonal links",
      "category": "Product",
      "blocks": [        
        { "type": "_product-link-wishlist" },
        { "type": "_product-link-popup" },
        { "type": "_product-link-inquiry" }
      ]
    }
  ]
}
{% endschema %}


