{%- liquid
  assign block_st = block.settings
-%}

<a href="#productinquiry" class="ask-ques fl f-aic popup-link [linkclass]" data-popup="productinquiry" aria-haspopup="dialog" role="link" aria-disabled="true">
   {% if block_st.image != blank and block_st.icon == 'custom' -%}
    <img loading="lazy" class="at-icon mr5" src="{{ block_st.image | image_url: width: '60' }}" width="18" height="18" alt="" >
  {%- else -%}
    {%- render 'icons', icon: block_st.icon %}
  {% endif %}   
  {{ 'products.enquiry.link' | t }}
</a>
