{% liquid
  assign block_st = block.settings
%}
{%- capture styles -%}
    {%- if block_st.preset == 'custom' -%}
      --fs:{{ block_st.fs }}px;--fsm:{{ block_st.fsm }}px;--lh:{{ block_st.lh }};--fw:{{ block_st.fw }};
    {%- endif -%}
{%- endcapture -%}
<div id="blk-{{ block.id }}" class="reg-text rte {{ block_st.ff }} mb{{ block_st.mbm }} mb{{ block_st.mb }}-md{% if block_st.hide_mb %} hide-sm{% endif %}{% if block_st.hide_br %} hide_br{% endif %}{% if block_st.tac %} t-center{% endif %}"
  style="--cl:{{ block_st.cl }};{{ styles }}" {{ block.shopify_attributes }}>
  {{- block.settings.text -}}
</div>
{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
      "info": "Shift + Enter to line break."
    },
    {
      "type": "checkbox",
      "id": "hide_br",
      "label": "Hide <br> on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mb",
      "label": "Hide on mobile",
      "default": false
    },
    {
        "type": "header",
        "content": "Appearance"
    },
    {
        "type": "color",
        "id": "cl",
        "label": "Color",
    },
    {
      "type": "select",
      "id": "preset",
      "label": "Preset",
      "info": "Edit presets in [theme settings](/editor?context=theme&category=Typography and Colors)",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
        "type": "select",
        "id": "ff",
        "label": "Font",
        "default": "ft1",
        "visible_if": "{{ block.settings.preset == 'custom' }}",
        "options": [
            {
                "value": "ft1",
                "label": "Body font"
            },
            {
                "value": "ft2",
                "label": "Heading font"
            },
            {
                "value": "ft3",
                "label": "Accent font"
            }
        ]
    },
    {
        "type": "range",
        "id": "fs",
        "label": "Font size",
        "default": 14,
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "visible_if": "{{ block.settings.preset == 'custom' }}"
    }, 
  {
        "type": "range",
        "id": "fsm",
        "label": "Font size (mobile)",
        "default": 13,
        "min": 10,
        "max": 60,
        "step": 1,
        "unit": "px",
        "visible_if": "{{ block.settings.preset == 'custom' }}"
    },    
    {
        "type": "select",
        "id": "fw",
        "label": "Font weight",
        "default": "400",
        "visible_if": "{{ block.settings.preset == 'custom' }}",
        "options": [
            {
                "value": "300",
                "label": "Light"
            },
            {
                "value": "400",
                "label": "Regular"
            },
            {
                "value": "500",
                "label": "Medium"
            },
            {
                "value": "600",
                "label": "Semi bold"
            },
            {
                "value": "700",
                "label": "Bold"
            }
        ]
    }, 	
    {
        "type": "range",
        "id": "lh",
        "label": "Line height",
        "default": 1.6,
        "min": 0.7,
        "max": 2.0,
        "step": 0.1,       
        "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
      {
      "type": "checkbox",
      "id": "tac",
      "label": "Center text",
      "default":false
    },
    {
        "type": "paragraph",
       "content": "-----------------------------------------------"
    },
    {
        "type": "range",
        "id": "mb",
        "label": "Bottom margin",
        "default":0,
        "min":0,
        "max": 50,
        "step":5,
        "unit": "px"
    },
    {
        "type": "range",
        "id": "mbm",
        "label": "Bottom margin (mobile)",
        "default":0,
        "min":0,
        "max":50,
        "step":5,
        "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Text",
      "category": "Basic"
    }
  ]
}
{% endschema %}