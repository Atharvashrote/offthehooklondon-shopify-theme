{% liquid
    assign block_st = block.settings
    assign cnt_width = settings.cntwd | append: 'px'
    if section.settings.sw
        assign cnt_width = '100vw'
    endif

    assign cmcolumn = 100.00 | divided_by: 60 | times: 1
    assign cmdivide = 1.00 | divided_by: cmcolumn | round: 2
-%}
{%- capture sizes -%}
    (min-width:1024px) calc((({{ cnt_width }} - 70px * {{ cmcolumn | minus: 1 }}) * {{ cmdivide }}) / {{ block_st.grid }}),(min-width:768px) calc((({{ cnt_width }} - 70px * {{ cmcolumn | minus: 1 }}) * {{ cmdivide }}) / {{ block_st.gridtb }}), calc(100vw / {{ block_st.gridmb }})
{%- endcapture -%}
{%- capture head_styles -%}
    --hdcl:{{ block_st.cl }};
    {%- if block_st.preset == 'custom-hd' -%}
      --fs:{{ block_st.fs }}px;--fsm:{{ block_st.fsm }}px;--ff:var(--{{ block_st.ff }});--fw:{{ block_st.fw }};--lh:{{ block_st.lh }};--ls:{{ block_st.ls }};
    {%- endif -%}
{%- endcapture -%}
<div class="complementary-products recommendad-wrapper mb{{ block_st.mbm }} mb{{ block_st.mb }}-md" {{ block_st.shopify_attributes }}>
    {% if block_st.title != blank %}
        <{{ block_st.htag }} id="blk-{{ block.id }}" class="head {{ block_st.preset }} mb15" style="{{ head_styles }}">{{- block_st.title -}}</{{ block_st.htag }}>
    {% endif %}
    <product-recommendations data-id="compSlider" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block_st.limit }}&intent=complementary"
        class="grid gspace recomPr rwcols-{{ block_st.gridmb }} rwcols-md-{{ block_st.gridtb }} rwcols-lg-{{ block_st.grid }} recomprSlider swiper" role="list" id="compSlider" style="--grsp:7px;--grspm:5px;"
        data-swiper='{ "slidesPerView":"auto", "loop":false, {% if block_st.autoplay %}"autoplay":{ "delay":"{{ block_st.speed | times: 1000 }}" },{% endif %} "navigation":{ "nextEl":".swn{{ section.id }}","prevEl":".swp{{ section.id }}" },"pagination":{ "el":".swpg{{ section.id }}","clickable":false }}'>
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
            <div class="swiper-wrapper">
            {%- for product in recommendations.products limit: block_st.settings.products_per_page -%}
                <div class="swiper-slide gitem tc">
                    <div class="grid-content">
                        <a class="grid-image mb15" href="{{ product.url | within: collection }}">
                            {{ product.featured_image | image_url: width: product.featured_image.width | image_tag: loading:'lazy', class:'img-fit primary', sizes:sizes, widths:"100,200,300,450,600" }}
                        </a>
                    <div class="grid-title"><a href="{{ product.url | within: collection }}">{{ product.title }}</a></div>
                    {% unless settings.catalogmode %}<div class="grid-price mt5">{% render 'product-price', product: product %}</div>{% endunless %}
                    </div>
                </div>
            {%- endfor -%}
            </div>
            {% render 'swiper-navigation', id:section.id, section_st:block_st %}
        {%- endif -%}
    </product-recommendations>
</div>
{% schema %}
{
  "name": "Complementary products",
  "tag": null,
  "settings": [
    {
        "type": "paragraph",
        "content": "To select complementary products, add the Search & Discovery app. [Learn more](https://shopify.dev/themes/product-merchandising/recommendations)"
