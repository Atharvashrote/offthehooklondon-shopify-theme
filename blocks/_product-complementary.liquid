      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ block.settings.preset == 'custom-hd' }}"
    },    
    {
      "type": "select",
      "id": "fw",
      "label": "Font weight",
      "default": "700",
      "visible_if": "{{ block.settings.preset == 'custom-hd' }}",
      "options": [
