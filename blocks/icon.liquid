{%- liquid
  assign block_st = block.settings

  capture classes
      if block_st.isbg
        echo "bg-custom "
      endif
      if block_st.ispd
        echo "pd-custom "
      endif
  endcapture
   
  assign img_alt = block_st.image.alt | escape
  assign img_class = 'img-auto'
  capture icnsizes
    echo "(min-width:1024px) " | append: block_st.icns | append: "px, " | append: block_st.icnsm | append: "px"
  endcapture
  capture widths
    echo block_st.icns | append: ", " | append: block_st.icns | times: 1.5 | round | append: ", " | append: block_st.icns | times: 2 | round
  endcapture
  if block_st.image.src contains ".svg" and block_st.custom_cl_override
    assign img_class = 'img-auto svg-icon'
  endif
-%}
{%- capture styles -%}
    --icncl:{{ block_st.cl }};--icns:{{ block_st.icns }}px;--icnsm:{{ block_st.icnsm }}px;
    {%- if block_st.isbg -%}
      --gr_bg:{% if block_st.bgg != blank %}{{ block_st.bgg }}{% else %}{{ block_st.bg }}{% endif %};
      --gr_bd:{% if block_st.bdr == 'solid' %}{{ block_st.brd_sz }}px solid {{ block_st.bdr-cl }}{% else %}0{% endif %};
    {% endif %}
    {%- if block_st.ispd -%}
      --gr_pd:{{ block_st.pd }}px;--gr_pdm:{{ block_st.pdm }}px;
    {%- endif -%}
{%- endcapture -%}
{%- if block_st.url != blank -%}<a href="{{ block_st.url }}" class="btn-icon anim" {% if block_st.newtab %} target="_blank"{% endif %}>{%- endif -%}
<div id="blk-{{ block.id }}" class="at-box__icons {{ block_st.rounded }} mb{{ block_st.mbm }} mb{{ block_st.mb }}-md{% if block_st.hide_mb %} hide-sm{% endif %} {{ classes }}" style="{{ styles }}" {{ block.shopify_attributes }}>
    {%- if block_st.icon == 'custom' and block_st.image != blank -%}
      {{- block_st.image | image_url: width: block_st.image.width | image_tag: loading:'lazy', class:img_class, sizes: icnsizes, widths: widths, alt: img_alt -}}
    {%- else -%}
    {% render 'icons', icon: block_st.icon %}                                                                                                     
    {%- endif -%}
</div>{%- if block_st.url != blank -%}</a>{%- endif -%}
