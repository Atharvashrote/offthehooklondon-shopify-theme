{%- capture mobile_menu -%}
<div class="mobile-nav__wrapper fl f-col hide-lg anim" role="navigation">
    <div class="mobile-nav__header fl">
        <a href="#mobile_nav" class="mobile-nav__title mobile-nav__links pr active">{{ 'sections.navigation.menu' | t }}</a>
        {%- if section_st.catnav and section_st.catmenu != blank -%}
            <a href="#mobile-category-nav" class="mobile-nav__title mobile-nav__links pr">{{ 'sections.navigation.categories' | t }}</a>
        {%- endif -%}
        <a href="#closeNav" class="mobile-nav__title pr ml-auto close-menu" style="--icns:16px;" title="{{ 'sections.navigation.close_menu' | t }}"><svg class="at-icon"><use xlink:href="#icon-close"></use></svg></a>
    </div>
    <ul id="mobile_nav" class="mobile-nav fl f-col {{ settings.navft }} hide-lg{% if settings.mmsub %} st2{% else %} st1{% endif %}{% if settings.nav_case %} text-upper{% endif %}" style="--icnsz:{{ settings.mbmenu-img-sz }}px;--icnrad:{{ settings.mbmenu-img-bdr }}px">
        {%- liquid
            capture arrow
                if settings.mmsub
                    echo '<svg class="at-icon arw ml-auto"><use class="mns" xlink:href="#icon-plus"></use><use xlink:href="#icon-minus"></use></svg>'
                else
                    echo '<svg class="at-icon arw right ml-auto"><use xlink:href="#icon-arrow"></use></svg>'
                endif
            endcapture
            capture arrowbk
                echo '<svg class="at-icon arw left mr20"><use xlink:href="#icon-arrow"></use></svg>'
            endcapture
        %}
        {%- if section_st.spnav -%}
            {%- for link in linklists[section_st.mbmenu].links -%}
                {%- render 'mm-mobile-links', link:link, arrow:arrow, arrowbk:arrowbk -%}
            {%- endfor -%}
        {%- else -%}
            {%- for block in section.blocks -%}
                {%- assign block_st = block.settings -%}
                {%- assign label = block_st.title |  split: '[label' | last  | split: ']' | first | prepend: "nm_lbl" -%}
                {%- capture link_level_1 -%}
                    {%- assign ttlink = block_st.url -%}
                    <a class="hasSub" href="{% if block_st.url != blank %}{{ ttlink }}{% else %}#{% endif %}">
                        {%- render 'link-icon', link: block_st -%}
                        {%- if section_st.sicnm and collection.metafields.custom.icon != blank -%}
                            {%- assign icn_size = section_st.icnm | plus: 50 -%}
                            <img class="icn mr10" src="{{ collection.metafields.custom.icon | image_url: width: icn_size }}" loading="lazy" width="{{ section_st.icnm }}" height="{{ section_st.icnm }}" alt="{{ collection.title }}" />
                        {%- endif -%}
                        {{- block_st.title | split: '[' | first -}}
                        {%- if block_st.title contains '[label' -%}<span class="lbl {{ label }}">{{ settings[label] }}</span>{%- endif -%}
                        {{- arrow -}}
                    </a>
                {%- endcapture -%}

                {%- if block.type == 'home' -%}
                    <li class="lvl1"><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>

                {%- elsif block.type == 'slink' -%}
                    <li class="lvl1">{{ link_level_1 | remove: arrow | remove: 'hasSub' }}</li>

                {%- elsif block.type == 'm1' or block.type == 'm2' or block.type == 'm4' or block.type == 'm5' or block.type == 'dd' -%}
                    {%- if block_st.title != blank -%}
                        <li class="lvl1 parent">
                            {{- link_level_1 -}}
                            <ul class="sublinks close anim">
                                {%- unless settings.mmsub -%}
                                    {%- assign name = block_st.title | split:'[label' | first -%}
                                    <li class="backto">{{ arrowbk }} {{ 'sections.navigation.back' | t: item: name }}</li>
                                {%- endunless -%}
                                {%- for link in linklists[block_st.menu].links -%}{%- render 'mm-mobile-links', link:link, arrow:arrow, arrowbk:arrowbk -%}{%- endfor -%}
                            </ul>
                        </li>
                    {%- endif -%}

                {%- elsif block.type == 'm3' and block_st.title != blank -%}
                    <li class="lvl1 parent">
                        {{- link_level_1 -}}
                        <ul class="sublinks anim">
                            {%- if block_st.ttl1 != blank or block_st.ttl2 != blank or block_st.ttl3 != blank or block_st.ttl4 != blank or block_st.ttl5 != blank -%}
                                {%- unless settings.mmsub -%}
                                    {%- assign name = block_st.title | split:'[label' | first -%}
                                    <li class="backto">{{ arrowbk }} {{ 'sections.navigation.back' | t: item: name }}</li>
                                {%- endunless -%}
                            {%- endif -%}
                            {%- for i in (1..5) -%}
                                {%- capture bkttl -%}{% cycle block_st.ttl1, block_st.ttl2, block_st.ttl3, block_st.ttl4, block_st.ttl5 %}{%- endcapture -%}
                                {%- assign m_3_label = bkttl |  split: '[label' | last  | split: ']' | first | prepend: "nm_lbl" -%}
                                {% capture bkurl %}{% cycle block_st.url1, block_st.url2, block_st.url3, block_st.url4, block_st.url5 %}{% endcapture %}
                                {% capture bkmenu %}{% cycle block_st.menu1, block_st.menu2, block_st.menu3, block_st.menu4, block_st.menu5 %}{% endcapture %}
                                {%- if bkttl != blank -%}
                                    <li>
                                        <a href="{% if bkurl != blank %}{{ bkurl }}{% else %}#{% endif %}" {% if linklists[block_st.menu1].links != blank %}class="hasSub"{% endif %}>
                                            {{- bkttl | split: '[label' | first -}}
                                            {%- if bkttl contains '[label' -%}<span class="lbl {{ m_3_label }}">{{ settings[m_3_label] }}</span>{%- endif -%}
                                            {%- if linklists[bkmenu].links != blank -%}{{ arrow }}{%- endif -%}
                                        </a>
                                        {% if linklists[bkmenu].links != blank %}
                                            <ul class="sublinks anim">
                                                <li class="backto">{{ arrowbk }} {{ bkttl | split: '[label' | first }}</li>
                                                {% for link in linklists[bkmenu].links %}
                                                    <li{% if link.active %} class="active"{% endif %}>
                                                        {%- assign label = link.title |  split: '[label' | last | split: ']' | first | prepend: "nm_lbl" -%}
                                                        <a href="{{ link.url }}">{{ link.title | split: '[label' | first }}{% if link.title contains '[label' %}<span class="lbl {{ label }}">{{ settings[label] }}</span>{% endif %}</a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {%- endif -%}
                                    </li>
                                {%- endif -%}
                            {% endfor %}
                        </ul>
                    </li>
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}

        {%- if section_st.exttxt1 != blank and section_st.extlk1 != blank -%}
            <li><a href="{{ section_st.extlk1 }}" style="color:{{ section_st.extcl1m }}">{{ section_st.exttxt1 }}</a></li>
        {%- endif -%}
        {%- if section_st.exttxt2 != blank and section_st.extlk2 != blank -%}
            <li><a href="{{ section_st.extlk2 }}" style="color:{{ section_st.extcl2m }}">{{ section_st.exttxt2 }}</a></li>
        {%- endif -%}

        {%- if section_st.help != blank -%}
            <li class="help">{{ section_st.help }}</li>
        {%- endif -%}
    </ul>

    {%- if section_st.catnav and section_st.catmenu != blank -%}
        <ul id="mobile-category-nav" class="mobile-nav {{ settings.navft }} hide{% if settings.mmsub %} st2{% else %} st1{% endif %}{% if settings.nav_case %} text-upper{% endif %}" style="--icnsz:{{ section_st.icnm }}px;--icnrad:{{ section_st.icnrad }}px">
            {% for link in linklists[section_st.catmenu].links %}{% render 'mb-cat-links', link: link, secSt: section.settings %}{% endfor %}
        </ul>
    {%- endif -%}

    {%- if settings.mlcurrency or settings.mlLang -%}
        <div class="cur-lang-mob mt-auto fl pr" style="--cl:{{ settings.mobTtl }};--bg:{{ settings.mobTtlbg }}">{%- render 'currencyLang', ismobile: true -%}</div>
    {%- endif -%}
</div>
{%- endcapture -%}
{{- mobile_menu | strip_newlines | remove: '  ' | remove: '	' -}}