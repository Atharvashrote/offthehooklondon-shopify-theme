{%- liquid
    assign form_class = 'search-form'
    if search_type == 'inline'
        assign form_class = 'search-form hide-lg'
    endif

    for collection in settings.srClList
        assign collection_image = collection.metafields.custom.custom_image.value | default: collection.image | default: collection.products.first.featured_image
        assign img_ratio = 1 | divided_by: collection_image.aspect_ratio | times: 100
        break
    endfor
-%}

{%- capture search_drawer -%}

<div class="search-drawer custom-scroll anim">

    <span class="close-search" style="--icns:16px">
        <svg class="at-icon">
            <use xlink:href="#icon-close"></use>
        </svg>
    </span>

    <div class="{% if secSt.fullwidth %}fw-section{% else %}page-width{% endif %}"
        style="--cl:{{settings.search_cl}};--fs:{{settings.search_fs}}px;--fsm:{{settings.search_fs}}px;--fw: {{settings.search_fw}};">

        <!-- SEARCH TITLE -->

        <p class="reg-text ft2 mb15{% if search_type == 'inline' %} hide-lg{% endif %}">
            {{ settings.search_ttl }}
        </p>


        <!-- SEARCH FORM -->

        {%- render 'search-form', formClass: form_class -%}


        <!-- LIVE SEARCH RESULTS -->

        <div id="serch-list" class="w-100 hide mb20"></div>


        <!-- DEFAULT SEARCH CONTENT -->

        {%- if popular_search_blocks != blank or settings.search_word != blank or settings.searchCl != blank -%}

            <div id="search-suggest__Wrapper" class="mb20">


                <!-- POPULAR SEARCH WORDS -->

                {%- assign has_popular_search_blocks = false -%}
                {%- if popular_search_blocks != blank -%}
                    {%- for block in popular_search_blocks -%}
                        {%- if block.type == 'popular_search' and block.settings.keyword != blank -%}
                            {%- assign has_popular_search_blocks = true -%}
                            {%- break -%}
                        {%- endif -%}
                    {%- endfor -%}
                {%- endif -%}

                {%- if has_popular_search_blocks -%}

                    <p class="reg-text ft2 mb15">
                        {{ settings.search_lbl1 }}
                    </p>

                    <div class="search-suggest fl f-wrap f-aic gap mb30"
                         style="--gap:14px;">

                        {%- for block in popular_search_blocks -%}
                            {%- if block.type == 'popular_search' -%}
                                {%- assign search_label = block.settings.keyword | strip -%}
                                {%- assign target_collection = block.settings.collection -%}

                                {%- if search_label != blank and target_collection != blank -%}
                                    <a href="{{ target_collection.url }}" {{ block.shopify_attributes }}>
                                        {{ search_label | escape }}
                                    </a>
                                {%- elsif search_label != blank -%}
                                    <span {{ block.shopify_attributes }}>
                                        {{ search_label | escape }}
                                    </span>
                                {%- endif -%}
                            {%- endif -%}
                        {%- endfor -%}

                    </div>

                {%- elsif settings.search_word != blank -%}

                    {%- assign searchwords = settings.search_word
                        | replace: ', ', ','
                        | split: ','
                    -%}

                    <p class="reg-text ft2 mb15">
                        {{ settings.search_lbl1 }}
                    </p>

                    <div class="search-suggest fl f-wrap f-aic gap mb30"
                         style="--gap:14px;">

                        {%- for searchvalue in searchwords -%}
                            {%- assign search_parts = searchvalue | split: '|' -%}
                            {%- assign search_label = search_parts[0] | strip -%}
                            {%- assign collection_handle = search_parts[1] | strip -%}

                            {%- if search_label != blank -%}
                                {%- if collection_handle != blank -%}
                                    <a href="{{ routes.collections_url }}/{{ collection_handle | handleize }}">
                                        {{ search_label | escape }}
                                    </a>
                                {%- else -%}
                                    <a href="{{ routes.search_url }}?type=product&amp;q={{ search_label | url_encode }}&amp;options%5Bunavailable_products%5D=last">
                                        {{ search_label | escape }}
                                    </a>
                                {%- endif -%}
                            {%- endif -%}
                        {%- endfor -%}

                    </div>

                {%- endif -%}


                <!-- POPULAR PRODUCTS TITLE -->

                {%- if settings.search_lbl2 != blank -%}

                    <p class="reg-text ft2 mb10">
                        {{ settings.search_lbl2 }}
                    </p>

                    <hr class="mt0 mb25">

                {%- endif -%}


                <!-- POPULAR PRODUCTS -->

                {%- if settings.search_recomand == 'prr' -%}

                    {%- assign collection = collections[settings.searchCl] -%}

                    {%- if collection.products.size > 0 -%}

                        <ul id="predictive-search-results-list"
                            class="grid gspace mb20 rwcols-2 rwcols-md-3 rwcols-lg-4"
                            role="list"
                            aria-label="{{ settings.search_lbl2 }}"
                            style="--grsp:7.5px;--grspm:5px;">

                            {%- for product in collection.products limit: settings.srclimit -%}

                                {%- capture sizes -%}
                                    (min-width:1024px) calc(({{ cntWd }} - 60px) / 5),
                                    (min-width:768px) calc((100vw - 45px) / 3),
                                    calc((100vw - 10px) / 2)
                                {%- endcapture -%}

                                <li class="gitem productCol {% render 'animate-data', css:true %}"
                                    {% render 'animate-data' %}
                                    role="option">

                                    {%- render 'product-card-columns',
                                        product: product,
                                        secSt: secSt,
                                        sizes: sizes,
                                        hide_currency_code: true
                                    -%}

                                </li>

                            {%- endfor -%}

                        </ul>


                        {%- if settings.btntxt != blank -%}

                            <p class="tc mt10">

                                <a href="{{ settings.searchCl.url }}"
                                    class="btn {{ settings.sbtn-size }} {{ settings.sbtn-style }} mt30">
                                    {{ settings.btntxt }}
                                </a>

                            </p>

                        {%- endif %}


                    {%- endif -%}


                {%- else -%}


                    <!-- COLLECTION SUGGESTIONS -->

                    <div class="collection-list collection-list1">

                        <div class="grid collection-grid gspace rwcols-2 rwcols-3 rwcols-lg-{{ settings.srclimit }} search_col"
                            style="--text_margin:20px;--bg:#fff;--grsp:10px;--grspm:5px;--ratio:{{ img_ratio | default:100 }}%">

                            {%- for collection in settings.srClList -%}

                                <div class="gitem">

                                    {%- assign collection_image = collection.metafields.custom.custom_image.value
                                        | default: collection.image
                                        | default: collection.products.first.featured_image
                                    -%}

                                    {%- capture ttl -%}
                                        --fs:16px;
                                        --fsm:13px;
                                        --ft:var(--ft2);
                                        --fw:600;
                                    {%- endcapture -%}

                                    {%- capture sizes -%}
                                        (min-width:1024px) calc(({{ cntWd }} - 60px) / 5),
                                        (min-width:768px) calc((100vw - 45px) / 3),
                                        calc((100vw - 10px) / 2)
                                    {%- endcapture -%}


                                    <a href="{{ collection.url }}"
                                        class="db pr of-hidden none zoom-hov">

                                        <div class="img pr of-hidden mb10 brad"
                                            style="--rounded:{{ settings.srbrad }}px;">

                                            {%- if collection_image != blank -%}

                                                {{
                                                    collection_image
                                                    | image_url: width: collection_image.width
                                                    | image_tag:
                                                        loading: 'lazy',
                                                        class: 'img-fit',
                                                        sizes: sizes,
                                                        widths: '180,320,400,560,740,900,1200'
                                                }}

                                            {%- else -%}

                                                {% capture current %}
                                                    {% cycle 1, 2, 3, 4, 5, 6 %}
                                                {% endcapture %}

                                                {{
                                                    'collection-'
                                                    | append: current
                                                    | placeholder_svg_tag: 'placeholder-svg'
                                                }}

                                            {%- endif -%}

                                        </div>


                                        <div class="collection-details pa left-50 translate-x50 tc anim none"
                                            style="padding:10px 25px;border-radius:{{settings.btn_rad}}px">

                                            <div class="head h6" style="{{ ttl }}">
                                                {{ collection.title }}
                                            </div>

                                        </div>

                                    </a>

                                </div>

                            {%- endfor -%}

                        </div>

                    </div>


                {%- endif -%}

            </div>

        {%- endif -%}

    </div>

</div>


<!-- ==========================================
     LIVE SEARCH STYLES
     ========================================== -->

<style>

    /* Search results wrapper */

    .search-drawer #serch-list {
        margin-top: 20px;
    }


    .search-drawer #serch-list.search-results-active {
        display: block !important;
    }


    /* Search result heading */

    .search-drawer .live-search-title {
        font-size: 14px;
        font-weight: 600;
        line-height: 1.4;
        margin: 0 0 18px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }


    /* Four compact columns */

    .search-drawer .live-search-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: 28px;
        row-gap: 24px;
        width: 100%;
    }


    /* Individual result */

    .search-drawer .live-search-item {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        text-decoration: none;
        color: inherit;
    }


    /* Product image */

    .search-drawer .live-search-image {
        position: relative;
        flex: 0 0 100px;
        width: 100px;
        height: 100px;
        overflow: hidden;
        background: #f7f7f7;
    }


    .search-drawer .live-search-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform .25s ease;
    }


    .search-drawer .live-search-item:hover .live-search-image img {
        transform: scale(1.04);
    }


    /* Text area */

    .search-drawer .live-search-info {
        min-width: 0;
        flex: 1;
    }


    /* Product title */

    .search-drawer .live-search-product-title {
        font-size: 15px;
        line-height: 1.35;
        font-weight: 500;
        margin: 0 0 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* Product price */

    .search-drawer .live-search-price {
        font-size: 14px;
        line-height: 1.3;
        margin: 0;
    }


    /* Sold out */

    .search-drawer .live-search-item.is-sold-out .live-search-image img {
        opacity: .5;
    }


    .search-drawer .live-search-soldout {
        display: inline-block;
        margin-top: 6px;
        padding: 2px 8px;
        font-size: 11px;
        line-height: 1.4;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: {{ settings.lbl_sold_cl | default: '#000' }};
        background: {{ settings.lbl_sold_bg | default: '#fafafa' }};
        border: 1px solid {{ settings.lbl_sold_cl | default: '#000' | color_modify: 'alpha', 0.15 }};
    }


    /* No results */

    .search-drawer .live-search-empty {
        font-size: 14px;
        line-height: 1.5;
        margin: 10px 0 20px;
    }


    .search-drawer .live-search-empty p {
        margin: 0 0 6px;
    }


    /* Loading */

    .search-drawer .live-search-status {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        line-height: 1.5;
        margin: 10px 0 20px;
    }


    .search-drawer .live-search-spinner {
        display: inline-block;
        width: 12px;
        height: 12px;
        margin-left: 10px;
        vertical-align: -1px;
        border: 2px solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        opacity: .6;
        animation: oth-live-search-spin .7s linear infinite;
    }


    .search-drawer .live-search-status .live-search-spinner {
        margin-left: 0;
    }


    @keyframes oth-live-search-spin {
        to {
            transform: rotate(360deg);
        }
    }


    @media (prefers-reduced-motion: reduce) {
        .search-drawer .live-search-spinner {
            animation-duration: 2s;
        }
    }


    /* View all */

    .search-drawer .live-search-view-all {
        margin-top: 25px;
        text-align: center;
    }


    .search-drawer .live-search-view-all a {
        display: inline-block;
        padding: 12px 25px;
        border: 1px solid currentColor;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        transition: all .2s ease;
    }


    .search-drawer .live-search-view-all a:hover {
        opacity: .7;
    }


    /* ==========================================
       TABLET
       ========================================== */

    @media screen and (max-width: 1023px) {

        .search-drawer .live-search-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: 20px;
            row-gap: 20px;
        }


        .search-drawer .live-search-image {
            flex: 0 0 80px;
            width: 80px;
            height: 80px;
        }


        .search-drawer .live-search-product-title {
            font-size: 14px;
        }


        .search-drawer .live-search-price {
            font-size: 13px;
        }

    }


    /* ==========================================
       MOBILE
       ========================================== */

    @media screen and (max-width: 575px) {

        .search-drawer .live-search-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }


        .search-drawer .live-search-image {
            flex: 0 0 75px;
            width: 75px;
            height: 75px;
        }


        .search-drawer .live-search-product-title {
            font-size: 13px;
        }


        .search-drawer .live-search-price {
            font-size: 13px;
        }

    }

</style>


<!-- ==========================================
     LIVE PREDICTIVE SEARCH
     ========================================== -->

<script>

/*
 * NOTE: this snippet's output is passed through strip_newlines,
 * so use block comments only and end every statement with a semicolon.
 */

(function () {

    /*
     * Prevent Avone from initializing this
     * script more than once.
     * (theme.js searchFocus also checks this flag and stands down.)
     */

    if (window.__offTheHookPredictiveSearchInitialized) {
        return;
    }

    window.__offTheHookPredictiveSearchInitialized = true;


    const RESULT_LIMIT = 10;
    const DEBOUNCE_MS = 150;
    const INDEX_STORAGE_KEY = 'oth-search-title-index-v1';
    const INPUT_SELECTOR = '.search-drawer input[type="search"], .search-drawer input[name="q"], .search-drawer input[type="text"]';


    let searchTimer = null;
    let searchRequest = null;
    let requestSeq = 0;
    let pendingKey = null;
    let activeInput = null;


    /*
     * Predictive search responses, keyed by normalized query,
     * so backspacing never refetches.
     */

    const suggestCache = {};


    /*
     * Compact list of published products (title, url, price, image,
     * stock) from sections/search-title-index.liquid. Loaded once per
     * session so titles starting with the query show from the first
     * character; predictive search alone returns only 10 products in
     * its own relevance order.
     */

    let titleIndex = null;
    let indexPromise = null;


    /*
     * Escape HTML so product names are safe.
     */

    function escapeHtml(value) {

        const div = document.createElement('div');

        div.textContent = value || '';

        return div.innerHTML;

    }


    function escapeAttr(value) {

        return escapeHtml(value).replace(/"/g, '&quot;');

    }


    /*
     * Case-insensitive, accent-free text with hyphens and other
     * punctuation as spaces: "Trueman-B-Tan" -> "trueman b tan".
     */

    function normalize(value) {

        return String(value || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .replace(/[^a-z0-9]+/g, ' ')
            .trim();

    }


    function productKey(product) {

        return product.handle ||
            (product.url || '').split('?')[0].split('/').pop();

    }


    /*
     * 0 = title starts with the query
     * 1 = a word in the title starts with the query
     * 2 = every query word starts a word in the title (any order)
     * -1 = no title match
     */

    function titleTier(product, query, queryWords) {

        if (!query) {
            return -1;
        }

        if (product._n === undefined) {
            product._n = normalize(product.title);
            product._w = product._n.split(' ');
        }

        if (product._n.indexOf(query) === 0) {
            return 0;
        }

        if ((' ' + product._n).indexOf(' ' + query) !== -1) {
            return 1;
        }

        if (
            queryWords.length > 1 &&
            queryWords.every(function (word) {
                return product._w.some(function (titleWord) {
                    return titleWord.indexOf(word) === 0;
                });
            })
        ) {
            return 2;
        }

        return -1;

    }


    /*
     * Merge title-index matches and predictive search results:
     * starts-with first, then other title matches, then the rest of
     * the predictive results (tags, product type...). In stock before
     * sold out inside each group. One entry per product.
     */

    function rankProducts(searchTerm, apiProducts) {

        const query = normalize(searchTerm);
        const queryWords = query ? query.split(' ') : [];
        const seen = {};
        const ranked = [];
        let titleMatches = 0;


        function add(product, tier, order) {

            const key = productKey(product);

            if (!key || seen[key]) {
                return;
            }

            seen[key] = true;

            ranked.push({ product: product, tier: tier, order: order });

        }


        if (titleIndex) {

            titleIndex.forEach(function (product) {

                const tier = titleTier(product, query, queryWords);

                if (tier >= 0) {
                    add(product, tier, 0);
                    titleMatches++;
                }

            });

        }


        (apiProducts || []).forEach(function (product, index) {

            const tier = titleTier(product, query, queryWords);

            add(product, tier >= 0 ? tier : 3, index);

        });


        ranked.sort(function (a, b) {

            if (a.tier !== b.tier) {
                return a.tier - b.tier;
            }

            const aSold = a.product.available === false ? 1 : 0;
            const bSold = b.product.available === false ? 1 : 0;

            if (aSold !== bSold) {
                return aSold - bSold;
            }

            if (a.tier === 3) {
                return a.order - b.order;
            }

            return a.product._n.localeCompare(b.product._n);

        });


        return {
            products: ranked.slice(0, RESULT_LIMIT).map(function (entry) {
                return entry.product;
            }),
            titleMatches: titleMatches
        };

    }


    /*
     * Find the current search drawer.
     */

    function getSearchDrawer(element) {

        return element.closest('.search-drawer');

    }


    /*
     * Load the title index once (sessionStorage first).
     */

    function fetchIndexPage(page) {

        return fetch(
            '{{ routes.all_products_collection_url }}?section_id=search-title-index&page=' + page,
            { headers: { 'Accept': 'text/html' } }
        )

        .then(function (response) {

            if (!response.ok) {
                throw new Error('Search index request failed');
            }

            return response.text();

        })

        .then(function (text) {

            const dataNode =
                new DOMParser()
                    .parseFromString(text, 'text/html')
                    .querySelector('script[data-search-title-index]');

            if (!dataNode) {
                throw new Error('Search index missing');
            }

            return {
                pages: parseInt(dataNode.getAttribute('data-pages'), 10) || 1,
                products: JSON.parse(dataNode.textContent)
            };

        });

    }


    function loadTitleIndex() {

        if (indexPromise) {
            return indexPromise;
        }


        try {

            const stored = sessionStorage.getItem(INDEX_STORAGE_KEY);

            if (stored) {
                titleIndex = JSON.parse(stored);
                indexPromise = Promise.resolve();
                return indexPromise;
            }

        } catch (error) {}


        indexPromise = fetchIndexPage(1)

        .then(function (first) {

            const rest = [];

            for (let page = 2; page <= first.pages; page++) {
                rest.push(fetchIndexPage(page));
            }

            return Promise.all(rest).then(function (pages) {
                return [first].concat(pages);
            });

        })

        .then(function (pages) {

            let products = [];

            pages.forEach(function (page) {
                products = products.concat(page.products);
            });

            try {
                sessionStorage.setItem(INDEX_STORAGE_KEY, JSON.stringify(products));
            } catch (error) {}

            titleIndex = products;


            /*
             * Re-rank whatever the customer has typed meanwhile.
             */

            if (activeInput && activeInput.value.trim()) {
                updateResults(getSearchDrawer(activeInput), activeInput.value.trim());
            }

        })

        .catch(function (error) {

            /*
             * Predictive search alone still works without the index.
             */

            console.warn('Search title index unavailable:', error);

        });


        return indexPromise;

    }


    /*
     * Cancel a scheduled or running predictive request so its
     * response can never overwrite newer results.
     */

    function cancelPending() {

        clearTimeout(searchTimer);

        if (searchRequest) {
            searchRequest.abort();
            searchRequest = null;
        }

        pendingKey = null;
        requestSeq++;

    }


    /*
     * Hide live results and restore
     * the default Popular Products content.
     */

    function hideLiveResults(drawer) {

        cancelPending();

        if (!drawer) {
            return;
        }

        const resultBox = drawer.querySelector('#serch-list');

        const defaultContent = drawer.querySelector(
            '#search-suggest__Wrapper'
        );


        if (resultBox) {

            resultBox.innerHTML = '';

            resultBox.classList.remove(
                'search-results-active',
                'is-loading'
            );

            resultBox.removeAttribute('aria-busy');

            resultBox.classList.add('hide');

        }


        if (defaultContent) {

            defaultContent.style.display = '';

        }

    }


    /*
     * Display predictive results.
     */

    function showLiveResults(
        drawer,
        products,
        searchTerm,
        loading
    ) {

        const resultBox = drawer.querySelector(
            '#serch-list'
        );

        const defaultContent = drawer.querySelector(
            '#search-suggest__Wrapper'
        );


        if (!resultBox) {
            return;
        }


        /*
         * Hide Popular Products while
         * customer is searching.
         */

        if (defaultContent) {

            defaultContent.style.display = 'none';

        }


        resultBox.classList.remove('hide');

        resultBox.classList.add(
            'search-results-active'
        );

        resultBox.classList.toggle('is-loading', loading);

        resultBox.setAttribute('aria-busy', loading ? 'true' : 'false');


        const spinner =
            '<span class="live-search-spinner" aria-hidden="true"></span>';


        /*
         * Nothing yet, still searching.
         */

        if (
            (!products || products.length === 0) &&
            loading
        ) {

            resultBox.innerHTML = `

                <div class="live-search-status">
                    ${spinner}
                    Searching&hellip;
                </div>

            `;

            return;

        }


        /*
         * No results.
         */

        if (
            !products ||
            products.length === 0
        ) {

            resultBox.innerHTML = `

                <div class="live-search-empty">

                    <p>
                        No products found for
                        "<strong>${escapeHtml(searchTerm)}</strong>".
                    </p>

                    <p>
                        Check the spelling, or try a shorter word such as a style name or colour.
                    </p>

                </div>

            `;

            return;

        }


        /*
         * Start results HTML.
         */

        let html = `

            <div class="live-search-title">
                Search Results${loading ? spinner : ''}
            </div>

            <div class="live-search-grid">

        `;


        /*
         * Create each product result.
         */

        products.forEach(function (product) {

            const image =
                product.featured_image?.url ||
                product.image?.url ||
                '';


            const title =
                product.title || '';


            const url =
                product.url || '#';


            const price =
                product.price || '';


            const soldOut =
                product.available === false;


            const comingSoon =
                soldOut &&
                product.coming_soon === true;


            html += `

                <a
                    href="${escapeAttr(url)}"
                    class="live-search-item${soldOut ? ' is-sold-out' : ''}"
                >

                    <div class="live-search-image">

                        ${
                            image
                            ? `
                                <img
                                    src="${escapeAttr(image)}"
                                    alt="${escapeAttr(title)}"
                                    loading="lazy"
                                >
                              `
                            : ''
                        }

                    </div>


                    <div class="live-search-info">

                        <p class="live-search-product-title">
                            ${escapeHtml(title)}
                        </p>


                        ${
                            price
                            ? `
                                <div class="live-search-price">
                                    ${price}
                                </div>
                              `
                            : ''
                        }


                        ${
                            soldOut
                            ? `
                                <span class="live-search-soldout">
                                    ${
                                        comingSoon
                                        ? 'Coming soon'
                                        : '{{ 'products.product.sold_out' | t | escape }}'
                                    }
                                </span>
                              `
                            : ''
                        }

                    </div>

                </a>

            `;

        });


        /*
         * View all results.
         */

        html += `

            </div>

            <div class="live-search-view-all">

                <a
                    href="{{ routes.search_url }}?type=product&q=${encodeURIComponent(searchTerm)}&options%5Bunavailable_products%5D=last"
                >
                    View All Results
                </a>

            </div>

        `;


        resultBox.innerHTML = html;

    }


    /*
     * Render what is known now (title index + cached predictive
     * results) and schedule a predictive request when needed.
     */

    function updateResults(
        drawer,
        searchTerm
    ) {

        if (
            !drawer ||
            !searchTerm
        ) {
            return;
        }


        const key =
            normalize(searchTerm) ||
            searchTerm.toLowerCase();

        const apiProducts =
            suggestCache[key];

        const result =
            rankProducts(searchTerm, apiProducts);


        /*
         * Skip the network when the title index
         * already fills every slot.
         */

        const loading =
            !apiProducts &&
            !(titleIndex && result.titleMatches >= RESULT_LIMIT);


        if (key !== pendingKey) {

            cancelPending();

            if (loading) {

                pendingKey = key;

                searchTimer = setTimeout(
                    function () {
                        searchProducts(drawer, searchTerm, key);
                    },
                    DEBOUNCE_MS
                );

            }

        }


        showLiveResults(
            drawer,
            result.products,
            searchTerm,
            loading
        );

    }


    /*
     * Shopify Predictive Search API.
     */

    function searchProducts(
        drawer,
        searchTerm,
        key
    ) {

        if (searchRequest) {

            searchRequest.abort();

        }


        const controller =
            new AbortController();

        const seq =
            ++requestSeq;


        searchRequest =
            controller;


        const url =
            '{{ routes.predictive_search_url }}' +
            '?q=' +
            encodeURIComponent(searchTerm) +
            '&resources[type]=product' +
            '&resources[limit]=10' +
            '&resources[limit_scope]=all' +
            '&resources[options][unavailable_products]=show' +
            '&section_id=predictive-search-data';


        fetch(
            url,
            {
                signal:
                    controller.signal,

                headers: {
                    'Accept':
                        'text/html'
                }
            }
        )

        .then(function (response) {

            if (!response.ok) {

                throw new Error(
                    'Predictive search request failed'
                );

            }

            return response.text();

        })

        .then(function (text) {

            /*
             * predictive-search-data section returns
             * the products as JSON (incl. coming soon status).
             */

            const dataNode =
                new DOMParser()
                    .parseFromString(text, 'text/html')
                    .querySelector('script[data-predictive-products]');


            suggestCache[key] =
                dataNode
                    ? JSON.parse(dataNode.textContent)
                    : [];


            /*
             * Ignore responses for an older query.
             */

            if (seq !== requestSeq) {
                return;
            }


            searchRequest = null;
            pendingKey = null;

            updateResults(
                drawer,
                searchTerm
            );

        })

        .catch(function (error) {

            /*
             * Ignore cancelled requests.
             */

            if (
                error.name ===
                'AbortError'
            ) {
                return;
            }


            console.error(
                'Predictive search error:',
                error
            );


            if (seq === requestSeq) {

                searchRequest = null;
                pendingKey = null;

                showLiveResults(
                    drawer,
                    rankProducts(searchTerm, []).products,
                    searchTerm,
                    false
                );

            }

        });

    }


    /*
     * Start loading the title index as soon as
     * the search is opened or focused.
     */

    document.addEventListener(
        'focusin',
        function (event) {

            if (event.target.matches && event.target.matches(INPUT_SELECTOR)) {
                loadTitleIndex();
            }

        }
    );


    document.addEventListener(
        'click',
        function (event) {

            if (event.target.closest && event.target.closest('.searchIcn, .searchinline')) {
                loadTitleIndex();
            }

        }
    );


    /*
     * Listen for typing: every keystroke,
     * from the first character.
     */

    document.addEventListener(
        'input',
        function (event) {

            const input =
                event.target;


            if (
                !input.matches(INPUT_SELECTOR)
            ) {
                return;
            }


            const drawer =
                getSearchDrawer(input);


            if (!drawer) {
                return;
            }


            activeInput = input;


            const searchTerm =
                input.value.trim();


            /*
             * Search box empty:
             * restore Popular Products.
             */

            if (!searchTerm) {

                hideLiveResults(
                    drawer
                );

                return;

            }


            loadTitleIndex();

            updateResults(
                drawer,
                searchTerm
            );

        }
    );


    /*
     * Escape key.
     */

    document.addEventListener(
        'keydown',
        function (event) {

            const input =
                event.target;


            if (
                !input.matches(INPUT_SELECTOR)
            ) {
                return;
            }


            if (
                event.key ===
                'Escape'
            ) {

                const drawer =
                    getSearchDrawer(
                        input
                    );


                hideLiveResults(
                    drawer
                );

            }

        }
    );

})();

</script>

{%- endcapture -%}

{{-
    search_drawer
    | strip_newlines
    | remove: '	'
    | replace: "   "," "
    | replace: "  "," "
-}}