} 

{%- if settings.heading_style == '2' -%}
    .section-header .dbi:before,.section-header .dbi:after { content:""; display:block; width:{{settings.element_wd}}px; height:2px; background-color:{{settings.element_cl}}; position:absolute; top:50%; }
    .section-header .dbi:before { right:calc(100% + 15px); }
    .section-header .dbi:after { left:calc(100% + 15px); }
{%- elsif settings.heading_style == '3' -%}
    .section-header:after { content:""; display:block; width:{{settings.element_wd}}px; height:5px; border-top:2px solid {{settings.element_cl}}; {% if settings.title_align != 'tl' %}margin:20px auto 0;{% else %}margin:15px 0 0;{% endif %} }
{%- elsif settings.heading_style == '4' or settings.heading_style == '5' or settings.heading_style == '6' -%}
    .element { color:{{settings.element_cl}}; fill:{{settings.element_cl}}; display:block; margin:0 auto 12px; max-width:{{settings.element_wd}}px; height:auto; }
{%- elsif settings.heading_style == '6' -%}
    .element * { color:{{settings.element_cl}}; fill:{{settings.element_cl}}; }
{%- elsif settings.heading_style == '7' -%}
   .section-header { background:{{settings.section_title_gradient}}; -webkit-background-clip: text; -webkit-text-fill-color: transparent;}  
{%- endif -%}

