@media only screen and (min-width:768px){
    .fw-section{ padding-left:{{ settings.pad-ipad }}px; padding-right:{{ settings.pad-ipad }}px }
} 
@media only screen and (min-width:1280px){
    body { letter-spacing:0.0{{ settings.bodyls }}em }
