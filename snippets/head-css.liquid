.hdicon { cursor:pointer; position:relative; color:var(--cl); text-align:center; padding:10px; }
.hdicon:hover { color:var(--clh); }
.hdicon p { font-family:var(--{{ settings.navft }});  font-size:var(--fs); line-height:1; font-weight:{{ settings.navfw }}; {% if settings.nav_case %} text-transform: uppercase; {% endif %} }
.cart-count { color:{{ settings.count_cl }}; font-size:11px; display:inline-block; font-weight:500; }
.cart-count.pp { position:absolute; min-width:16px; height:16px; border-radius:16px; line-height:17px; margin:-5px 0 0 -6px; background-color:{{ settings.count_bg }}; }
shopify-account { --shopify-account-avatar-size:auto;--shopify-account-dialog-position-top:calc(50% - 180px); }

shopify-account::part(dialog) { inset-inline-start: calc(50% - 180px); }

.search .search-input, 
.search .btn:is(.search-submit) { min-height:{{settings.search_h}}px !important; border:0;}
.search .adth-inputs { border:1px solid {{settings.search_border}}; border-radius:{{settings.search_rad}}px; background-color:{{settings.search_bg}}; }  
.search .search-input { padding:0 25px; color:{{ settings.search_txt }}; background: transparent; font-size:{{ settings.search_font_size }}px; border-radius:{% if is_rtl %}0 {{ settings.search_rad }}px {{ settings.search_rad }}px 0{% else %}{{ settings.search_rad }}px 0 0 {{ settings.search_rad }}px{% endif %};}
.search .search-input::placeholder { color:{{ settings.search_txt }};}  
.search .btn:is(.search-submit) { color:{{ settings.search_btnicon }}; background:{{ settings.search_btnbg }}; padding:0; width:60px; border-left:0; border-radius:{% if is_rtl %}{{ settings.search_rad }}px 0 0 {{ settings.search_rad }}px{% else %}0 {{ settings.search_rad }}px {{ settings.search_rad }}px 0{% endif %}; } 
.search .btn:is(.search-submit):hover, 
.search .btn:is(.search-submit):focus {color:{{ settings.search_btnicon }}; background:{{ settings.search_btnbg }};}

@media only screen and (min-width:1025px){
    .main-header { min-height:var(--header_height); }
    .header-logo { max-width:var(--logowd); }
    .icons-col { margin-{{ p_left }}:auto; }
}
    
{% comment %} /* Site Navigation  */ {% endcomment %}
#main-nav__wrapper { background-color:{{ settings.navbar }}; {% if settings.isnavbd %}border-top:1px solid {{ settings.navbdr }};{% endif %} }
.mgmenu {border-radius:0 0 {{settings.mbrad}}px {{settings.mbrad}}px;}
.ddmenu {border-radius:{{settings.mbrad}}px;}

@media only screen and (min-width:1025px){

	#main-nav a { position:relative; align-items:center; }
	#main-nav .snav { display:flex; padding: 5px 0;}
    #main-nav a .lbl, .catMenu a .lbl { color:{{ settings.nav_link_lbl }}; font-size:10px;font-family:var(--{{ settings.navft }}); font-weight:400; letter-spacing:0; line-height:1; display:inline-block; vertical-align:middle; margin-{{ p_left }}:5px; padding:3px 5px; position:relative; border-radius:2px; }

    #main-nav>li.ctsize, #main-nav>li.ddmenu { position:relative; }
    #main-nav>li>a { color:{{ settings.navcl }}; font-size:{{ settings.navfs }}px; font-family:var(--{{ settings.navft }}); font-weight:{{ settings.navfw }}; {% if settings.nav_case %}text-transform:uppercase;{% endif %} padding:{{ settings.nav_min_h }}px 20px; display:flex; align-items:center; white-space:nowrap; }
    #main-nav>li:hover>a, #main-nav>li>a.active { color:{{ settings.navclh }}; }
    #main-nav>li>a .lbl { display:block; position:absolute; top:0; left:50%; }
    
    .mgmenu { {% if settings.boxshdow %} box-shadow:0px 0px 6px #00000010; {% endif %} opacity:0; visibility:hidden; padding:30px 25px 35px; position:absolute; top:auto; z-index:9999; max-height:600px; overflow:auto;background-color:{{ settings.nmmbg }}; pointer-events:none; transform:translateY(20px); transition:all 0.3s ease-in; }
     #header.fw-section #main-nav li:not(.ctsize) .mgmenu { {% if settings.boxshdow %}border-top:1px solid {{ settings.mmborder}}; box-shadow:none;{% endif %} }
    .mgmenu.mmfull { width:100%; left:0; }
    .fw-section .mgmenu.mmfull { padding-left:{{ settings.pad-desk }}px; padding-right:{{ settings.pad-desk }}px; border-radius:0; }
    .mgmenu.left { inset-inline-start:-17px; }
    .mgmenu.center { {{ p_left }}:50%; transform:translate({% if is_rtl %}50%{% else %}-50%{% endif %}, 20px); }
    .mgmenu.right { inset-inline-end:-17px; }
    
    ul.ddmenu { opacity:0; visibility:hidden; width:220px; position:absolute; top:100%; {{ p_left }}:-17px; z-index:999;  padding:20px 25px; background-color:{{ settings.navddbg }}; {% if settings.boxshdow %}box-shadow:0px 0px 6px #00000010;{%  endif %} transform:translateY(30px); }

    #main-nav li:hover>div.mgmenu,
    #main-nav li:hover>.ddmenu, 
    #main-nav ul.ddmenu li:hover>ul { transform:translateY(0); opacity:1; visibility:visible; pointer-events:visible; }
    #main-nav li:hover>div.mgmenu.center { transform:translate({% if is_rtl %}50%{% else %}-50%{% endif %}, 0); }

   .img-ttl { background:var(--bg);}
  .img-ttl.above { position:absolute; bottom:20px; left:50%; transform:translate(-50%); padding:8px 35px; border-radius:{{settings.btn_rad}}px; white-space: nowrap;}
}
.mobile-nav__wrapper { width:100%; height:100%; position:fixed; {{ p_left }}:0; top:0; transform:translateX({% if is_rtl %}115%{% else %}-115%{% endif %}); z-index:999; background-color:var(--mbnav_bg); box-shadow:0 0 5px rgba(0, 0, 0, 0.3); }
.mobile-nav-active .mobile-nav__wrapper { transform:translateX(0); }
{% if settings.mmsub %}
    .mobile-nav .sublinks { overflow:hidden; }
    .mobile-nav .sublinks:not(.active),
    .mobile-nav a.active .mns { display:none; }
    .mobile-nav .sublinks { border-top:1px solid var(--mbnav_bd_cl) }
    .mobile-nav .sublinks a { padding-{{ p_left }}:30px; }
    .mobile-nav .sublinks .sublinks a { padding-{{ p_left }}:40px; }
{% else %}
    .mobile-nav ul.sublinks { width:100%; height:100%; overflow:auto; background-color:var(--mbnav_bg); position:fixed; inset-inline-start:0; top:0; z-index:1; transform:translateX({% if is_rtl %}110%{% else %}-110%{% endif %}); transition:all 0.3s ease-in-out; }
    .mobile-nav ul.sublinks.active { transform:translateX(0); z-index:5; }
{% endif %}

.cart-drawer__wrapper { top:0; {{ p_right }}:0; visibility:hidden; z-index:1200; background-color:rgba(0,0,0,0.5); }
.search-drawer { padding:35px 0; width:100%; max-height:100vh; opacity:0; visibility:hidden; transform:translateY(-100%); position:fixed; top:0; left:0; z-index:668; overflow:auto; background-color:{{ settings.search_drawer_bg }}; box-shadow:inset 0 0 15px {{ settings.search_shadow }}; pointer-events:none; }
.search-result { display:none; min-width:100%; max-height:calc(100vh - 100px); overflow:auto; z-index:99; background-color:{{ settings.search_drawer_bg }}; border-radius:6px; padding:30px; box-shadow:0 0 3px {{ settings.drawer_txt | color_modify:'alpha', 0.10 | replace:", ","," }}; }
{% if settings.hide_price_search %}#predictive-search-results-list .product-price { display:none }{% endif %}

{%- if request.design_mode -%}
    #theme-wrapper { font-size:15px; position:absolute; top:0; bottom:0; z-index:99999; width:100%; height:100%; text-align:center; display:flex; align-items:center; justify-content:center;
         background-color:#f4f4f4;   background-image: url('{{ "theme-active-bg.webp" | asset_url }}');   background-repeat: no-repeat;     background-position: center;     background-size: cover;}
    #theme-wrapper .cntWrapper { max-width:600px; margin:auto; padding:20px; }
     #theme-wrapper .cntWrapper h2 { margin-bottom:25px;}
    #theme-wrapper .note { color:#cb321E; font-weight:600; font-size:16px; margin-top:20px;}
    #theme-wrapper h2 { font-size:40px; font-weight:700; }
    #theme-wrapper .steps { background-color:#fff; padding:40px; border-radius:10px; text-align:left; font-size:15px; border:1px solid #eef;}
    #theme-wrapper .steps li { padding:12px 0; border-bottom:1px solid #eee; margin:0;}
    #theme-wrapper .steps ul { margin-bottom:20px;}
    #theme-wrapper a { text-decoration:underline; }
    #theme-wrapper p { margin:15px 0; }
    #theme-wrapper .links a { display:inline-block; margin:10px; }
    #theme-wrapper .success { color:#0baa25 }
    #theme-wrapper .error { color: #cb321E; font-weight: 16px; font-weight: 500; margin-bottom: 25px;}
    @media only screen and (max-width:767px){
      #theme-wrapper { font-size:13px; }
      #theme-wrapper  h2 { font-size:22px; }
   }
{%- endif -%}
</style>

