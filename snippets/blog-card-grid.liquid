<div class="pr of-hidden {{ section_st.blog_align }}{% if section_st.layout == 'grid-2' %} of-hidden {{ section_st.rounded }}{% endif %}{% if section_st.is_bg %} {{ section_st.box-rounded }}{% endif %}">   
    {% if article.image %}
      <div class="pr of-hidden {{ section_st.rounded }}{% if section_st.grids == '2' %} w-100 fl1{% endif %}">
        <a class="db" href="{{ article.url }}" style="padding-bottom:{{ section_st.img_ratio }}%;">
            {{ article.image | image_url: width: article.image.width | image_tag: loading:'lazy', class:'img-fit', sizes: sizes, widths:"300,450,600,750,900" }}
        </a>
         {% if section_st.tags and article.tags.size > 0 %}
          <div class="blog-tags fl f-wrap {{ section_st.blog_align }} gap pa fw-500 fs12" style="--gap:10px">
            {% for tag in article.tags %}<a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% endfor %}
          </div>
        {% endif %} 
      </div>
    {% endif %} 
    <div class="blog-content {{ section_st.blog_align }}{% if  section_st.is_bg %} bg-true{% else %} mt25 mb30{% endif %}" style="--bg_cl:{{section_st.bg_cl}};--cl:{{ section_st.cl }}">        
        <{{ section_st.htag }} class="head {{ section_st.preset }} mb10{% if section_st.tcase %} text-upper{% endif %}"><a href="{{ article.url }}">{{ article.title }}</a></{{ section_st.htag }}>
        {% if section_st.date or section_st.author or section_st.comment %}
            <ul class="fl mb15 blog-meta {{ section_st.blog_align }} f-wrap{% if section_st.post_case %} text-upper{% endif %}" style="--icns:14px;">
                {% if section_st.date %}
                    <li><time class="fl f-ais" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    <span class="sep-{{ section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-date' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>
                    {{ article.published_at | date: format: 'month_day_year' }}</time></li>
                {% endif %}
                {% if section_st.author %}
                    <li class="fl">
                    <span class="sep-{{section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-user' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>
                    {{ 'blogs.article.by_author' | t }} <span class="ml5">{{ article.author }}</span></li>
                {% endif %}
                {% if section_st.comment and article.comments_count > 0 %}
                    <li class="cmnt fl"><a href="{{ article.url }}#comments">
                  <span class="sep-{{ section_st.post_sep }}">{% if section_st.post_sep == '1' %}{% render 'icon-comment' %} {% elsif section_st.post_sep == '2'%} 〡 {% elsif section_st.post_sep == '3' %} ● {% elsif section_st.post_sep == '4' %} ━ {% endif %}</span>
                    {{ 'blogs.comments.comments_with_count' | t: count: article.comments_count }}</a></li>
                {% endif %}
            </ul>
        {% endif %}
        {% if section_st.desc %}
            <div class="rte mb25">{% if article.excerpt.size > 0 %}{{ article.excerpt | truncatewords: section_st.dwords }}{% else %}{{ article.content | strip_html | truncatewords: section_st.dwords }}{% endif %}</div>
        {% endif %}
        {% if section_st.more %}<a class="btn btn-sm" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }} <span class="hidden_txt">about {{ article.title }}</span></a>{% endif %}        
    </div>
</div>