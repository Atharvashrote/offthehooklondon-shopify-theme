{%- liquid     
	assign boxstyle = section_st.prbox_style | default: settings.prbox_style
	assign second_img = settings.secondary_image
    assign product_review = settings.show_product_review
    assign hide_atc = settings.hide_atc
    assign hide_wishlist = settings.hide_wishlist
    assign hide_quickview = settings.hide_quickview
    assign hide_icons_mb = settings.btn_mobiles  		
   
    if section_st.prbox_style != blank  		
		assign vendor_name = section_st.show_vendor  		  		 		
  		assign color_swatch = section_st.show_color_swatch
	else  		
  		assign vendor_name = settings.show_vendor
  		assign color_swatch = settings.show_color_swatch
	endif

    if showSw == false
      assign color_swatch = false
    endif
   
    assign product_url = product.url | within: collection
	  assign quick_url = product.url | split: "?" | first
    
    if settings.clurl
        assign product_url = product.url
    endif

    assign product_media = product.featured_media
    assign image_class = 'img-fit'
    if second_img and product.images.size > 1
       assign image_class = 'img-fit primary'
       if product_media.media_type == 'video'
         assign image_class = 'img-fit primary lazy'
       endif
    endif

    # Optional srcset list from the caller (products-carousel peek mode); other callers keep the default.
    # Shopify drops srcset widths above the source width, so a source smaller than the largest step
    # (e.g. 382px) would top out at a lower step (320). Offer the source width itself in that case.
    assign img_widths = '200,320,460,550,660,800'
    assign img2_widths = img_widths
    if widths != blank
      assign img_widths = widths
      assign img2_widths = widths
      assign width_list = widths | split: ','
      assign max_w = width_list | last | plus: 0
      assign src_w = product.featured_image.width | default: 0
      if src_w > 0 and src_w < max_w
        assign src_w_str = src_w | append: ''
        unless width_list contains src_w_str
          assign img_widths = widths | append: ',' | append: src_w_str
        endunless
      endif
      assign src_w = product.images[1].width | default: 0
      if src_w > 0 and src_w < max_w
        assign src_w_str = src_w | append: ''
        unless width_list contains src_w_str
          assign img2_widths = widths | append: ',' | append: src_w_str
        endunless
      endif
    endif

    # Homepage carousel (card_portrait from products-carousel): 20:29 cards, target 400x580.
    # Portrait sources (3:4, e.g. 1800x2400) are centre-cropped to 20:29 on the CDN (about 4% off each side);
    # square or landscape sources are never cropped (no cut-off footwear) and are shown whole (pc-fit = contain).
    # image_tag drops srcset widths above the base URL width, so the base is the 2x file (800) and the
    # width/height attributes carry the 400x580 target.
    if card_portrait
      assign img_widths = '200,300,400,600,800'
      assign img2_widths = img_widths
      assign pc_img = product.featured_image
      # No image (or no second image): skip, image_url on nil would print a Liquid error
      if pc_img == blank
      elsif pc_img.aspect_ratio <= 0.8
        assign pc_src = pc_img | image_url: width: 800, height: 1160, crop: 'center'
        assign pc_class = image_class | append: ' pc-crop'
        assign pc_h = 580
      else
        assign pc_src = pc_img | image_url: width: 800
        assign pc_class = image_class | append: ' pc-fit'
        assign pc_h = 400 | divided_by: pc_img.aspect_ratio | round
      endif
      assign pc_img2 = product.images[1]
      if pc_img2 == blank
      elsif pc_img2.aspect_ratio <= 0.8
        assign pc_src2 = pc_img2 | image_url: width: 800, height: 1160, crop: 'center'
        assign pc_class2 = 'img-fit hover pc-crop'
        assign pc_h2 = 580
      else
        assign pc_src2 = pc_img2 | image_url: width: 800
        assign pc_class2 = 'img-fit hover pc-fit'
        assign pc_h2 = 400 | divided_by: pc_img2.aspect_ratio | round
      endif
    endif

    assign lazy_img = 'lazy'
    assign fetch_priority = 'auto'
    if section.index < 3 and product_index <= 4
        assign lazy_img = 'eager'
        assign fetch_priority = 'high'
    endif
   
assign coming_soon = false
assign custom_status = ''

if product.metafields.custom.sold != blank
    assign custom_status = product.metafields.custom.sold.value | default: product.metafields.custom.sold | strip

    if custom_status == 'Coming Soon' and product.available == false
        assign coming_soon = true
    endif
endif



    if boxstyle == "grid-1" or boxstyle == "grid-2" or boxstyle == "grid-6"
		assign lblposition = "top"
    elsif boxstyle == "grid-3"
        assign lblposition = "right"
    elsif boxstyle == "grid-4"
    	assign lblposition = "left"
	endif
-%}
{%- capture btn_wishlist -%}
  {%- if settings.wishlist -%}
    <button type="button" class="grid-button pr addwishlist{% if boxstyle == "grid-6" %} hide{% endif %}" data-url="{{pages[settings.wishlist_page].url}}" data-id="{{ product.id }}" aria-label="{{ 'products.wishlist.add_to_wishlist' | t }}">{{-  -}}
      <span class="txt"><svg class="at-icon wishicon"><use class="add" xlink:href="#icon-wishlist"></use><use class="added" xlink:href="#icon-remove"></use></svg></span>{{-  -}}
      <span class="tooltip-label {{lblposition}}">{{ 'products.wishlist.add_to_wishlist' | t}}</span><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg>{{-  -}}
    </button>
  {%- endif -%}
{%- endcapture -%}
{%- capture btn_quickview -%}
  {%- if settings.quick_view -%}
      <button type="button" data-url="{{ quick_url }}?section_id=quick-view" class="grid-button pr quick-view{% if boxstyle == "grid-6" %} hide{% endif %}" aria-label="{{ 'products.product.quick_view' | t }}">{{-  -}}
        <span class="txt"><svg class="at-icon"><use xlink:href="#icon-eye"></use></svg></span>{{-  -}}
        <span class="tooltip-label {{lblposition}}">{{ 'products.product.quick_view' | t}}</span>{{-  -}}
        <svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg>{{-  -}}
      </button>
  {%- endif -%}
{%- endcapture -%}
{%- capture btn_cart -%}
  {%- unless settings.catalog-mode -%}
        {%- if product.available -%}
            {%- assign variant_count = product.variants | size -%}
            {%- if variant_count > 1 -%}
                  <button type="button" class="{% if boxstyle == "grid-2" or boxstyle == "grid-4" or boxstyle == "grid-6"  %}btn h-auto {% endif %}grid-button{% if boxstyle == "grid-4" %} db{% else %} pr{% endif %} btn-options quickShop{% if hide_icons_mb %} hide-sm{% endif %}" data-url="{{ quick_url }}?section_id=quick-shop" aria-label="{{ 'products.product.quick_shop' | t }}">
                      <span class="txt">
                      {%- if boxstyle == "grid-2" or boxstyle == "grid-4" or boxstyle == "grid-6"-%}
                          {{ 'products.product.quick_shop' | t}}
                      {%- else -%}
                        <svg class="at-icon"><use xlink:href="#icon-cart"></use></svg> <span class="tooltip-label {{lblposition}}">{{ 'products.product.quick_shop' | t}}</span>
                      {%- endif -%}
                      </span>
                      <svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg>
                  </button>
            {%- else -%}
                <product-form class="product-form">
                    {%- form 'product', product, id: 'quickadd', class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" name="add" id="AddToCart-{{ product.id }}" class="{% if boxstyle == "grid-2" or boxstyle == "grid-4" or boxstyle == "grid-6" %}btn h-auto {% endif %}grid-button{% if boxstyle == "grid-4" %} db{% else %} pr{% endif %}{% if hide_icons_mb %} hide-sm{% endif %}" aria-label="{{ 'products.product.add_to_cart' | t }}">
                            <span class="txt" id="AddToCartText-{{ product.id }}">
                              {%- if boxstyle == "grid-2" or boxstyle == "grid-4" or boxstyle == "grid-6" -%}
                                 {{ 'products.product.add_to_cart' | t}}
                             {%- else -%}
                                  <svg class="at-icon"><use xlink:href="#icon-cart"></use></svg> <span class="tooltip-label {{lblposition}}">{{ 'products.product.add_to_cart' | t}}</span>
                             {%- endif -%}
                            </span>
                            <div class="loading__spinner"><svg class="at-icon at-spin"><use xlink:href="#icon-loading"></use></svg></div>
                        </button>
                    {%- endform -%}
                </product-form>
            {%- endif -%}
        {%- endif -%}
    {%- endunless -%}
{%- endcapture -%}

{%- capture buttons -%}  
      <div class="button-set{% if hide_icons_mb %} hide-sm{% endif %}" style="--icns:15px;">
        {%- unless hide_wishlist -%}{{ btn_wishlist }}{%- endunless -%}
        {%- unless hide_atc -%}{% if product.metafields.custom.external_link_text == blank and product.metafields.custom.external_link == blank %} {{ btn_cart }}{% endif %}{%- endunless -%}      
        {%- unless hide_quickview -%} {{ btn_quickview }}{%- endunless -%}      
      </div> 
{%- endcapture -%}

{%- capture product_timer -%}
	{%- if settings.display_countdown and product.metafields.my_fields.countdown != blank -%}
        <countdown-time class="grid-timer adth-timer pa db tc fl text-upper anim left-50 translate-x50 hide-sm hide-md" data-date="{{product.metafields.my_fields.countdown }}" data-complete="true">
          <span><span class="tm days">00</span>{{'date_formats.days' | t}}</span>
          <span><span class="tm hours">00</span>{{ 'date_formats.hours' | t }}</span>
          <span><span class="tm minutes">00</span>{{'date_formats.minuts' | t}}</span>
          <span><span class="tm seconds">00</span>{{'date_formats.seconds' | t}}</span>
        </countdown-time>
	{%- endif -%}
{%- endcapture -%}
{% capture product_labels %}
        {%- if settings.lbl_sale and product.compare_at_price > product.price -%}
          <span class="lbl sale">
              {%- if settings.lbl_sale_type == "1" -%}
                {{- 'products.product.on_sale' | t -}}
              {%- else -%}
                {{- product.compare_at_price_min | minus: product.price | times: 100 | divided_by: product.compare_at_price_min -}}% OFF
              {%- endif -%}
          </span>
        {%- endif -%}
        {%- if product.tags contains settings.pr_label1 -%}<span class="lbl {{ settings.pr_label1 | handleize }}">{{ settings.pr_label1 }}</span>{%- endif -%}
        {%- if product.tags contains settings.pr_label2 -%}<span class="lbl {{ settings.pr_label2 | handleize }}">{{ settings.pr_label2 }}</span>{%- endif -%}
        {%- if product.tags contains settings.pr_label3 -%}<span class="lbl {{ settings.pr_label3 | handleize }}">{{ settings.pr_label3 }}</span>{%- endif -%}
        {%- for label in product.metafields.custom.select_labels.value -%}
          <span class="lbl {{ label.label | handleize }}">{{ label.label }}</span>
        {%- endfor -%}
        {%- if coming_soon -%}
          <span class="lbl coming-soon-badge">COMING SOON</span>
        {%- elsif settings.soldout_style == '1' and settings.soldout_lbl and product.available == false and coming_soon == false -%}
          <span class="lbl sold-out">{{ 'products.product.sold_out' | t}}</span>
        {%- endif -%}
 {% endcapture %}
<product-card class="db grid-content {{ boxstyle }}{% if settings.grid_box %} {{ settings.grid_boxrd }}{% endif %}{% if product.available == false and coming_soon == false %} sold-out style{{ settings.soldout_style }}{% endif %}"{% if card_portrait %} data-swap-section="product-card-swap-carousel"{% elsif hide_currency_code %} data-swap-section="product-card-swap-search"{% endif %}>
  {%- if boxstyle == "grid-2" -%}<a class="overly h-100 w-100 pa db" href="{{ product_url }}" aria-label="{{ product.title }}"></a>{%- endif -%}
  <div class="grid-image__wrapper mb15 {{ settings.grid-image_rad }}">
    <a class="grid-image" href="{{ product_url }}">
        {% if product_media.media_type == 'video' %}
            {% capture video_tag %}{{ product_media | video_tag: loop:true, autoplay:true, muted:muted, class:image_class }}{% endcapture %}
            {{ video_tag | replace: 'src=', 'data-src=' }}
        {%- elsif product.featured_image and card_portrait -%}
            {{ pc_src | image_tag: loading:lazy_img, fetchpriority: fetch_priority, class:pc_class, sizes:sizes, widths:img_widths, width: 400, height: pc_h, alt: product.featured_image.alt }}
        {%- elsif product.featured_image -%}
            {{ product.featured_image | image_url: width: product.featured_image.width | image_tag: loading:lazy_img, fetchpriority: fetch_priority, class:image_class, sizes:sizes, widths:img_widths }}
        {%- endif -%}
        {%- if second_img and product.images.size > 1 and boxstyle != "style2" -%}
            {%- if card_portrait -%}
            {{ pc_src2 | image_tag: loading:'lazy', class:pc_class2, sizes:sizes, widths:img2_widths, width: 400, height: pc_h2, alt: product.images[1].alt }}
            {%- else -%}
            {{ product.images[1] | image_url: width: product.images[1].width | image_tag: loading:'lazy', class:'img-fit hover', sizes:sizes, widths:img2_widths }}
            {%- endif -%}
        {%- endif -%}
    </a>
    {%- if settings.product-label -%}
        {%- if product_labels != blank -%}
        <div class="product-label fl f-col pa z1">{{ product_labels }}</div>
        {%- endif -%}
        {%- if settings.soldout_style == '2' and settings.soldout_lbl and product.available == false and coming_soon == false -%}
            <span class="lbl sold-out st2 pa fl f-aic f-jcc"><span>{{ 'products.product.sold_out' | t }}</span></span>
        {%- endif -%}
    {%- endif -%}

    {{- product_timer -}}

    {%- if boxstyle == "grid-1" or boxstyle == "grid-3" -%}{{ buttons }}{%- endif -%}
    
    {%- if boxstyle == "grid-4" -%}
      <div class="grid-4__top anim fl f-col pa{% if hide_icons_mb %} hide-sm{% endif %}">{%- unless hide_wishlist -%}{{ btn_wishlist }}{%- endunless -%}{%- unless hide_quickview -%}{{ btn_quickview }}{%- endunless -%}</div>
      {%- unless hide_atc -%}<div class="grid-4__bottom anim pa{% if hide_icons_mb %} hide-sm{% endif %}">{{ btn_cart }}</div>{%- endunless -%}
    {%- endif -%}
   
    {%- if settings.marquee and  product.metafields.custom.scrolling_text != blank -%}
      <div class="grid-marquee fl pa {{ settings.m_case }} {{ settings.m_fw }} w-100 of-hidden anim" style="--grsp:20px;">
        {%- for i in (0..3) -%}
          <div class="fl gap marquee">
            <span class="marquee-text">{{ product.metafields.custom.scrolling_text }}</span><span class="marquee-text">{{ product.metafields.custom.scrolling_text }}</span>
          </div>
        {% endfor %}
      </div>
    {%- endif -%}
    
  </div>
  <div class="grid-meta anim">
    {%- if vendor_name -%}<div class="grid-vendor">{{ product.vendor }}</div>{%- endif -%}
    <div class="grid-title product-title{% if settings.gttl_case %} text-upper{% endif %}">
      {%- if boxstyle == "grid-5" -%}{{ buttons }}{%- endif -%}
      <a href="{{ product_url }}">{{ product.title }}</a>
      {%- if product.metafields.descriptors.subtitle != blank and settings.is_subttl -%}<div>{{ product.metafields.descriptors.subtitle }}</div>{%- endif -%}
    </div>
    {%- unless settings.hide-price -%}<div class="grid-price">{% render 'product-price', product: product, hide_currency_code: hide_currency_code %}</div>{%- endunless -%}
    {%- if product_review -%}<div class="product-review">{%- render 'ratings', product: product -%}</div>{%- endif -%}
    {%- if color_swatch -%}{%- render 'color-swatches', product: product -%}{%- endif -%}
	  {%- if boxstyle == "grid-2" -%}{{- btn_cart -}}{%- endif -%}
    {%- if boxstyle == "grid-6" -%}{{- buttons -}}{%- endif -%}
  {{-  -}}</div>
</product-card>

<style>
  product-card .coming-soon-badge {
    background: #BABD8D !important;
    color: #fff !important;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
</style>

<style>
  product-card:has(.coming-soon-badge) .sold-out,
  product-card:has(.coming-soon-badge) .lbl.sold-out,
  product-card:has(.coming-soon-badge) .sold-out.st2 {
    display: none !important;
  }

  product-card:has(.coming-soon-badge) {
    opacity: 1 !important;
  }
</style>
