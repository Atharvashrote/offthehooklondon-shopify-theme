
{%- liquid
    assign compare_at_price = product.compare_at_price
    assign price = product.price | default: 1999
    assign price_varies = product.price_varies

    assign money_price = price | money_with_currency
    assign min_price = product.price_min | money_with_currency
    assign max_price = product.price_max | money_with_currency
    assign compare_money_price = compare_at_price | money_with_currency

    comment
      hide_currency_code (search only): shop money format without the trailing currency code, e.g. £35.00
    endcomment
    if hide_currency_code
        assign money_price = price | money
        assign min_price = product.price_min | money
        assign max_price = product.price_max | money
        assign compare_money_price = compare_at_price | money
    endif
-%}

{%- if compare_at_price > price -%}
    <span class="hidden_txt">{{ 'products.product.regular_price' | t }}</span>
    <span class="product-price sale">{{ money_price }}</span>
    <s class="product-price">{{ compare_money_price }}</s>
{%- else -%}
    {%- if price_varies -%}
        {%- if settings.price_style == 'default' -%}
            <span class="product-price">
                {% if settings.price_lbl %}{{ settings.price_lbl_txt }}{% endif %}
                {{ money_price }}
            </span>
        {%- else -%}
            <span class="product-price">
                {% if settings.price_lbl %}{{ settings.price_lbl_txt }}{% endif %}
                {{ min_price }} - {{ max_price }}
            </span>
        {%- endif -%}
    {%- else -%}
        <span class="hidden_txt">{{ 'products.product.regular_price' | t }}</span>
        <span class="product-price">{{ money_price }}</span>
    {%- endif -%}
{%- endif -%}
