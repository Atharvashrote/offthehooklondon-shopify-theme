{%- comment -%} Absolute URL for the share services: products pass a full URL, articles a relative one. {%- endcomment -%}
{%- assign share_abs = share_link -%}
{%- unless share_link contains '://' -%}{%- assign share_abs = shop.url | append: share_link -%}{%- endunless -%}
<script src="{{ 'share.js' | asset_url }}" defer="defer"></script>

<share-button id="Share-{{ section.id }}" class="share-button fl">

  <a
    href="#share-popup"
    class="fl f-aic popup-link [linkclass]"
    data-popup="share-popup"
    aria-haspopup="dialog"
    role="link"
  >
    <svg
      class="at-icon mr5"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 48 48"
    >
      <path d="M 36 5 C 32.151772 5 29 8.1517752 29 12 C 29 12.585766 29.198543 13.109464 29.335938 13.654297 L 17.345703 19.652344 C 16.059118 18.073938 14.181503 17 12 17 C 8.1517722 17 5 20.151775 5 24 C 5 27.848225 8.1517722 31 12 31 C 14.181503 31 16.059118 29.926062 17.345703 28.347656 L 29.335938 34.345703 C 29.198543 34.890536 29 35.414234 29 36 C 29 39.848225 32.151772 43 36 43 C 39.848228 43 43 39.848225 43 36 C 43 32.151775 39.848228 29 36 29 C 33.818497 29 31.940882 30.073938 30.654297 31.652344 L 18.664062 25.654297 C 18.801457 25.109464 19 24.585766 19 24 C 19 23.414234 18.801457 22.890536 18.664062 22.345703 L 30.654297 16.347656 C 31.940882 17.926062 33.818497 19 36 19 C 39.848228 19 43 15.848225 43 12 C 43 8.1517752 39.848228 5 36 5 z M 36 8 C 38.226909 8 40 9.7730927 40 12 C 40 14.226907 38.226909 16 36 16 C 33.773091 16 32 14.226907 32 12 C 32 9.7730927 33.773091 8 36 8 z M 12 20 C 14.226909 20 16 21.773093 16 24 C 16 26.226907 14.226909 28 12 28 C 9.7730915 28 8 26.226907 8 24 C 8 21.773093 9.7730915 20 12 20 z M 36 32 C 38.226909 32 40 33.773093 40 36 C 40 38.226907 38.226907 40 36 40 C 33.773091 40 32 38.226907 32 36 C 32 33.773093 33.773091 32 36 32 z">
      </path>
    </svg>

    {{- 'general.social.share' | t -}}
  </a>

  <div
    id="share-popup"
    class="tinglebox pp-hide cm"
  >

    <!-- COPY LINK HEADING -->
    <label
      class="fs16 fw-600 tc mb15 text-upper"
      for="ShareUrl-{{ section.id }}"
    >
      {{ 'general.social.copy_to_clipboard' | t }}
    </label>

    <!-- COPY LINK -->
    <div
      class="fl f-wrap mb15 gap"
      style="--gap:8px"
    >
      <input type="text" class="fl1 mb0" id="ShareUrl-{{ section.id }}" value="{{ share_link }}" onclick="this.select();" readonly>

      <button
        type="button"
        class="copy_url btn"
        aria-label="{{ 'general.social.copy_to_clipboard' | t }}"
      >
        {{- 'icon-copy.svg' | inline_asset_content -}}

        <span class="hidden_txt">
          {{ 'general.social.copy_to_clipboard' | t }}
        </span>
      </button>
    </div>

    <!-- COPY SUCCESS MESSAGE -->
    <span
      id="ShareMessage-{{ section.id }}"
      class="share_message scmsg hidden mb15 fw-500 tc"
      role="status"
      aria-live="polite"
    >
      {{ 'general.social.success_message' | t }}
    </span>

    <!-- SOCIAL SHARING -->
    <div
      class="social-sharing fl f-wrap f-jcc f-aic gap"
      style="--gap:10px;"
    >

      <p class="h5 mb0 fw-500 fs16">
        {{ 'general.social.share_on' | t }}:
      </p>


      <!-- FACEBOOK -->
      <a
        href="https://www.facebook.com/sharer/sharer.php?u={{ share_abs | url_encode }}"
        class="btn-share share-facebook fl f-aic f-jcc"
        title="Share on Facebook"
        aria-label="Share on Facebook"
        target="_blank"
        rel="noopener noreferrer"
        onclick="window.open(this.href, 'facebook-share', 'menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=500,width=700'); return false;"
      >
        <svg
          class="at-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 264 512"
        >
          <path d="M76.7 512V283H0v-91h76.7v-71.7C76.7 42.4 124.3 0 193.8 0c33.3 0 61.9 2.5 70.2 3.6V85h-48.2c-37.8 0-45.1 18-45.1 44.3V192H256l-11.7 91h-73.6v229">
          </path>
        </svg>
      </a>


      <!-- WHATSAPP -->
      <a
        href="https://wa.me/?text={{ share_title | append: ' - ' | append: share_abs | url_encode }}"
        class="btn-share share-whatsapp fl f-aic f-jcc"
        title="Share on WhatsApp"
        aria-label="Share on WhatsApp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          class="at-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 448 512"
        >
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z">
          </path>
        </svg>
      </a>


      <!-- INSTAGRAM -->
      <a
        href="https://www.instagram.com/"
        class="btn-share share-instagram fl f-aic f-jcc"
        title="Open Instagram"
        aria-label="Open Instagram"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          class="at-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 448 512"
        >
          <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12.1 26.8-26.8 26.8-14.9 0-26.8-12.1-26.8-26.8s12.1-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2C293.7 21.5 154.3 21.5 117.5 23.2 81.6 24.9 49.8 35.1 23.6 61.3-2.6 87.5-12.8 119.3-14.5 155.2c-1.7 36.8-1.7 176.2 0 213 1.7 35.9 9.9 67.7 36.2 93.9 26.2 26.2 58 34.4 93.9 36.2 36.8 1.7 176.2 1.7 213 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 1.7-36.8 1.7-176.1 0-213zm-47.9 260.7c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132 9s-102.5 2.6-132-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132s-2.6-102.5 9-132c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132-9s102.5-2.6 132 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132s2.7 102.5-9 132z">
          </path>
        </svg>
      </a>


      <!-- PINTEREST -->
      <a
        href="https://www.pinterest.com/pin/create/button/?url={{ share_abs | url_encode }}&media={{ share_image | image_url: width: 1024 | url_encode }}&description={{ share_title | url_param_escape }}"
        class="btn-share share-pinterest fl f-aic f-jcc"
        title="Share on Pinterest"
        aria-label="Share on Pinterest"
        target="_blank"
        rel="noopener noreferrer"
        onclick="window.open(this.href, 'pinterest-share', 'menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=600,width=800'); return false;"
      >
        <svg
          class="at-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 384 512"
        >
          <path d="M204 6.5C101.4 6.5 0 74.9 0 185.6 0 256 39.6 296 63.6 296c9.9 0 15.6-27.6 15.6-35.4 0-9.3-23.7-29.1-23.7-67.8 0-80.4 61.2-137.4 140.4-137.4 68.1 0 118.5 38.7 118.5 109.8 0 53.1-21.3 152.7-90.3 152.7-24.9 0-46.2-18-46.2-43.8 0-37.8 26.4-74.4 26.4-113.4 0-66.2-93.9-54.2-93.9 25.8 0 16.8 2.1 35.4 9.6 50.7-13.8 59.4-42 147.9-42 209.1 0 18.9 2.7 37.5 4.5 56.4 3.4 3.8 1.7 3.4 6.9 1.5 50.4-69 48.6-82.5 71.4-172.8 12.3 23.4 44.1 36 69.3 36 106.2 0 153.9-103.5 153.9-196.8C384 71.3 298.2 6.5 204 6.5z">
          </path>
        </svg>
      </a>


      <!-- EMAIL -->
      <a
        href="mailto:?subject={{ 'Check this product - ' | append: share_title | url_param_escape }}&body={{ share_abs | url_param_escape }}"
        class="btn-share share-email fl f-aic f-jcc"
        title="Share by Email"
        aria-label="Share by Email"
        target="_blank"
      >
        <svg
          class="at-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 512 512"
        >
          <path d="M464 64H48C21.49 64 0 85.49 0 112v288c0 26.51 21.49 48 48 48h416c26.51 0 48-21.49 48-48V112c0-26.51-21.49-48-48-48zm0 48v40.805c-22.422 18.259-58.168 46.651-134.587 106.49-16.841 13.247-50.201 45.072-73.413 44.701-23.208.375-56.579-31.459-73.413-44.701C106.18 199.465 70.425 171.067 48 152.805V112h416zM48 400V214.398c22.914 18.251 55.409 43.862 104.938 82.646 21.857 17.205 60.134 55.186 103.062 54.955 42.717.231 80.509-37.199 103.053-54.947 49.528-38.783 82.032-64.401 104.947-82.653V400H48z">
          </path>
        </svg>
      </a>

    </div>
  </div>
</share-button>

<style>
/* ---------------------------------------------------------
   COPY SUCCESS MESSAGE
--------------------------------------------------------- */

#share-popup .share_message.hidden {
    display: none !important;
}

#share-popup .share_message:not(.hidden) {
    display: block !important;
}


/* ---------------------------------------------------------
   SOCIAL SHARE BUTTONS
--------------------------------------------------------- */

#share-popup .social-sharing .btn-share {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    text-decoration: none;
}

#share-popup .social-sharing .btn-share .at-icon {
    width: 18px;
    height: 18px;
    margin: 0 !important;
}

#share-popup .social-sharing .share-instagram .at-icon {
    width: 19px;
    height: 19px;
}

#share-popup .social-sharing .share-whatsapp .at-icon {
    width: 19px;
    height: 19px;
}

#share-popup .social-sharing .share-pinterest .at-icon {
    width: 19px;
    height: 19px;
}
</style>